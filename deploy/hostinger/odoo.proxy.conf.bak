[options]
; Force reverse-proxy awareness (Dokploy Traefik terminates TLS).
; No secrets in this file — DB credentials come from compose env / entrypoint.
proxy_mode = True
addons_path = /mnt/extra-addons
data_dir = /var/lib/odoo
