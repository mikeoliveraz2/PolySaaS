# Edge proxy: Traefik → nginx → odoo
# Hardcode Host / X-Forwarded-* so Odoo proxy_mode always sees HTTPS (CSRF Secure cookie).
server {
    listen 80;
    server_name odoo.prod-polysaas.cloud _;
    client_max_body_size 100M;

    location / {
        proxy_pass http://odoo:8069;
        proxy_http_version 1.1;

        proxy_set_header Host odoo.prod-polysaas.cloud;
        proxy_set_header X-Forwarded-Host odoo.prod-polysaas.cloud;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_redirect off;
        proxy_read_timeout 720s;
        proxy_connect_timeout 720s;
        proxy_send_timeout 720s;
    }
}
