# THIS CODE IS FROZEN — NO CHANGES TO THIS CODE ARE ALLOWED WITHOUT THE OWNER'S PERMISSION
# BINGO: Founders Beta $10 + Mattermost CP — 2026-09-16
# FIX 2026-09-19 (owner): wire ODOO_SHARED_URL into Django for subscribe/Founders provision
# Copy to deploy/hostinger/.env on the VPS / Dokploy (chmod 600). Never commit .env.

# --- Dokploy / Hostinger ---
# VPS_IP=187.53.138.235
# Domain base: prod-polysaas.cloud
ACME_EMAIL=admin@prod-polysaas.cloud
APP_HOST=app.prod-polysaas.cloud
MM_HOST=mm.prod-polysaas.cloud
ODOO_HOST=odoo.prod-polysaas.cloud

# --- Django ---
DJANGO_SECRET_KEY=CHANGE_ME_long_random_string
DEBUG=False
ALLOWED_HOSTS=app.prod-polysaas.cloud,.prod-polysaas.cloud
CSRF_TRUSTED_ORIGINS=https://app.prod-polysaas.cloud
SECURE_SSL_REDIRECT=False
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# --- Core Postgres (Django multi-tenant schemas) ---
DB_NAME=dosedbsaas
DB_USER=dosedbadmin
DOSE_DB_PASSWORD=CHANGE_ME_core_pg

# --- Redis (mailbox / message queue backing) ---
# REDIS_URL is composed in docker-compose (redis://redis:6379/0)

# --- Mattermost ---
MATTERMOST_URL=https://mm.prod-polysaas.cloud
MATTERMOST_DB_NAME=mattermost
MATTERMOST_DB_USER=mattermost
MATTERMOST_DB_PASSWORD=CHANGE_ME_mm_pg
# Passed into django for recover_mattermost_admin_token (same password as above)
MATTERMOST_DB_HOST=mattermost-db
MM_CORS_ORIGINS=https://app.prod-polysaas.cloud
MM_ALLOWED_INTERNAL=django localhost 127.0.0.1
# Optional once recovered: Personal Access Token for provisioners
# MATTERMOST_ADMIN_TOKEN=

# --- Odoo ---
ODOO_DB_NAME=polysaas_odoo
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=CHANGE_ME_odoo_pg
# Django provisioner (in-network). Defaults in compose to http://odoo:8069 if unset.
ODOO_SHARED_URL=http://odoo:8069
ODOO_SHARED_DB=polysaas_odoo
# Must match odoo.conf admin_passwd (db manager). Override if not "admin".
ODOO_MASTER_PASSWORD=admin

# --- Optional integrations (hydrate TenantApp / env as needed) ---
HUBSPOT_PRIVATE_APP_TOKEN=
# Required for Mattermost tenant provision on subscribe
# MATTERMOST_ADMIN_TOKEN=
# SLACK signing secrets live in TenantApp.extra_config after restore

# --- Stripe (required for /dose/subscribe/ card fields) ---
# Live mode: pk_live_… / sk_live_… and STRIPE_LIVE_MODE=true
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_LIVE_MODE=false
# Optional dj-stripe secrets (defaults to STRIPE_SECRET_KEY in settings if empty)
# STRIPE_TEST_SECRET_KEY=
# STRIPE_LIVE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for plan billing (live catalog)
# STRIPE_PRICE_ID=
# STRIPE_PRICE_ID_POLYSAAS_1=
# STRIPE_PRICE_ID_POLYSAAS_3=
# STRIPE_PRICE_ID_POLYSAAS_UNLIMITED=
# STRIPE_PRICE_ID_FOUNDERS_BETA=
# STRIPE_PRICE_ID_STORAGE=
# --- Mailbox consumer ---
MAILBOX_POLL_INTERVAL=1.0
MAILBOX_BATCH_SIZE=10

# --- Hostinger VPS notes ---
# VPS_IP=187.53.138.235
# VPS_PLAN=KVM 4
# ORCHESTRATOR=Dokploy
