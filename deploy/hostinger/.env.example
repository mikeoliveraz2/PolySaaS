# Copy to deploy/hostinger/.env on the VPS (chmod 600). Never commit .env.

# --- Hostinger / Traefik ---
ACME_EMAIL=admin@polysaas.online
APP_HOST=app.polysaas.online
MM_HOST=mm.polysaas.online
ODOO_HOST=odoo.polysaas.online

# --- Django ---
DJANGO_SECRET_KEY=CHANGE_ME_long_random_string
DEBUG=False
ALLOWED_HOSTS=app.polysaas.online,.polysaas.online
CSRF_TRUSTED_ORIGINS=https://app.polysaas.online
SECURE_SSL_REDIRECT=False
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# --- Core Postgres (Django multi-tenant schemas) ---
DB_NAME=dosedbsaas
DB_USER=dosedbadmin
DOSE_DB_PASSWORD=CHANGE_ME_core_pg

# --- Redis (mailbox / message queue backing) ---
# REDIS_URL is composed in docker-compose (redis://redis:6379/0)

# --- Mattermost ---
MATTERMOST_URL=https://mm.polysaas.online
MATTERMOST_DB_NAME=mattermost
MATTERMOST_DB_USER=mattermost
MATTERMOST_DB_PASSWORD=CHANGE_ME_mm_pg
MM_CORS_ORIGINS=https://app.polysaas.online
MM_ALLOWED_INTERNAL=django localhost 127.0.0.1

# --- Odoo ---
ODOO_DB_NAME=polysaas_odoo
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=CHANGE_ME_odoo_pg

# --- Optional integrations (hydrate TenantApp / env as needed) ---
HUBSPOT_PRIVATE_APP_TOKEN=
# MATTERMOST_ADMIN_TOKEN=
# SLACK signing secrets live in TenantApp.extra_config after restore

# --- Mailbox consumer ---
MAILBOX_POLL_INTERVAL=1.0
MAILBOX_BATCH_SIZE=10

# --- Hostinger VPS notes (laptop / handoff) ---
# VPS_IP=
# VPS_PLAN=KVM 4
# VPS_REGION=
