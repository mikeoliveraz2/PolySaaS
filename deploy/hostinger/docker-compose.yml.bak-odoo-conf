# PolySaaS Hostinger + Dokploy production stack (phase 1)
#
# Deploy as a Dokploy Compose application (Dokploy owns Traefik on :80/:443).
# Do NOT run our own Traefik — it would fight Dokploy for ports.
#
# Hostnames (DNS A → 187.53.138.235):
#   app.prod-polysaas.cloud  → django
#   mm.prod-polysaas.cloud   → mattermost
#   odoo.prod-polysaas.cloud → odoo
#
# Usage (Dokploy UI): create Compose app → point at this file + .env
# Or SSH: docker compose -f deploy/hostinger/docker-compose.yml --env-file deploy/hostinger/.env up -d --build
#
# Dokploy note: avoid container_name (breaks Dokploy logs/metrics).

name: polysaas-hostinger

services:
  core-postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${DB_NAME:-dosedbsaas}
      POSTGRES_USER: ${DB_USER:-dosedbadmin}
      POSTGRES_PASSWORD: ${DOSE_DB_PASSWORD:?set DOSE_DB_PASSWORD}
    volumes:
      - host_core_pg:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER:-dosedbadmin} -d ${DB_NAME:-dosedbsaas}"]
      interval: 10s
      timeout: 5s
      retries: 12
    networks:
      - polysaas-internal

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - host_redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10
    networks:
      - polysaas-internal

  django:
    build:
      context: ../..
      dockerfile: Dockerfile.django
    image: polysaas-django:hostinger
    restart: unless-stopped
    depends_on:
      core-postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      DJANGO_SETTINGS_MODULE: mysite.settings_hosted
      DJANGO_SECRET_KEY: ${DJANGO_SECRET_KEY:?set DJANGO_SECRET_KEY}
      DEBUG: ${DEBUG:-False}
      DATABASE_URL: postgresql://${DB_USER:-dosedbadmin}:${DOSE_DB_PASSWORD}@core-postgres:5432/${DB_NAME:-dosedbsaas}
      REDIS_URL: redis://redis:6379/0
      ALLOWED_HOSTS: ${ALLOWED_HOSTS:-app.prod-polysaas.cloud,.prod-polysaas.cloud}
      CSRF_TRUSTED_ORIGINS: ${CSRF_TRUSTED_ORIGINS:-https://app.prod-polysaas.cloud}
      SECURE_SSL_REDIRECT: ${SECURE_SSL_REDIRECT:-False}
      PORT: "8000"
      GUNICORN_WORKERS: ${GUNICORN_WORKERS:-2}
      GUNICORN_THREADS: ${GUNICORN_THREADS:-4}
      MATTERMOST_URL: ${MATTERMOST_URL:-https://mm.prod-polysaas.cloud}
      HUBSPOT_PRIVATE_APP_TOKEN: ${HUBSPOT_PRIVATE_APP_TOKEN:-}
    volumes:
      - host_django_media:/app/var/media_root
    networks:
      - polysaas-internal
      - dokploy-network
    labels:
      - traefik.enable=true
      - traefik.docker.network=dokploy-network
      - traefik.http.routers.polysaas-django.rule=Host(`${APP_HOST:-app.prod-polysaas.cloud}`)
      - traefik.http.routers.polysaas-django.entrypoints=websecure
      - traefik.http.routers.polysaas-django.tls=true
      - traefik.http.routers.polysaas-django.tls.certresolver=letsencrypt
      - traefik.http.services.polysaas-django.loadbalancer.server.port=8000
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8000/health/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 60s
    command: ["web"]

  mailbox-consumer:
    image: polysaas-django:hostinger
    restart: unless-stopped
    depends_on:
      django:
        condition: service_started
      core-postgres:
        condition: service_healthy
    environment:
      DJANGO_SETTINGS_MODULE: mysite.settings_hosted
      DJANGO_SECRET_KEY: ${DJANGO_SECRET_KEY:?set DJANGO_SECRET_KEY}
      DATABASE_URL: postgresql://${DB_USER:-dosedbadmin}:${DOSE_DB_PASSWORD}@core-postgres:5432/${DB_NAME:-dosedbsaas}
      REDIS_URL: redis://redis:6379/0
      ALLOWED_HOSTS: ${ALLOWED_HOSTS:-app.prod-polysaas.cloud,.prod-polysaas.cloud}
      MAILBOX_POLL_INTERVAL: ${MAILBOX_POLL_INTERVAL:-1.0}
      MAILBOX_BATCH_SIZE: ${MAILBOX_BATCH_SIZE:-10}
    networks:
      - polysaas-internal
    command: ["consumer"]

  mattermost-db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${MATTERMOST_DB_NAME:-mattermost}
      POSTGRES_USER: ${MATTERMOST_DB_USER:-mattermost}
      POSTGRES_PASSWORD: ${MATTERMOST_DB_PASSWORD:?set MATTERMOST_DB_PASSWORD}
    volumes:
      - host_mattermost_pg:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${MATTERMOST_DB_USER:-mattermost} -d ${MATTERMOST_DB_NAME:-mattermost}"]
      interval: 10s
      timeout: 5s
      retries: 12
    networks:
      - polysaas-internal

  mattermost:
    image: mattermost/mattermost-team-edition:latest
    restart: unless-stopped
    depends_on:
      mattermost-db:
        condition: service_healthy
    environment:
      MM_SQLSETTINGS_DRIVERNAME: postgres
      MM_SQLSETTINGS_DATASOURCE: postgres://${MATTERMOST_DB_USER:-mattermost}:${MATTERMOST_DB_PASSWORD}@mattermost-db:5432/${MATTERMOST_DB_NAME:-mattermost}?sslmode=disable&connect_timeout=10
      MM_SERVICESETTINGS_SITEURL: ${MATTERMOST_URL:-https://mm.prod-polysaas.cloud}
      MM_SERVICESETTINGS_ENABLEUSERACCESSTOKENS: "true"
      MM_SERVICESETTINGS_ALLOWCORSFROM: ${MM_CORS_ORIGINS:-https://app.prod-polysaas.cloud}
      MM_SERVICESETTINGS_CORSALLOWCREDENTIALS: "true"
      MM_SERVICESETTINGS_ALLOWEDUNTRUSTEDINTERNALCONNECTIONS: ${MM_ALLOWED_INTERNAL:-django localhost 127.0.0.1}
      MM_SERVICESETTINGS_ENABLEOUTGOINGWEBHOOKS: "true"
    volumes:
      - host_mattermost_config:/mattermost/config
      - host_mattermost_data:/mattermost/data
      - host_mattermost_logs:/mattermost/logs
      - host_mattermost_plugins:/mattermost/plugins
    networks:
      - polysaas-internal
      - dokploy-network
    labels:
      - traefik.enable=true
      - traefik.docker.network=dokploy-network
      - traefik.http.routers.polysaas-mattermost.rule=Host(`${MM_HOST:-mm.prod-polysaas.cloud}`)
      - traefik.http.routers.polysaas-mattermost.entrypoints=websecure
      - traefik.http.routers.polysaas-mattermost.tls=true
      - traefik.http.routers.polysaas-mattermost.tls.certresolver=letsencrypt
      - traefik.http.services.polysaas-mattermost.loadbalancer.server.port=8065
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8065/api/v4/system/ping || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 20
      start_period: 90s

  odoo-db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${ODOO_DB_NAME:-polysaas_odoo}
      POSTGRES_USER: ${ODOO_DB_USER:-odoo}
      POSTGRES_PASSWORD: ${ODOO_DB_PASSWORD:?set ODOO_DB_PASSWORD}
    volumes:
      - host_odoo_pg:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${ODOO_DB_USER:-odoo} -d ${ODOO_DB_NAME:-polysaas_odoo}"]
      interval: 10s
      timeout: 5s
      retries: 12
    networks:
      - polysaas-internal

  odoo:
    image: odoo:18.0
    restart: unless-stopped
    depends_on:
      odoo-db:
        condition: service_healthy
    environment:
      HOST: odoo-db
      PORT: "5432"
      USER: ${ODOO_DB_USER:-odoo}
      PASSWORD: ${ODOO_DB_PASSWORD:?set ODOO_DB_PASSWORD}
    # Traefik terminates TLS; without proxy_mode, login CSRF/session cookies break over HTTPS.
    command: ["odoo", "--proxy-mode"]
    volumes:
      - host_odoo_data:/var/lib/odoo
      - ../../docker/odoo/addons:/mnt/extra-addons
    networks:
      - polysaas-internal
      - dokploy-network
    labels:
      - traefik.enable=true
      - traefik.docker.network=dokploy-network
      - traefik.http.routers.polysaas-odoo.rule=Host(`${ODOO_HOST:-odoo.prod-polysaas.cloud}`)
      - traefik.http.routers.polysaas-odoo.entrypoints=websecure
      - traefik.http.routers.polysaas-odoo.tls=true
      - traefik.http.routers.polysaas-odoo.tls.certresolver=letsencrypt
      - traefik.http.routers.polysaas-odoo.middlewares=odoo-fwdheaders
      - traefik.http.middlewares.odoo-fwdheaders.headers.customrequestheaders.X-Forwarded-Proto=https
      - traefik.http.middlewares.odoo-fwdheaders.headers.customrequestheaders.X-Forwarded-Host=${ODOO_HOST:-odoo.prod-polysaas.cloud}
      - traefik.http.services.polysaas-odoo.loadbalancer.server.port=8069
      - traefik.http.services.polysaas-odoo.loadbalancer.passHostHeader=true
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8069/web/health || curl -fsS http://127.0.0.1:8069/web/login || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 30
      start_period: 120s

networks:
  polysaas-internal:
    name: polysaas-hostinger
    driver: bridge
  dokploy-network:
    external: true

volumes:
  host_core_pg:
  host_redis:
  host_django_media:
  host_mattermost_pg:
  host_mattermost_config:
  host_mattermost_data:
  host_mattermost_logs:
  host_mattermost_plugins:
  host_odoo_pg:
  host_odoo_data:
