# PolySaaS — Odoo on Render
# All database credentials come from the container environment at runtime (Render dashboard).
# Never bake HOST, USER, PASSWORD, or PGPASSWORD into this file or into image layers.
#
# Required on Render: HOST (Postgres hostname only), USER, PASSWORD
# Optional: DB_NAME (defaults to postgres), PGPASSWORD (if set, overrides PASSWORD for DB auth),
#           ADMIN_PASSWORD, ODOO_MASTER_PASSWORD
# Do not set PORT=5432 in Render; Render injects PORT for HTTP. This CMD sets PORT=5432 for Postgres
# before /entrypoint.sh and passes Render's HTTP port to Odoo via --http-port.
# --proxy-mode: trust X-Forwarded-* from Render's edge (per Render / Odoo behind reverse proxy guidance).

FROM odoo:18

EXPOSE 8069

# Prefer PASSWORD; if your team sets PGPASSWORD only, it is used. If both are set, PGPASSWORD wins.
# If HOST is missing, official entrypoint defaults to hostname "db" — fail fast with a clear message.
CMD ["sh", "-c", "if [ -z \"${HOST}\" ]; then echo \"FATAL: HOST is unset or empty. On Render set HOST to your Postgres hostname only (from Connections), not the full postgresql:// URL.\" >&2; exit 1; fi; ODOO_HTTP_PORT=\"${PORT:-8069}\"; DB_PASS=\"${PGPASSWORD:-${PASSWORD}}\"; export PORT=5432 HOST=\"${HOST}\" USER=\"${USER}\" PASSWORD=\"${DB_PASS}\" PGHOST=\"${HOST}\" PGPORT=5432 PGUSER=\"${USER}\" PGPASSWORD=\"${DB_PASS}\" PGDATABASE=\"${DB_NAME:-postgres}\"; export ADMIN_PASSWORD=\"${ADMIN_PASSWORD}\" ODOO_MASTER_PASSWORD=\"${ODOO_MASTER_PASSWORD}\"; exec /entrypoint.sh odoo --http-port=\"${ODOO_HTTP_PORT}\" --proxy-mode"]
