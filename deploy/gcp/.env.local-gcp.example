# =============================================================================
# Local desktop .env overrides — test PolySaaS against GCP-hosted Odoo/Mattermost
# Merge these into repo-root `.env` after bundled apps are deployed on GCP.
# =============================================================================

# Point Django bundled-app URLs at GCP (replace with VM IP or DNS names)
ODOO_SHARED_URL=https://YOUR_GCE_IP:8069
MATTERMOST_URL=https://YOUR_GCE_IP:8065

# Keep Django DB on Cloud SQL (already configured locally)
# DB_HOST=8.230.100.97
# DB_PORT=5432
# DB_NAME=dosedbsaas
# DOSE_DB_PASSWORD=...

# Passthrough endpoints — update PassThroughEndpoint rows or re-seed after cutover:
# Odoo trigger: polysaas-odoo-gcp / Mattermost trigger: polysaas-mattermost-gcp

# Verification checklist (run after updating .env):
#   .\runall.ps1
#   python manage.py test dose.tests.test_hubspot_integration  # smoke
