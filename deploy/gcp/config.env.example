# =============================================================================
# PolySaaS GCP migration — shared infrastructure variables
# Copy to deploy/gcp/config.env and fill in real values. Never commit config.env.
# =============================================================================

# --- GCP project ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Existing Cloud SQL instance (PolySaaS core already uses this)
CLOUDSQL_INSTANCE_NAME=your-cloudsql-instance
# Format: project:region:instance — used by Cloud Run + Auth Proxy
CLOUDSQL_CONNECTION_NAME=your-gcp-project-id:us-central1:your-cloudsql-instance
CLOUDSQL_HOST=8.230.100.97
CLOUDSQL_PORT=5432

# Django / DOSE database (existing)
DOSE_DB_NAME=dosedbsaas
DOSE_DB_USER=dosedbadmin
# DOSE_DB_PASSWORD=set-in-secret-manager

# Bundled app databases (create on same Cloud SQL instance)
ODOO_DB_NAME=odoo_prod
ODOO_DB_USER=odoouser
# ODOO_DB_PASSWORD=set-in-secret-manager

MATTERMOST_DB_NAME=mattermost_prod
MATTERMOST_DB_USER=mmuser
# MATTERMOST_DB_PASSWORD=set-in-secret-manager

# --- Cloud Storage buckets ---
GCS_ODOO_FILESTORE_BUCKET=polysaas-odoo-filestore
GCS_MATTERMOST_FILES_BUCKET=polysaas-mattermost-files
GCS_DJANGO_STATIC_BUCKET=polysaas-django-static
GCS_DJANGO_MEDIA_BUCKET=polysaas-django-media

# --- Compute Engine (Odoo + Mattermost Docker host) ---
GCE_VM_NAME=polysaas-bundled-apps
GCE_MACHINE_TYPE=e2-standard-2
GCE_DISK_SIZE_GB=50

# Public URLs (after load balancer / DNS)
ODOO_PUBLIC_URL=https://odoo.polysaas.online
MATTERMOST_PUBLIC_URL=https://mm.polysaas.online
DJANGO_PUBLIC_URL=https://production.polysaas.online

# --- Artifact Registry ---
AR_REPOSITORY=polysaas
AR_HOST=us-central1-docker.pkg.dev/your-gcp-project-id/polysaas

# --- Cloud Run (Django core) ---
CLOUD_RUN_SERVICE=polysaas-core
CLOUD_RUN_IMAGE=polysaas-django

# --- Legacy source DB (for migration scripts) ---
SOURCE_ODOO_DB_HOST=
SOURCE_ODOO_DB_NAME=odoodb
SOURCE_MM_DB_HOST=
SOURCE_MM_DB_NAME=mattermost
