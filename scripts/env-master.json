{
  "_meta": {
    "description": "Inventory of env KEY NAMES for Render (values: FILL_MANUALLY or env-master.local.json, never commit secrets).",
    "align_with": "render.yaml groups + mysite/settings.py + mysite/settings_render.py",
    "naming_authority": [
      "1) Render service disk resource names: render.yaml `services[].name` (e.g. PolySaaS-Core, PolySaaS-Celery-Worker2, PolySaaS-Odoo2).",
      "2) Env group keys declared for Blueprint: render.yaml `envVarGroups` (add new keys there when you want sync/prompts).",
      "3) Full Django/app inventory and checklists: this file + `python scripts/render_env_sync.py` (may list keys not yet in render.yaml — add them on Render or extend YAML)."
    ]
  },
