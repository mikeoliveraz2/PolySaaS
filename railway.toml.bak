# Railway — PolySaaS Django (DOSE)
# https://docs.railway.app/guides/dockerfiles
# Healthcheck: only healthcheckPath + healthcheckTimeout are valid in config-as-code
# (see https://railway.com/railway.schema.json — no startPeriod). Timeout is total wait
# for /health/ to return 200; allow time for collectstatic + Gunicorn on cold boot.

[build]
builder = "DOCKERFILE"
dockerfilePath = "Dockerfile.django"

[deploy]
healthcheckPath = "/health/"
healthcheckTimeout = 300
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 5
