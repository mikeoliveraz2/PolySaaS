# =============================================================================
# PolySaaS / DOSE — unified environment reference (PLACEHOLDERS ONLY)
# =============================================================================
# HOW TO USE (local):  copy this file to repo-root `.env` and replace values.
#                       `.env` is gitignored — never commit real secrets.
# RENDER / RAILWAY:     set the same keys in Dashboard or env groups (see render.yaml).
# DJANGO:               uses django-environ from `.env` when present (mysite/settings.py).
# =============================================================================

# --- Runtime / Django module ---
DJANGO_SETTINGS_MODULE=mysite.settings
# Production container (Render / Railway):
# DJANGO_SETTINGS_MODULE=mysite.settings_railway

PYTHONUNBUFFERED=1

# --- Core security (REQUIRED in production) ---
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=false
# Comma-separated hosts (Render: include your onrender.com hostname)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Database (Django / Core / Celery) ---
# Preferred on Render: single URL (password must be URL-encoded if it contains @ : etc.)
# Use postgresql:// or postgres:// — NOT postgresql+asyncpg (that is for async drivers only).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# If you do NOT use DATABASE_URL, discrete vars (see mysite/settings_railway.py):
# DB_NAME=dosedbsaas
# DB_USER=dosedbadmin
# DB_PASSWORD=
# DOSE_DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
DB_CONN_MAX_AGE=0

# --- Static / media (containers) ---
STATIC_ROOT=/app/var/static_root/
MEDIA_ROOT=/app/var/media_root/

# --- HTTPS / proxy (Railway / Render behind TLS) ---
SECURE_SSL_REDIRECT=false

# --- Logging (Render/Railway: stdout; set LOG_LEVEL=DEBUG while testing) ---
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
DOSE_LOG_LEVEL=INFO
# polysaas.* / passthrough / PolySniffer (defaults to LOG_LEVEL if unset)
CC_LOG_LEVEL=INFO

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_LOG_LEVEL=INFO
CELERY_CONCURRENCY=2

# Render pre-deploy / boot (see render.yaml)
RUN_MIGRATIONS=0

# --- Stripe / dj-stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_POLYSAAS_1=
STRIPE_PRICE_ID_POLYSAAS_3=
STRIPE_PRICE_ID_POLYSAAS_UNLIMITED=
STRIPE_PRICE_ID_STORAGE=
STRIPE_LIVE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_MODE=false

# --- Google OAuth (allauth) — set in Render or local .env ---
# GOOGLE_OAUTH2_CLIENT_ID=
# GOOGLE_OAUTH2_CLIENT_SECRET=

# --- PolySaaS staff rule (comma-separated emails → staff/superuser on Google login) ---
POLYSAAS_SUPERUSER_EMAILS=
# Email/password users: after first signup on Render, run in Render Shell (same service / DATABASE_URL).
# Command is registered under the ``dose`` app (mysite is not in INSTALLED_APPS):
#   python manage.py promote_superuser --email you@example.com
# If /admin/ still shows no model tiles after promote, verify app_list in-process:
#   python manage.py diagnose_admin_dashboard --email you@example.com
# (Uses HTTP_HOST=localhost or RENDER_EXTERNAL_URL host — not "testserver", which prod ALLOWED_HOSTS rejects.)

# --- Tenant enforcement ---
STRICT_TENANT_ENFORCEMENT=false

# --- Passthrough debug ---
POLYSNIFFER_PASSTHROUGH_DEBUG=false

# Admin /admin/ index diagnostics (structured log line per hit). Off by default.
ADMIN_INDEX_DIAG=false

# --- Mattermost (Django settings + provisioning) ---
MATTERMOST_URL=http://localhost:8065
MATTERMOST_ADMIN_TOKEN=
MATTERMOST_BASE_URL=
MATTERMOST_BOT_TOKEN=

# --- Parameters app (Fernet encrypted secrets in DB) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PARAMETER_FERNET_KEY=

# --- AI peers / LLM providers (mysite/settings.py) ---
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
AI_PEER_PROVIDER_COPILOT=anthropic
AI_PEER_PROVIDER_CURSOR=anthropic
AI_PEER_PROVIDER_GROK=xai
AI_PEER_PROVIDER_ROUTER=anthropic
AI_PEER_PROVIDER_OPENCLAW=anthropic
AI_PEER_PROVIDER_GEM=gemini
BOT_TOKEN_COPILOT=
BOT_TOKEN_CURSOR=
BOT_TOKEN_GROK=
BOT_TOKEN_ROUTER=
BOT_TOKEN_OPENCLAW=
BOT_TOKEN_CC=
BOT_TOKEN_SUPERGROK=
BOT_TOKEN_GEM=
AI_PEERS_WEBHOOK_TOKEN=
AI_PEERS_CHANNEL_MESSAGE_LIMIT=75

# --- Peers adapter (Render service PolySaaS-Peers-Adapter) ---
PEERS_UPSTREAM_DJANGO_URL=

# --- ML Studio ---
MLSTUDIO_BASE_URL=
MLSTUDIO_SERVICE_TOKEN=
POLYSAAS_CORE_BASE_URL=

# --- OIDC / OAuth2 provider (Railway overrides; PEM use \n escapes in env) ---
OIDC_ISS_ENDPOINT=
OIDC_RSA_PRIVATE_KEY=

# --- Email (partial — see settings for full SMTP block) ---
EMAIL_HOST_PASSWORD=

# --- Misc API keys referenced in settings ---
DEEPSEEK_API_KEY=

# --- Admin UI banner (green message on /admin/) ---
ADMIN_STATUS_BANNER_ENABLED=1
ADMIN_STATUS_BANNER_TEXT=Status: tenant admin bootstrap is enabled.

# =============================================================================
# Odoo (PolySaaS-Odoo2) — env group polysaas-odoo on Render
# =============================================================================
# Internal hostname ONLY (e.g. dpg-xxxx-a), never a postgresql:// URL.
ODOO_DB_HOST=
ODOO_DB_USER=odoouser
ODOO_DB_PASSWORD=
ODOO_DB_NAME=odoodb
ODOO_DB_PORT=5432
# First-time empty DB: run once in Odoo Shell (same image/env):
#   /usr/local/bin/entrypoint-render.sh odoo -i base,web --stop-after-init
ADMIN_PASSWORD=
ODOO_MASTER_PASSWORD=
# Edge case: force entrypoint to treat POSIX USER as Postgres role (normally avoid)
# USE_ENV_USER_FOR_POSTGRES=1

# Legacy Odoo DB vars (migration only — prefer ODOO_DB_* above):
# HOST=
# USER=
# PASSWORD=
# DB_NAME=

# =============================================================================
# Render Blueprint — bundled apps (polysaas-bundled-apps group)
# =============================================================================
NEXTCLOUD_BASE_URL=
NEXTCLOUD_SERVICE_TOKEN=
DOLIBARR_BASE_URL=
DOLIBARR_API_KEY=
LIFERAY_BASE_URL=
LIFERAY_OAUTH_CLIENT_SECRET=
WORDPRESS_BASE_URL=
WORDPRESS_APPLICATION_PASSWORD=
POLYSYSMON_BASE_URL=
POLYSYSMON_API_KEY=
MONITORLOGGER_BASE_URL=
MONITORLOGGER_INGEST_KEY=
AIASPEERS_BASE_URL=
AIASPEERS_API_KEY=
APPSASPEERS_BASE_URL=
APPSASPEERS_API_KEY=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# =============================================================================
# bootstrap_auth management command (optional Render boot / one-off)
# =============================================================================
BOOTSTRAP_SITE_DOMAIN=
BOOTSTRAP_SITE_NAME=PolySaaS Production
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@polysaas.online
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_GOOGLE_CLIENT_ID=
BOOTSTRAP_GOOGLE_CLIENT_SECRET=
BOOTSTRAP_TENANT_ADMIN_USERNAME=
BOOTSTRAP_TENANT_ADMIN_EMAIL=
BOOTSTRAP_TENANT_ADMIN_PASSWORD=
BOOTSTRAP_TENANT_ADMIN_TENANT_SLUG=olient
BOOTSTRAP_TENANT_ADMIN_TENANT_NAME=
BOOTSTRAP_TENANT_ADMIN_FORCE_PASSWORD=0
BOOTSTRAP_TENANT_ADMIN_CLONE_ENDPOINTS=1

# =============================================================================
# Adminer (PolySaaS-Adminer) — if deployed from render.yaml
# =============================================================================
ADMINER_DEFAULT_SERVER=

# =============================================================================
# Optional: WordPress sync scripts (see documentation/website/.env.wordpress.example)
# =============================================================================
# WP_BASE_URL=https://polysaas.online
# WP_USER=
# WP_APP_PASSWORD=

# =============================================================================
# Legacy / tooling examples (not all read by Django — trim to what you use)
# =============================================================================
PROJECT_NAME=PolySaaS
VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/2
