"""Example configuration file for PolySaaS."""

# Application Settings
PROJECT_NAME=PolySaaS
VERSION=0.1.0
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/polysaas
DB_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security Configuration
SECRET_KEY=change-me-in-production-to-a-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=11520
ALGORITHM=HS256

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Orchestration Configuration
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT_SECONDS=3600
ORCHESTRATION_RETRY_ATTEMPTS=3

# Optional: WordPress REST — scripts/wp_sync_ml_page.py (or .env.wordpress at repo root; see documentation/website/.env.wordpress.example)
# Never commit real credentials. Use Application Passwords in wp-admin.
# WP_BASE_URL=https://polysaas.online
# WP_USER=
# WP_APP_PASSWORD=

# Django / allauth (if using mysite.settings with django-environ)
# POLYSAAS_SUPERUSER_EMAILS=you@example.com
