# mysite/csrf_exemption_middleware.py
from django.utils.deprecation import MiddlewareMixin


class CSRFExemptionMiddleware(MiddlewareMixin):
    def process_request(self, request):
        if self._should_exempt_csrf(request):
            setattr(request, '_csrf_exempt', True)
        return None

    def _should_exempt_csrf(self, request):
        path = request.path_info or request.path
        if not path.startswith('/pt/'):
            return False

        try:
            from dose.passthrough.registry import any_handler_exempts_csrf_for_path
            exempt = any_handler_exempts_csrf_for_path(path)
            if exempt:
                print(f"[CSRF] Exempted: {path}")
            return exempt
        except Exception as e:
            print(f"[CSRF] Error: {e}")
            return False