# PolySaaS Railway Complete Stack — Environment Variables Template
# Copy these to Railway UI → Project Settings → Variables
# Replace placeholders with actual values

# ════════════════════════════════════════════════════════════════════════════
# CORE INFRASTRUCTURE — Database, Message Queue, Search
# ════════════════════════════════════════════════════════════════════════════

# PostgreSQL (DOSE core database)
DOSE_DB_USER=dosedbadmin
DOSE_DB_PASSWORD=changeme_strong_postgres_password_here
DOSE_DB=dosedbsaas

# RabbitMQ (Celery broker for task queue)
RABBITMQ_USER=guest
RABBITMQ_PASS=changeme_strong_rabbitmq_password_here

# Grafana (Monitoring dashboards)
GRAFANA_USER=admin
GRAFANA_PASS=changeme_strong_grafana_password_here

# MonitorLogger (OpenObserve — logs & metrics ingestion)
MONITORLOGGER_ROOT_USER_EMAIL=admin@polysaas.online
MONITORLOGGER_ROOT_USER_PASSWORD=changeme_strong_monitorlogger_password_here

# ════════════════════════════════════════════════════════════════════════════
# DJANGO / POLYSAAS CORE (DOSE)
# ════════════════════════════════════════════════════════════════════════════

DJANGO_SETTINGS_MODULE=mysite.settings
DJANGO_SECRET_KEY=changeme_generate_a_random_secret_key_with_secrets.token_urlsafe()
DEBUG=false
ALLOWED_HOSTS=yourapp.up.railway.app,production.polysaas.online,yourdomain.com

# Database connection—use internal Docker network hostname
DATABASE_URL=postgresql://dosedbadmin:changeme_strong_postgres_password_here@postgres:5432/dosedbsaas

# Celery broker—use internal Docker network hostname
CELERY_BROKER_URL=amqp://guest:changeme_strong_rabbitmq_password_here@rabbitmq:5672//

# Elasticsearch for search/analytics
ELASTICSEARCH_HOST=http://elasticsearch:9200

# Optional: Stripe (for subscription views)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: OAuth2 / OIDC (if using django-oauth-toolkit)
# OIDC_ISS_ENDPOINT=https://yourapp.up.railway.app/o
# OIDC_RSA_PRIVATE_KEY=<pem-content-if-not-using-file>

# ════════════════════════════════════════════════════════════════════════════
# MATTERMOST (Team Chat)
# ════════════════════════════════════════════════════════════════════════════

MATTERMOST_DB_USER=mattermost
MATTERMOST_DB_PASSWORD=changeme_strong_mattermost_db_password
MATTERMOST_DB=mattermost

# Public-facing URL (used in Mattermost config for OAuth redirects, etc.)
MATTERMOST_SITE_URL=https://production.polysaas.online:8065

# ════════════════════════════════════════════════════════════════════════════
# NEXTCLOUD (File Sharing)
# ════════════════════════════════════════════════════════════════════════════

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme_strong_nextcloud_admin_password
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=changeme_strong_nextcloud_db_password
NEXTCLOUD_DB=nextcloud

# Trusted domains (space-separated; prevents "Cannot access the server from this address")
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1 production.polysaas.online yourdomain.com

# Public-facing host/URL
NEXTCLOUD_HOST=production.polysaas.online:8888
NEXTCLOUD_CLI_URL=https://production.polysaas.online:8888
NEXTCLOUD_PROTOCOL=https

# ════════════════════════════════════════════════════════════════════════════
# LIFERAY (Portal Engine)
# ════════════════════════════════════════════════════════════════════════════

LIFERAY_DB_USER=liferay
LIFERAY_DB_PASSWORD=changeme_strong_liferay_db_password
LIFERAY_MYSQL_ROOT_PASSWORD=changeme_strong_liferay_root_password
LIFERAY_DB=lportal

# ════════════════════════════════════════════════════════════════════════════
# NOTES FOR RAILWAY DEPLOYMENT
# ════════════════════════════════════════════════════════════════════════════

# 1. GENERATE STRONG PASSWORDS:
#    python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. DJANGO_SECRET_KEY:
#    python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# 3. INTERNAL vs EXTERNAL NETWORKING:
#    - Services within the Docker network communicate via hostnames: postgres, rabbitmq, mattermost, etc.
#    - External users access via Railway's public domain or custom domain + port number
#    - Update PassThroughEndpoint URLs in Django admin to use internal hostnames for best performance
#
# 4. PORT MAPPINGS:
#    - Django: port 8000 (redirected to Railway's HTTPS URL)
#    - Mattermost: port 8065 (access via https://production.polysaas.online:8065)
#    - Nextcloud: port 8888 (access via https://production.polysaas.online:8888)
#    - Liferay: port 8181 (access via https://production.polysaas.online:8181)
#    - Grafana: port 3000 (internal only for now)
#    - MonitorLogger: port 5080 (internal only for now)
#
# 5. HTTPS/TLS:
#    Railway auto-provides HTTPS for your .up.railway.app domain.
#    For custom domains (polysaas.online), add custom domain in Railway settings + set up DNS.
#
# 6. DATABASE CONNECTIONS:
#    All services connect via internal Docker hostnames:
#    - postgres:5432 (for Django)
#    - mattermost-db:5432 (for Mattermost)
#    - nextcloud-db:3306 (for Nextcloud)
#    - liferay-db:3306 (for Liferay)
#    These ARE NOT exposed to the internet; only the application ports are.
