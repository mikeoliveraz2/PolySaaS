# Copy to .env.Render.local (gitignored) for docker-compose.Render-stack.yml
# On Render, set equivalent variables in the dashboard (never commit secrets).

# PostgreSQL (compose maps host 5433 -> container 5432 to match common local settings.py)
DOSE_DB_PASSWORD=changeme

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Grafana
GRAFANA_USER=admin
GRAFANA_PASS=changeme

# MonitorLogger (first-login admin; maps to ZO_* for OpenObserve-based image)
MONITORLOGGER_ROOT_USER_EMAIL=admin@example.com
MONITORLOGGER_ROOT_USER_PASSWORD=changeme

# --- Django on Render (web + worker) — set in Render UI, not only here ---
# DJANGO_SECRET_KEY=   # required before any manage.py / gunicorn (base settings read this)
# DJANGO_SETTINGS_MODULE=mysite.settings_render
# DEBUG=False
# ALLOWED_HOSTS=yourapp.onrender.com
# DB_HOST=postgres.Render.internal
# DB_PORT=5432
# DB_NAME=dosedbsaas
# DB_USER=dosedbadmin
# CELERY_BROKER_URL=amqp://guest:guest@rabbitmq.Render.internal:5672//
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# CSRF_TRUSTED_ORIGINS=https://yourapp.onrender.com

# OAuth2 / OIDC (django-oauth-toolkit) — public issuer; PEM optional if not using oidc_rsa_key.pem file
# OIDC_ISS_ENDPOINT=https://yourapp.onrender.com/o
# OIDC_RSA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
