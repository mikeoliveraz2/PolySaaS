# Copy to repo root as .env.wordpress (gitignored). Never commit secrets.
# Used by: python scripts/wp_sync_ml_page.py

WP_BASE_URL=https://polysaas.online
WP_USER=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional
# WP_PAGE_TITLE=Machine Learning
# WP_PAGE_STATUS=draft
# WP_FORCE_STATUS=publish
# WP_SKIP_ML_MEDIA=1   — do not upload screenshots / rewrite img src (default: upload + rewrite)
# WP_REFRESH_ML_MEDIA=1 — ignore .wp-ml-screenshots.json and upload again (new URLs)
