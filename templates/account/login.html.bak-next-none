{% extends "account/base.html" %}
{% load i18n %}
{% load static %}

{% block title %}Sign in — PolySaaS{% endblock %}

{% block content %}
<div class="login-container" style="background:white;padding:32px 28px;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.18);max-width:420px;width:100%;margin:0 auto;">
    <div style="text-align:center;margin-bottom:20px;">
        <img src="{% static 'img/PolySaaS-Industrial-Logo.png' %}" alt="PolySaaS" style="height:72px;width:auto;display:block;margin:0 auto 12px;">
        <h1 style="color:#2c3e50;font-size:1.35rem;margin:0 0 6px;font-weight:600;">PolySaaS</h1>
        <p style="color:#5a6c7d;font-size:0.9rem;margin:0;font-style:italic;">Industrial Strength SaaS for Limitless Horizons</p>
    </div>

    <div id="ps-new-user-banner" style="display:none;background:#e8f5e9;border:1px solid #a5d6a7;border-radius:6px;padding:10px 14px;margin-bottom:16px;font-size:.88rem;color:#2e7d32;"></div>

    {% if form.errors %}
    <div style="background:#ffebee;color:#c62828;border:1px solid #ef9a9a;border-radius:6px;padding:10px 14px;margin-bottom:16px;font-size:.9rem;">
        {% trans "Invalid username or password" %}
    </div>
    {% endif %}

    {% if form %}
    <form method="post" action="" id="login-form">
        {% csrf_token %}
        <input type="hidden" name="{{ redirect_field_name }}" value="{{ redirect_field_value }}">

        <div style="margin-bottom:14px;">
            <label for="id_login" style="display:block;font-weight:600;margin-bottom:4px;color:#333;font-size:.9rem;">Username or email</label>
            <input type="text" name="login" id="id_login" autocomplete="username"
                style="width:100%;padding:9px 12px;border:1px solid #ccc;border-radius:6px;font-size:.95rem;box-sizing:border-box;"
                placeholder="Your username or email">
        </div>

        <div style="margin-bottom:18px;">
            <label for="id_password" style="display:block;font-weight:600;margin-bottom:4px;color:#333;font-size:.9rem;">Password</label>
            <div style="position:relative;display:flex;align-items:center;">
                <input type="password" name="password" id="id_password" autocomplete="current-password"
                       style="width:100%;padding:9px 36px 9px 12px;border:1px solid #ccc;border-radius:6px;font-size:.95rem;box-sizing:border-box;"
                       placeholder="Your password">
                <button type="button" tabindex="-1"
                        onclick="(function(){var f=document.getElementById('id_password'),b=this;if(f.type==='password'){f.type='text';b.textContent='🙈';}else{f.type='password';b.textContent='👁';}})(this)"
                        aria-label="Show/hide password"
                        style="position:absolute;right:8px;background:none;border:none;cursor:pointer;font-size:1.1em;padding:0;line-height:1;color:#666;">👁</button>
            </div>
            <small style="color:#666;display:block;margin-top:6px;font-size:.8rem;">
                Save your password — you will need it for Odoo, Mattermost, and other bundled apps.
            </small>
        </div>

        <button type="submit"
                style="width:100%;padding:11px;background:#457894;color:#fff;border:none;border-radius:6px;font-size:1rem;font-weight:600;cursor:pointer;">
            Sign in
        </button>
    </form>
    {% endif %}

    <div style="text-align:center;margin:18px 0 10px;color:#aaa;font-size:.85rem;">— or —</div>

    <a href="/accounts/google/login/?prompt=select_account"
       style="display:block;background:#4285f4;color:#fff;padding:10px;border-radius:6px;text-align:center;font-size:.95rem;font-weight:600;text-decoration:none;">
        <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" style="height:18px;vertical-align:middle;margin-right:8px;" alt="">
        Sign in with Google
    </a>

    <div style="text-align:center;margin-top:16px;">
        <a href="/dose/subscribe/" style="color:#1976d2;font-size:.88rem;">Subscribe</a>
    </div>
</div>

<script>
(function() {
            function getCookie(name) {
                var value = '; ' + document.cookie;
                var parts = value.split('; ' + name + '=');
                if (parts.length === 2) {
                    return decodeURIComponent(parts.pop().split(';').shift());
                }
                return '';
            }

            function syncCsrfTokenToLoginForm() {
                var form = document.getElementById('login-form');
                if (!form) return;
                var token = getCookie('csrftoken');
                if (!token) return;

                var input = form.querySelector('input[name="csrfmiddlewaretoken"]');
                if (!input) {
                    input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'csrfmiddlewaretoken';
                    form.prepend(input);
                }
                input.value = token;
            }

    document.addEventListener('DOMContentLoaded', function() {
                syncCsrfTokenToLoginForm();

        try {
            var raw = sessionStorage.getItem('polysaas_new_user_creds');
            if (!raw) return;
            var creds = JSON.parse(raw);
            sessionStorage.removeItem('polysaas_new_user_creds');
            if (creds.u) {
                var uField = document.getElementById('id_login');
                if (uField) uField.value = creds.u;
            }
            if (creds.p) {
                var pField = document.getElementById('id_password');
                if (pField) pField.value = creds.p;
            }
            var banner = document.getElementById('ps-new-user-banner');
            if (banner) {
                banner.textContent = 'Your new account "' + (creds.u || '') + '" has been pre-filled. Please review and click Sign in.';
                banner.style.display = 'block';
            }
        } catch (e) {
            console.error('[AUTO-LOGIN] Error:', e);
        }

        var loginForm = document.getElementById('login-form');
        if (loginForm) {
            loginForm.addEventListener('submit', function() {
                syncCsrfTokenToLoginForm();
            });
        }
    });
})();
</script>
{% endblock %}
