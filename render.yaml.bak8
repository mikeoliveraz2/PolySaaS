#   - key: USER
#     fromDatabase:
#       name: polysaas-odoo-db
#       property: user
#   - key: PASSWORD
#     fromDatabase:
#       name: polysaas-odoo-db
#       property: password
# (Keep DB_NAME as sync:false or set database name per Render docs for your plan.)
