# Render Blueprint — PolySaaS (temporary phase before GCP)
# https://render.com/docs/blueprint-spec
#
# Apply: Dashboard → Blueprints → Connect this repo (same repo that contains this file).
# Add secrets in the dashboard or via `sync: false` prompts on first sync.
#
# Notes:
# - Django/Celery use Dockerfile.django (never the repo-root stub Dockerfile).
# - Odoo uses deploy/odoo-render/Dockerfile (official odoo:18 + Render PORT split + --proxy-mode).
# - preDeploy runs after image build, before new instances get traffic (web) / start (worker).
# - We call migrate_all_schemas explicitly (not `migrate`) to match multi-tenant manage.py.
# - Scale to more services later by copying a block and changing `name`, `type`, `dockerCommand`.

previews:
  generation: off

envVarGroups:
  - name: polysaas-common
    envVars:
      - key: DJANGO_SETTINGS_MODULE
        value: mysite.settings_railway
      - key: PYTHONUNBUFFERED
        value: "1"
      # Set in dashboard / Blueprint sync prompts (never commit real secrets)
      - key: DJANGO_SECRET_KEY
        sync: false
      - key: DATABASE_URL
        sync: false
      - key: CELERY_BROKER_URL
        sync: false
      - key: ALLOWED_HOSTS
        sync: false
      - key: CSRF_TRUSTED_ORIGINS
        sync: false
      # Optional tuning
      - key: LOG_LEVEL
        value: INFO
      - key: CELERY_LOG_LEVEL
        value: INFO
      - key: CELERY_CONCURRENCY
        value: "2"

  # Passthrough / integration targets (set URLs or secrets in Render when each app is wired).
  # Naming is intentionally generic; map to Django settings or TenantApp.extra_config as you implement each bundle.
  - name: polysaas-bundled-apps
    envVars:
      - key: NEXTCLOUD_BASE_URL
        sync: false
      - key: NEXTCLOUD_SERVICE_TOKEN
        sync: false
      - key: MATTERMOST_BASE_URL
        sync: false
      - key: MATTERMOST_BOT_TOKEN
        sync: false
      - key: DOLIBARR_BASE_URL
        sync: false
      - key: DOLIBARR_API_KEY
        sync: false
      - key: LIFERAY_BASE_URL
        sync: false
      - key: LIFERAY_OAUTH_CLIENT_SECRET
        sync: false
      - key: WORDPRESS_BASE_URL
        sync: false
      - key: WORDPRESS_APPLICATION_PASSWORD
        sync: false
      - key: POLYSYSMON_BASE_URL
        sync: false
      - key: POLYSYSMON_API_KEY
        sync: false
      - key: MONITORLOGGER_BASE_URL
        sync: false
      - key: MONITORLOGGER_INGEST_KEY
        sync: false
      - key: AIASPEERS_BASE_URL
        sync: false
      - key: AIASPEERS_API_KEY
        sync: false
      - key: APPSASPEERS_BASE_URL
        sync: false
      - key: APPSASPEERS_API_KEY
        sync: false
      - key: ELASTICSEARCH_URL
        sync: false
      - key: ELASTICSEARCH_API_KEY
        sync: false
      - key: MLSTUDIO_BASE_URL
        sync: false
      - key: MLSTUDIO_API_KEY
        sync: false

services:
  # --- Main Django / Gunicorn (uses Dockerfile CMD + ENTRYPOINT) ---
  - type: web
    name: PolySaaS
    runtime: docker
    region: singapore
    plan: starter
    branch: main
    dockerfilePath: Dockerfile.django
    dockerContext: .
    # Omit dockerCommand → image CMD runs Gunicorn via /entrypoint.sh
    healthCheckPath: /health/
    autoDeployTrigger: commit
    preDeployCommand: python manage.py migrate_all_schemas --noinput && python manage.py bootstrap_auth
    envVars:
      - fromGroup: polysaas-common
      - fromGroup: polysaas-bundled-apps
      # First-time / disaster recovery: set to 1 on the web service only if you need migrate on boot too
      - key: RUN_MIGRATIONS
        value: "0"

  # --- Celery worker (OpenClaw / agents / background jobs) ---
  - type: worker
    name: PolySaaS-Celery-Worker
    runtime: docker
    region: singapore
    plan: starter
    branch: main
    dockerfilePath: Dockerfile.django
    dockerContext: .
    # Overrides image CMD; ENTRYPOINT still runs bootstrap + collectstatic before this exec
    dockerCommand: celery -A mysite worker -l INFO --concurrency=2
    autoDeployTrigger: commit
    preDeployCommand: python manage.py migrate_all_schemas --noinput && python manage.py bootstrap_auth
    envVars:
      - fromGroup: polysaas-common
      - fromGroup: polysaas-bundled-apps
      - key: RUN_MIGRATIONS
        value: "0"

  # --- Odoo (official Hub image via deploy/odoo-render; matches Render support pattern except we
  #     do NOT set PORT=5432 in env — that breaks Render's HTTP PORT. The Dockerfile snapshots HTTP
  #     PORT then forces Postgres 5432 before /entrypoint.sh. Persistent disk for filestore.)
  - type: web
    name: PolySaaS-Odoo
    runtime: docker
    region: singapore
    plan: starter
    branch: main
    dockerfilePath: deploy/odoo-render/Dockerfile
    dockerContext: deploy/odoo-render
    autoDeployTrigger: commit
    healthCheckPath: /web/login
    envVars:
      # Set to internal hostname ONLY (from your paid Postgres Connections — not the full postgresql:// URL).
      - key: HOST
        sync: false
      - key: USER
        sync: false
      - key: PASSWORD
        sync: false
      # Dedicated database on the shared server (e.g. odoo_hkyw); create empty DB + role in Postgres first if needed.
      - key: DB_NAME
        sync: false
      - key: ADMIN_PASSWORD
        sync: false
      - key: ODOO_MASTER_PASSWORD
        sync: false
    disk:
      name: odoo-filestore
      mountPath: /var/lib/odoo
      sizeGB: 10

