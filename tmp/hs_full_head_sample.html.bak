    const fontSizeSlider = document.getElementById('sidebar-font-size-slider');
    const fontWeightSlider = document.getElementById('sidebar-font-weight-slider');
    const fontSizeValue = document.getElementById('sidebar-font-size-value');
    const fontWeightValue = document.getElementById('sidebar-font-weight-value');
    const fontResetBtn = document.getElementById('sidebar-font-reset-btn');

