{
  "name": "Sandbox Environment",
  "host": "YOUR_HOST_HERE",
  "protocol": "sftp",
  "port": 65002,
  "username": "YOUR_USERNAME_HERE",
  "password": "YOUR_PASSWORD_HERE",
  "remotePath": "/domains/YOUR_DOMAIN_HERE/public_html",
  "uploadOnSave": true,
  "syncMode": "update",
  "interactiveAuth": true,
  "ignore": [
    ".vscode/**",
    ".git/**",
    ".DS_Store",
    "wp-config.php",
    ".env",
    "/wp-content/uploads/**",
    "/wp-content/cache/**",
    "/wp-content/upgrade/**"
  ],
  "watcher": {
    "files": "**/*.{php,css,js,html,svg,json,txt}",
    "autoUpload": true,
    "autoDelete": false
  },
  "downloadOnOpen": false
}
