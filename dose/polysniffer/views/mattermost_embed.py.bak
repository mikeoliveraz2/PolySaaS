# dose/polysniffer/views/mattermost_embed.py
# Back-compat: admin/polysniffer/mattermost-embed/<id>/ → building pen.

from django.contrib.admin.views.decorators import staff_member_required

from .building_pen_embed import building_pen_embed


@staff_member_required
def mattermost_embed_view(request, endpoint_id):
    """Delegate to building_pen_embed(service_name=mattermost)."""
    return building_pen_embed(request, "mattermost", endpoint_id)
