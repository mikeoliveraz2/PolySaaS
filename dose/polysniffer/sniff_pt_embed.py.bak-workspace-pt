"""Inline passthrough embed for PolySniffer workspace (admin-style div, not iframe)."""
from __future__ import annotations

import re

from django.http import HttpResponse
from django.template.loader import render_to_string
from django.utils.safestring import mark_safe

from dose.polysniffer.sniff_native_embed import (
    _extract_head_and_body,
    _is_html_response,
    _split_head_for_inline,
    workspace_shell_prefix,
)
from dose.polysniffer.sniff_pt_proxy import public_polysniff_prefix


def passthrough_browse_prefix(endpoint_id: int) -> str:
    """Transparent proxy prefix for passthrough API/assets inside workspace."""
    return public_polysniff_prefix(endpoint_id)


def _subpath_from_polysniff_location(location: str, endpoint_id: int) -> str:
    prefix = public_polysniff_prefix(endpoint_id).rstrip("/")
    loc = (location or "").strip()
    if loc.startswith(prefix + "/"):
        return loc[len(prefix) + 1 :]
    if loc.startswith(prefix):
        return loc[len(prefix) :].lstrip("/")
    if loc.startswith("/"):
        return loc.lstrip("/")
    return ""


def build_inline_passthrough_embed_context(
    request,
    endpoint_id: int,
    endpoint,
    path: str,
    *,
    endpoint_label: str = "",
) -> dict | None:
    """
    Fetch production passthrough HTML and return head/body fragments for the
  workspace left pane (orchestration bar + scoped upstream body).
    """
    from dose.polysniffer.sniff_pt_proxy import dispatch_polysniff_passthrough
    from dose.polysniffer.sniff_tenant import bind_request_tenant, get_sniff_capture_session

    bind_request_tenant(request)
    session = get_sniff_capture_session(request, endpoint_id)
    request._polysniffer_endpoint_id = endpoint_id
    request._polysniffer_sniff_mode = "passthrough"
    if session:
        request._polysniffer_capture = session

    subpath = (path or "").strip().lstrip("/")
    response = dispatch_polysniff_passthrough(request, endpoint_id, subpath)

    if response.status_code in (301, 302, 303, 307, 308):
        location = response.get("Location", "")
        rel = _subpath_from_polysniff_location(location, endpoint_id)
        shell = workspace_shell_prefix(endpoint_id)
        target = f"{shell}/{rel}" if rel else shell
        return {"redirect": target}

    if request.method != "GET" or not _is_html_response(response):
        return None
    try:
        raw_html = response.content.decode("utf-8", errors="ignore")
    except Exception:
        return None
    if not raw_html or len(raw_html) < 50:
        return None

    head_content, body_content = _extract_head_and_body(raw_html)
    head_static, head_scripts = _split_head_for_inline(head_content)
    orch_bar = render_to_string("polysniffer/sniff_pt_orchestration_bar.html", request=request)
    scope_body = (
        f'{orch_bar}'
        f'<div class="polysaas-passthrough-scope polysniffer-pt-scope" '
        f'data-polysniffer-workspace-pt="1" data-polysniffer-endpoint-id="{endpoint_id}">'
        f"{body_content}</div>"
        f"{head_scripts}"
    )
    browse_base = passthrough_browse_prefix(endpoint_id)
    return {
        "passthrough_embed_title": endpoint_label or f"PolySniffer passthrough — ep{endpoint_id}",
        "passthrough_embed_head": mark_safe(head_static),
        "passthrough_embed_body": mark_safe(scope_body),
        "passthrough_browse_base": browse_base,
        "passthrough_shell_base": workspace_shell_prefix(endpoint_id),
    }
