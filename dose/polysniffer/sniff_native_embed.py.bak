"""Minimal workspace embed helpers for PolySniffer native sniff (no orchestration bar).

Inline Native (owner 2026-08-21): upstream HTML is embedded in the workspace left
pane — no <object>, no iframe. Scripts run in the shell document after mount.
"""
from __future__ import annotations

import re
from urllib.parse import urlparse

from django.http import HttpResponse
from django.template.loader import render_to_string
from django.utils.safestring import mark_safe


def workspace_browse_prefix(endpoint_id: int) -> str:
    """Transparent proxy prefix for API/assets (not full workspace chrome)."""
    return f"/dose/sniff/{endpoint_id}/workspace/browse"


def workspace_shell_prefix(endpoint_id: int) -> str:
    """HTML navigation prefix — reloads PolySniffer shell with inline native embed."""
    return f"/dose/sniff/{endpoint_id}/workspace"


def host_keyed_native_proxy_prefix(endpoint_host: str) -> str:
    return f"/admin/polysniffer/sniff/{endpoint_host}/native"


def host_keyed_native_shell_prefix(endpoint_host: str) -> str:
    return f"/admin/polysniffer/sniff/{endpoint_host}/workspace/native"


def _split_head_for_inline(head_content: str) -> tuple[str, str]:
    """Styles/meta stay in <head>; scripts must run after inline mount DOM exists."""
    script_pat = re.compile(r"<script\b[^>]*>.*?</script>", re.DOTALL | re.IGNORECASE)
    scripts = [m.group(0) for m in script_pat.finditer(head_content or "")]
    head_static = script_pat.sub("", head_content or "").strip()
    return head_static, "\n".join(scripts)


def _extract_head_and_body(html: str) -> tuple[str, str]:
    head_content = ""
    body_content = html or ""
    head_match = re.search(r"<head[^>]*>(.*?)</head>", html or "", re.DOTALL | re.IGNORECASE)
    if head_match:
        head_content = head_match.group(1)
    body_match = re.search(r"<body[^>]*>(.*?)</body>", html or "", re.DOTALL | re.IGNORECASE)
    if body_match:
        body_content = body_match.group(1)
    elif "<body" in (html or "").lower():
        body_start = re.search(r"<body[^>]*>", html, re.IGNORECASE)
        if body_start:
            body_content = html[body_start.end() :]
            body_content = re.sub(r"</html>\s*$", "", body_content, flags=re.IGNORECASE)
    return head_content, body_content


def _is_html_response(response: HttpResponse) -> bool:
    content_type = (response.get("Content-Type") or "").lower()
    return "text/html" in content_type or "application/xhtml" in content_type


def wrap_native_sniff_for_workspace(
    request,
    endpoint_id: int,
    response: HttpResponse,
    *,
    endpoint_label: str = "",
) -> HttpResponse:
    """
    Wrap native sniff HTML in a minimal shell (content column only — no Jazzmin,
    no orchestration bar). Legacy helper; host-keyed inline uses
    build_inline_native_embed_context instead.
    """
    if request.method != "GET" or not _is_html_response(response):
        return response
    try:
        raw_html = response.content.decode("utf-8", errors="ignore")
    except Exception:
        return response
    if not raw_html or len(raw_html) < 50:
        return response

    head_content, body_content = _extract_head_and_body(raw_html)
    browse_base = workspace_browse_prefix(endpoint_id)
    wrapped = render_to_string(
        "polysniffer/sniff_native_embed.html",
        {
            "embed_title": endpoint_label or f"PolySniffer native — ep{endpoint_id}",
            "embed_head": mark_safe(head_content),
            "embed_body": mark_safe(body_content),
            "browse_base": browse_base,
        },
        request=request,
    )
    wrapped_response = HttpResponse(wrapped, status=response.status_code)
    wrapped_response["Content-Type"] = "text/html; charset=utf-8"
    wrapped_response["Cache-Control"] = "no-cache, no-store, must-revalidate, max-age=0"
    for cookie_name in response.cookies:
        wrapped_response.cookies[cookie_name] = response.cookies[cookie_name].value
    if response.has_header("Location"):
        wrapped_response["Location"] = response["Location"]
    return wrapped_response


def build_inline_native_embed_context(
    request,
    endpoint_id: int,
    endpoint,
    path: str,
    *,
    endpoint_label: str = "",
    endpoint_host: str = "",
) -> dict | None:
    """Build head/body fragments for native embed inlined in the workspace left pane."""
    from dose.polysniffer.sniff_forward import forward_sniff_native
    from dose.polysniffer.sniff_tenant import bind_request_tenant, get_sniff_capture_session

    host = (endpoint_host or "").strip()
    if not host:
        host = urlparse((getattr(endpoint, "endpoint_url", None) or "").strip()).netloc or ""
    if not host:
        return None

    proxy_prefix = host_keyed_native_proxy_prefix(host)
    shell_prefix = host_keyed_native_shell_prefix(host)

    request._polysniffer_endpoint_id = endpoint_id
    request._polysniffer_endpoint_host = host
    request._polysniffer_sniff_mode = "native"
    request._polysniffer_proxy_prefix = proxy_prefix
    request._polysniffer_workspace_shell_prefix = shell_prefix
    request._polysniffer_workspace_inline = True
    bind_request_tenant(request)
    session = get_sniff_capture_session(request, host)
    if session:
        request._polysniffer_capture = session

    sub = (path or "").strip() or "/"
    if not sub.startswith("/"):
        sub = "/" + sub

    response = forward_sniff_native(request, endpoint, sub)
    if response.status_code in (301, 302, 303, 307, 308):
        loc = response.get("Location") or ""
        # Prefer staying on workspace shell for HTML redirects.
        if loc.startswith(proxy_prefix):
            rel = loc[len(proxy_prefix) :] or "/"
            return {"redirect": f"{shell_prefix}{rel}"}
        return None

    if request.method != "GET" or not _is_html_response(response):
        return None
    try:
        raw_html = response.content.decode("utf-8", errors="ignore")
    except Exception:
        return None
    if not raw_html or len(raw_html) < 50:
        return None

    head_content, body_content = _extract_head_and_body(raw_html)
    head_static, head_scripts = _split_head_for_inline(head_content)
    scoped = (
        f'<div class="polysniffer-native-inline" id="polysniffer-native-inline" '
        f'style="height:100%;overflow:auto;background:#fff;position:relative;">'
        f"{head_scripts}{body_content}</div>"
    )
    return {
        "native_embed_title": endpoint_label or f"PolySniffer native — {host}",
        "native_embed_head": mark_safe(head_static),
        "native_embed_body": mark_safe(scoped),
        "native_browse_base": proxy_prefix,
        "native_shell_base": shell_prefix,
        "native_endpoint_host": host,
    }
