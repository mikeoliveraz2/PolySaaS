# THIS CODE IS FROZEN — NO CHANGES TO THIS CODE ARE ALLOWED WITHOUT THE OWNER'S PERMISSION

# BINGO: PolySniffer 2.0 — 2026-06-24

"""PolySniffer 2.0 URL routes — mounted at /dose/sniff/."""

from django.urls import path, re_path

from django.views.decorators.clickjacking import xframe_options_exempt



from dose.polysniffer.views.sniff_v2 import (

    export_session_har,

    mode_picker,

    native_sniff_proxy as _native_sniff_proxy,

    passthrough_sniff_proxy as _passthrough_sniff_proxy,

    session_start,

    session_stop,

    sniff_diff,

)

from dose.polysniffer.views.sniff_v2_workspace import (

    sniff_shell,

    workspace_capture_frame,

    workspace_poll,

)



# Allow same-origin iframe embedding for browse + capture panes

native_sniff_proxy = xframe_options_exempt(_native_sniff_proxy)

passthrough_sniff_proxy = xframe_options_exempt(_passthrough_sniff_proxy)



app_name = 'polysniffer_v2'



urlpatterns = [

    path('<int:endpoint_id>/', sniff_shell, name='mode_picker'),

    path('<int:endpoint_id>/picker/', mode_picker, name='mode_picker_legacy'),

    path('<int:endpoint_id>/session/start/', session_start, name='session_start'),

    path('<int:endpoint_id>/session/stop/', session_stop, name='session_stop'),

    path('<int:endpoint_id>/diff/', sniff_diff, name='diff'),

    path('<int:endpoint_id>/export-har/', export_session_har, name='export_har'),

    path('<int:endpoint_id>/workspace/poll/', workspace_poll, name='workspace_poll'),

    path('<int:endpoint_id>/workspace/capture/', workspace_capture_frame, name='workspace_capture'),

    path('<int:endpoint_id>/workspace/', sniff_shell, name='workspace'),
    path('<int:endpoint_id>/workspace/native/', sniff_shell, {'mode': 'native'}, name='workspace_native'),
    path('<int:endpoint_id>/workspace/passthrough/', sniff_shell, {'mode': 'passthrough'}, name='workspace_passthrough'),

    path('<int:endpoint_id>/native/', native_sniff_proxy, {'path': ''}, name='native_proxy_root'),

    path('<int:endpoint_id>/passthrough/', passthrough_sniff_proxy, {'path': ''}, name='passthrough_proxy_root'),

    re_path(r'^(?P<endpoint_id>\d+)/native/(?P<path>.*)$', native_sniff_proxy, name='native_proxy'),

    re_path(r'^(?P<endpoint_id>\d+)/passthrough/(?P<path>.*)$', passthrough_sniff_proxy, name='passthrough_proxy'),

]

