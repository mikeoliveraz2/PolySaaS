"""
PolySniffer 2.0 — minimal URL rewriting for native sniff subpath proxy.

Handler-specific native rewrites register via sniff_handler_bridge.
This module keeps generic fallback + response header filtering.
"""
# THIS CODE IS FROZEN — NO CHANGES TO THIS CODE ARE ALLOWED WITHOUT THE OWNER'S PERMISSION
# BINGO: PolySniffer 2.0 Native Login Workspace — 2026-06-24
from __future__ import annotations

import re
from urllib.parse import urlparse

_STRIP_RESPONSE_HEADERS = frozenset(
    h.lower()
    for h in (
        "content-security-policy",
        "content-security-policy-report-only",
        "x-frame-options",
        "cross-origin-opener-policy",
        "cross-origin-embedder-policy",
    )
)


def sniff_native_proxy_prefix(request, endpoint_id: int) -> str:
    path = request.path_info or ""
    for pattern in (
        r"^(/dose/sniff/\d+/workspace/browse)",
        r"^(/dose/sniff/\d+/native)",
    ):
        m = re.match(pattern, path)
        if m:
            return m.group(1)
    return f"/dose/sniff/{endpoint_id}/native"


def _upstream_origin(endpoint_url: str) -> str:
    parsed = urlparse((endpoint_url or "").strip())
    if parsed.scheme and parsed.netloc:
        return f"{parsed.scheme}://{parsed.netloc}"
    return ""


def _is_html(content_type: str) -> bool:
    ct = (content_type or "").lower()
    return "text/html" in ct or "application/xhtml" in ct


def rewrite_generic_native_fallback(
    body: bytes,
    *,
    content_type: str,
    upstream_path: str,
    proxy_prefix: str,
    endpoint_url: str,
) -> bytes:
    """Generic apps: static → upstream host; other root paths → sniff prefix."""
    if not body or not _is_html(content_type):
        return body

    origin = _upstream_origin(endpoint_url)
    if not origin:
        return body

    try:
        html = body.decode("utf-8")
    except UnicodeDecodeError:
        return body

    def _static_to_host(m):
        path = m.group(3)
        if path.startswith(proxy_prefix) or path.startswith("http"):
            return m.group(0)
        return f"{m.group(1)}={m.group(2)}{origin}{path}{m.group(2)}"

    html = re.sub(r"<base\b[^>]*>", "", html, flags=re.IGNORECASE)
    html = re.sub(
        r"(src|href)=(['\"])(/static/[^'\"]+)",
        _static_to_host,
        html,
        flags=re.IGNORECASE,
    )
    html = re.sub(
        r"(src|href)=(['\"])(/(?!/)[^'\"]+)",
        lambda m: (
            m.group(0)
            if m.group(3).startswith(proxy_prefix)
            else f"{m.group(1)}={m.group(2)}{proxy_prefix}{m.group(3)}{m.group(2)}"
        ),
        html,
        flags=re.IGNORECASE,
    )
    return html.encode("utf-8")


def prepare_native_upstream_url(target_url: str, upstream_path: str) -> str:
    """Ensure Mattermost config/client requests include format=old (upstream 501 otherwise)."""
    path = upstream_path or ""
    if "/api/v4/config/client" not in path or "format=old" in target_url:
        return target_url
    sep = "&" if "?" in target_url else "?"
    return f"{target_url}{sep}format=old"


def filter_native_response_headers(headers: dict) -> dict:
    return {
        k: v
        for k, v in headers.items()
        if k.lower() not in _STRIP_RESPONSE_HEADERS
    }
