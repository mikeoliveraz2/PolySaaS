"""PolySniffer 2.0 — tenant binding for capture session lookup."""
from __future__ import annotations

from dose.polysniffer.har_capture import get_active_capture_session
from dose.utils import get_current_tenant


def bind_request_tenant(request):
    """har_capture uses request.tenant; middleware sets current_tenant_slug instead."""
    tenant = getattr(request, "tenant", None)
    if tenant:
        return tenant
    tenant = get_current_tenant(request)
    if tenant:
        request.tenant = tenant
    return tenant


def get_sniff_capture_session(request, endpoint_id: int | None = None):
    bind_request_tenant(request)
    return get_active_capture_session(request, endpoint_id)
