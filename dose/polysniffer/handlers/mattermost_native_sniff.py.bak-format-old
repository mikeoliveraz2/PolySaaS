"""
Mattermost — PolySniffer native sniff rewrites.

Native mode: static assets load direct from upstream host (same as passthrough);
API / plugins traffic routes through the sniff prefix for HAR capture.
No SSO bridge, login interception, or passthrough shim.
"""
from __future__ import annotations

import json
import re
from urllib.parse import urlparse


def _base_origin(endpoint_url: str) -> str:
    parsed = urlparse((endpoint_url or "").strip())
    return f"{parsed.scheme}://{parsed.netloc}" if parsed.scheme and parsed.netloc else ""


def _is_html(content_type: str) -> bool:
    ct = (content_type or "").lower()
    return "text/html" in ct or "application/xhtml" in ct


def _rewrite_html_static_to_host(html: str, base_origin: str, proxy_prefix: str) -> str:
    html = re.sub(r"<base\b[^>]*>", "", html, flags=re.IGNORECASE)
    html = re.sub(
        r'<meta\s+http-equiv\s*=\s*["\']Content-Security-Policy["\'][^>]*>',
        "",
        html,
        flags=re.IGNORECASE,
    )
    html = re.sub(
        r'<meta\s+http-equiv\s*=\s*["\']refresh["\'][^>]*>',
        "",
        html,
        flags=re.IGNORECASE,
    )

    # Form posts stay on sniff prefix
    html = re.sub(
        r"(action=)([\"'])(/[^\"']*)",
        lambda m: f"{m.group(1)}{m.group(2)}{proxy_prefix}{m.group(3)}{m.group(2)}",
        html,
        flags=re.IGNORECASE,
    )

    # Static assets → upstream host (naked browser)
    html = re.sub(
        r"(src|href)=(['\"])([^'\"]*?[\w.-]+\.(?:js|css|png|jpg|jpeg|gif|svg|woff2?|ttf|eot|json|map|ico)(?:\?[^'\"]*)?)",
        lambda m: f"{m.group(1)}={m.group(2)}{base_origin}{m.group(3)}{m.group(2)}",
        html,
        flags=re.IGNORECASE,
    )
    html = re.sub(
        r"(src|href)=(['\"])(/static/[^'\"]*(?:\?[^'\"]*)?)",
        lambda m: f"{m.group(1)}={m.group(2)}{base_origin}{m.group(3)}{m.group(2)}",
        html,
        flags=re.IGNORECASE,
    )

    _abs_static = re.escape(base_origin) + r"/static/"
    html = re.sub(
        r"(src|href)=(['\"])" + _abs_static + r"([^'\"]*)",
        lambda m: f"{m.group(1)}={m.group(2)}{base_origin}/static/{m.group(3)}{m.group(2)}",
        html,
        flags=re.IGNORECASE,
    )

    # SPA basename uses sniff prefix so routing works in the iframe
    html = re.sub(
        r"(window\.basename\s*=\s*)['\"][^'\"]*['\"]",
        lambda m: m.group(1) + f"'{proxy_prefix}'",
        html,
    )

    public_path = f"{base_origin}/static/"
    filled = (
        f'<script id="publicPathInWindowScript">'
        f'window.publicPath="{public_path}";'
        f"window.__webpack_public_path__=window.publicPath;"
        f"</script>"
    )
    html = re.sub(
        r'<script\s+id=["\']publicPathInWindowScript["\'][^>]*>\s*</script>',
        filled,
        html,
        count=1,
        flags=re.IGNORECASE,
    )

    return html


def _inject_native_api_shim(html: str, base_origin: str, proxy_prefix: str) -> str:
    shim = f"""
<script data-polysniffer-mm-native="1">
(function() {{
  var B = {json.dumps(base_origin.rstrip("/"))};
  var PROXY = {json.dumps(proxy_prefix)};
  var O = window.location.origin;
  function isStatic(path) {{
    return path.indexOf('/static/') === 0 || path.indexOf('/images/') === 0;
  }}
  function rewrite(url) {{
    if (typeof url !== 'string' || !url) return url;
    if (url.indexOf('data:') === 0 || url.indexOf('blob:') === 0) return url;
    var path = '';
    if (url.indexOf(B) === 0) path = url.slice(B.length);
    else if (url.indexOf(O) === 0) path = url.slice(O.length);
    else if (url.charAt(0) === '/') path = url;
    else return url;
    if (path.charAt(0) !== '/') path = '/' + path;
    if (path.indexOf(PROXY + '/') === 0) return path;
    if (isStatic(path)) return B + path;
    if (path.indexOf('/api/') === 0 || path.indexOf('/plugins/') === 0) return PROXY + path;
    return url;
  }}
  function installBasenameLock() {{
    var _basenameVal = PROXY;
    try {{
      window.publicPath = B + '/static/';
      window.__webpack_public_path__ = window.publicPath;
      Object.defineProperty(window, 'basename', {{
        get: function() {{ return _basenameVal; }},
        set: function() {{ _basenameVal = PROXY; }},
        configurable: true
      }});
    }} catch (e) {{
      window.basename = PROXY;
      window.publicPath = B + '/static/';
      window.__webpack_public_path__ = window.publicPath;
    }}
  }}
  installBasenameLock();
  function patchProp(proto, prop) {{
    var d = Object.getOwnPropertyDescriptor(proto, prop);
    if (!d || !d.set) return;
    Object.defineProperty(proto, prop, {{
      get: d.get,
      set: function(v) {{
        if (typeof v === 'string') v = rewrite(v);
        d.set.call(this, v);
      }},
      configurable: true, enumerable: true
    }});
  }}
  patchProp(HTMLScriptElement.prototype, 'src');
  patchProp(HTMLLinkElement.prototype, 'href');
  patchProp(HTMLImageElement.prototype, 'src');
  var _setAttr = Element.prototype.setAttribute;
  Element.prototype.setAttribute = function(name, value) {{
    if (typeof value === 'string') {{
      var ln = name.toLowerCase();
      if ((ln === 'src' || ln === 'href') &&
          (this instanceof HTMLScriptElement || this instanceof HTMLLinkElement || this instanceof HTMLImageElement)) {{
        value = rewrite(value);
      }}
    }}
    return _setAttr.call(this, name, value);
  }};
  var _f = window.fetch;
  window.fetch = function(input, init) {{
    if (typeof input === 'string') input = rewrite(input);
    else if (typeof Request !== 'undefined' && input instanceof Request) {{
      var u = rewrite(input.url);
      if (u !== input.url) input = new Request(u, input);
    }}
    return _f.call(this, input, init);
  }};
  var _xo = XMLHttpRequest.prototype.open;
  XMLHttpRequest.prototype.open = function(method, url) {{
    var rest = Array.prototype.slice.call(arguments, 2);
    return _xo.apply(this, [method, rewrite(url)].concat(rest));
  }};
}})();
</script>
"""
    if re.search(r"<head[^>]*>", html, flags=re.IGNORECASE):
        return re.sub(r"(?i)(<head[^>]*>)", r"\1" + shim, html, count=1)
    return shim + html


def _rewrite_config_client(body: bytes, request, endpoint_url: str, proxy_prefix: str) -> bytes | None:
    try:
        data = json.loads(body)
    except (json.JSONDecodeError, UnicodeDecodeError):
        return None

    scheme = "https" if request.is_secure() else "http"
    origin = f"{scheme}://{request.get_host()}"
    if "SiteURL" in data:
        data["SiteURL"] = origin + proxy_prefix
    if "WebsocketURL" in data:
        upstream = (endpoint_url or "").strip().rstrip("/")
        if upstream:
            parsed = urlparse(upstream)
            ws_scheme = "wss" if parsed.scheme == "https" else "ws"
            data["WebsocketURL"] = f"{ws_scheme}://{parsed.netloc}"
    return json.dumps(data).encode("utf-8")


def process_mattermost_native_sniff(
    handler,
    body: bytes,
    content_type: str,
    request,
    *,
    endpoint_url: str,
    upstream_path: str,
    proxy_prefix: str,
) -> bytes | None:
    base_origin = _base_origin(endpoint_url)
    if not base_origin:
        return None

    ct = (content_type or "").lower()
    path = upstream_path or "/"

    if _is_html(ct):
        try:
            html = body.decode("utf-8")
        except UnicodeDecodeError:
            return body
        html = _rewrite_html_static_to_host(html, base_origin, proxy_prefix)
        html = _inject_native_api_shim(html, base_origin, proxy_prefix)
        return html.encode("utf-8")

    if "json" in ct and "/api/v4/config/client" in path:
        return _rewrite_config_client(body, request, endpoint_url, proxy_prefix)

    return body


def _register() -> None:
    from dose.passthrough.handlers.mattermost_handler import MattermostPassthroughHandler
    from dose.polysniffer.sniff_handler_bridge import register_native_sniff_processor

    register_native_sniff_processor(
        MattermostPassthroughHandler,
        process_mattermost_native_sniff,
    )


_register()
