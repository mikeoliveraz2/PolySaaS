"""Slack — PolySniffer native sniff rewrites.

Native discovery must keep Slack on the forwarder (firewall / capture), not
send fetch/XHR cross-origin to app.slack.com (CORS + blank pane).

Uses SlackPassthroughHandler.process_html_response for:
  - /auth proxy-relay
  - postMessage retarget + MessageEvent origin spoof

Plus a Native firewall shim that:
  - rewrites root-relative URLs onto the native proxy prefix
  - rewrites absolute https://app.slack.com (and *.slack.com) back onto the proxy
  - patches Location, setAttribute(src/href), window.open, iframe src
  - rewrites meta refresh URL=/… so nojsmode cannot escape to site root
"""
from __future__ import annotations

import json
import re
from urllib.parse import urlparse


def _base_origin(endpoint_url: str) -> str:
    parsed = urlparse((endpoint_url or "").strip())
    return f"{parsed.scheme}://{parsed.netloc}" if parsed.scheme and parsed.netloc else ""


_CSP_META_RE = re.compile(
    r"(?is)<meta[^>]+http-equiv\s*=\s*[\"']?content-security-policy[\"']?[^>]*>"
)


def _strip_csp_meta(html: str) -> str:
    """Slack ships a hash-allowlisted script-src CSP meta; it blocks our shims
    and then WD treats that as asset failure (?cdn_fallback=… loop). Same strip
    as sniff_pt_proxy (BINGO 2026-08-21)."""
    if not html:
        return html
    return _CSP_META_RE.sub("", html)


def _is_html(content_type: str) -> bool:
    ct = (content_type or "").lower()
    return "text/html" in ct or "application/xhtml" in ct


def _rewrite_meta_refresh_through_proxy(html: str, proxy_prefix: str) -> str:
    """Slack ships meta refresh to /?nojsmode=1 — that must stay under the proxy."""
    prefix = (proxy_prefix or "").rstrip("/")
    if not prefix or not html:
        return html

    def _sub(match: re.Match) -> str:
        prefix_part = match.group(1)
        url_part = match.group(2) or "/"
        if url_part.startswith("http://") or url_part.startswith("https://"):
            parsed = urlparse(url_part)
            if parsed.netloc and (
                parsed.netloc == "app.slack.com"
                or parsed.netloc.endswith(".slack.com")
            ):
                path = parsed.path or "/"
                q = f"?{parsed.query}" if parsed.query else ""
                return f"{prefix_part}{prefix}{path}{q}"
            return match.group(0)
        if not url_part.startswith("/"):
            url_part = "/" + url_part
        if url_part.startswith(prefix):
            return match.group(0)
        return f"{prefix_part}{prefix}{url_part}"

    return re.sub(
        r'(?i)(<meta[^>]+http-equiv\s*=\s*["\']refresh["\'][^>]*content\s*=\s*["\'][^"\']*URL\s*=\s*)([^"\'>\s]+)',
        _sub,
        html,
    )


def _inject_native_firewall_shim(
    html: str,
    proxy_prefix: str,
    tenant: str,
    upstream_origin: str,
    *,
    shell_prefix: str = "",
) -> str:
    """Keep the SPA on the native proxy — including absolute Slack navigations.

    When shell_prefix is set (inline workspace embed), document navigations stay
    on the workspace shell URL while fetch/XHR use the native proxy prefix.
    """
    prefix = (proxy_prefix or "").rstrip("/")
    if not prefix:
        return html
    shell = (shell_prefix or "").rstrip("/") or prefix
    upstream = (upstream_origin or "https://app.slack.com").rstrip("/")
    shim = f"""
<script data-polysniffer-slack-native-firewall="1">
(function() {{
  var PROXY = {json.dumps(prefix)};
  var SHELL = {json.dumps(shell)};
  var PS_TENANT = {json.dumps(tenant or "")};
  var UPSTREAM = {json.dumps(upstream)};
  console.log('[PS SLACK FIREWALL] installed', {{
    proxy: PROXY,
    shell: SHELL,
    upstream: UPSTREAM,
    href: String(location.href),
    origin: String(location.origin)
  }});
  function withTenant(url) {{
    if (!PS_TENANT) return url;
    if (url.indexOf('_ps_tenant=') !== -1) return url;
    return url + (url.indexOf('?') >= 0 ? '&' : '?') + '_ps_tenant=' + encodeURIComponent(PS_TENANT);
  }}
  function isSlackHost(hostname) {{
    if (!hostname) return false;
    hostname = String(hostname).toLowerCase();
    if (hostname.indexOf('slack-edge.com') !== -1) return false;
    return hostname === 'slack.com' || hostname === 'app.slack.com'
      || hostname.slice(-10) === '.slack.com';
  }}
  function toProxyPath(parsed) {{
    try {{ parsed.searchParams.delete('_ps_tenant'); }} catch (e) {{}}
    var q = '';
    try {{ q = parsed.searchParams.toString(); }} catch (e) {{ q = (parsed.search || '').replace(/^\\?/, ''); }}
    return parsed.pathname + (q ? ('?' + q) : '') + (parsed.hash || '');
  }}
  function stripKnownPrefix(path) {{
    if (path.indexOf(PROXY) === 0) return path.slice(PROXY.length) || '/';
    if (SHELL && path.indexOf(SHELL) === 0) return path.slice(SHELL.length) || '/';
    return path;
  }}
  function rewriteTo(base, url) {{
    if (typeof url !== 'string' || !url) return url;
    if (url.indexOf('data:') === 0 || url.indexOf('blob:') === 0) return url;
    try {{
      var parsed = new URL(url, window.location.origin);
      if (parsed.origin === UPSTREAM || isSlackHost(parsed.hostname)) {{
        return withTenant(base + toProxyPath(parsed));
      }}
      if (parsed.origin !== window.location.origin) return url;
      var path = stripKnownPrefix(parsed.pathname + parsed.search + parsed.hash);
      if (path.charAt(0) !== '/') path = '/' + path;
      return withTenant(base + path);
    }} catch (e) {{
      if (url.charAt(0) === '/') {{
        var p = stripKnownPrefix(url);
        if (p.charAt(0) !== '/') p = '/' + p;
        return withTenant(base + p);
      }}
      return url;
    }}
  }}
  function rewriteFetch(url) {{ return rewriteTo(PROXY, url); }}
  function rewriteNav(url) {{ return rewriteTo(SHELL, url); }}
  var _fetch = window.fetch;
  window.fetch = function(input, init) {{
    if (typeof input === 'string') input = rewriteFetch(input);
    else if (typeof Request !== 'undefined' && input instanceof Request) {{
      try {{ input = new Request(rewriteFetch(input.url), input); }} catch (e) {{}}
    }}
    return _fetch.call(this, input, init);
  }};
  var _open = XMLHttpRequest.prototype.open;
  XMLHttpRequest.prototype.open = function(method, url) {{
    var args = Array.prototype.slice.call(arguments);
    args[1] = rewriteFetch(url);
    return _open.apply(this, args);
  }};
  try {{
    var _sa = Element.prototype.setAttribute;
    Element.prototype.setAttribute = function(name, value) {{
      var n = String(name || '').toLowerCase();
      if ((n === 'src' || n === 'href' || n === 'action') && typeof value === 'string') {{
        value = (n === 'href' || n === 'action') ? rewriteNav(value) : rewriteFetch(value);
      }}
      return _sa.call(this, name, value);
    }};
  }} catch (e) {{}}
  try {{
    var _scriptSrc = Object.getOwnPropertyDescriptor(HTMLScriptElement.prototype, 'src');
    if (_scriptSrc && _scriptSrc.set) {{
      Object.defineProperty(HTMLScriptElement.prototype, 'src', {{
        get: _scriptSrc.get,
        set: function(v) {{ _scriptSrc.set.call(this, rewriteFetch(String(v || ''))); }},
        configurable: true
      }});
    }}
  }} catch (e) {{}}
  try {{
    var _linkHref = Object.getOwnPropertyDescriptor(HTMLLinkElement.prototype, 'href');
    if (_linkHref && _linkHref.set) {{
      Object.defineProperty(HTMLLinkElement.prototype, 'href', {{
        get: _linkHref.get,
        set: function(v) {{
          var s = String(v || '');
          _linkHref.set.call(this, /\\.css(\\?|$)/i.test(s) ? rewriteFetch(s) : rewriteNav(s));
        }},
        configurable: true
      }});
    }}
  }} catch (e) {{}}
  try {{
    var _wopen = window.open;
    window.open = function(url, target, features) {{
      return _wopen.call(this, rewriteNav(String(url || '')), target, features);
    }};
  }} catch (e) {{}}
  try {{
    var _hrefDesc = Object.getOwnPropertyDescriptor(Location.prototype, 'href');
    if (_hrefDesc && _hrefDesc.set) {{
      Object.defineProperty(Location.prototype, 'href', {{
        get: _hrefDesc.get,
        set: function(v) {{ _hrefDesc.set.call(this, rewriteNav(String(v || ''))); }},
        configurable: true
      }});
    }}
    var _assign = Location.prototype.assign;
    Location.prototype.assign = function(v) {{ return _assign.call(this, rewriteNav(String(v || ''))); }};
    var _replace = Location.prototype.replace;
    Location.prototype.replace = function(v) {{ return _replace.call(this, rewriteNav(String(v || ''))); }};
  }} catch (e) {{
    console.warn('[PS SLACK FIREWALL] Location patch failed', e);
  }}
  try {{
    var _srcDesc = Object.getOwnPropertyDescriptor(HTMLIFrameElement.prototype, 'src');
    if (_srcDesc && _srcDesc.set) {{
      Object.defineProperty(HTMLIFrameElement.prototype, 'src', {{
        get: _srcDesc.get,
        set: function(v) {{ _srcDesc.set.call(this, rewriteFetch(String(v || ''))); }},
        configurable: true
      }});
    }}
  }} catch (e) {{}}
  try {{
    var bar = document.createElement('div');
    bar.id = 'ps-native-diag';
    bar.textContent = 'PolySniffer native inline — ' + location.pathname;
    bar.setAttribute('style',
      'position:sticky;top:0;left:0;z-index:2147483647;background:#047857;color:#fff;' +
      'font:12px Consolas,monospace;padding:4px 8px;pointer-events:none;');
    var mount = document.getElementById('polysniffer-native-inline') || document.body || document.documentElement;
    mount.insertBefore(bar, mount.firstChild);
  }} catch (e) {{}}
}})();
</script>
"""
    if re.search(r"<head[^>]*>", html, flags=re.IGNORECASE):
        return re.sub(r"(?i)(<head[^>]*>)", r"\1" + shim, html, count=1)
    return shim + html


def process_slack_native_sniff(
    handler,
    body: bytes,
    content_type: str,
    request,
    *,
    endpoint_url: str,
    upstream_path: str,
    proxy_prefix: str,
) -> bytes | None:
    if not body or not _is_html(content_type):
        return None
    base_origin = _base_origin(endpoint_url)
    if not base_origin:
        return None
    try:
        html = body.decode("utf-8")
    except UnicodeDecodeError:
        return body

    # Must strip before our shims land — Slack CSP meta ∩ our header CSP = blocked inline.
    html = _strip_csp_meta(html)

    prefix = (proxy_prefix or "").strip().rstrip("/")
    if prefix:
        request._polysniffer_proxy_prefix = prefix

    html = _rewrite_meta_refresh_through_proxy(html, prefix)

    # Auth + postMessage / MessageEvent bridge (same as Passthrough).
    if hasattr(handler, "process_html_response"):
        html = handler.process_html_response(
            html, request, endpoint_url=endpoint_url
        )

    tenant = (
        getattr(request, "schema_name", None)
        or (getattr(getattr(request, "tenant", None), "schema_name", None) or "")
    )
    shell_prefix = (
        getattr(request, "_polysniffer_workspace_shell_prefix", None) or ""
    ).strip()
    # Firewall last so Location / setAttribute patches win.
    html = _inject_native_firewall_shim(
        html, prefix, tenant, base_origin, shell_prefix=shell_prefix
    )
    return html.encode("utf-8")


def _register() -> None:
    from dose.passthrough.handlers.slack_handler import SlackPassthroughHandler
    from dose.polysniffer.sniff_handler_bridge import register_native_sniff_processor

    register_native_sniff_processor(
        SlackPassthroughHandler,
        process_slack_native_sniff,
    )


_register()
