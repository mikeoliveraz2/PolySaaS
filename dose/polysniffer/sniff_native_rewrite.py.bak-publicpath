"""
PolySniffer 2.0 — minimal URL rewriting for native sniff subpath proxy.

Native mode does not use passthrough handlers or orchestration, but when the
browser loads /dose/sniff/<id>/native/… every upstream absolute path (/static/,
/api/, etc.) must be routed back through the sniff prefix — same as any reverse
proxy mounted on a subpath.
"""
from __future__ import annotations

import json
import re
from urllib.parse import urlparse

MAX_BODY_REWRITE_BYTES = 25 * 1024 * 1024

_STRIP_RESPONSE_HEADERS = frozenset(
    h.lower()
    for h in (
        "content-security-policy",
        "content-security-policy-report-only",
        "x-frame-options",
        "cross-origin-opener-policy",
        "cross-origin-embedder-policy",
    )
)


def sniff_native_proxy_prefix(request, endpoint_id: int) -> str:
    m = re.match(r"^(/dose/sniff/\d+/native)", request.path_info or "")
    if m:
        return m.group(1)
    return f"/dose/sniff/{endpoint_id}/native"


def _upstream_origin(endpoint_url: str) -> str:
    parsed = urlparse((endpoint_url or "").strip())
    if parsed.scheme and parsed.netloc:
        return f"{parsed.scheme}://{parsed.netloc}"
    return ""


def _is_html(content_type: str) -> bool:
    ct = (content_type or "").lower()
    return "text/html" in ct or "application/xhtml" in ct


def _is_css(content_type: str, path: str) -> bool:
    ct = (content_type or "").lower()
    path_l = (path or "").lower()
    return ("css" in ct and "javascript" not in ct) or path_l.endswith(".css")


def _is_js(content_type: str, path: str) -> bool:
    ct = (content_type or "").lower()
    path_l = (path or "").lower()
    return (
        "javascript" in ct
        or "ecmascript" in ct
        or path_l.endswith(".js")
        or path_l.endswith(".mjs")
    )


def _is_json(content_type: str, path: str) -> bool:
    ct = (content_type or "").lower()
    return "json" in ct or (path or "").lower().endswith(".json")


def _strip_base_tags(html: str) -> str:
    return re.sub(r"<base\b[^>]*>", "", html, flags=re.IGNORECASE)


def _strip_meta_csp_and_refresh(html: str) -> str:
    html = re.sub(
        r'<meta\s+http-equiv\s*=\s*["\']Content-Security-Policy["\'][^>]*>',
        "",
        html,
        flags=re.IGNORECASE,
    )
    html = re.sub(
        r'<meta\s+http-equiv\s*=\s*["\']refresh["\'][^>]*>',
        "",
        html,
        flags=re.IGNORECASE,
    )
    return html


def _inject_webpack_public_path(html: str, proxy_prefix: str) -> str:
    base = f"{proxy_prefix}/static/"
    snippet = (
        f'<script>try{{window.__webpack_public_path__="{base}";}}catch(e){{}}</script>'
    )
    if re.search(r"<head[^>]*>", html, flags=re.IGNORECASE):
        return re.sub(r"(?i)(<head[^>]*>)", r"\1" + snippet, html, count=1)
    return snippet + html


def _rewrite_html_assets(html: str, proxy_prefix: str, upstream_origin: str) -> str:
    def _prefix_attr(m):
        path = m.group(3)
        if path.startswith(proxy_prefix):
            return m.group(0)
        return f"{m.group(1)}={m.group(2)}{proxy_prefix}{path}{m.group(2)}"

    html = re.sub(
        r'(src|href)=(["\'])([^"\']*?[\w\.-]{5,}\.(js|css|png|jpg|jpeg|gif|svg|woff2?|ttf|eot|json|map|ico))',
        _prefix_attr,
        html,
        flags=re.IGNORECASE,
    )
    html = re.sub(
        r'(src|href)=(["\'])(/[^"\']+)',
        _prefix_attr,
        html,
        flags=re.IGNORECASE,
    )
    if upstream_origin:
        html = re.sub(
            re.escape(upstream_origin) + r"(/[^\"'\s>]*)",
            lambda m: proxy_prefix + m.group(1),
            html,
            flags=re.IGNORECASE,
        )
    return html


def _inject_native_client_shim(html: str, proxy_prefix: str, upstream_origin: str) -> str:
    """Patch fetch/XHR/WebSocket so runtime API + asset calls stay on sniff prefix."""
    shim = f"""
<script data-polysniffer-native-shim="1">
(function() {{
  var B = {json.dumps(upstream_origin)};
  var PROXY = {json.dumps(proxy_prefix)};
  var O = window.location.origin;
  var PS = ['/static/admin/','/static/img/','/admin/','/dose/','/media/','/accounts/','/favicon'];
  function isPS(s) {{
    for (var i = 0; i < PS.length; i++) if (s.indexOf(PS[i]) === 0) return true;
    return false;
  }}
  function toProxy(s) {{
    if (typeof s !== 'string' || !s) return s;
    if (s.indexOf('data:') === 0 || s.indexOf('blob:') === 0) return s;
    if (B && s.indexOf(B) === 0) {{
      var tail = s.slice(B.length);
      if (tail.charAt(0) !== '/') tail = '/' + tail;
      return PROXY + tail;
    }}
    if (s.indexOf(O + '/') === 0) s = s.slice(O.length);
    else if (s.indexOf('http:') === 0 || s.indexOf('https:') === 0 || s.indexOf('//') === 0) return s;
    if (s.charAt(0) !== '/') return s;
    if (isPS(s)) return s;
    if (s.indexOf(PROXY + '/') === 0) return s;
    return PROXY + s;
  }}
  var _f = window.fetch;
  window.fetch = function(input, init) {{
    if (typeof input === 'string') input = toProxy(input);
    else if (typeof Request !== 'undefined' && input instanceof Request) {{
      var u = toProxy(input.url);
      if (u !== input.url) input = new Request(u, input);
    }}
    return _f.call(this, input, init);
  }};
  var _xo = XMLHttpRequest.prototype.open;
  XMLHttpRequest.prototype.open = function(method, url) {{
    var rest = Array.prototype.slice.call(arguments, 2);
    return _xo.apply(this, [method, toProxy(url)].concat(rest));
  }};
  var _WS = window.WebSocket;
  window.WebSocket = function(url, protocols) {{
    if (typeof url === 'string') {{
      try {{
        var abs = toProxy(url);
        if (abs.charAt(0) === '/') abs = O + abs;
        url = abs.replace(/^http/, 'ws');
      }} catch (e) {{}}
    }}
    return protocols === undefined ? new _WS(url) : new _WS(url, protocols);
  }};
}})();
</script>
"""
    if re.search(r"<head[^>]*>", html, flags=re.IGNORECASE):
        return re.sub(r"(?i)(<head[^>]*>)", r"\1" + shim, html, count=1)
    return shim + html


def _rewrite_webpack_static_paths(body: bytes, *, is_css: bool, webpack_prefix: str) -> bytes:
    if not body or len(body) > MAX_BODY_REWRITE_BYTES:
        return body
    try:
        s = body.decode("utf-8")
    except UnicodeDecodeError:
        return body

    p = webpack_prefix
    s = s.replace('"/static/', f'"{p}')
    s = s.replace("'/static/", f"'{p}")
    s = s.replace('\\"/static/', f'\\"{p}')
    s = s.replace("\\'/static/", f"\\'{p}")
    if is_css:
        s = s.replace("url(/static/", f"url({p}")
        s = s.replace('url("/static/', f'url("{p}')
        s = s.replace("url('/static/", f"url('{p}")
    return s.encode("utf-8")


def rewrite_native_response_body(
    body: bytes,
    *,
    content_type: str,
    upstream_path: str,
    proxy_prefix: str,
    endpoint_url: str,
) -> bytes:
    """Rewrite HTML/CSS/JS bodies so subpath native sniff loads like a naked browser."""
    if not body:
        return body

    origin = _upstream_origin(endpoint_url)
    webpack_prefix = f"{proxy_prefix}/static/"

    if _is_html(content_type):
        try:
            html = body.decode("utf-8")
        except UnicodeDecodeError:
            return body
        html = _strip_base_tags(html)
        html = _strip_meta_csp_and_refresh(html)
        html = _inject_webpack_public_path(html, proxy_prefix)
        html = _inject_native_client_shim(html, proxy_prefix, origin)
        html = _rewrite_html_assets(html, proxy_prefix, origin)
        return html.encode("utf-8")

    if _is_css(content_type, upstream_path):
        return _rewrite_webpack_static_paths(body, is_css=True, webpack_prefix=webpack_prefix)

    if _is_js(content_type, upstream_path) or _is_json(content_type, upstream_path):
        return _rewrite_webpack_static_paths(body, is_css=False, webpack_prefix=webpack_prefix)

    return body


def filter_native_response_headers(headers: dict) -> dict:
    """Drop headers that block iframe embed or subpath asset loading."""
    return {
        k: v
        for k, v in headers.items()
        if k.lower() not in _STRIP_RESPONSE_HEADERS
    }
