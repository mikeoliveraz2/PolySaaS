                data = json.loads(request.body)
                capture_type = data.get('type', 'unknown')
                capture_data = data.get('data', {})
                url = data.get('url', '')
                timestamp = data.get('ts', timezone.now().timestamp() * 1000)

                # Minimal logging - only log errors, not every capture
                # if capture_type in ['form_submit', 'navigation']:  # Only log important events
                #     print(f"[SILENT CAPTURE] {capture_type}: {url[:100]}", flush=True)

                # Save to TrafficLog for analysis (limit body size to prevent terminal spam)
                try:
                    body_data = json.dumps(capture_data, indent=2)
                    # Limit body size more aggressively for session captures (which include full HTML)
                    if capture_type == 'session' and 'html' in capture_data:
                        body_data = body_data[:5000]  # Much smaller limit for session captures
                    else:
                        body_data = body_data[:10000]  # Smaller limit for other captures

                    # DISABLED: TrafficLog creation to prevent terminal spam
                    # TrafficLog.objects.create(...)
                    pass
                except Exception as e:
                    # Only log errors, not every creation - use logger instead of print
                    import logging
                    logger = logging.getLogger(__name__)
                    logger.warning(f"[SILENT CAPTURE] Error saving log: {e}")

                # Also save to endpoint's discovered_subpaths for easy access
                if not endpoint.discovered_subpaths:
                    endpoint.discovered_subpaths = {}

                if 'silent_captures' not in endpoint.discovered_subpaths:
                    endpoint.discovered_subpaths['silent_captures'] = []

                # Keep last 100 captures
                endpoint.discovered_subpaths['silent_captures'].append({
