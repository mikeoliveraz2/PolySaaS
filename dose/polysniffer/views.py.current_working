@staff_member_required
def open_sniffer(request, endpoint_id):
    """
    Main entry point - accessed via admin "Sniff" button
    Redirects to navigate_with_toolbar which shows the notice page with Navigate button
    """
    # Double-check staff access
    if not request.user.is_staff:
        from django.shortcuts import redirect
        return redirect('admin:index')

    # Redirect to navigate_with_toolbar which shows the notice page
    from django.shortcuts import redirect
    return redirect('polysniffer:navigate_with_toolbar', endpoint_id=endpoint_id)


@staff_member_required
@require_http_methods(["POST"])
def save_capture(request, endpoint_id):
    """
    Save captured traffic data to endpoint model
    """
    if not request.user.is_staff:
        return JsonResponse({'success': False, 'error': 'Staff access required'}, status=403)

    endpoint = get_endpoint_any_schema(endpoint_id, request)

    try:
        import json
        data = json.loads(request.body)
        captures = data.get('captures', [])

        if captures:
            # Save latest capture to endpoint
            latest = captures[-1]
            endpoint.polysniffer_debug_output = json.dumps(latest, indent=2)
            endpoint.polysniffer_last_run = timezone.now()
            endpoint.save()

            return JsonResponse({
                'success': True,
                'message': f'Saved {len(captures)} capture(s) to endpoint'
            })
        else:
            return JsonResponse({
                'success': False,
                'error': 'No captures to save'
            }, status=400)

    except json.JSONDecodeError:
        return JsonResponse({'success': False, 'error': 'Invalid JSON'}, status=400)
    except Exception as e:
        return JsonResponse({'success': False, 'error': str(e)}, status=500)


