@staff_member_required
def polysniffer_in_content(request, endpoint_id):
    """
    Open PolySniffer in the main content area (for sidebar links)
    NO IFRAME, NO PROXY - just fetch HTML directly like the Sniff button does
    """
    if not request.user.is_staff:
        from django.http import HttpResponseForbidden
        return HttpResponseForbidden('Staff access required')

    endpoint = get_endpoint_any_schema(endpoint_id, request)

    if not endpoint.endpoint_url:
        from django.http import HttpResponseBadRequest
        return HttpResponseBadRequest("Endpoint URL is required")

    # Build target URL - same as Sniff button does
    target_url = endpoint.endpoint_url.rstrip('/')
    if '/scp/' in target_url:
        # For OS Ticket, default to dashboard
        base = target_url.split('/scp/')[0].rstrip('/')
        target_url = f"{base}/scp/dashboard.php"

    # Fetch HTML directly from endpoint - NO PROXY, NO IFRAME (just like Sniff button)
    import requests
    from urllib.parse import urlparse, urljoin
    try:
        # Forward cookies from browser to request
        cookies = request.COOKIES.copy()
        response = requests.get(target_url, cookies=cookies, timeout=30, verify=False)
        html_content = response.text

        # CRITICAL: Rewrite all URLs to go through proxy for navigation/forms
        # But keep CSS/JS/images as absolute URLs to OS Ticket domain
        from bs4 import BeautifulSoup
        soup = BeautifulSoup(html_content, 'html.parser')
        parsed_target = urlparse(target_url)
        base_url = f"{parsed_target.scheme}://{parsed_target.netloc}"

        # Rewrite CSS/JS/images to absolute URLs (so they load from OS Ticket)
        for tag in soup.find_all(['link', 'script', 'img']):
            for attr in ['href', 'src']:
                if tag.get(attr):
                    url = tag[attr]
                    # Skip absolute URLs and special protocols
                    if url.startswith('http') or url.startswith('//') or url.startswith('#'):
                        continue
                    # Skip javascript: and data: URLs
                    if ':' in url and not url.startswith('/'):
                        continue
                    # Convert relative URLs to absolute
                    if url.startswith('/'):
                        tag[attr] = base_url + url
                    else:
                        tag[attr] = urljoin(target_url, url)

        # Rewrite links and forms to go through proxy (for navigation)
        for tag in soup.find_all(['a', 'form']):
            for attr in ['href', 'action']:
                if tag.get(attr):
                    url = tag[attr]
                    # Skip absolute URLs that aren't to our endpoint
                    if url.startswith('http') and endpoint.endpoint_url not in url:
                        continue
                    # Skip javascript:, mailto:, tel:, etc.
                    if ':' in url and not url.startswith('http'):
                        continue
                    # Rewrite to proxy URL
                    if url.startswith('/') or endpoint.endpoint_url in url or (not url.startswith('http') and not url.startswith('#')):
                        # Extract path from URL
                        if url.startswith('http'):
                            parsed_url = urlparse(url)
                            url_path = parsed_url.path.lstrip('/')
                            query_part = parsed_url.query
                        else:
                            url_path = url.lstrip('/')
                            if '?' in url_path:
                                url_path, query_part = url_path.split('?', 1)
                            else:
                                query_part = ''
                        # Build proxy URL
                        new_url = f'/admin/polysniffer/proxy/{endpoint_id}/{url_path}'
                        if query_part:
                            new_url += f'?{query_part}'
                        tag[attr] = new_url

        # Inject AJAX interceptor to route AJAX through proxy
        if soup.body:
            interceptor_script = soup.new_tag('script')
            interceptor_script.string = f"""
(function() {{
    var proxyBase = '/admin/polysniffer/proxy/{endpoint_id}/';

    // Intercept jQuery AJAX
    if (typeof jQuery !== 'undefined' && jQuery.ajax) {{
        var originalAjax = jQuery.ajax;
        jQuery.ajax = function(options) {{
            if (options && options.url) {{
                var url = options.url;
                if (typeof url === 'string' && !url.startsWith('http') && !url.startsWith('/admin/polysniffer/') && !url.startsWith('#')) {{
                    var urlPath = url.replace(/^\\//, '');
                    options.url = proxyBase + urlPath;
                    console.log('[POLYSNIFFER] Rewrote AJAX URL:', url, '->', options.url);
                }}
            }}
            return originalAjax.apply(this, arguments);
        }};
    }}

    // Intercept fetch API
    if (window.fetch) {{
        var originalFetch = window.fetch;
        window.fetch = function(url, options) {{
            if (typeof url === 'string' && !url.startsWith('http') && !url.startsWith('/admin/polysniffer/') && !url.startsWith('#')) {{
                var urlPath = url.replace(/^\\//, '');
                url = proxyBase + urlPath;
                console.log('[POLYSNIFFER] Rewrote fetch URL:', arguments[0], '->', url);
            }}
            return originalFetch.apply(this, arguments);
        }};
    }}

    // Intercept XMLHttpRequest
    if (window.XMLHttpRequest) {{
        var originalOpen = XMLHttpRequest.prototype.open;
        XMLHttpRequest.prototype.open = function(method, url, async, user, password) {{
            if (typeof url === 'string' && !url.startsWith('http') && !url.startsWith('/admin/polysniffer/') && !url.startsWith('#')) {{
                var urlPath = url.replace(/^\\//, '');
                url = proxyBase + urlPath;
                console.log('[POLYSNIFFER] Rewrote XHR URL:', arguments[1], '->', url);
            }}
            return originalOpen.apply(this, arguments);
        }};
    }}
}})();
"""
            soup.body.append(interceptor_script)

        html_content = str(soup)
    except Exception as e:
        import logging
        logging.getLogger(__name__).error(f"Error fetching endpoint: {e}")
        html_content = f'<p>Error loading {target_url}: {str(e)}</p>'

    context = {
        'endpoint': endpoint,
        'endpoint_url': target_url,
        'html_content': html_content,
    }
    return render(request, 'polysniffer/in_content_with_toolbar.html', context)


@csrf_exempt
@staff_member_required
def proxy_capture(request, endpoint_id, path=''):
    """
    Proxy that forwards requests to endpoint and captures all traffic
    This is the key - it captures raw traffic without modifying it
    CSRF exempt because we're proxying external service requests

    ⊗⊗⊗ CURSOR PROTECTION ZONE ⊗⊗⊗
    Do NOT inject PolySniffer here. It belongs in navigate_with_toolbar.
    If you move it again, the server will cry.
    — Mike & Shela, November 22, 2025
    """
    if not request.user.is_staff:
        from django.http import HttpResponseForbidden
        return HttpResponseForbidden('Staff access required')

    endpoint = get_endpoint_any_schema(endpoint_id, request)

    if not endpoint.endpoint_url:
        from django.http import HttpResponseBadRequest
        return HttpResponseBadRequest("Endpoint URL is required")

    # ─────── EARLY STATIC ASSET DETECTION — BEFORE MAKING REQUEST ───────
    # Extract the actual path from the request
    proxy_prefix = f'/admin/polysniffer/proxy/{endpoint_id}/'
    if request.path.startswith(proxy_prefix):
        actual_path = request.path[len(proxy_prefix):]
    else:
        actual_path = path if path else request.path

    # Normalize path
    if actual_path and not actual_path.startswith('/'):
        actual_path = '/' + actual_path

    actual_path_lower = actual_path.lower()

    # Check if this is a static asset request BEFORE making the upstream request
    is_static_asset_request = (
        '/chat-static/' in actual_path_lower or
        '/_next/' in actual_path_lower or
        actual_path_lower.endswith(('.woff2', '.woff', '.ttf', '.otf', '.eot', '.js', '.css', '.png', '.jpg', '.jpeg', '.gif', '.svg', '.ico', '.json', '.webp', '.mp4', '.webm')) or
        'image?' in actual_path_lower or
        '/assets/' in actual_path_lower or
        '/fonts/' in actual_path_lower
    )

    # If it's a static asset, bypass immediately and fetch directly from original domain
    if is_static_asset_request:
        import logging
        logger = logging.getLogger(__name__)
        logger.info(f"[PROXY BYPASS] Static asset detected early: path={actual_path}, request.path={request.path}")

        # Build real URL from endpoint
        from urllib.parse import urlparse
        parsed_endpoint = urlparse(endpoint.endpoint_url)

        # For v0.dev, always use https://v0.dev as base
        if 'v0.dev' in endpoint.endpoint_url or 'v0.app' in endpoint.endpoint_url:
            base_domain = "https://v0.dev"
        else:
            base_domain = f"{parsed_endpoint.scheme}://{parsed_endpoint.netloc}"

        # 1. For Next.js Image Optimizer (/_next/image or /image)
        if '/_next/image' in actual_path or '/image' in actual_path or 'image?' in actual_path_lower:
            image_url = request.GET.get('url')
            if image_url and image_url.startswith('http'):
                # Bypass proxy — redirect directly to the image URL
                from django.http import HttpResponseRedirect
                return HttpResponseRedirect(image_url)

        # 2. For all other static assets — fetch from real CDN/original domain
        # Use actual_path which we already extracted
        real_path = actual_path

        # Build the real URL
        real_url = base_domain + real_path
        if request.GET:
            real_url += '?' + request.GET.urlencode()

        logger.info(f"[PROXY BYPASS] Fetching static asset from: {real_url}")

        try:
            import requests
            # Fetch directly from original domain (no proxy rewriting)
            upstream_resp = requests.get(
                real_url,
                headers={
                    'User-Agent': request.headers.get('User-Agent', 'Mozilla/5.0'),
                    'Accept': request.headers.get('Accept', '*/*'),
                    'Accept-Language': request.headers.get('Accept-Language', 'en-US,en;q=0.9'),
                },
                stream=True,
                timeout=10,
                allow_redirects=True
            )

            # Force correct MIME types (fixes "text/html" errors)
            content_type = upstream_resp.headers.get('Content-Type', 'application/octet-stream')
            if '.woff2' in actual_path_lower:
                content_type = 'font/woff2'
            elif '.woff' in actual_path_lower:
                content_type = 'font/woff'
            elif '.ttf' in actual_path_lower:
                content_type = 'font/ttf'
            elif '.js' in actual_path_lower or actual_path_lower.endswith('.js'):
                content_type = 'application/javascript'
            elif '.css' in actual_path_lower or actual_path_lower.endswith('.css'):
                content_type = 'text/css'
            elif '.png' in actual_path_lower:
                content_type = 'image/png'
            elif '.jpg' in actual_path_lower or '.jpeg' in actual_path_lower:
                content_type = 'image/jpeg'
            elif '.webp' in actual_path_lower:
                content_type = 'image/webp'
            elif '.svg' in actual_path_lower:
                content_type = 'image/svg+xml'
            elif '.json' in actual_path_lower:
                content_type = 'application/json'
            elif '.mp4' in actual_path_lower:
                content_type = 'video/mp4'
            elif '.webm' in actual_path_lower:
                content_type = 'video/webm'

            from django.http import StreamingHttpResponse
            response = StreamingHttpResponse(
                upstream_resp.iter_content(chunk_size=8192),
                content_type=content_type,
                status=upstream_resp.status_code
            )
            # Copy important headers
            for header_name in ['Cache-Control', 'ETag', 'Last-Modified']:
                if header_name in upstream_resp.headers:
                    response[header_name] = upstream_resp.headers[header_name]
            return response
        except Exception as e:
            import logging
            logger = logging.getLogger(__name__)
            logger.error(f"[PROXY BYPASS ERROR] {e}")
            from django.http import HttpResponse
            return HttpResponse(f"Asset fetch failed: {e}", status=502)

    # ─────── NORMAL PROXY FLOW (rewriting/injection) FOR HTML PAGES ───────
    import requests
    from django.http import HttpResponse
    from django.utils import timezone
    import uuid

    # Build target URL
    # endpoint.endpoint_url is the base (e.g., "https://example.com/scp/")
    # path is relative to that base (e.g., "dashboard.php" or "scp/dashboard.php")
    base_url = endpoint.endpoint_url.rstrip('/')
    if path:
        clean_path = path.lstrip('/')
        # Simple concatenation - base_url already includes the full path prefix
        # e.g., base_url = "https://example.com/scp/", path = "dashboard.php"
        # Result: "https://example.com/scp/dashboard.php"
        target_url = f"{base_url}/{clean_path}"
    else:
        target_url = base_url

    # Reduced logging - only log when debugging
    # print(f"[POLYSNIFFER PROXY] Base URL: {base_url}", flush=True)
    # print(f"[POLYSNIFFER PROXY] Path: {path}", flush=True)
    # print(f"[POLYSNIFFER PROXY] Target URL: {target_url}", flush=True)

    # Add query string if present
    if request.GET:
        query_string = request.GET.urlencode()
        separator = '&' if '?' in target_url else '?'
        target_url = f"{target_url}{separator}{query_string}"

    # Prepare request headers - clean and forward only necessary ones
