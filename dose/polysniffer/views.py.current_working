@staff_member_required
def export_har(request, log_id=None):
    """
    Export traffic log(s) as HAR file
    Staff access required
    """
    if not request.user.is_staff:
        return JsonResponse({'error': 'Staff access required'}, status=403)

    if log_id:
        logs = [get_object_or_404(TrafficLog, id=log_id)]
    else:
        logs = TrafficLog.objects.all().order_by('-timestamp')[:100]

    # Build HAR structure
    har = {
        'log': {
            'version': '1.2',
            'creator': {'name': 'PolySniffer', 'version': '1.0'},
            'entries': []
        }
    }

    for log in logs:
        entry = {
            'startedDateTime': log.timestamp.isoformat(),
            'time': log.duration_ms,
            'request': {
                'method': log.method,
                'url': log.url,
                'httpVersion': 'HTTP/1.1',
                'headers': [{'name': k, 'value': v} for k, v in log.headers.items()],
                'queryString': [{'name': k, 'value': v} for k, v in log.query_params.items()],
                'postData': {'text': log.body} if log.body else None,
            },
            'response': {
                'status': log.status_code,
                'statusText': 'OK' if log.status_code == 200 else 'Error',
                'httpVersion': 'HTTP/1.1',
                'headers': [{'name': k, 'value': v} for k, v in log.response_headers.items()],
                'content': {
                    'size': log.response_size,
                    'mimeType': log.response_headers.get('Content-Type', 'text/html'),
                    'text': log.response_body[:10000]  # Limit size
                }
            }
        }
        har['log']['entries'].append(entry)

    response = HttpResponse(
        json.dumps(har, indent=2),
        content_type='application/json'
    )
    response['Content-Disposition'] = f'attachment; filename="polysniffer-export-{timezone.now().strftime("%Y%m%d-%H%M%S")}.har"'
    return response


