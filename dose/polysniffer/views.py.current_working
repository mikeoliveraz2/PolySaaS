        logger.error(f"[SILENT CAPTURE] Error: {e}", exc_info=True)
        print(traceback.format_exc(), flush=True)
        from django.http import JsonResponse
        return JsonResponse({'error': str(e)}, status=500)


@staff_member_required
@require_http_methods(["POST"])
def apply_latest_capture(request, endpoint_id):
    """
    Use Playwright to log in headlessly, grab fresh OSTSESSID, and save it.

    This is the primary method for auto-login to get past "access denied" errors.
    PolySniffer (bookmarklet approach) is kept for future debugging of new passthroughs.
    """
    import sys
    sys.stdout.write(f"\n{'='*80}\n")
    sys.stdout.write(f"[OSTICKET LOGIN] ===== FUNCTION CALLED =====\n")
    sys.stdout.write(f"[OSTICKET LOGIN] Endpoint ID: {endpoint_id}\n")
    sys.stdout.write(f"[OSTICKET LOGIN] User: {request.user.username if request.user else 'Anonymous'}\n")
    sys.stdout.write(f"[OSTICKET LOGIN] Method: {request.method}\n")
    sys.stdout.write(f"[OSTICKET LOGIN] Path: {request.path}\n")
    sys.stdout.write(f"{'='*80}\n")
    sys.stdout.flush()

    print(f"\n{'='*80}", flush=True)
    print(f"[OSTICKET LOGIN] ===== FUNCTION CALLED =====", flush=True)
    print(f"[OSTICKET LOGIN] Endpoint ID: {endpoint_id}", flush=True)
    print(f"[OSTICKET LOGIN] User: {request.user.username if request.user else 'Anonymous'}", flush=True)
    print(f"{'='*80}\n", flush=True)

    if not request.user.is_staff:
        print(f"[OSTICKET LOGIN] ERROR: Not staff user", flush=True)
        return JsonResponse({'success': False, 'error': 'Staff access required'}, status=403)

    try:
        # NOTE: For demo, using public schema endpoint. After meeting, fix to use tenant schema.
        # TODO: After meeting - ensure endpoint is in correct tenant schema
        endpoint = get_endpoint_any_schema(endpoint_id, request)
        print(f"[OSTICKET LOGIN] Endpoint found: {endpoint.endpoint_url}", flush=True)

        if not endpoint.endpoint_url:
            print(f"[OSTICKET LOGIN] ERROR: Endpoint URL not set", flush=True)
            return JsonResponse({'success': False, 'error': 'Endpoint URL not set'}, status=400)

        if not endpoint.auth_username or not endpoint.auth_password:
            print(f"[OSTICKET LOGIN] ERROR: Credentials not set", flush=True)
            return JsonResponse({
                'success': False,
                'error': 'Auto-login credentials not set. Please set "Auth Username" and "Auth Password" fields in the endpoint.'
            }, status=400)

        print(f"[OSTICKET LOGIN] Credentials found: username={endpoint.auth_username}", flush=True)

        # Build login URL - always construct full URL
        from urllib.parse import urlparse, urljoin

        print(f"[OSTICKET LOGIN] Building login URL from: {endpoint.endpoint_url}", flush=True)

        # If endpoint_url is relative, we need to extract base from it
        if endpoint.endpoint_url.startswith('http://') or endpoint.endpoint_url.startswith('https://'):
            # Full URL provided
            if '/scp/login.php' in endpoint.endpoint_url:
                login_url = endpoint.endpoint_url
            elif '/scp/' in endpoint.endpoint_url:
                # Extract base and construct login URL
                base_url = endpoint.endpoint_url.split('/scp/')[0].rstrip('/')
                login_url = f"{base_url}/scp/login.php"
            else:
                # Use endpoint_url as base
                base_url = endpoint.endpoint_url.rstrip('/')
                login_url = f"{base_url}/scp/login.php"
        else:
            # Relative path - need to construct from endpoint_url context
            # If endpoint_url is like /scp/login.php, we need the domain
            # Try to extract from any /scp/ pattern
            if '/scp/' in endpoint.endpoint_url:
                # This shouldn't happen if endpoint_url is relative, but handle it
                # Assume we need to get domain from somewhere - use a default or error
                print(f"[OSTICKET LOGIN] ERROR: Endpoint URL must be full URL", flush=True)
                return JsonResponse({
                    'success': False,
                    'error': 'Endpoint URL must be a full URL (starting with http:// or https://). Current: ' + endpoint.endpoint_url
                }, status=400)
            else:
                print(f"[OSTICKET LOGIN] ERROR: Cannot determine login URL", flush=True)
                return JsonResponse({
                    'success': False,
                    'error': 'Cannot determine login URL from endpoint URL. Please set endpoint URL to full URL like https://domain.com/scp/login.php'
                }, status=400)

        print(f"[OSTICKET LOGIN] Login URL: {login_url}", flush=True)

        # Use requests to log in (simpler than Playwright, works perfectly)
        # This matches exactly what the browser does: AJAX login with CSRF token
        import requests
        from bs4 import BeautifulSoup
        import logging
        import http.client as http_client

        # Enable verbose HTTP logging to see EXACTLY what's being sent
        http_client.HTTPConnection.debuglevel = 1
        logging.basicConfig()
        logging.getLogger().setLevel(logging.DEBUG)
        requests_log = logging.getLogger("requests.packages.urllib3")
        requests_log.setLevel(logging.DEBUG)
        requests_log.propagate = True

        session = requests.Session()
        session.headers.update({
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        })

        try:
            # 1. GET login page to get CSRF token
            print(f"[OSTICKET LOGIN] Getting login page: {login_url}")
            r = session.get(login_url, timeout=10)

            if r.status_code != 200:
                return JsonResponse({
                    'success': False,
                    'error': f"Can't reach login page: {r.status_code}"
                }, status=400)

            soup = BeautifulSoup(r.text, 'html.parser')
            csrf_input = soup.find("input", {"name": "__CSRFToken__"})

            if not csrf_input:
                return JsonResponse({
                    'success': False,
                    'error': "No CSRF token found – OSTicket version too old/new"
                }, status=400)

            csrf = csrf_input["value"]
            print(f"[OSTICKET LOGIN] Found CSRF token: {csrf[:20]}...")

            # 2. AJAX login – this is the exact payload the real browser sends
            payload = {
                "__CSRFToken__": csrf,
                "do": "scplogin",
                "userid": endpoint.auth_username,
                "passwd": endpoint.auth_password,
                "ajax": "1"
            }

            print(f"[OSTICKET LOGIN] Submitting AJAX login...")
            r2 = session.post(
                login_url,
                data=payload,
                headers={
                    "X-Requested-With": "XMLHttpRequest",
                    "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                    "Referer": login_url
                },
                timeout=10
            )

            if "success" not in r2.text.lower() and r2.status_code != 200:
                return JsonResponse({
                    'success': False,
                    'error': f"Login failed: {r2.text[:300]}"
                }, status=400)

            # 3. Grab the fresh session cookie (try both OSTSESSID and SSSESSID)
            cookies = session.cookies.get_dict()
            session_cookie_name = None
            session_cookie_value = None

            for cookie_name in ['OSTSESSID', 'SSSESSID']:
                if cookie_name in cookies:
                    session_cookie_name = cookie_name
                    session_cookie_value = cookies[cookie_name]
                    print(f"[OSTICKET LOGIN] Found session cookie: {session_cookie_name}")
                    break

            if not session_cookie_value:
                return JsonResponse({
                    'success': False,
                    'error': f"No {session_cookie_name or 'OSTSESSID/SSSESSID'} after login. Cookies: {list(cookies.keys())}"
                }, status=400)

            # 4. Save ALL cookies to endpoint.discovered_subpaths (for passthrough to use)
            if not endpoint.discovered_subpaths:
                endpoint.discovered_subpaths = {}
            endpoint.discovered_subpaths['cookies'] = cookies  # Save all cookies, not just session cookie
            print(f"[OSTICKET LOGIN] Saving cookies to discovered_subpaths: {list(cookies.keys())}", flush=True)

            # CRITICAL: Set ALL cookies in persistent session (not just session cookie)
            # OS Ticket might need all cookies (CSRF, etc.) not just the session cookie
            from dose.osticket_admin import get_osticket_session
            persistent_session = get_osticket_session()

            # Set ALL cookies from the login session into persistent session
            for cookie_name, cookie_value in cookies.items():
                persistent_session.cookies.set(cookie_name, cookie_value)
                print(f"[OSTICKET LOGIN] Set {cookie_name} in persistent session", flush=True)

            print(f"[OSTICKET LOGIN] All {len(cookies)} cookies set in persistent session", flush=True)

            print(f"[OSTICKET LOGIN] Cookie saved: {session_cookie_name}={session_cookie_value[:50]}...")
            print(f"[OSTICKET LOGIN] All cookies saved: {list(cookies.keys())}")

            # Update debug output
            endpoint.polysniffer_debug_output = json.dumps({
                'timestamp': timezone.now().isoformat(),
                'method': 'requests_ajax_login',
                'login_url': login_url,
                'cookies_captured': cookies,
                'session_cookie': session_cookie_name,
                'csrf_token': csrf,
                'message': f'Fresh {session_cookie_name} captured via AJAX login'
            }, indent=2)
            endpoint.polysniffer_last_run = timezone.now()
            endpoint.save()

            # CRITICAL: Verify save worked by refreshing from DB
            endpoint.refresh_from_db()
            saved_cookies = endpoint.discovered_subpaths.get('cookies', {}) if endpoint.discovered_subpaths else {}
            if saved_cookies:
                print(f"[OSTICKET LOGIN] ✓ Verified: Cookies saved to DB: {list(saved_cookies.keys())}", flush=True)
            else:
                print(f"[OSTICKET LOGIN] ✗ ERROR: Cookies NOT saved to DB! discovered_subpaths: {endpoint.discovered_subpaths}", flush=True)

        except Exception as e:
            import traceback
            traceback.print_exc()
            error_msg = f'AJAX login error: {str(e)}'
            print(f"[OSTICKET LOGIN ERROR] {error_msg}")
            endpoint.polysniffer_debug_output = json.dumps({
                'timestamp': timezone.now().isoformat(),
                'error': str(e),
                'message': 'AJAX login failed'
            }, indent=2)
            endpoint.polysniffer_last_run = timezone.now()
            endpoint.save()
            return JsonResponse({
                'success': False,
                'error': error_msg
            }, status=400)

        # CRITICAL: Set cookie in browser via Set-Cookie header
        # This ensures the browser has the cookie for subsequent passthrough requests
        response = JsonResponse({
            'success': True,
            'message': 'OSTicket fixed – refresh widget now',
            'cookie_captured': True,
            'cookie_name': session_cookie_name,
            'OSTSESSID': session_cookie_value
        })

        # Set cookie in browser so it's available for passthrough requests
        # Use the proxy path so browser sends it with requests to our passthrough
        from django.conf import settings
        proxy_path = f"/pt/admin/{endpoint.trigger_path}"

        # Set session cookie
        response.set_cookie(
            session_cookie_name,
            session_cookie_value,
            path=proxy_path,
            max_age=86400,  # 24 hours
            httponly=False,  # Allow JS to read (like osticket_admin_view)
            samesite='Lax'  # Match osticket_admin_view
        )

        # Also set CSRF token if available
        if "__CSRFToken__" in cookies:
            response.set_cookie(
                "__CSRFToken__",
                cookies["__CSRFToken__"],
                path=proxy_path,
                max_age=86400,
                httponly=False,
                samesite='Lax'
            )

        print(f"[OSTICKET LOGIN] Set {session_cookie_name} cookie in browser response (path={proxy_path})", flush=True)

        return response

    except Exception as e:
        import traceback
        traceback.print_exc()
        error_output = {
            'timestamp': timezone.now().isoformat(),
            'error': str(e),
            'message': 'An unexpected error occurred during Playwright auto-login.'
        }
        endpoint.polysniffer_debug_output = json.dumps(error_output, indent=2)
        endpoint.polysniffer_last_run = timezone.now()
        endpoint.save()
        return JsonResponse({
            'success': False,
            'error': f'Playwright error: {str(e)}. Debug info saved.',
            'debug_saved': True
        }, status=500)


