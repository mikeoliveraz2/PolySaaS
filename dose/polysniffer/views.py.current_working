def get_endpoint_any_schema(endpoint_id, request=None):
    """
    Find PassThroughEndpoint across all schemas (public + tenant schemas).
    This allows endpoints to be found regardless of which schema they're in.
    """
    from django.db import connection
    from dose.utils import get_current_tenant

    # Try current tenant schema first
    tenant = get_current_tenant(request) if request else None
    if tenant and tenant.schema_name:
        try:
            with connection.cursor() as cursor:
                cursor.execute(f"SET search_path TO {tenant.schema_name},public;")
                endpoint = PassThroughEndpoint.objects.filter(id=endpoint_id).first()
                if endpoint:
                    return endpoint
        except Exception:
            pass

    # Try public schema
    try:
        with connection.cursor() as cursor:
            cursor.execute("SET search_path TO public;")
            endpoint = PassThroughEndpoint.objects.filter(id=endpoint_id).first()
            if endpoint:
                return endpoint
    except Exception:
        pass

    # Try all tenant schemas
    try:
        from dose.models.tenant import Tenant
        with connection.cursor() as cursor:
            tenants = Tenant.objects.all()
            for tenant_obj in tenants:
                if tenant_obj.schema_name:
                    try:
                        cursor.execute(f"SET search_path TO {tenant_obj.schema_name},public;")
                        endpoint = PassThroughEndpoint.objects.filter(id=endpoint_id).first()
                        if endpoint:
                            return endpoint
                    except Exception:
                        continue
    except Exception:
        pass

    # Not found in any schema
    from django.http import Http404
    raise Http404(f"PassThroughEndpoint with id={endpoint_id} does not exist")


