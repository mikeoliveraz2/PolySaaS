"""
Build ``admin_home_links`` for ``custom_sidebar.html``: data records first, DB after.
"""

from __future__ import annotations

import re
from typing import Any

from django.db import connection
from django.urls import NoReverseMatch, reverse

from dose.data.admin_home_sidebar_records import (
    ADMIN_HOME_EXTENSION_PANEL_TITLE,
    ADMIN_HOME_SIDEBAR_BASE_RECORDS,
)


def _admin_path_for_matching(request) -> str:
    """Path used for admin-prefix checks and active states (``path_info`` or ``path``, no query)."""
    for raw in (getattr(request, "path_info", None), getattr(request, "path", None)):
        if raw:
            return raw.split("?", 1)[0]
    return ""


# Match ``/admin``, ``/admin/...``, locale-prefixed ``/en/admin/...``, passthrough ``/pt/admin/...``.
_ADMIN_PATH_RE = re.compile(r"(?:^|/)admin(?:/|$)")


def _is_admin_shell_path(path: str) -> bool:
    if not path:
        return False
    p = path.split("?", 1)[0]
    if p == "/admin" or p == "/admin/" or p.startswith("/admin/"):
        return True
    return bool(_ADMIN_PATH_RE.search(p))


def _materialize_base_records(path_info: str) -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []
    for rec in ADMIN_HOME_SIDEBAR_BASE_RECORDS:
        try:
            url = reverse(rec["url_reverse"])
        except NoReverseMatch:
            url = rec.get("url_static_fallback") or "#"
        exact = rec.get("active_path_exact")
        if exact:
            is_active = path_info in exact
        else:
            prefix = rec.get("active_path_prefix") or ""
            is_active = bool(prefix) and path_info.startswith(prefix)
        out.append(
            {
                "title": rec["title"],
                "url": url,
                "description": rec.get("description") or "",
                "icon_fa": rec["icon_fa"],
                "sidebar_exact": bool(rec.get("sidebar_exact")),
                "is_active": is_active,
            }
        )
    return out


def _navigation_item_to_home_link(item: Any, path_info: str) -> dict[str, Any]:
    """Map ``NavigationItem`` to the shape expected by ``custom_sidebar`` HOME links."""
    url = (item.url or "").strip() or "#"
    if item.icon_style == "fontawesome" and (item.icon_value or "").strip():
        icon_fa = item.icon_value.strip()
        if not icon_fa.startswith("fa"):
            icon_fa = f"fas {icon_fa}" if " " not in icon_fa else icon_fa
    else:
        icon_fa = "fas fa-link"
    norm = path_info.rstrip("/")
    u = url.split("?", 1)[0].rstrip("/")
    is_active = False
    if u and (path_info == u or norm == u or path_info.startswith(u + "/")):
        is_active = True
    return {
        "title": item.title,
        "url": url,
        "description": (item.description or "")[:500],
        "icon_fa": icon_fa,
        "sidebar_exact": False,
        "is_active": is_active,
    }


def _fetch_extension_items(request, tenant) -> list[dict[str, Any]]:
    """DB-backed HOME extras: ``NavigationPanel`` titled ``ADMIN_HOME_EXTENSION_PANEL_TITLE``."""
    if not tenant or not getattr(tenant, "schema_name", None):
        return []
    from dose.models import NavigationItem, NavigationPanel

    out: list[dict[str, Any]] = []
    path_info = _admin_path_for_matching(request)
    try:
        with connection.cursor() as cursor:
            cursor.execute(f'SET search_path TO "{tenant.schema_name}",public;')
        panel = NavigationPanel.objects.filter(
            tenant=tenant,
            is_active=True,
            title__iexact=ADMIN_HOME_EXTENSION_PANEL_TITLE,
        ).first()
        if not panel:
            return []
        items = list(
            NavigationItem.objects.filter(panel_id=panel.id, is_active=True).order_by(
                "sort_order", "id"
            )
        )
        for item in items:
            if item.has_permission(request.user):
                out.append(_navigation_item_to_home_link(item, path_info))
    except Exception:
        return []
    return out


def admin_home_extension_panel_title() -> str:
    return ADMIN_HOME_EXTENSION_PANEL_TITLE


def is_admin_home_extension_panel(title: str) -> bool:
    return (title or "").strip().casefold() == ADMIN_HOME_EXTENSION_PANEL_TITLE.casefold()


def ensure_admin_home_base_links_first(
    request,
    links: list[dict[str, Any]] | None,
) -> list[dict[str, Any]]:
    """
    On admin-shell requests, always place the two DATA records at the start of the list,
    then append any other links (e.g. from DB), deduped by ``url``.

    Call this right before returning context so ``[]`` from upstream logic is still
    replaced by Dashboard + PolySaaS AI when the path is an admin URL.
    """
    if not getattr(request, "user", None) or not request.user.is_authenticated:
        return list(links or [])
    path = _admin_path_for_matching(request)
    if not _is_admin_shell_path(path):
        return list(links or [])
    head = _materialize_base_records(path)
    tail = list(links or [])
    head_urls = {x["url"] for x in head}
    tail = [x for x in tail if (x or {}).get("url") not in head_urls]
    return head + tail


def build_admin_home_sidebar_links(request) -> list[dict[str, Any]]:
    """
    HOME sidebar links: **data** rows first, then optional **database** rows.

    Empty extension tables do not remove the base data rows.
    """
    user = getattr(request, "user", None)
    if not user or not user.is_authenticated:
        return []
    path_info = _admin_path_for_matching(request)
    if not _is_admin_shell_path(path_info):
        return []
    try:
        from dose.utils import get_current_tenant

        tenant = get_current_tenant(request)
        links = _materialize_base_records(path_info)
        links.extend(_fetch_extension_items(request, tenant))
        return links
    except Exception:
        return _materialize_base_records(path_info)
