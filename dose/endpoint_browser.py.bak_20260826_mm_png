from urllib.parse import urljoin, urlsplit, urlunsplit

from dose.passthrough.registry import resolve_handler_for_endpoint

_CANONICAL_APP_LABELS = (
    ("mattermost", "Mattermost"),
    ("nextcloud", "Nextcloud"),
    ("hubspot", "HubSpot"),
    ("dolibarr", "Dolibarr"),
    ("wordpress", "WordPress"),
    ("odoo", "Odoo"),
    ("slack", "Slack"),
    ("gmail", "Gmail"),
)

# Sidebar + endpoint-home marks (static/ relative paths for {% static %}).
_APP_LOGO_STATIC = {
    "odoo": "img/apps/odoo-sidebar-mark.svg",
    "mattermost": "img/apps/mattermost-sidebar-mark.png",
    "nextcloud": "img/apps/nextcloud-logo.svg",
    "hubspot": "img/apps/hubspot-sidebar-mark.png",
    "dolibarr": "img/apps/dolibarr-logo.svg",
    "wordpress": "img/apps/wordpress-logo.svg",
    "slack": "img/apps/slack-sidebar-mark.png",
}


def endpoint_app_label(endpoint) -> str:
    """Stable product name for Browse labels: Odoo, Mattermost, Slack, …"""
    slug = (getattr(endpoint, "slug", "") or "").strip().lower().replace("-", "_")
    host = (urlsplit(getattr(endpoint, "endpoint_url", "") or "").netloc or "").lower()
    title = ""
    if hasattr(endpoint, "get_menu_title"):
        try:
            title = (endpoint.get_menu_title() or "").strip()
        except Exception:
            title = (getattr(endpoint, "menu_title", "") or "").strip()
    else:
        title = (getattr(endpoint, "menu_title", "") or "").strip()
    blob = f"{slug} {title} {host}".lower()
    for key, label in _CANONICAL_APP_LABELS:
        if slug == key or key in blob:
            return label
    if title:
        first = title.split()[0]
        if first[:1].isupper():
            return first
        return title
    if host:
        return host.split(".")[0].title()
    return "app"


def endpoint_app_logo_key(endpoint) -> str:
    """Canonical key for logo lookup (odoo, slack, …) or empty."""
    slug = (getattr(endpoint, "slug", "") or "").strip().lower().replace("-", "_")
    label = endpoint_app_label(endpoint).strip().lower().replace(" ", "")
    for key, _label in _CANONICAL_APP_LABELS:
        if slug == key or key in label or key.replace("_", "") in label:
            return key
    if slug in _APP_LOGO_STATIC:
        return slug
    return ""


def endpoint_app_logo_static(endpoint) -> str:
    """Static path for the app mark, or empty when unknown."""
    return _APP_LOGO_STATIC.get(endpoint_app_logo_key(endpoint), "")


def logo_static_for_app_name(name: str) -> str:
    """Resolve logo path from a title/slug string (sidebar cards)."""
    blob = (name or "").strip().lower().replace("-", "_").replace(" ", "")
    for key, path in _APP_LOGO_STATIC.items():
        if key in blob or key.replace("_", "") in blob:
            return path
    return ""


def safe_browser_launch_url(endpoint, relative_path: str | None = None) -> str:
    """Return a top-level http(s) URL or an empty string for unsafe targets."""
    candidate = ""
    handler = resolve_handler_for_endpoint(endpoint)
    hook = getattr(handler, "endpoint_browser_launch_url", None)
    if callable(hook):
        try:
            candidate = hook(endpoint) or ""
        except Exception:
            candidate = ""
    if not candidate:
        candidate = getattr(endpoint, "endpoint_url", "") or ""

    parsed = urlsplit(candidate)
    if (
        parsed.scheme not in ("http", "https")
        or not parsed.hostname
        or parsed.username
        or parsed.password
    ):
        return ""

    base = urlunsplit((parsed.scheme, parsed.netloc, parsed.path or "/", parsed.query, ""))
    path = (relative_path or "").strip()
    if not path or path == "/":
        return base
    requested = urlsplit(path)
    if requested.scheme:
        if (
            requested.netloc.lower() != parsed.netloc.lower()
            or requested.username
            or requested.password
            or requested.scheme not in ("http", "https")
            or (requested.scheme == "http" and parsed.scheme != "http")
        ):
            return ""
        return urlunsplit(
            (
                requested.scheme,
                requested.netloc,
                requested.path or "/",
                requested.query,
                "",
            )
        )
    if not path.startswith("/") or path.startswith("//") or "\\" in path:
        return ""
    origin = urlunsplit((parsed.scheme, parsed.netloc, "/", "", ""))
    return urljoin(origin, path.lstrip("/"))


def _handler_prefers_top_level_browser(handler, endpoint) -> bool:
    if handler is None:
        return False
    hook = getattr(handler, "prefers_top_level_browser", None)
    if callable(hook):
        try:
            return bool(hook())
        except TypeError:
            try:
                return bool(hook(endpoint))
            except Exception:
                return False
        except Exception:
            return False
    wireframe = getattr(handler, "polysniffer_wireframe_context", None)
    if callable(wireframe):
        try:
            ctx = wireframe(endpoint) or {}
            return bool(ctx.get("enabled"))
        except Exception:
            return False
    return False


def _passthrough_browse_url(endpoint) -> str:
    """Passthrough Browse opens fullscreen in a new tab when possible."""
    passthrough = ""
    if hasattr(endpoint, "get_menu_url"):
        passthrough = endpoint.get_menu_url() or ""
    if not passthrough and hasattr(endpoint, "get_proxy_prefix"):
        passthrough = (endpoint.get_proxy_prefix() or "").rstrip("/") + "/"
    if not passthrough:
        return ""
    if "ps_fullscreen=" in passthrough:
        return passthrough
    sep = "&" if "?" in passthrough else "?"
    return f"{passthrough}{sep}ps_fullscreen=1"


def endpoint_browse_target(endpoint) -> dict:
    """Resolve Browse [app] for endpoint home.

    Always intended for a new tab/popup. URL depends on app type:

    - Passthrough-capable apps (Odoo, Mattermost, Nextcloud, …): `/pt/admin/…`
      with fullscreen so the embedded app fills the new tab.
    - Non-proxied SPAs (Slack, HubSpot, …): real vendor URL (dumb browser);
      consumers/messages stay on the endpoint home pane.
    """
    from dose.endpoint_actions import adapter_for_endpoint

    adapter = adapter_for_endpoint(endpoint)
    if adapter is not None:
        mode = (getattr(adapter, "browse_mode", "") or "").strip().lower()
        if mode == "external":
            url = safe_browser_launch_url(endpoint)
            return {"url": url, "external": True, "mode": "external", "new_tab": True}
        if mode == "passthrough":
            url = _passthrough_browse_url(endpoint)
            return {"url": url, "external": False, "mode": "passthrough", "new_tab": True}

    handler = resolve_handler_for_endpoint(endpoint)
    if _handler_prefers_top_level_browser(handler, endpoint):
        url = safe_browser_launch_url(endpoint)
        return {"url": url, "external": True, "mode": "external", "new_tab": True}

    passthrough = _passthrough_browse_url(endpoint)
    if passthrough:
        return {
            "url": passthrough,
            "external": False,
            "mode": "passthrough",
            "new_tab": True,
        }

    url = safe_browser_launch_url(endpoint)
    return {
        "url": url,
        "external": bool(url),
        "mode": "external" if url else "none",
        "new_tab": bool(url),
    }
