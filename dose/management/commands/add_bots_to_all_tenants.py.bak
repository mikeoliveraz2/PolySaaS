"""
Management command: Sync demo AI Peer bots to the shared Mattermost collaboration team.

AI peers (@copilot, @grok, @gemini) live on the shared team Town Square only.

Usage:
  python manage.py add_bots_to_all_tenants
  python manage.py add_bots_to_all_tenants --team-id=<id> --mm-url=<url>
"""

import logging

import requests
from django.conf import settings
from django.core.management.base import BaseCommand, CommandError

logger = logging.getLogger(__name__)


class Command(BaseCommand):
    help = "Add demo AI Peer bots to the shared Mattermost team Town Square."

    def add_arguments(self, parser):
        parser.add_argument(
            '--tenant',
            type=str,
            default=None,
            help='Ignored (runall.ps1 compatibility). Bots sync to shared team only.',
        )
        parser.add_argument(
            '--team-id',
            type=str,
            default=None,
            help='Specific MM team ID. Requires --mm-url as well.',
        )
        parser.add_argument(
            '--mm-url',
            type=str,
            default=None,
            help='Mattermost base URL. Required if --team-id is used.',
        )

    def handle(self, *args, **options):
        admin_token = getattr(settings, 'MATTERMOST_ADMIN_TOKEN', '')
        if not admin_token:
            raise CommandError('MATTERMOST_ADMIN_TOKEN not configured in settings.')

        headers = {'Authorization': f'Bearer {admin_token}'}

        if options.get('team_id') and options.get('mm_url'):
            mm_url = options['mm_url'].rstrip('/')
            team_id = options['team_id']
        else:
            from dose.services.mattermost_tenant_provisioner import (
                _get_mattermost_base_url,
                resolve_shared_mattermost_team_id,
            )

            mm_url = _get_mattermost_base_url()
            team_id = resolve_shared_mattermost_team_id(mm_url, headers) or ''
            if not team_id:
                raise CommandError(
                    'Shared Mattermost team not found. '
                    'Set MATTERMOST_SHARED_TEAM_NAME or pass --team-id and --mm-url.'
                )

        self._add_bots_to_team(mm_url, headers, team_id)
        from dose.services.mattermost_tenant_provisioner import (
            sync_mattermost_users_shared_team_landing,
        )

        self.stdout.write('Setting shared Town Square as default landing for MM users...')
        landing_stats = sync_mattermost_users_shared_team_landing(
            mm_url, headers, team_id, log=lambda m: self.stdout.write(m),
        )
        self.stdout.write(
            self.style.SUCCESS(
                f'Landing prefs: {landing_stats["updated"]} updated, '
                f'{landing_stats["skipped"]} skipped, {landing_stats["errors"]} errors'
            )
        )
        self.stdout.write(
            self.style.SUCCESS(f'OK Demo bots synced for shared team {team_id} at {mm_url}')
        )

    def _add_bots_to_team(self, mm_url: str, headers: dict, team_id: str) -> None:
        """Add demo peers to team and sync Town Square channel membership."""
        from dose.mattermost_bot.demo_roster import (
            DEMO_TOWN_SQUARE_USERNAMES,
            sync_town_square_demo_roster,
        )

        bot_usernames = list(DEMO_TOWN_SQUARE_USERNAMES)

        added, skipped, errors = [], [], []

        for bot_username in bot_usernames:
            try:
                r = requests.get(
                    f'{mm_url}/api/v4/users/username/{bot_username}',
                    headers=headers,
                    timeout=10,
                )
                if r.status_code != 200:
                    skipped.append(bot_username)
                    continue

                bot_user_id = r.json().get('id')
                if not bot_user_id:
                    skipped.append(bot_username)
                    continue

                r2 = requests.post(
                    f'{mm_url}/api/v4/teams/{team_id}/members',
                    headers=headers,
                    json={'team_id': team_id, 'user_id': bot_user_id},
                    timeout=10,
                )
                if r2.status_code in (200, 201) or 'already' in r2.text.lower():
                    added.append(bot_username)
                else:
                    errors.append(f'{bot_username}:{r2.status_code}')
            except Exception as exc:
                errors.append(f'{bot_username}:{exc}')

        sync_town_square_demo_roster(
            mm_url, headers, team_id, log=lambda m: self.stdout.write(m)
        )

        logger.info(
            'Demo bots synced: %s added=%s skipped=%s errors=%s',
            team_id,
            added,
            skipped,
            errors,
        )
