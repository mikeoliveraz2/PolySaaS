"""
OdooCustomerSyncService - Atomic service that receives customer data
from Pub/Sub (originating from another bundled app like Dolibarr) and
creates or updates the corresponding partner record in Odoo.

Triggered by MQQueueMonitor when a message arrives on topic:
  polysaas.dolibarr.customer.created
  polysaas.dolibarr.customer.updated
  (or any other *.customer.* topic)

The Instruction for this service should match:
  requestpath: /mq/polysaas.dolibarr.customer
  requestmethod: POST
  executescript: OdooCustomerSyncService
"""
import json
import logging
import datetime
import xmlrpc.client
from dose.services.atomic_service_base import AtomicServiceBase

logger = logging.getLogger(__name__)

ODOO_DEFAULTS = {
    "url": "http://localhost:8069",
    "db": "odoo",
    "username": "admin",
    "password": "admin",
}


class OdooCustomerSyncService(AtomicServiceBase):

    @staticmethod
    def get_parameters(parameters):
        key = 'OdooCustomerSyncService'
        if isinstance(parameters, dict):
            return parameters if parameters.get('MatchingKey') == key else None
        elif isinstance(parameters, list):
            return [
                p for p in parameters
                if (isinstance(p, dict) and p.get('MatchingKey') == key)
                or (hasattr(p, 'matchingKey') and getattr(p, 'matchingKey', None) == key)
            ]
        return None

    @staticmethod
    def execute_and_save(request, instruction_row):
        timestamp = datetime.datetime.now().isoformat()

        # Extract message data (comes from MQ mock request or direct request)
        message_data = getattr(request, 'mq_message_data', None)
        if not message_data:
            body = getattr(request, 'body', None)
            if body:
                if isinstance(body, bytes):
                    body = body.decode('utf-8', errors='replace')
                try:
                    message_data = json.loads(body) if isinstance(body, str) else body
                except (json.JSONDecodeError, TypeError):
                    message_data = {}

        if not message_data:
            logger.warning("[OdooCustomerSync] No message data received")
            return {"status": "error", "reason": "no_message_data"}

        # The message from EndpointDataExtractorService contains:
        # { "source_app": "dolibarr", "entity": "customer", "action": "created",
        #   "normalized_data": { "name": "...", "email": "...", ... },
        #   "raw_data": { ... original fields ... } }
        source_app = message_data.get("source_app", "unknown")
        entity = message_data.get("entity", "unknown")
        action = message_data.get("action", "unknown")
        normalized = message_data.get("normalized_data", {})
        raw_data = message_data.get("raw_data", {})

        logger.info(
            f"[OdooCustomerSync] Received {source_app}.{entity}.{action}: "
            f"{normalized.get('name', 'unknown')}"
        )

        if not normalized.get("name"):
            logger.warning("[OdooCustomerSync] No 'name' in normalized data, skipping")
            return {"status": "skipped", "reason": "missing_name", "data": normalized}

        # Get Odoo connection config from parameters or defaults
        odoo_config = OdooCustomerSyncService._get_odoo_config(request)

        # Map normalized data to Odoo partner fields (Mapping engine or hard-coded)
        partner_vals = OdooCustomerSyncService._map_with_engine_or_fallback(
            instruction_row, normalized, raw_data
        )

        result = OdooCustomerSyncService._sync_to_odoo(odoo_config, partner_vals, action)

        callback_data = {
            "service_name": "OdooCustomerSyncService",
            "execution_timestamp": timestamp,
            "source_app": source_app,
            "entity": entity,
            "action": action,
            "partner_vals": partner_vals,
            "odoo_result": result,
        }

        # Save to CallBackData
        try:
            if instruction_row and getattr(instruction_row, 'save_callbackdata', False):
                from dose.models import CallBackData
                tenant = getattr(request, 'tenant', None)
                CallBackData.objects.create(
                    tenant=tenant,
                    matchingEventKey=getattr(instruction_row, 'eventKey', None),
                    description=f"Synced {source_app} {entity} → Odoo partner: {partner_vals.get('name', 'N/A')}",
                    parameters_json=json.dumps(callback_data),
                    callbackdata=callback_data,
                )
        except Exception as e:
            logger.error(f"[OdooCustomerSync] Error saving CallBackData: {e}")

        # Notify via DoseMessage
        try:
            from dose.models import DoseMessage
            user = getattr(request, 'user', None)
            if user and hasattr(user, 'is_authenticated') and user.is_authenticated:
                DoseMessage.objects.create(
                    user=user,
                    message=f"Customer synced from {source_app} to Odoo: {partner_vals.get('name', 'N/A')}",
                    level="success",
                )
        except Exception as e:
            logger.warning(f"[OdooCustomerSync] Could not create DoseMessage: {e}")

        return callback_data

    @staticmethod
    def _get_odoo_config(request):
        """Get Odoo connection config from Parameters or PassThroughEndpoint."""
        config = dict(ODOO_DEFAULTS)

        try:
            from dose.models.pass_through_endpoint import PassThroughEndpoint
            odoo_ep = PassThroughEndpoint.objects.filter(
                trigger_path="odoo", is_enabled=True
            ).order_by("-id").first()
            if odoo_ep:
                config["url"] = odoo_ep.endpoint_url.rstrip('/')
                if odoo_ep.auth_username:
                    config["username"] = odoo_ep.auth_username
                if odoo_ep.auth_password:
                    config["password"] = odoo_ep.auth_password
        except Exception as e:
            logger.warning(f"[OdooCustomerSync] Could not load Odoo endpoint config: {e}")

        # Override from atomic parameters if available
        params = getattr(request, 'atomic_parameters', [])
        for p in params:
            val = getattr(p, 'parameterValue', None) or (p.get('parameterValue') if isinstance(p, dict) else None)
            key = getattr(p, 'parameterKey', None) or (p.get('parameterKey') if isinstance(p, dict) else None)
            if key and val:
                if key == 'odoo_url':
                    config["url"] = val
                elif key == 'odoo_db':
                    config["db"] = val
                elif key == 'odoo_username':
                    config["username"] = val
                elif key == 'odoo_password':
                    config["password"] = val

        return config

    @staticmethod
    def _map_with_engine_or_fallback(instruction_row, normalized, raw_data):
        """
        Try database-driven Mapping (NORMALIZED_TO_TARGET direction) first.
        Falls back to hard-coded _map_to_odoo_partner if no mappings exist.
        """
        if instruction_row:
            try:
                from dose.services.mapping_engine import (
                    apply_mappings_for_instruction,
                    build_context_from_payload,
                )
                from dose.models import InstructionMapping

                has_mappings = InstructionMapping.objects.filter(
                    instruction=instruction_row, enabled=True
                ).exists()

                if has_mappings:
                    context = build_context_from_payload(normalized)
                    context['raw'] = raw_data
                    mapped = apply_mappings_for_instruction(instruction_row, context)
                    if mapped:
                        logger.info(
                            f"[OdooCustomerSync] Used Mapping engine: "
                            f"{len(mapped)} fields -> Odoo"
                        )
                        return mapped
            except Exception as e:
                logger.warning(f"[OdooCustomerSync] Mapping engine error, falling back: {e}")

        return OdooCustomerSyncService._map_to_odoo_partner(normalized)

    @staticmethod
    def _map_to_odoo_partner(normalized):
        """Hard-coded fallback: map normalized entity data to Odoo res.partner fields."""
        partner = {
            "name": normalized.get("name", ""),
            "customer_rank": 1,
            "is_company": True,
        }

        field_mapping = {
            "email": "email",
            "phone": "phone",
            "address": "street",
            "zip": "zip",
            "town": "city",
        }

        for norm_field, odoo_field in field_mapping.items():
            if normalized.get(norm_field):
                partner[odoo_field] = normalized[norm_field]

        country_code = normalized.get("country_code")
        if country_code and isinstance(country_code, str):
            partner["_country_code"] = country_code

        return partner

    @staticmethod
    def _sync_to_odoo(config, partner_vals, action):
        """
        Create or update a partner in Odoo via XML-RPC.
        """
        url = config["url"]
        db = config["db"]
        username = config["username"]
        password = config["password"]

        try:
            # Authenticate
            common = xmlrpc.client.ServerProxy(f'{url}/xmlrpc/2/common')
            uid = common.authenticate(db, username, password, {})

            if not uid:
                logger.error("[OdooCustomerSync] Odoo authentication failed")
                return {"status": "auth_failed", "url": url, "db": db}

            models = xmlrpc.client.ServerProxy(f'{url}/xmlrpc/2/object')

            # Remove internal mapping fields
            vals = {k: v for k, v in partner_vals.items() if not k.startswith('_')}

            # Resolve country_code to country_id
            country_code = partner_vals.get("_country_code")
            if country_code:
                country_ids = models.execute_kw(
                    db, uid, password, 'res.country', 'search',
                    [[['code', '=', country_code.upper()]]]
                )
                if country_ids:
                    vals["country_id"] = country_ids[0]

            # Check if partner already exists (by email or name)
            existing_ids = []
            if vals.get("email"):
                existing_ids = models.execute_kw(
                    db, uid, password, 'res.partner', 'search',
                    [[['email', '=', vals['email']]]]
                )
            if not existing_ids and vals.get("name"):
                existing_ids = models.execute_kw(
                    db, uid, password, 'res.partner', 'search',
                    [[['name', '=', vals['name']]]]
                )

            if existing_ids:
                # Update existing partner
                models.execute_kw(
                    db, uid, password, 'res.partner', 'write',
                    [existing_ids, vals]
                )
                logger.info(f"[OdooCustomerSync] Updated Odoo partner id={existing_ids[0]}: {vals.get('name')}")
                return {
                    "status": "updated",
                    "partner_id": existing_ids[0],
                    "name": vals.get("name"),
                }
            else:
                # Create new partner
                new_id = models.execute_kw(
                    db, uid, password, 'res.partner', 'create',
                    [vals]
                )
                logger.info(f"[OdooCustomerSync] Created Odoo partner id={new_id}: {vals.get('name')}")
                return {
                    "status": "created",
                    "partner_id": new_id,
                    "name": vals.get("name"),
                }

        except ConnectionRefusedError:
            logger.error(f"[OdooCustomerSync] Could not connect to Odoo at {url}")
            return {"status": "connection_refused", "url": url}
        except Exception as e:
            logger.error(f"[OdooCustomerSync] Odoo sync error: {e}")
            return {"status": "error", "error": str(e)}
