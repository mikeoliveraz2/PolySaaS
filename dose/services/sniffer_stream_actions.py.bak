"""
Sniffer Stream Actions Service
-------------------------------
For every PassThroughEndpoint that has captured traffic (TrafficLog entries),
creates an Instruction + MQOutput for each unique POST path discovered.

Local RabbitMQ flow (Odoo-first / current primary):
  1. PolySniffer captures POST traffic → TrafficLog row.
  2. This service creates:
     - an Instruction (POST, path, executescript=EndpointDataExtractor)
     - an MQOutput (provider=rabbitmq; routing key template = action_path prefix)
  3. On a live passthrough POST, DoseRequestController matches the Instruction
     and runs EndpointDataExtractor.
  4. EndpointDataExtractor publishes to RabbitMQ with topic
     {action_path}.{username} (see dose.utils.mq_topic).
  5. Queue monitor / subscribers consume by routing key.

Topic naming convention (locked 2026-08-01):
  {action_path}.{username}
  e.g. instruction path "/odoo/contacts", user "pso13"
       → topic "odoo.contacts.pso13"
  MQOutput stores the action_path prefix; username is appended at publish time.
"""
import logging
from django.db import transaction
from urllib.parse import urlparse

from dose.utils.mq_topic import build_mq_topic, sanitize_action_path

logger = logging.getLogger(__name__)


def _topic_prefix(instruction_path: str) -> str:
    """Action-path segment only (username appended at publish time)."""
    return sanitize_action_path(instruction_path)


def _topic_name(instruction_path: str, username: str = "sniffer") -> str:
    """Full topic for eventKey / dry-run display."""
    return build_mq_topic(instruction_path, username)


def _set_schema(tenant):
    """Point the DB search_path at the tenant schema so TrafficLog is visible."""
    import re as _re
    from django.db import connection
    schema = tenant.schema_name if tenant and tenant.schema_name else "public"
    if not _re.match(r"^[a-zA-Z0-9_]+$", schema):
        raise ValueError(f"Invalid schema name: {schema!r}")
    with connection.cursor() as cur:
        cur.execute(f'SET search_path TO "{schema}", public;')


def _resolve_rabbitmq_defaults(tenant):
    """
    Look up the tenant's active RabbitMQ MQConfig to populate MQOutput
    connection defaults. Falls back to localhost guest/guest (runall stack).
    """
    from dose.models.mq_config import MQConfig
    cfg = MQConfig.objects.filter(
        tenant=tenant,
        provider="rabbitmq",
        is_active=True,
    ).first()
    if not cfg:
        cfg = MQConfig.objects.filter(
            provider="rabbitmq",
            is_active=True,
        ).first()
    if cfg:
        return {
            "rabbitmq_host": cfg.rabbitmq_host or "localhost",
            "rabbitmq_port": cfg.rabbitmq_port or 5672,
            "rabbitmq_username": cfg.rabbitmq_username or "guest",
            "rabbitmq_password": cfg.rabbitmq_password or "guest",
            "rabbitmq_vhost": cfg.rabbitmq_vhost or "/",
            "rabbitmq_exchange": cfg.rabbitmq_exchange or "polysaas.events",
            "rabbitmq_queue": cfg.rabbitmq_queue or "polysaas.events",
        }
    return {
        "rabbitmq_host": "localhost",
        "rabbitmq_port": 5672,
        "rabbitmq_username": "guest",
        "rabbitmq_password": "guest",
        "rabbitmq_vhost": "/",
        "rabbitmq_exchange": "polysaas.events",
        "rabbitmq_queue": "polysaas.events",
    }


def create_stream_actions_for_endpoint(endpoint, tenant, dry_run=False):
    """
    For a single PassThroughEndpoint, find all unique POST paths in TrafficLog
    and create (or update) one Instruction + one MQOutput per path.

    Returns a list of result dicts describing what was created/skipped.
    """
    from dose.polysniffer.models import TrafficLog
    from dose.models.instruction import Instruction
    from dose.models.mq_output import MQOutput

    _set_schema(tenant)

    trigger = (endpoint.trigger_path or "").strip("/") or str(endpoint.id)

    try:
        logs = list(
            TrafficLog.objects.filter(
                endpoint_name__icontains=trigger,
                method="POST",
            ).values_list("path", flat=True).distinct()
        )

        if not logs:
            parsed = urlparse(endpoint.endpoint_url)
            domain_fragment = parsed.netloc.split(":")[0]
            logs = list(
                TrafficLog.objects.filter(
                    url__icontains=domain_fragment,
                    method="POST",
                ).values_list("path", flat=True).distinct()
            )
    except Exception as e:
        logger.warning(f"TrafficLog query failed for {trigger}: {e}")
        return [{"endpoint": trigger, "status": "no_posts_found", "note": str(e)}]

    logs = list(dict.fromkeys(logs))

    results = []

    if not logs:
        return [{"endpoint": endpoint.trigger_path, "status": "no_posts_found"}]

    rabbit_defaults = _resolve_rabbitmq_defaults(tenant)

    for raw_path in logs:
        path = raw_path.strip() or "/"
        instruction_path = f"/{trigger}/{path.strip('/')}" if not path.startswith(f"/{trigger}") else path
        topic_prefix = _topic_prefix(instruction_path)
        topic = _topic_name(instruction_path, username="sniffer")

        if dry_run:
            results.append({
                "endpoint": trigger,
                "path": path,
                "topic": topic,
                "topic_prefix": topic_prefix,
                "instruction_path": instruction_path,
                "status": "dry_run",
            })
            continue

        with transaction.atomic():
            instruction, instr_created = Instruction.objects.get_or_create(
                tenant=tenant,
                requestpath=instruction_path,
                requestmethod="POST",
                defaults={
                    "eventKey": topic_prefix,
                    "description": f"Auto-generated from sniffer: {endpoint.get_menu_title()} POST {path}",
                    "direction": "REQ",
                    "executescript": "EndpointDataExtractor",
                    "appusername": "sniffer",
                    "urllist": endpoint.endpoint_url,
                    "save_callbackdata": True,
                },
            )

            mq_output, mq_created = MQOutput.objects.get_or_create(
                tenant=tenant,
                name=f"sniffer-{topic_prefix}"[:200],
                defaults={
                    "provider": "rabbitmq",
                    "is_active": True,
                    "instruction_path": instruction_path,
                    "rabbitmq_host": rabbit_defaults["rabbitmq_host"],
                    "rabbitmq_port": rabbit_defaults["rabbitmq_port"],
                    "rabbitmq_username": rabbit_defaults["rabbitmq_username"],
                    "rabbitmq_password": rabbit_defaults["rabbitmq_password"],
                    "rabbitmq_vhost": rabbit_defaults["rabbitmq_vhost"],
                    "rabbitmq_exchange": rabbit_defaults["rabbitmq_exchange"],
                    "rabbitmq_queue": rabbit_defaults["rabbitmq_queue"],
                    # Prefix only; EndpointDataExtractor appends .{username} at publish
                    "rabbitmq_routing_key": topic_prefix,
                    "message_format": "json",
                    "include_request_metadata": True,
                    "include_response_data": False,
                    "description": (
                        f"Auto-generated: publish {endpoint.get_menu_title()} "
                        f"POST {path} to RabbitMQ as '{{action_path}}.{{username}}' "
                        f"(prefix '{topic_prefix}')"
                    ),
                },
            )

        results.append({
            "endpoint": trigger,
            "path": path,
            "topic": topic,
            "instruction_path": instruction_path,
            "instruction_id": instruction.pk,
            "instruction_created": instr_created,
            "mq_output_id": mq_output.pk,
            "mq_output_created": mq_created,
            "status": "created" if (instr_created or mq_created) else "already_exists",
        })

    return results


def create_stream_actions_for_all_sniffed(tenant, dry_run=False):
    """
    Iterate over all PassThroughEndpoints that have TrafficLog data and
    call create_stream_actions_for_endpoint for each.

    Returns aggregated list of results.
    """
    from dose.models.pass_through_endpoint import PassThroughEndpoint
    from dose.polysniffer.models import TrafficLog

    _set_schema(tenant)

    try:
        sniffed_triggers = list(
            TrafficLog.objects.filter(method="POST")
            .values_list("endpoint_name", flat=True)
            .distinct()
        )
    except Exception as e:
        logger.warning(f"TrafficLog scan failed: {e}")
        sniffed_triggers = []

    endpoints = PassThroughEndpoint.objects.all()
    sniffed_lower = [(sn or "").lower() for sn in sniffed_triggers]
    matched = []
    for ep in endpoints:
        trigger = (ep.trigger_path or "").strip("/")
        if any(trigger and trigger.lower() in sn for sn in sniffed_lower):
            matched.append(ep)
        elif ep.endpoint_url:
            domain = urlparse(ep.endpoint_url).netloc.split(":")[0]
            if any(domain and domain.lower() in sn for sn in sniffed_lower):
                matched.append(ep)

    all_results = []
    for ep in matched:
        results = create_stream_actions_for_endpoint(ep, tenant, dry_run=dry_run)
        all_results.extend(results)

    if not all_results:
        all_results.append({"status": "no_sniffed_endpoints_found"})

    return all_results
