# dose/passthrough/incoming_path_rewrite.py
"""
Generic hook: handlers may rewrite request.path_info when the browser issues
native app URLs without /pt/admin/<trigger>/.

Middleware stays endpoint-agnostic; each handler implements
try_rewrite_incoming_path(request, endpoint) -> bool.
"""
import logging
from urllib.parse import urlparse

from dose.models import PassThroughEndpoint, UserTenantMembership
from dose.utils import get_current_tenant

logger = logging.getLogger(__name__)


def _handler_for_endpoint(endpoint, request):
    """Resolve passthrough handler from endpoint URL/slug (same rules as PT middleware)."""
    url = getattr(endpoint, 'endpoint_url', '') or ''
    host = urlparse(url).netloc.lower()
    slug = str(getattr(endpoint, 'slug', '') or '').lower()
    blob = f"{host} {slug}"

    if 'odoo' in blob:
        from dose.passthrough.handlers.odoo_handler import OdooPassthroughHandler
        return OdooPassthroughHandler()
    if 'mattermost' in blob:
        from dose.passthrough.handlers.mattermost_handler import MattermostPassthroughHandler
        return MattermostPassthroughHandler()
    if 'nextcloud' in blob:
        from dose.passthrough.handlers.nextcloud_handler import NextcloudPassthroughHandler
        return NextcloudPassthroughHandler()
    return None


def apply_incoming_path_rewrites(request) -> None:
    """
    Ask each enabled passthrough handler (in stable order) whether it wants to
    rewrite this request. First handler that returns True wins.

    Same auth/tenant/membership rules as ExternalPassthroughMiddleware for /pt/.
    """
    user = getattr(request, "user", None)
    if not user or not user.is_authenticated:
        return

    tenant = get_current_tenant(request)
    if not tenant:
        return

    if not request.user.is_superuser and not UserTenantMembership.objects.filter(
        user=request.user, tenant=tenant
    ).exists():
        return

    for endpoint in PassThroughEndpoint.objects.filter(is_enabled=True).order_by("id"):
        handler = _handler_for_endpoint(endpoint, request)
        if handler is None:
            continue
        fn = getattr(handler, "try_rewrite_incoming_path", None)
        if not callable(fn):
            continue
        try:
            if fn(request, endpoint):
                logger.debug(
                    "incoming_path_rewrite: %s handler rewrote to %s",
                    getattr(endpoint, 'slug', endpoint.pk),
                    request.path_info,
                )
                return
        except Exception:
            logger.exception(
                "incoming_path_rewrite failed for endpoint %s",
                getattr(endpoint, 'slug', endpoint.pk),
            )

    # Fallback when referer is an active passthrough embed but DB loop did not rewrite.
    path = request.path_info or ''
    if path.startswith('/pt/') or not path.startswith('/'):
        return
    ref = request.META.get('HTTP_REFERER', '') or ''
    import re
    m = re.search(r'(/pt/admin/[^/]+)', ref)
    if m and 'odoo' in m.group(1).lower() and (
        path.startswith('/odoo/') or path.startswith('/web/')
        or path.startswith('/bus/') or path.startswith('/mail/')
    ):
        request.path_info = m.group(1) + path
        print(f"[INCOMING REWRITE] referer fallback → {request.path_info}")
