    def _resolve_mm_endpoint_url(self, request, endpoint_url=None):
        """Best-effort Mattermost origin for token validation (handler-only)."""
        if endpoint_url:
            return (endpoint_url or '').rstrip('/')
        path = (getattr(request, 'path_info', '') or '').strip('/')
        parts = path.split('/')
        if len(parts) >= 3 and parts[0] == 'pt' and parts[1] == 'admin' and parts[2]:
            return f'https://{parts[2]}'
        return ''

    _MM_SESSION_COOKIE_NAMES = (
        'mmauthtoken',
        'MMAUTHTOKEN',
        'MMUSERID',
        'MMCSRF',
        'MMSESSIONID',
        'MMTEAMID',
    )

    def _mm_upstream_cookie_keys(self):
        return {n.lower() for n in self._MM_SESSION_COOKIE_NAMES}

    def _strip_mm_cookies_from_dict(self, cookies: dict) -> dict:
        drop = self._mm_upstream_cookie_keys()
        return {k: v for k, v in (cookies or {}).items() if k.lower() not in drop}

    def _is_fresh_sidebar_request(self, request) -> bool:
        return bool(getattr(request, '_mm_fresh_sidebar_entry', False))

    def _mark_fresh_sidebar_entry(self, request) -> None:
        request._mm_fresh_sidebar_entry = True

    _SIDEBAR_AUTH_SESSION_KEY = 'mm_sidebar_auth_token'
    _SIDEBAR_AUTH_TS_KEY = 'mm_sidebar_auth_token_ts'
    _SIDEBAR_AUTH_TTL_SEC = 120
    # After plugin auth, Mattermost SPA may hit root?redirect_to=… — do not wipe cookies again.
    _POST_SIDEBAR_GRACE_SEC = 90

    def _is_post_sidebar_auth_grace(self, request) -> bool:
        try:
            ts = float(request.session.get(self._SIDEBAR_AUTH_TS_KEY) or 0)
            if not ts:
                return False
            return (time.time() - ts) <= self._POST_SIDEBAR_GRACE_SEC
        except Exception:
            return False

    def _publish_sidebar_auth_token(self, request, token: str) -> None:
        """Make fresh plugin/login token visible to parallel passthrough requests (race window)."""
        if not token:
            return
        request._mm_sidebar_auth_token = token
        try:
            request.session[self._SIDEBAR_AUTH_SESSION_KEY] = token
            request.session[self._SIDEBAR_AUTH_TS_KEY] = time.time()
            request.session.modified = True
        except Exception as exc:
            logger.warning('[MM_AUTH] Could not store sidebar auth token in session: %s', exc)
        try:
            self._save_tenantapp_token(token, request)
            print(f'[MM_AUTH] Published sidebar auth token len={len(token)} (session + TenantApp)')
        except Exception as exc:
            print(f'[MM_AUTH] TenantApp token save failed: {exc}')

    def _get_sidebar_auth_token(self, request):
        """Token from the latest sidebar plugin/login, valid for a short TTL."""
        cached = (getattr(request, '_mm_sidebar_auth_token', None) or '').strip()
        if cached:
            return cached
        try:
            ts = float(request.session.get(self._SIDEBAR_AUTH_TS_KEY) or 0)
            if ts and (time.time() - ts) <= self._SIDEBAR_AUTH_TTL_SEC:
                tok = (request.session.get(self._SIDEBAR_AUTH_SESSION_KEY) or '').strip()
                if tok:
                    return tok
        except Exception:
            pass
        return ''

    def _is_fresh_sidebar_entry(self, request, proxy_prefix: str, path: str) -> bool:
        """True while handling sidebar fresh-login hop (cookies stripped, plugin-only auth)."""
        if request.method != 'GET' or path != proxy_prefix:
            return False
        if request.GET.get('mm_cleared') == '1':
            return True
        return bool(getattr(request, '_mm_fresh_sidebar_entry', False))

