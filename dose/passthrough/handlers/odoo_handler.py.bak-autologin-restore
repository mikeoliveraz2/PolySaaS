class OdooPassthroughHandler(PassthroughHandlerBase):
    """Odoo passthrough — all Odoo-specific routing/rewrite logic lives here only."""

    _DJANGO_COOKIE_NAMES = frozenset({
        "sessionid", "csrftoken",
        "messages", "django_language",
    })

    @classmethod
    def matches_endpoint(cls, endpoint) -> bool:
        """Discover Odoo endpoints by hostname."""
        url = (getattr(endpoint, 'endpoint_url', '') or '').lower()
        return 'odoo' in url

    def native_passthrough_prefixes(self):
        """Bare paths Odoo uses when the browser escapes the /pt/admin/<trigger>/ prefix."""
        return ("/web", "/odoo", "/apps", "/bus", "/websocket", "/longpolling")

    def needs_readable_response_body(self, request, target_url: str) -> bool:
        """We need readable body to rewrite asset URLs."""
        return True

    def should_follow_upstream_redirects(self, request, target_url: str, upstream_path: str) -> bool:
        """Follow GET redirect chains; POST must return to the browser for login flows."""
        follow = request.method != "POST"
        print(
            f"[ODOO HANDLER] should_follow_upstream_redirects: method={request.method}, "
            f"path={upstream_path}, follow={follow}"
        )
        return follow

    def filter_cookies_for_upstream(self, request, cookies: dict) -> dict:
        """Strip Django session/CSRF cookies — Odoo uses its own session_id."""
        filtered = {k: v for k, v in cookies.items() if k not in self._DJANGO_COOKIE_NAMES}
        removed = set(cookies) - set(filtered)
        if removed:
            print(f"[ODOO HANDLER] Filtered Django cookies from upstream request: {removed}")
        return filtered

    @staticmethod
    def _odoo_proxy_prefix_from_endpoint(endpoint) -> str:
        url = getattr(endpoint, 'endpoint_url', '') or ''
        parsed = urlparse(url)
        seg = parsed.netloc or 'odoo'
        return f"/pt/admin/{seg}"

    @staticmethod
    def _odoo_endpoint_is_odoo(endpoint) -> bool:
        slug = str(getattr(endpoint, 'slug', '') or '').lower()
        url = str(getattr(endpoint, 'endpoint_url', '') or '').lower()
        return slug == 'odoo' or 'odoo' in url

    @staticmethod
    def _odoo_root_path_should_proxy(path: str) -> bool:
        if not path or not path.startswith('/'):
            return False
        if path == '/web' or path.startswith('/web/'):
            return True
        if path == '/odoo' or path.startswith('/odoo/'):
            return True
        if path == '/apps' or path.startswith('/apps/'):
            return True
        for prefix in ('/bus/', '/mail/', '/longpolling/', '/website/', '/jsonrpc/'):
            if path.startswith(prefix):
                return True
        if path == '/websocket' or path.startswith('/websocket'):
            return True
        return False

    @staticmethod
    def _odoo_incoming_rewrite_confidence(request, proxy_prefix: str) -> bool:
        ref = request.META.get('HTTP_REFERER', '') or ''
        if proxy_prefix in ref:
            return True
        if request.COOKIES.get('session_id'):
            if ref and proxy_prefix not in ref and 'odoo' not in ref.lower():
                return False
            return True
        return False

    @classmethod
    def try_rewrite_incoming_path_referer_fallback(cls, request) -> bool:
        """
        Map bare /web/login POST (and similar) onto /pt/admin/<hostname>/… when the
        browser escaped the proxy prefix. Handler-only — no shared urlconf rules.
        """
        path = request.path_info or ''
        if path.startswith('/pt/') or not cls._odoo_root_path_should_proxy(path):
            return False
        ref = request.META.get('HTTP_REFERER', '') or ''
        m = re.search(r'(/pt/admin/[^/]+)', ref)
        if not m or 'odoo' not in m.group(1).lower():
            return False
        proxy_prefix = m.group(1)
        if not cls._odoo_incoming_rewrite_confidence(request, proxy_prefix):
            return False
        request.path_info = proxy_prefix + path
        print(f"[ODOO HANDLER] referer fallback rewrite → {request.path_info}")
        return True

    def try_rewrite_incoming_path(self, request, endpoint) -> bool:
        """Rewrite bare Odoo paths onto /pt/admin/<hostname>/… before urlconf routing."""
        if not self._odoo_endpoint_is_odoo(endpoint):
            return False

        proxy_prefix = self._odoo_proxy_prefix_from_endpoint(endpoint)
        path = request.path_info or ''

        if path.startswith('/pt/'):
            return False
        if not self._odoo_root_path_should_proxy(path):
            return False
        if not self._odoo_incoming_rewrite_confidence(request, proxy_prefix):
            return False

        request.path_info = proxy_prefix + path
        print(f"[ODOO HANDLER] bare path rewrite → {request.path_info}")
        return True

    def should_wrap_in_admin_template(self, request, upstream_path, **kwargs):
        """Force wrapping in admin template for Odoo HTML pages."""
        print(f"[ODOO HANDLER] should_wrap_in_admin_template: upstream_path={upstream_path}, status={kwargs.get('status_code')}, ct={kwargs.get('content_type')}")

        status = kwargs.get('status_code', 200)
        ct = (kwargs.get('content_type') or '').lower()

        if status != 200:
            print(f"[ODOO HANDLER] Not wrapping: status {status}")
            return False

        if 'text/html' not in ct and 'application/xhtml' not in ct:
            print(f"[ODOO HANDLER] Not wrapping: content_type {ct}")
            return False

        print(f"[ODOO HANDLER] Wrapping in admin template")
        return True

    def passthrough_embed_template_context(self, request, upstream_path, **kwargs):
        """Provide Odoo-specific template context including the body scope flag."""
        print(f"[ODOO HANDLER] Setting embed_enable_odoo_body_scope=True for template")
        return {
            'embed_enable_odoo_body_scope': True
        }

    def _get_tenantapp_extra_config(self, request=None):
        """Return extra_config dict for this tenant's Odoo TenantApp."""
        try:
            from dose.models import TenantApp
            tenant = getattr(request, 'tenant', None) if request else None
            tenant_id = tenant.pk if tenant else None

            if tenant_id:
                try:
                    ta = TenantApp.objects.filter(
                        app_name='odoo',
                        tenant_id=tenant_id,
                        status='active'
                    ).exclude(extra_config={}).first()
                    if ta and ta.extra_config:
                        print(f"[ODOO HANDLER] extra_config found for tenant={tenant} keys={list(ta.extra_config.keys())}")
                        return ta.extra_config
                except Exception as e:
                    print(f"[ODOO HANDLER] tenant query error: {e}")

            try:
                ta = TenantApp.objects.filter(
                    app_name='odoo',
                    status='active'
                ).exclude(extra_config={}).first()
                if ta and ta.extra_config:
                    print(f"[ODOO HANDLER] extra_config found via fallback keys={list(ta.extra_config.keys())}")
                    return ta.extra_config
            except Exception as e:
                print(f"[ODOO HANDLER] fallback query error: {e}")

            print(f"[ODOO HANDLER] extra_config NOT found")
        except Exception as exc:
            print(f"[ODOO HANDLER] _get_tenantapp_extra_config error: {exc}")
        return {}

