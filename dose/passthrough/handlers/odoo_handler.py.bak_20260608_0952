# dose/passthrough/handlers/odoo_handler.py
"""
Odoo SPA passthrough handler.

Lessons applied directly from the Mattermost 26-hour debug session:
  BUG1  HTTP_COOKIE never forwarded as header — use cookies= param only
  BUG2  HTTP_ prefix stripped from all outbound headers (fixed in forwarding.py)
  BUG3  Browser session_id takes priority over server-cached token
  BUG4  Set-Cookie forwarded by forwarding.py automatically
  BUG7  CSP stripped (both meta tag and response header)
  BUG8  <base> tag stripped
  BUG9  API calls route through proxy; statics direct to upstream
  BUG10 Navigation lock on hard-nav only, not history.*
"""

import json
import logging
import re
import time
import requests
from urllib.parse import urlparse

logger = logging.getLogger(__name__)

# Visible stamp used in all root logs (latest pattern)
ODOO_HANDLER_VERSION = "v1-2026-06-root-redirect"

# Odoo display-shell fetch/XHR/SW runtime lives in templates/admin/display.html extrajs
# (end of body) so it runs after Jazzmin sync scripts and before deferred Odoo modules.

def _odoo_upstream_bypasses_display_shell(upstream_subpath: str) -> bool:
    """
    If True, try_root_display_shell_response returns None so the request is
    forwarded to Odoo (JSON/binary/assets). Never use startswith('/web') alone —
    it would false-match /website, /websocket, etc.
    """
    u = upstream_subpath or ""
    # /web exact = Odoo app home after login redirect — must go through display shell, not be bypassed.
    # /web/login = login form — must go through display shell for SSO credential injection.
    # /web/ subdpaths (assets, datasets, actions, binary, session) are API/asset calls → bypass.
    if u.startswith("/web/") and u != "/web/login":
        return True
    if u == "/website" or u.startswith("/website/"):
        return True
    if u == "/bus" or u.startswith("/bus/"):
        return True
    if u == "/jsonrpc" or u.startswith("/jsonrpc/"):
        return True
    if u.startswith("/json/"):
        return True
    if u == "/longpolling" or u.startswith("/longpolling/"):
        return True
    if u == "/websocket" or u.startswith("/websocket/"):
        return True
    if u == "/mail" or u.startswith("/mail/"):
        return True
    return False


class OdooPassthroughHandler:

    def native_passthrough_prefixes(self):
        return ("/web", "/odoo", "/bus", "/websocket", "/longpolling")

    def should_exempt_csrf_for_path(self, path_info: str) -> bool:
        """
        Safety net: exempt native Odoo paths from Django CSRF.
        The client-side shim rewrites form actions to go through /pt/, but if it
        fails (timing, Owl re-render), the POST lands here without a Django CSRF
        token. Exempting these paths prevents a confusing 403 — the request will
        either be forwarded by ExternalPassthroughMiddleware or 404 via urlconf.
        """
        for prefix in self.native_passthrough_prefixes():
            if path_info == prefix or path_info.startswith(prefix + "/"):
                return True
        return False

    def should_follow_upstream_redirects(self, request, target_url: str, upstream_path: str) -> bool:
        """Follow GET redirect chains (e.g. login page) but NOT POST — the browser must
        receive the post-login 3xx so it navigates to the correct proxied URL."""
        return request.method != "POST"

    # ------------------------------------------------------------------
    # Incoming path rewrite (called by incoming_path_rewrite.apply_incoming_path_rewrites)
    # ------------------------------------------------------------------

    @staticmethod
    def _odoo_proxy_prefix_from_endpoint(endpoint) -> str:
        url = getattr(endpoint, 'endpoint_url', '') or ''
        parsed = urlparse(url)
        seg = parsed.netloc or 'odoo'
        return f"/pt/admin/{seg}"

    @staticmethod
    def _odoo_endpoint_is_odoo(endpoint) -> bool:
        slug = str(getattr(endpoint, 'slug', '') or '').lower()
        url = str(getattr(endpoint, 'endpoint_url', '') or '').lower()
        return slug == 'odoo' or 'odoo' in url

    @classmethod
    def matches_endpoint(cls, endpoint) -> bool:
        return cls._odoo_endpoint_is_odoo(endpoint)

    def should_process_html_response(
        self,
        request,
        upstream_path: str,
        *,
        content_type=None,
        status_code=200,
    ) -> bool:
        if status_code != 200:
            return False
        ct = (content_type or "").lower()
        if "text/html" not in ct and "application/xhtml" not in ct:
            return False
        if _odoo_upstream_bypasses_display_shell(upstream_path or "/"):
            return False
        return True

    def should_wrap_in_admin_template(
        self,
        request,
        upstream_path: str,
        *,
        content_type=None,
        status_code=200,
    ) -> bool:
        return self.should_process_html_response(
            request,
            upstream_path,
            content_type=content_type,
            status_code=status_code,
        )

    @classmethod
    def try_rewrite_incoming_path_referer_fallback(cls, request) -> bool:
        """
        Odoo-only: bare /web/, /odoo/, etc. with referer from an Odoo passthrough embed.
        Lives here so shared incoming_path_rewrite stays endpoint-agnostic.
        """
        path = request.path_info or ''
        if path.startswith('/pt/') or not path.startswith('/'):
            return False
        if not cls._odoo_root_path_should_proxy(path):
            return False
        ref = request.META.get('HTTP_REFERER', '') or ''
        m = re.search(r'(/pt/admin/[^/]+)', ref)
        if not m or 'odoo' not in m.group(1).lower():
            return False
        proxy_prefix = m.group(1)
        if not cls._odoo_incoming_rewrite_confidence(request, proxy_prefix):
            return False
        request.path_info = proxy_prefix + path
        print(f"[ODOO HANDLER] referer fallback → {request.path_info}")
        return True

    def passthrough_embed_template_context(self, trigger, request):
        from django.utils.safestring import mark_safe
        norm = trigger.strip('/')
        # Override embed_body with a clean SPA mount target only.
        # Odoo is an Owl SPA — it boots from embed_head scripts and renders client-side.
        # The static Odoo body HTML placed inside a nested <div> renders its <script>
        # source as visible background text — this eliminates that entirely.
        return {
            'embed_enable_odoo_body_scope': True,
            'embed_body': mark_safe(
                f'<div class="polysaas-passthrough-scope" data-polysaas-embed-trigger="{norm}">'
                f'<div id="wrapwrap" class="o_web_client" style="width:100%;height:100%;"></div>'
                f'</div>'
            ),
        }

    def fallback_rewrite_html_for_proxy(self, html: str, request) -> str:
        """Forwarder safety net: rewrite escaped root-relative Odoo paths in HTML bodies."""
        if not html:
            return html
        path = (getattr(request, "path_info", "") or "").strip()
        parts = path.strip("/").split("/") if path else []
        if len(parts) < 3 or parts[0] != "pt" or parts[1] != "admin":
            return html
        if not self.matches_endpoint(type("_E", (), {
            "endpoint_url": f"https://{parts[2]}",
            "slug": parts[2],
            "trigger_path": parts[2],
        })()):
            return html

        proxy_prefix = f"/pt/admin/{parts[2]}"
        out = html
        rewrite_count = 0

        def _apply_pairs(text: str, pairs):
            local_count = 0
            out_text = text
            for old, new in pairs:
                hits = out_text.count(old)
                if hits:
                    out_text = out_text.replace(old, new)
                    local_count += hits
            return out_text, local_count

        quoted_pairs = (
            ('"/web/', f'"{proxy_prefix}/web/'),
            ("'/web/", f"'{proxy_prefix}/web/"),
            ('"/web?', f'"{proxy_prefix}/web?'),
            ("'/web?", f"'{proxy_prefix}/web?"),
            ('"/website/', f'"{proxy_prefix}/website/'),
            ("'/website/", f"'{proxy_prefix}/website/"),
            ('"/odoo/', f'"{proxy_prefix}/odoo/'),
            ("'/odoo/", f"'{proxy_prefix}/odoo/"),
            ('"/bus/', f'"{proxy_prefix}/bus/'),
            ("'/bus/", f"'{proxy_prefix}/bus/"),
            ('"/websocket', f'"{proxy_prefix}/websocket'),
            ("'/websocket", f"'{proxy_prefix}/websocket"),
            ('"/longpolling/', f'"{proxy_prefix}/longpolling/'),
            ("'/longpolling/", f"'{proxy_prefix}/longpolling/"),
            ('"/jsonrpc', f'"{proxy_prefix}/jsonrpc'),
            ("'/jsonrpc", f"'{proxy_prefix}/jsonrpc"),
        )
        out, applied = _apply_pairs(out, quoted_pairs)
        rewrite_count += applied

        public_host = request.get_host().strip().lower()
        if public_host:
            for scheme in ("http", "https"):
                base = f"{scheme}://{public_host}"
                abs_pairs = (
                    (f"{base}/web/", f"{base}{proxy_prefix}/web/"),
                    (f"{base}/web?", f"{base}{proxy_prefix}/web?"),
                    (f"{base}/website/", f"{base}{proxy_prefix}/website/"),
                    (f"{base}/odoo/", f"{base}{proxy_prefix}/odoo/"),
                    (f"{base}/bus/", f"{base}{proxy_prefix}/bus/"),
                    (f"{base}/websocket", f"{base}{proxy_prefix}/websocket"),
                    (f"{base}/longpolling/", f"{base}{proxy_prefix}/longpolling/"),
                    (f"{base}/jsonrpc", f"{base}{proxy_prefix}/jsonrpc"),
                )
                out, applied = _apply_pairs(out, abs_pairs)
                rewrite_count += applied

            base_proto_relative = f"//{public_host}"
            proto_pairs = (
                (f"{base_proto_relative}/web/", f"{base_proto_relative}{proxy_prefix}/web/"),
                (f"{base_proto_relative}/web?", f"{base_proto_relative}{proxy_prefix}/web?"),
                (f"{base_proto_relative}/website/", f"{base_proto_relative}{proxy_prefix}/website/"),
                (f"{base_proto_relative}/odoo/", f"{base_proto_relative}{proxy_prefix}/odoo/"),
                (f"{base_proto_relative}/bus/", f"{base_proto_relative}{proxy_prefix}/bus/"),
                (f"{base_proto_relative}/websocket", f"{base_proto_relative}{proxy_prefix}/websocket"),
                (f"{base_proto_relative}/longpolling/", f"{base_proto_relative}{proxy_prefix}/longpolling/"),
                (f"{base_proto_relative}/jsonrpc", f"{base_proto_relative}{proxy_prefix}/jsonrpc"),
            )
            out, applied = _apply_pairs(out, proto_pairs)
            rewrite_count += applied

        if rewrite_count:
            print(
                f"[ODOO HANDLER] fallback_rewrite_html_for_proxy: {rewrite_count} refs "
                f"for {parts[2]}"
            )
        return out

    @staticmethod
    def _odoo_incoming_rewrite_confidence(request, proxy_prefix: str) -> bool:
        ref = request.META.get('HTTP_REFERER', '') or ''
        if proxy_prefix in ref:
            return True
        if request.COOKIES.get('session_id'):
            # Odoo session_id persists after navigating to Mattermost — do not rewrite
            # bare /web/, /websocket/, etc. when the referer is another passthrough app.
            if ref and proxy_prefix not in ref and 'odoo' not in ref.lower():
                return False
            return True
        return False

    @staticmethod
    def _odoo_root_path_should_proxy(path: str) -> bool:
        if not path or not path.startswith('/'):
            return False
        if path == '/web' or path.startswith('/web/'):
            return True
        if path == '/odoo' or path.startswith('/odoo/'):
            return True
        for prefix in ('/bus/', '/mail/', '/longpolling/', '/website/', '/jsonrpc/'):
            if path.startswith(prefix):
                return True
        if path == '/websocket' or path.startswith('/websocket'):
            return True
        return False

    def try_rewrite_incoming_path(self, request, endpoint) -> bool:
        """
        Map bare /odoo/…, /web/…, etc. onto /pt/admin/<hostname>/… when the browser
        escaped the proxy prefix (Odoo SPA pushState or direct navigation).
        """
        if not self._odoo_endpoint_is_odoo(endpoint):
            return False

        proxy_prefix = self._odoo_proxy_prefix_from_endpoint(endpoint)
        path = request.path_info or ''

        if path.startswith('/pt/'):
            return False
        if not self._odoo_root_path_should_proxy(path):
            return False
        if not self._odoo_incoming_rewrite_confidence(request, proxy_prefix):
            return False

        request.path_info = proxy_prefix + path
        print(f"[ODOO HANDLER] bare path rewrite → {request.path_info}")
        return True

    # Django-owned cookies that must never be forwarded to Odoo.
    # NOTE: 'session_id' is Odoo's session cookie — do NOT include it here.
    # 'sessionid' (no underscore) is Django's session cookie.
    _DJANGO_COOKIE_NAMES = frozenset({
        "sessionid", "csrftoken",
        "messages", "django_language",
    })

    def filter_cookies_for_upstream(self, request, cookies: dict) -> dict:
        """Remove Django session/CSRF cookies so Odoo uses its own session context."""
        filtered = {k: v for k, v in cookies.items() if k not in self._DJANGO_COOKIE_NAMES}
        removed = set(cookies) - set(filtered)
        if removed:
            print(f"[ODOO HANDLER] Filtered Django cookies from upstream request: {removed}")
        return filtered

    # Thread-local cache: stores (session_id, csrf_token) fetched from a fresh GET /web/login
    _fresh_login_session: dict = {}

    def _fetch_fresh_login_session(self, odoo_base_url: str, tenant_session_id: str = None) -> tuple:
        """
        Do a server-side GET /web/login to Odoo and return (session_id, csrf_token).
        Uses the tenant's cached session_id so the csrf_token MATCHES the session.
        Caches result for 5 minutes.
        """
        import time as _time
        cache_key = odoo_base_url
        cached = self._fresh_login_session.get(cache_key, {})
        if cached and (_time.time() - cached.get("ts", 0) < 300):
            print(f"[ODOO HANDLER] Using cached fresh login session for {odoo_base_url}")
            return cached["session_id"], cached["csrf_token"]

        try:
            import requests as _req
            cookies = {}
            if tenant_session_id:
                cookies['session_id'] = tenant_session_id
                print(f"[ODOO HANDLER] Fetching login page with tenant session_id")
            resp = _req.get(
                f"{odoo_base_url}/web/login",
                allow_redirects=True,
                timeout=15,
                cookies=cookies,
            )
            # Prefer the session we sent; if Odoo rotated it, use the new one
            session_id = resp.cookies.get("session_id") or tenant_session_id
            csrf_token = None
            if resp.status_code == 200 and resp.text:
                m = re.search(
                    r'<input[^>]+name=["\']csrf_token["\'][^>]+value=["\']([^"\']+)["\']',
                    resp.text,
                    re.IGNORECASE,
                )
                if not m:
                    m = re.search(
                        r'csrf_token["\s]*:["\s]*["\']([a-f0-9]+o\d+)["\']',
                        resp.text,
                    )
                if m:
                    csrf_token = m.group(1)
            if session_id and csrf_token:
                self._fresh_login_session[cache_key] = {
                    "session_id": session_id,
                    "csrf_token": csrf_token,
                    "ts": _time.time(),
                }
                print(f"[ODOO HANDLER] Fetched fresh login session: session_id=<redacted>, csrf_token={csrf_token[:16]}...")
                return session_id, csrf_token
            else:
                print(f"[ODOO HANDLER] _fetch_fresh_login_session: status={resp.status_code} session_id={bool(session_id)} csrf={bool(csrf_token)}")
        except Exception as exc:
            print(f"[ODOO HANDLER] _fetch_fresh_login_session failed: {exc}")
        return None, None

    def override_upstream_cookies(self, request, target_url: str):
        """Always inject a fresh server-side session_id so Odoo never sees a stale
        browser cookie.  get_upstream_cookies has a 30-min TTL cache so this is cheap."""
        try:
            cookies = self.get_upstream_cookies(request)
            if cookies.get('session_id'):
                had = bool(request.COOKIES.get('session_id'))
                print(f"[ODOO HANDLER] override_upstream_cookies: injecting fresh session_id (browser had={'yes' if had else 'no'})")
                return cookies
        except Exception as exc:
            print(f"[ODOO HANDLER] override_upstream_cookies failed: {exc}")
        return {}

    def get_request_body(self, request, target_url: str):
        """Pass login POST body through unchanged.
        The browser csrf_token is paired with its own session; replacing it with
        a server-fetched token from a different session causes Odoo 400."""
        return None

    def augment_outbound_headers(self, request, headers: dict, target_url: str) -> None:
        """
        Every Odoo upstream call (including display-shell HTML fetch) must see proxy headers
        so generated asset URLs and web.base.url logic match the browser-facing PolySaaS host.
        """
        if not target_url:
            return
        parsed = urlparse(target_url)
        if not parsed.netloc:
            return
        headers["Host"] = parsed.netloc
        headers["X-Forwarded-For"] = request.META.get("REMOTE_ADDR", "")
        headers["X-Forwarded-Proto"] = "https" if request.is_secure() else "http"
        headers["X-Forwarded-Host"] = parsed.netloc
        try:
            headers["X-Forwarded-Port"] = str(request.get_port())
        except Exception:
            headers["X-Forwarded-Port"] = "443" if request.is_secure() else "80"
        headers.pop("Referer", None)

    def upstream_url_for_subpath(self, endpoint_url, clean_path):
        """
        Initial HTML (path /): use the full configured endpoint_url (e.g. .../web/login).
        All other upstream paths: only scheme://netloc + path so assets and RPC never stack
        onto the login (or other entry) path from endpoint_url.
        """
        if not endpoint_url:
            return None
        parsed = urlparse(endpoint_url)
        base = f"{parsed.scheme}://{parsed.netloc}"
        if clean_path in ("/", ""):
            # Always send root to /web/login — bare / serves the DB manager when no session exists
            return base.rstrip("/") + "/web/login"
        return base.rstrip("/") + clean_path

    def try_root_display_shell_response(
        self,
        request,
        endpoint,
        url_trigger_segment,
        fetch_upstream_shell: bool = False,
        **kwargs,
    ):
        """
        Latest pattern (matching Mattermost frozen handler).
        - Bare proxy root (or root + /) → redirect to /web (main Odoo dashboard).
        - When fetch_upstream_shell=True: fetch the real upstream /web shell
          server-side (authenticated) and return it wrapped.
        - Everything else → return None so normal forwarder path is used.
        Root-originating responses are wrapped via _wrap_in_admin_template.
        """
        print(
            f"\n[ODOO HANDLER {ODOO_HANDLER_VERSION} ENTRY] "
            f"path={getattr(request, 'path_info', None)!r} "
            f"trigger={url_trigger_segment!r} method={getattr(request, 'method', None)} "
            f"fetch_upstream_shell={fetch_upstream_shell}"
        )

        if request.method != "GET":
            print(f"[ODOO HANDLER {ODOO_HANDLER_VERSION}] not GET → return None")
            return None

        # Derive proxy_prefix (support hostname triggers and simple slugs)
        raw_seg = (url_trigger_segment or "").strip("/")
        if "." in raw_seg:
            seg = raw_seg  # keep hostname verbatim (for URL rewrite consistency)
        else:
            seg = raw_seg.lower().split("/")[-1].replace("-", "_") or "odoo"

        proxy_prefix = f"/pt/admin/{seg}"
        path = (getattr(request, "path_info", "") or "").rstrip("/") or "/"

        is_bare_root = path == proxy_prefix.rstrip("/")
        print(
            f"[ODOO HANDLER {ODOO_HANDLER_VERSION}] "
            f"proxy_prefix={proxy_prefix!r} is_bare_root={is_bare_root} path={path!r}"
        )

        if not is_bare_root:
            # Not the root we own — let normal forwarding (and existing Odoo SPA logic) run.
            return None

        # We own the bare root. Build redirect to the main Odoo dashboard.
        from django.http import HttpResponse, HttpResponseRedirect
        from dose.passthrough.forwarding import _wrap_in_admin_template, fetch_upstream_index_html

        endpoint_url = (getattr(endpoint, "endpoint_url", "") or "").rstrip("/")
        landing = f"{proxy_prefix}/web"

        # Obtain session via the existing, proven credential/TenantApp/JSON-RPC path
        session_cookies = {}
        try:
            session_cookies = self.get_upstream_cookies(request) or {}
        except Exception as exc:
            print(f"[ODOO HANDLER {ODOO_HANDLER_VERSION}] get_upstream_cookies failed: {exc}")

        if fetch_upstream_shell and endpoint_url:
            print(f"[ODOO HANDLER {ODOO_HANDLER_VERSION}] fetch_upstream_shell=True → fetching real /web shell")
            raw = fetch_upstream_index_html(
                request,
                endpoint_url,
                "/web",
                handler=self,
            )
            if raw and not str(raw).startswith("REDIRECT:"):
                # Run through existing HTML processing (rewrites, client shims, etc.)
                processed = (
                    self.process_html_response(raw, request, endpoint_url=endpoint_url)
                    if hasattr(self, "process_html_response")
                    else raw
                )
                html_body = processed[0] if isinstance(processed, (list, tuple)) else processed
                if html_body and isinstance(html_body, str):
                    resp = HttpResponse(html_body, content_type="text/html; charset=utf-8")
                    if session_cookies.get("session_id"):
                        resp.set_cookie("session_id", session_cookies["session_id"], path="/", samesite="Lax")
                    resp["Cache-Control"] = "no-cache, no-store, must-revalidate"
                    wrapped = _wrap_in_admin_template(request, resp, seg, endpoint, handler=self)
                    print(
                        f"[ODOO HANDLER {ODOO_HANDLER_VERSION}] "
                        f"serving upstream /web shell (wrapped, len={len(html_body)})"
                    )
                    return wrapped
            print(f"[ODOO HANDLER {ODOO_HANDLER_VERSION}] upstream shell fetch failed or empty — falling back to redirect")

        # On root path: show a clean redirect *page* (minimal HTML) to /web.
        # This is a proper text/html document so _wrap_in_admin_template can wrap it cleanly
        # inside the embed (no raw Odoo content or leaking at the bare proxy root).
        print(f"[ODOO HANDLER {ODOO_HANDLER_VERSION}] bare root → clean redirect page to {landing}")
        redirect_html = (
            "<!DOCTYPE html><html><head><meta charset=\"utf-8\">"
            "<title>Redirecting to Odoo...</title>"
            f"<meta http-equiv=\"refresh\" content=\"0;url={landing}\">"
            "</head><body></body>"
            f"<script>location.replace({repr(landing)});</script></html>"
        )
        resp = HttpResponse(redirect_html, content_type="text/html; charset=utf-8")

        # Propagate freshly obtained session_id so the browser lands authenticated
        if session_cookies.get("session_id"):
            resp.set_cookie("session_id", session_cookies["session_id"], path="/", samesite="Lax")
            print(f"[ODOO HANDLER {ODOO_HANDLER_VERSION}] attached session_id cookie on redirect")

        resp["Cache-Control"] = "no-cache, no-store, must-revalidate"
        return _wrap_in_admin_template(request, resp, seg, endpoint, handler=self)

    @staticmethod
    def _rewrite_web_paths_for_display_shell(html: str, seg: str = "odoo") -> str:
        """Quoted /web/ and /website/ -> /pt/admin/<seg>/..."""
        if not html:
            return html
        proxy_web = f"/pt/admin/{seg}/web/"
        proxy_site = f"/pt/admin/{seg}/website/"
        return (
            html.replace('"/web/', f'"{proxy_web}')
            .replace("'/web/", f"'{proxy_web}")
            .replace('"/website/', f'"{proxy_site}')
            .replace("'/website/", f"'{proxy_site}")
        )

    @staticmethod
    def _rewrite_absolute_polysaas_host_paths(
        html: str, public_host: str, proxy_prefix: str
    ) -> str:
        """
        With X-Forwarded-Host, Odoo often embeds absolute URLs like
        http://localhost:8000/web/... — the browser loads those against PolySaaS without
        the passthrough prefix and assets 404; Owl never boots (blank shell).
        """
        if not html or not public_host or not proxy_prefix:
            return html
        ph = public_host.strip().lower()
        out = html
        for scheme in ("http", "https"):
            base = f"{scheme}://{ph}"
            pairs = (
                (f"{base}/web/", f"{base}{proxy_prefix}/web/"),
                (f"{base}/web?", f"{base}{proxy_prefix}/web?"),
                (f"{base}/odoo/", f"{base}{proxy_prefix}/odoo/"),
                (f"{base}/bus/", f"{base}{proxy_prefix}/bus/"),
                (f"{base}/websocket", f"{base}{proxy_prefix}/websocket"),
                (f"{base}/longpolling/", f"{base}{proxy_prefix}/longpolling/"),
                (f"{base}/website/", f"{base}{proxy_prefix}/website/"),
            )
            for old, new in pairs:
                if old in out:
                    out = out.replace(old, new)
        return out

