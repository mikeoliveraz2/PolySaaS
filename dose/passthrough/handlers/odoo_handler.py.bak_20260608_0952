    @staticmethod
    def _proxy_prefix_from_request(request) -> str:
        path_info = (getattr(request, 'path_info', '') or '').strip()
        seg = 'odoo'
        parts = path_info.strip('/').split('/') if path_info else []
        if len(parts) >= 3 and parts[0] == 'pt' and parts[1] == 'admin':
            seg = parts[2]
        return f"/pt/admin/{seg}"

    def _rewrite_root_paths_in_asset_text(
        self, text: str, proxy_prefix: str, public_host: str = ''
    ) -> str:
        """
        Rewrite root-absolute and PolySaaS-host-absolute paths inside CSS (or JS) bodies.
        Browsers resolve url(/web/static/...) from CSS against the site root, not the proxy.
        """
        if not text or not proxy_prefix:
            return text

        odoo_prefixes = (
            '/web/', '/odoo/', '/bus/', '/mail/', '/longpolling/', '/websocket',
            '/website/', '/jsonrpc/',
        )

        def _needs_proxy(path: str) -> bool:
            if not path or not path.startswith('/'):
                return False
            if path.startswith('/pt/') or path.startswith(proxy_prefix):
                return False
            if any(path.startswith(p) for p in odoo_prefixes):
                return True
            if '/static/' in path:
                return True
            return False

        def _rewrite_path(path: str) -> str:
            return proxy_prefix + path if _needs_proxy(path) else path

        def _rewrite_css_url(m):
            quote = m.group(1) or ''
            path = m.group(2)
            close = m.group(3) or ''
            return f'url({quote}{_rewrite_path(path)}{close})'

        out = re.sub(
            r'url\((["\']?)(/[^)"\']*)(["\']?)\)',
            _rewrite_css_url,
            text,
            flags=re.IGNORECASE,
        )

        if public_host:
            out = self._rewrite_absolute_polysaas_host_paths(
                out, public_host.strip(), proxy_prefix
            )
        return out

    def _rewrite_static_paths(self, html, proxy_prefix='/pt/admin/odoo', base_origin=''):
        """
        Rewrite src/href/action attributes in Odoo HTML to route through proxy.
        All paths go through proxy_prefix — direct-to-upstream breaks CORS
        since Odoo's Render instance does not allow localhost:8000 as an origin.
        """
        import re

        def _rewrite_attr(m):
            attr = m.group(1)
            path = m.group(2)
            if not path.startswith('/') or path.startswith('/pt/'):
                return attr + path
            return attr + proxy_prefix + path

        html = re.sub(
            r'((?:src|data-src|href|action)=["\'])(/[^"\']+)',
            _rewrite_attr, html, flags=re.IGNORECASE
        )

        return html

