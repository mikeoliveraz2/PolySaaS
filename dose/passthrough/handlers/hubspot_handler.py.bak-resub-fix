  var _setHref = null;
  function normalizeSubpath(path) {{
    var p = path || '/';
    if (!p || p.charAt(0) !== '/') p = '/' + p;
    if (SHELL_PREFIX && p.indexOf(SHELL_PREFIX) === 0) {{
