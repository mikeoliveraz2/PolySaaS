import logging
import re
from urllib.parse import urlparse

from django.http import HttpResponse
from dose.passthrough.handlers.handler_base import PassthroughHandlerBase

logger = logging.getLogger(__name__)

VERSION = "ODOO_HANDLER_v20260613_theme_sync_fix"
print(f"[ODOO HANDLER] {VERSION} LOADED")

ODOO_THEME_SYNC_SESSION_KEY = 'polysaas_odoo_theme_sync_mode'


class OdooPassthroughHandler(PassthroughHandlerBase):
    """Odoo passthrough — all Odoo-specific routing/rewrite logic lives here only."""

    _DJANGO_COOKIE_NAMES = frozenset({
        "sessionid", "csrftoken",
        "messages", "django_language",
    })

    @classmethod
    def matches_endpoint(cls, endpoint) -> bool:
        """Discover Odoo endpoints by slug (preferred) or hostname."""
        slug = (getattr(endpoint, 'slug', '') or '').lower().strip()
        if slug == 'odoo':
            return True
        url = (getattr(endpoint, 'endpoint_url', '') or '').lower()
        return 'odoo' in url

    def native_passthrough_prefixes(self):
        """Bare paths Odoo uses when the browser escapes the /pt/admin/<trigger>/ prefix."""
        return ("/web", "/odoo", "/apps", "/bus", "/websocket", "/longpolling")

    def needs_readable_response_body(self, request, target_url: str) -> bool:
        """We need readable body to rewrite asset URLs."""
        return True

    def should_follow_upstream_redirects(self, request, target_url: str, upstream_path: str) -> bool:
        """Follow GET redirect chains; POST must return to the browser for login flows."""
        follow = request.method != "POST"
        print(
            f"[ODOO HANDLER] should_follow_upstream_redirects: method={request.method}, "
            f"path={upstream_path}, follow={follow}"
        )
        return follow

    def filter_cookies_for_upstream(self, request, cookies: dict) -> dict:
        """Strip Django session/CSRF cookies — Odoo uses its own session_id."""
        filtered = {k: v for k, v in cookies.items() if k not in self._DJANGO_COOKIE_NAMES}
        removed = set(cookies) - set(filtered)
        if removed:
            print(f"[ODOO HANDLER] Filtered Django cookies from upstream request: {removed}")

        # Server SSO owns session_id — browser cookie may be stale after auto-login loops.
        path = (getattr(request, 'path_info', '') or '')
        if '/pt/admin/' in path and 'session_id' in filtered:
            if not self._skip_server_session_injection(request):
                print("[ODOO HANDLER] Stripping browser session_id — server SSO will inject")
                filtered = {k: v for k, v in filtered.items() if k != 'session_id'}

        scheme = self._polysaas_display_mode(request)
        prev = filtered.get('color_scheme')
        filtered.pop('color_scheme', None)
        filtered['color_scheme'] = scheme
        if prev != scheme:
            print(f"[ODOO HANDLER] Upstream color_scheme: {prev!r} -> {scheme!r}")

        return filtered

    @staticmethod
    def _skip_server_session_injection(request) -> bool:
        """Login/authenticate flows must use the browser/upstream session handshake."""
        path = (getattr(request, 'path_info', '') or '').lower()
        if '/web/session/authenticate' in path:
            return True
        if path.endswith('/web/login') and request.method == 'POST':
            return True
        return False

    def override_upstream_cookies(self, request, target_url: str):
        """Force validated server session + color_scheme on every upstream call."""
        scheme = self._polysaas_display_mode(request)
        overrides = {'color_scheme': scheme}
        if not self._skip_server_session_injection(request):
            sid = (self.get_upstream_cookies(request) or {}).get('session_id')
            if sid:
                overrides['session_id'] = sid
                print("[ODOO HANDLER] override_upstream_cookies: forcing server session_id")
        return overrides

    def apply_browser_response_cookies(self, request, response):
        """Keep browser session_id and color_scheme aligned with server SSO."""
        scheme = self._polysaas_display_mode(request)
        response.cookies['color_scheme'] = scheme
        response.cookies['color_scheme']['path'] = '/'
        response.cookies['color_scheme']['samesite'] = 'Lax'
        response.cookies['color_scheme']['max-age'] = 365 * 24 * 60 * 60
        print(f"[ODOO HANDLER] Browser Set-Cookie color_scheme={scheme}")
        if not self._skip_server_session_injection(request):
            sid = (self.get_upstream_cookies(request) or {}).get('session_id')
            if sid:
                response.cookies['session_id'] = sid
                response.cookies['session_id']['path'] = '/'
                response.cookies['session_id']['samesite'] = 'Lax'
                print("[ODOO HANDLER] Browser Set-Cookie session_id from server SSO")

    def should_forward_set_cookie_headers(
        self,
        request,
        *,
        upstream_content_type=None,
        upstream_path=None,
        response_kind=None,
    ) -> bool:
        """Block upstream Set-Cookie — Odoo resets color_scheme=light and breaks theme sync."""
        print(
            f"[ODOO HANDLER] Suppressing upstream Set-Cookie ({response_kind}, {upstream_path})"
        )
        return False

    @staticmethod
    def _odoo_proxy_prefix_from_endpoint(endpoint) -> str:
        # Owner-approved 2026-08-02: proxy prefix from endpoint.slug (not hostname).
        slug = (getattr(endpoint, "slug", None) or "").strip()
        if slug:
            return f"/pt/admin/{slug}"
        if hasattr(endpoint, "get_proxy_prefix"):
            return endpoint.get_proxy_prefix().rstrip("/")
        url = getattr(endpoint, "endpoint_url", "") or ""
        parsed = urlparse(url)
        return f"/pt/admin/{parsed.netloc}" if parsed.netloc else "/pt/admin"

    @staticmethod
    def _odoo_endpoint_is_odoo(endpoint) -> bool:
        slug = str(getattr(endpoint, 'slug', '') or '').lower()
        url = str(getattr(endpoint, 'endpoint_url', '') or '').lower()
        return slug == 'odoo' or 'odoo' in url

    @staticmethod
    def _odoo_root_path_should_proxy(path: str) -> bool:
        if not path or not path.startswith('/'):
            return False
        if path == '/web' or path.startswith('/web/'):
            return True
        if path == '/odoo' or path.startswith('/odoo/'):
            return True
        if path == '/apps' or path.startswith('/apps/'):
            return True
        for prefix in ('/bus/', '/mail/', '/longpolling/', '/website/', '/jsonrpc/'):
            if path.startswith(prefix):
                return True
        if path == '/websocket' or path.startswith('/websocket'):
            return True
        # Odoo addon module assets: /account/static/..., /sale_management/static/...
        if re.match(r'^/[a-z][a-z0-9_]*(?:/|$)', path) and '/static/' in path:
            return True
        return False

    @staticmethod
    def _odoo_incoming_rewrite_confidence(request, proxy_prefix: str) -> bool:
        ref = request.META.get('HTTP_REFERER', '') or ''
        if proxy_prefix in ref:
            return True
        if request.COOKIES.get('session_id'):
            if ref and proxy_prefix not in ref and 'odoo' not in ref.lower():
                return False
            return True
        return False

    @classmethod
    def try_rewrite_incoming_path_referer_fallback(cls, request) -> bool:
        """
        Map bare /web/login POST (and similar) onto /pt/admin/<hostname>/… when the
        browser escaped the proxy prefix. Handler-only — no shared urlconf rules.
        """
        path = request.path_info or ''
        if path.startswith('/pt/') or not cls._odoo_root_path_should_proxy(path):
            return False
        ref = request.META.get('HTTP_REFERER', '') or ''
        m = re.search(r'(/pt/admin/[^/]+)', ref)
        if not m or 'odoo' not in m.group(1).lower():
            return False
        proxy_prefix = m.group(1)
        if not cls._odoo_incoming_rewrite_confidence(request, proxy_prefix):
            return False
        request.path_info = proxy_prefix + path
        print(f"[ODOO HANDLER] referer fallback rewrite → {request.path_info}")
        return True

    def try_rewrite_incoming_path(self, request, endpoint) -> bool:
        """Rewrite bare Odoo paths onto /pt/admin/<hostname>/… before urlconf routing."""
        if not self._odoo_endpoint_is_odoo(endpoint):
            return False

        proxy_prefix = self._odoo_proxy_prefix_from_endpoint(endpoint)
        path = request.path_info or ''

        if path.startswith('/pt/'):
            return False
        if not self._odoo_root_path_should_proxy(path):
            return False
        if not self._odoo_incoming_rewrite_confidence(request, proxy_prefix):
            return False

        request.path_info = proxy_prefix + path
        print(f"[ODOO HANDLER] bare path rewrite → {request.path_info}")
        return True

    def should_wrap_in_admin_template(self, request, upstream_path, **kwargs):
        """Wrap Odoo HTML shells in admin/passthrough_embed (content column).

        Previously always False so raw Odoo filled the browser with no PolySaaS
        chrome. Assets/API still skip wrap via should_process_html_response.
        Fullscreen remains available via ?ps_fullscreen=1 (new tab / ↗).
        """
        content_type = kwargs.get("content_type")
        status_code = kwargs.get("status_code", 200)
        print(
            f"[ODOO HANDLER] should_wrap_in_admin_template: "
            f"upstream_path={upstream_path}, status={status_code}, ct={content_type}"
        )
        return self.should_process_html_response(
            request,
            upstream_path,
            content_type=content_type,
            status_code=status_code,
        )

    def passthrough_embed_template_context(self, trigger, request):
        """Provide Odoo-specific template context including the body scope flag."""
        mode = self._polysaas_display_mode(request)
        self._ensure_odoo_theme_sync_for_request(request, mode)
        print(f"[ODOO HANDLER] embed context: body_scope=True, display_mode={mode}")
        ctx = {
            'embed_enable_odoo_body_scope': True,
            'embed_polysaas_display_mode': mode,
        }
        return ctx

    def passthrough_embed_scope_classes(self, request, raw_html, upstream_root_classes=''):
        """Preserve Odoo o_dark/o_light on embed scope — never on Jazzmin document.body."""
        mode = self._polysaas_display_mode(request)
        classes = []
        for cls in (upstream_root_classes or '').split():
            if cls in ('o_dark', 'o_light', 'o_rtl', 'o_touch'):
                classes.append(cls)
        if mode == 'dark':
            if 'o_dark' not in classes:
                classes.append('o_dark')
            if 'o_light' in classes:
                classes.remove('o_light')
        else:
            if 'o_light' not in classes:
                classes.append('o_light')
            if 'o_dark' in classes:
                classes.remove('o_dark')
        merged = ' '.join(dict.fromkeys(classes))
        print(f"[ODOO HANDLER] embed scope classes: {merged!r} (mode={mode})")
        return merged

    _DARK_JAZZMIN_THEMES = frozenset({'darkly', 'cyborg', 'slate', 'solar', 'superhero'})

    @classmethod
    def _polysaas_display_mode(cls, request) -> str:
        """PolySaaS admin light/dark — match jazzmin_ui_tweaks + display_mode cookie."""
        if not request:
            return 'light'

        display_mode = 'light'
        if hasattr(request, 'session'):
            display_mode = request.session.get('display_mode', 'light')
        if hasattr(request, 'COOKIES') and 'display_mode' in request.COOKIES:
            display_mode = request.COOKIES.get('display_mode', display_mode)

        display_mode = str(display_mode or 'light').strip().lower()
        if display_mode == 'system':
            display_mode = (
                request.COOKIES.get('ps_theme_effective')
                or request.COOKIES.get('display_mode')
                or 'light'
            ).strip().lower()
        if display_mode not in ('light', 'dark'):
            display_mode = 'light'

        # If cookie missing/stale, infer from active Bootswatch palette (same as admin UI).
        try:
            from dose.models import UserProfile
            from dose.utils import get_current_tenant

            light_theme = 'sandstone'
            dark_theme = 'darkly'
            if hasattr(request, 'session'):
                light_theme = request.session.get('light_theme') or light_theme
                dark_theme = request.session.get('dark_theme') or dark_theme
            user = getattr(request, 'user', None)
            tenant = get_current_tenant(request)
            if user and getattr(user, 'is_authenticated', False) and tenant:
                profile = UserProfile.objects.filter(user=user, tenant=tenant).first()
                if profile:
                    light_theme = request.session.get('light_theme') or profile.light_theme or light_theme
                    dark_theme = request.session.get('dark_theme') or profile.dark_theme or dark_theme
            active_theme = dark_theme if display_mode == 'dark' else light_theme
            theme_is_dark = str(active_theme or '').lower() in cls._DARK_JAZZMIN_THEMES
            if theme_is_dark and display_mode != 'dark':
                print(
                    f"[ODOO HANDLER] display_mode cookie={display_mode!r} but "
                    f"jazzmin theme {active_theme!r} is dark -> dark"
                )
                display_mode = 'dark'
        except Exception as exc:
            print(f"[ODOO HANDLER] display_mode jazzmin fallback error: {exc}")

        print(f"[ODOO HANDLER] resolved display_mode={display_mode}")
        return display_mode

    @staticmethod
    def _rewrite_asset_bundles_for_mode(html_str: str, mode: str) -> str:
        """Force Odoo webclient onto dark/light asset bundles in proxied HTML."""
        if not html_str or mode != 'dark':
            return html_str
        if 'web.assets_web_dark' in html_str and 'web.assets_web.min' not in html_str:
            return html_str
        out = html_str
        for light, dark in (
            ('web.assets_web.min.css', 'web.assets_web_dark.min.css'),
            ('web.assets_web.min.js', 'web.assets_web_dark.min.js'),
            ('web.assets_web.css', 'web.assets_web_dark.css'),
            ('web.assets_web.js', 'web.assets_web_dark.js'),
        ):
            out = out.replace(light, dark)
        out = re.sub(
            r'web\.assets_web(?!(?:_dark|_print))',
            'web.assets_web_dark',
            out,
        )
        if out != html_str:
            print('[ODOO HANDLER] Rewrote web.assets_web -> web.assets_web_dark in HTML')
        return out

    def _sync_odoo_user_color_scheme(self, odoo_url, session_id, uid, scheme) -> bool:
        """Write color_scheme on Odoo res.users when permitted (best-effort)."""
        if not odoo_url or not session_id or not uid:
            return False
        scheme = 'dark' if scheme == 'dark' else 'light'
        try:
            import requests as _req

            resp = _req.post(
                f'{odoo_url.rstrip("/")}/web/dataset/call_kw',
                json={
                    'jsonrpc': '2.0',
                    'method': 'call',
                    'id': 1,
                    'params': {
                        'model': 'res.users',
                        'method': 'write',
                        'args': [[int(uid)], {'color_scheme': scheme}],
                        'kwargs': {},
                    },
                },
                cookies={'session_id': session_id, 'color_scheme': scheme},
                timeout=15,
            )
            body = resp.json() if resp.content else {}
            if body.get('error'):
                print(
                    f"[ODOO HANDLER] Odoo user color_scheme sync uid={uid} "
                    f"scheme={scheme} denied: {body['error'].get('data', {}).get('name') or body['error'].get('message')}"
                )
                return False
            print(
                f"[ODOO HANDLER] Odoo user color_scheme sync uid={uid} "
                f"scheme={scheme} HTTP={resp.status_code}"
            )
            return resp.status_code == 200
        except Exception as exc:
            print(f"[ODOO HANDLER] Odoo user color_scheme sync failed: {exc}")
            return False

    def _ensure_odoo_theme_sync_for_request(self, request, scheme=None) -> None:
        """One-way PolySaaS display_mode → Odoo color_scheme (best-effort user sync)."""
        if not request:
            return
        scheme = scheme or self._polysaas_display_mode(request)
        if hasattr(request, 'session') and request.session.get(ODOO_THEME_SYNC_SESSION_KEY) == scheme:
            return
        try:
            from dose.models import TenantApp
            from dose.tenant_app_lookup import tenant_schema_search_path

            tenant = self._resolve_tenant(request)
            if not tenant:
                return
            with tenant_schema_search_path(tenant):
                ta = TenantApp.objects.filter(
                    app_name='odoo', status='active',
                ).first()
            if not ta:
                return
            extra = ta.extra_config if isinstance(ta.extra_config, dict) else {}
            odoo_url = (extra.get('odoo_url') or ta.app_url or '').rstrip('/')
            session_id = extra.get('odoo_session_id')
            uid = extra.get('odoo_uid')
            if odoo_url and session_id and uid:
                self._sync_odoo_user_color_scheme(odoo_url, session_id, uid, scheme)
            if hasattr(request, 'session'):
                request.session[ODOO_THEME_SYNC_SESSION_KEY] = scheme
                try:
                    request.session.modified = True
                except Exception:
                    pass
            print(f"[ODOO HANDLER] Theme sync session marked mode={scheme}")
        except Exception as exc:
            print(f"[ODOO HANDLER] Theme sync ensure failed: {exc}")

    @staticmethod
    def _clear_odoo_session_cache(ta):
        """Drop cached upstream session so the next request re-authenticates."""
        if not ta:
            return
        extra = ta.extra_config if isinstance(ta.extra_config, dict) else {}
        if not extra.get('odoo_session_id'):
            return
        extra.pop('odoo_session_id', None)
        extra.pop('odoo_session_time', None)
        extra.pop('odoo_uid', None)
        ta.extra_config = extra
        from dose.tenant_app_lookup import tenant_schema_search_path
        with tenant_schema_search_path(ta.tenant):
            ta.save(update_fields=['extra_config'])
        print('[ODOO HANDLER] Cleared stale odoo_session_id cache')

    @staticmethod
    def _resolve_odoo_uid_from_session(odoo_url, session_id):
        """Resolve Odoo uid from session when extra_config has no cached odoo_uid."""
        if not odoo_url or not session_id:
            return None
        try:
            import requests as _req

            resp = _req.post(
                f'{odoo_url.rstrip("/")}/web/session/get_session_info',
                json={'jsonrpc': '2.0', 'method': 'call', 'id': 1, 'params': {}},
                cookies={'session_id': session_id},
                timeout=10,
            )
            uid = (resp.json().get('result') or {}).get('uid')
            if uid:
                print(f"[ODOO HANDLER] Resolved odoo_uid={uid} from session")
            return uid
        except Exception as exc:
            print(f"[ODOO HANDLER] resolve odoo_uid failed: {exc}")
            return None

    def _resolve_tenant(self, request):
        """Tenant for TenantApp lookup — session/middleware, not only request.tenant."""
        if not request:
            return None
        tenant = getattr(request, 'tenant', None)
        if tenant:
            return tenant
        try:
            from dose.utils import get_current_tenant
            return get_current_tenant(request)
        except Exception:
            return None

    def _get_tenantapp_extra_config(self, request=None):
        """Return extra_config dict for this tenant's Odoo TenantApp."""
        try:
            from dose.models import TenantApp
            from dose.tenant_app_lookup import tenant_schema_search_path
            tenant = self._resolve_tenant(request)
            tenant_id = tenant.pk if tenant else None

            if tenant:
                try:
                    with tenant_schema_search_path(tenant):
                        ta = TenantApp.objects.filter(
                            app_name='odoo',
                            status='active',
                        ).exclude(extra_config={}).first()
                    if ta and ta.extra_config:
                        print(f"[ODOO HANDLER] extra_config found for tenant={tenant} keys={list(ta.extra_config.keys())}")
                        return ta.extra_config
                except Exception as e:
                    print(f"[ODOO HANDLER] tenant bundle query error: {e}")

            print(f"[ODOO HANDLER] extra_config NOT found")
        except Exception as exc:
            print(f"[ODOO HANDLER] _get_tenantapp_extra_config error: {exc}")
        return {}

    def try_root_display_shell_response(self, request, endpoint, url_trigger_segment, fetch_upstream_shell=False):
        """Show a splash page for bare root click, redirect to /web through proxy."""
        trigger = url_trigger_segment.strip("/")
        print(f"[ODOO ROOT] {VERSION} - Path: {request.path_info} | Trigger: {trigger}")

        proxy_redirect = f"/pt/admin/{trigger}/web"
        html = f"""<!DOCTYPE html>
<html>
<head>
    <title>Connecting to Odoo...</title>
    <style>
        body {{ font-family: Arial, sans-serif; text-align: center; padding: 120px; background: #1f2a44; color: white; }}
        h2 {{ margin-bottom: 20px; }}
    </style>
</head>
<body>
    <h2>Connecting to Odoo...</h2>
    <p>Redirecting to dashboard...</p>
    <script>
        window.location.href = "{proxy_redirect}";
    </script>
</body>
</html>"""

        response = HttpResponse(html, content_type="text/html")
        try:
            from dose.passthrough.forwarding import _wrap_in_admin_template
            wrapped = _wrap_in_admin_template(request, response, trigger, endpoint)
            print(f"[ODOO ROOT] {VERSION} - Wrapped in admin template")
            return wrapped
        except Exception as e:
            print(f"[ODOO ROOT] Wrap failed: {e}")
            return response

    @staticmethod
    def _is_odoo_login_page(request, html_str: str) -> bool:
        """True only for Odoo login HTML — not webclient (csrf_token appears there too)."""
        path = (getattr(request, 'path_info', '') or '').lower()
        if '/web/login' in path:
            return True
        if not html_str:
            return False
        html_lower = html_str.lower()
        if 'o_web_client' in html_lower or 'web.assets_web' in html_lower:
            return False
        return 'oe_login_form' in html_lower or 'o_login_auth' in html_lower

    def get_client_side_shim(
        self,
        proxy_prefix,
        odoo_login=None,
        odoo_password=None,
        odoo_db=None,
        display_mode='light',
        enable_auto_login=False,
        odoo_origin=None,
    ):
        """Client shim: rewrite fetch/XHR/navigation/form POSTs through /pt/admin/<trigger>/."""
        import json
        auto_login_js = ""
        if enable_auto_login and odoo_login and odoo_password and odoo_db:
            safe_db = json.dumps(odoo_db)
            safe_login = json.dumps(odoo_login)
            safe_password = json.dumps(odoo_password)
            auto_login_js = f"""
            (function() {{
                var onLoginForm = !!(document.querySelector('.oe_login_form, .o_login_auth'));
                if (onLoginForm && sessionStorage.getItem('polysaas_odoo_sso_done')) {{
                    sessionStorage.removeItem('polysaas_odoo_sso_done');
                    console.log('[ODOO SSO] Login form visible — clearing SSO guard for retry');
                }}
                if (!onLoginForm && sessionStorage.getItem('polysaas_odoo_sso_done')) {{
                    console.log('[ODOO SSO] Skipping auto-login (already succeeded this tab)');
                    return;
                }}
                console.log('[ODOO SSO] Login page fallback — attempting auto-login...');
                fetch(PROXY_PREFIX + '/web/session/authenticate', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    credentials: 'same-origin',
                    body: JSON.stringify({{
                        jsonrpc: '2.0',
                        method: 'call',
                        params: {{
                            db: {safe_db},
                            login: {safe_login},
                            password: {safe_password}
                        }}
                    }})
                }})
                .then(function(r) {{ return r.json(); }})
                .then(function(data) {{
                    if (data && data.result && data.result.uid) {{
                        console.log('[ODOO SSO] Auto-login successful, uid=' + data.result.uid);
                        sessionStorage.setItem('polysaas_odoo_sso_done', '1');
                        var p = window.location.pathname || '';
                        if (p.indexOf('/web/login') >= 0 || p === PROXY_PREFIX || p === PROXY_PREFIX + '/') {{
                            window.location.replace(PROXY_PREFIX + '/web');
                        }}
                    }} else {{
                        console.warn('[ODOO SSO] Auto-login failed:', data);
                    }}
                }})
                .catch(function(err) {{
                    console.error('[ODOO SSO] Auto-login error:', err);
                }});
            }})();
            """

        safe_odoo_origin = json.dumps((odoo_origin or "").rstrip("/") or "")

        return f"""
        <script>
        (function() {{
            var PROXY_PREFIX = "{proxy_prefix}";
            var ODOO_ORIGIN = {safe_odoo_origin};
            var PS_DISPLAY_MODE = "{display_mode}";
            document.cookie = 'color_scheme=' + PS_DISPLAY_MODE + '; path=/; max-age=' + (365 * 24 * 60 * 60) + '; SameSite=Lax';
            console.log('[ODOO SHIM] color_scheme set to', PS_DISPLAY_MODE, 'odoo_origin=', ODOO_ORIGIN || '(none)');

            function applyOdooThemeVisuals() {{
                /* Never add Odoo classes to Jazzmin document.body — breaks admin shell. */
                if (PS_DISPLAY_MODE !== 'dark') return;
                var scope = document.querySelector('.polysaas-passthrough-scope');
                if (!scope || !scope.classList) return;
                scope.classList.add('o_dark');
                scope.classList.remove('o_light');
                var shell = scope.querySelector('.o_web_client[data-polysaas-odoo-shell]')
                    || scope.querySelector(':scope > .o_web_client');
                if (shell && shell.classList) {{
                    shell.classList.add('o_dark');
                    shell.classList.remove('o_light');
                }}
            }}
            document.addEventListener('DOMContentLoaded', applyOdooThemeVisuals);

            /* Paint invoice inputs in place. A class on .o_form_view never reached these fields. */
            function paintReadableField(el) {{
                if (!el || !el.style) return;
                var tag = (el.tagName || '').toLowerCase();
                if (tag === 'input') {{
                    var typ = (el.getAttribute('type') || 'text').toLowerCase();
                    if (typ === 'checkbox' || typ === 'radio' || typ === 'hidden' || typ === 'button' || typ === 'submit') return;
                }}
                if (el.classList) el.classList.add('ps-odoo-fields-light');
                el.style.setProperty('background-color', '#ffffff', 'important');
                el.style.setProperty('color', '#1f2937', 'important');
                el.style.setProperty('-webkit-text-fill-color', '#1f2937', 'important');
                el.style.setProperty('caret-color', '#1f2937', 'important');
                el.style.setProperty('color-scheme', 'light');
            }}
            function markReadableForms(root) {{
                var scope = document.querySelector('.polysaas-passthrough-scope');
                if (!scope) return;
                var start = (root && root.nodeType === 1 && scope.contains(root)) ? root : scope;
                if (start.classList && (start.classList.contains('o_form_view') || start.classList.contains('o_input') || start.matches && start.matches('input, textarea, select, .o_input_dropdown'))) {{
                    paintReadableField(start);
                }}
                if (!start.querySelectorAll) return;
                var fields = start.querySelectorAll('.o_form_view input, .o_form_view textarea, .o_form_view select, .o_field_widget input, .o_field_widget textarea, .o_field_widget select, input.o_input, textarea.o_input, .o_input, .o_input_dropdown');
                for (var i = 0; i < fields.length; i++) paintReadableField(fields[i]);
            }}
            markReadableForms(null);
            var formWatch = new MutationObserver(function (records) {{
                for (var r = 0; r < records.length; r++) {{
                    var added = records[r].addedNodes;
                    for (var n = 0; n < added.length; n++) {{
                        if (added[n] && added[n].nodeType === 1) markReadableForms(added[n]);
                    }}
                }}
            }});
            function watchReadableForms() {{
                var scope = document.querySelector('.polysaas-passthrough-scope');
                if (!scope) return;
                markReadableForms(scope);
                formWatch.observe(scope, {{ childList: true, subtree: true }});
            }}
            if (document.readyState === 'loading') {{
                document.addEventListener('DOMContentLoaded', watchReadableForms);
            }} else {{
                watchReadableForms();
            }}

            var ODOO_PATHS = ['/web', '/odoo', '/apps', '/report', '/download', '/api', '/base', '/bus', '/mail', '/longpolling', '/websocket', '/jsonrpc', '/website', '/logo.png', '/logo'];

            function normalizeToPath(url) {{
                if (!url || typeof url !== 'string') return url;
                if (url.indexOf(PROXY_PREFIX) === 0) return url;
                try {{
                    var parsed = new URL(url, window.location.origin);
                    if (parsed.origin === window.location.origin) {{
                        return parsed.pathname + parsed.search + parsed.hash;
                    }}
                    /* Absolute upstream Odoo host (e.g. Render) — force through proxy. */
                    if (ODOO_ORIGIN && parsed.origin === ODOO_ORIGIN) {{
                        return parsed.pathname + parsed.search + parsed.hash;
                    }}
                }} catch (e) {{}}
                return url;
            }}

            function shouldRewritePath(path) {{
                if (!path || typeof path !== 'string') return false;
                if (path.indexOf(PROXY_PREFIX) === 0) return false;
                if (path.charAt(0) !== '/') return false;
                if (path.indexOf('/admin/') === 0 || path === '/admin') return false;
                if (path.indexOf('/dose/') === 0) return false;
                if (path.indexOf('/static/admin/') === 0) return false;
                if (path.indexOf('/accounts/') === 0) return false;
                for (var i = 0; i < ODOO_PATHS.length; i++) {{
                    if (path === ODOO_PATHS[i] || path.indexOf(ODOO_PATHS[i] + '/') === 0) return true;
                }}
                if (/^\\/[a-z][a-z0-9_]*\\/static\\//.test(path)) return true;
                return false;
            }}

            function rewriteUrl(url) {{
                var path = normalizeToPath(url);
                if (shouldRewritePath(path)) {{
                    return PROXY_PREFIX + path;
                }}
                return url;
            }}

            /* Owner-approved 2026-09-24: SPA pushState updates the bar without a
               document GET. If an Instruction exists for the action path, do one
               full navigation so the server can run the atomic. Data-driven via
               /dose/api/orchestration-instruction/ — no hardcoded paths. */
            function coerceNavUrl(url) {{
                if (!url) return '';
                if (typeof url === 'string') return url;
                try {{
                    if (typeof URL !== 'undefined' && url instanceof URL) {{
                        return url.pathname + url.search + (url.hash || '');
                    }}
                    if (typeof url.href === 'string') return url.href;
                    return String(url);
                }} catch (e) {{ return ''; }}
            }}
            function pathNorm(pathname) {{
                var p = (pathname || '').split('?')[0].split('#')[0] || '';
                if (p.length > 1 && p.charAt(p.length - 1) === '/') p = p.slice(0, -1);
                return p || '/';
            }}
            function upstreamActionPathFromUrl(url) {{
                var raw = coerceNavUrl(url);
                if (!raw) return '';
                if (raw.indexOf('polysaas_odoo_form=1') >= 0) return '';
                var rewritten = rewriteUrl(raw);
                var path = pathNorm(rewritten);
                try {{
                    if (rewritten.indexOf('http') === 0) path = pathNorm(new URL(rewritten).pathname);
                }} catch (e) {{}}
                if (path.indexOf(PROXY_PREFIX) === 0) {{
                    path = path.slice(PROXY_PREFIX.length) || '/';
                    if (path.charAt(0) !== '/') path = '/' + path;
                }}
                return pathNorm(path);
            }}
            function instructionApiUrl(actionPath) {{
                var path = (actionPath || '').trim();
                if (!path) return '';
                if (path.charAt(0) !== '/') path = '/' + path;
                var segments = path.replace(/^\\/+|\\/+$/g, '').split('/').filter(Boolean);
                if (!segments.length) return '';
                return '/dose/api/orchestration-instruction/' + segments.map(encodeURIComponent).join('/') + '/?method=GET';
            }}
            function skipInstructionPageNav() {{
                if ((window.location.search || '').indexOf('polysaas_odoo_form=1') >= 0) return true;
                try {{
                    if (sessionStorage.getItem('ps_orch_skip_page') === '1') return true;
                }} catch (e) {{}}
                return false;
            }}
            function documentPathMatchesInstruction(currentPath, instrPath) {{
                /* Same rule as dose.passthrough.instruction_page.document_path_matches_instruction.
                   Orch matcher may return an Instruction for a shorter SPA URL (/odoo);
                   only full-navigate when the document path is the rule (or under it). */
                var cur = pathNorm(currentPath);
                var rule = pathNorm(instrPath);
                if (!cur || !rule || rule === '/') return false;
                if (cur === rule) return true;
                if (cur.indexOf(rule + '/') === 0) return true;
                if (cur.indexOf(rule) !== -1) return true;
                return false;
            }}
            function maybeInstructionPageNav(url) {{
                if (skipInstructionPageNav()) return;
                var actionPath = upstreamActionPathFromUrl(url || (window.location.pathname + window.location.search));
                if (!actionPath || actionPath === '/') return;
                var onceKey = 'ps_orch_page_nav';
                try {{
                    var already = sessionStorage.getItem(onceKey);
                    if (already === actionPath) return;
                    if (already && already !== actionPath) sessionStorage.removeItem(onceKey);
                }} catch (e0) {{}}
                var api = instructionApiUrl(actionPath);
                if (!api) return;
                fetch(api, {{ credentials: 'same-origin', headers: {{ 'Accept': 'application/json' }} }})
                    .then(function (r) {{ return r.json(); }})
                    .then(function (data) {{
                        if (!data || data.mode !== 'update' || !data.executescript) return;
                        var instrPath = data.action_path || '';
                        if (!documentPathMatchesInstruction(actionPath, instrPath)) {{
                            console.log('[ODOO SHIM] skip page nav: path ' + actionPath + ' is not document match for ' + instrPath);
                            return;
                        }}
                        try {{ sessionStorage.setItem(onceKey, actionPath); }} catch (e1) {{}}
                        var jump = PROXY_PREFIX + actionPath;
                        console.log('[ODOO SHIM] instruction page nav: ' + jump);
                        window.location.assign(jump);
                    }})
                    .catch(function () {{}});
            }}
            (function checkInstructionPageOnLoad() {{
                try {{
                    maybeInstructionPageNav(window.location.pathname + window.location.search);
                }} catch (eInit) {{}}
            }})();

            function rewriteFormAction(form) {{
                if (!form || form.tagName !== 'FORM') return;
                var rawAction = form.action || '';
                if (!rawAction) return;
                if (rawAction.indexOf(PROXY_PREFIX) !== -1) return;
                var proxied = rewriteUrl(rawAction);
                if (proxied !== rawAction) {{
                    console.log('[ODOO SHIM] Form action rewrite:', rawAction, '->', proxied);
                    form.setAttribute('action', proxied);
                }}
            }}

            document.addEventListener('submit', function(e) {{
                rewriteFormAction(e.target);
            }}, true);

            var _formSubmit = HTMLFormElement.prototype.submit;
            HTMLFormElement.prototype.submit = function() {{
                rewriteFormAction(this);
                return _formSubmit.call(this);
            }};

            var _formObserver = new MutationObserver(function(mutations) {{
                mutations.forEach(function(mutation) {{
                    if (mutation.type === 'attributes' && mutation.target.tagName === 'FORM') {{
                        rewriteFormAction(mutation.target);
                    }} else if (mutation.type === 'childList') {{
                        mutation.addedNodes.forEach(function(node) {{
                            if (!node || node.nodeType !== 1) return;
                            if (node.tagName === 'FORM') rewriteFormAction(node);
                            if (node.querySelectorAll) {{
                                var forms = node.querySelectorAll('form');
                                for (var i = 0; i < forms.length; i++) rewriteFormAction(forms[i]);
                            }}
                        }});
                    }}
                }});
            }});

            function attachFormObserver() {{
                var scope = document.querySelector('.polysaas-passthrough-scope') || document.body;
                if (!scope) return false;
                _formObserver.observe(scope, {{
                    childList: true,
                    subtree: true,
                    attributes: true,
                    attributeFilter: ['action']
                }});
                var existingForms = scope.querySelectorAll('form');
                for (var i = 0; i < existingForms.length; i++) rewriteFormAction(existingForms[i]);
                console.log('[ODOO SHIM] Form observer attached');
                return true;
            }}

            if (document.readyState === 'loading') {{
                document.addEventListener('DOMContentLoaded', function() {{
                    if (!attachFormObserver()) setTimeout(attachFormObserver, 500);
                }});
            }} else if (!attachFormObserver()) {{
                setTimeout(attachFormObserver, 500);
            }}

            /* FIX 2026-08-02 (owner-approved, frozen-file exception): a plain
               <a href="/odoo"> (or similar) in Odoo's own rendered markup navigates
               natively on click — it never calls setAttribute(), location.href=, or
               pushState, so none of the patches above see it. Rewrite the href on the
               capture phase, before the browser acts on the click, same pattern as the
               form-submit guard above. */
            function rewriteAnchor(anchor) {{
                if (!anchor || anchor.tagName !== 'A') return;
                var rawHref = anchor.getAttribute('href');
                if (!rawHref) return;
                if (rawHref.indexOf(PROXY_PREFIX) !== -1) return;
                var proxied = rewriteUrl(rawHref);
                if (proxied !== rawHref) {{
                    console.log('[ODOO SHIM] anchor href rewrite: ' + rawHref + ' -> ' + proxied);
                    anchor.setAttribute('href', proxied);
                }}
            }}

            document.addEventListener('click', function(e) {{
                var anchor = e.target && e.target.closest ? e.target.closest('a[href]') : null;
                if (anchor) rewriteAnchor(anchor);
            }}, true);

            var _originalFetch = window.fetch;
            window.fetch = function(url, init) {{
                var rewritten = rewriteUrl(url);
                if (rewritten !== url) {{
                    console.debug('[ODOO SHIM] fetch rewrite: ' + url + ' -> ' + rewritten);
                }}
                return _originalFetch.call(this, rewritten, init);
            }};

            var _originalOpen = XMLHttpRequest.prototype.open;
            XMLHttpRequest.prototype.open = function(method, url, async, user, pass) {{
                var rewritten = rewriteUrl(url);
                if (rewritten !== url) {{
                    console.debug('[ODOO SHIM] XHR rewrite: ' + url + ' -> ' + rewritten);
                }}
                return _originalOpen.call(this, method, rewritten, async, user, pass);
            }};

            if (window.Worker) {{
                var _OriginalWorker = window.Worker;
                window.Worker = function(url, options) {{
                    if (String(url).indexOf('/bus/websocket_worker_bundle') !== -1) {{
                        var worker = new EventTarget();
                        worker.postMessage = function(message) {{
                            if (message && message.action === 'initialize_connection') {{
                                setTimeout(function() {{
                                    worker.dispatchEvent(new MessageEvent('message', {{
                                        data: {{type: 'initialized', data: {{}}}}
                                    }}));
                                }}, 0);
                            }}
                        }};
                        worker.terminate = function() {{}};
                        return worker;
                    }}
                    return new _OriginalWorker(rewriteUrl(url), options);
                }};
                window.Worker.prototype = _OriginalWorker.prototype;
            }}

            if (window.SharedWorker) {{
                window.SharedWorker = undefined;
            }}

            var _origSetAttribute = Element.prototype.setAttribute;
            Element.prototype.setAttribute = function(name, value) {{
                if ((name === 'src' || name === 'href') && typeof value === 'string') {{
                    value = rewriteUrl(value);
                }}
                return _origSetAttribute.call(this, name, value);
            }};

            try {{
                var imgSrcDesc = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, 'src');
                if (imgSrcDesc && imgSrcDesc.set) {{
                    Object.defineProperty(HTMLImageElement.prototype, 'src', {{
                        configurable: true,
                        get: imgSrcDesc.get,
                        set: function(v) {{
                            imgSrcDesc.set.call(this, rewriteUrl(v));
                        }}
                    }});
                }}
            }} catch (imgErr) {{
                console.warn('[ODOO SHIM] img.src patch skipped:', imgErr);
            }}

            var _originalPushState = history.pushState;
            var _originalReplaceState = history.replaceState;
            history.pushState = function(state, title, url) {{
                if (url) {{
                    var rewritten = rewriteUrl(coerceNavUrl(url) || url);
                    if (rewritten !== url) {{
                        console.log('[ODOO SHIM] pushState rewrite: ' + url + ' -> ' + rewritten);
                    }}
                    var result = _originalPushState.call(this, state, title, rewritten);
                    maybeInstructionPageNav(rewritten);
                    return result;
                }}
                return _originalPushState.call(this, state, title, url);
            }};
            history.replaceState = function(state, title, url) {{
                if (url) {{
                    var rewritten = rewriteUrl(coerceNavUrl(url) || url);
                    if (rewritten !== url) {{
                        console.log('[ODOO SHIM] replaceState rewrite: ' + url + ' -> ' + rewritten);
                    }}
                    var result = _originalReplaceState.call(this, state, title, rewritten);
                    maybeInstructionPageNav(rewritten);
                    return result;
                }}
                return _originalReplaceState.call(this, state, title, url);
            }};

            /* FIX 2026-08-01 (owner-approved, frozen-file exception): Odoo's newer
               app-activation flow (e.g. installing/opening Invoicing) navigates via a
               full-page `location.href` / `location.assign` / `location.replace` to a
               bare path like "/odoo/invoicing" instead of pushState or fetch. None of
               the patches above catch that, so the browser resolved it against the
               PolySaaS origin (localhost:8000) and 404'd. Patch Location the same way
               img.src is already patched above, reusing the existing rewriteUrl(). */
            try {{
                var _locHrefDesc = Object.getOwnPropertyDescriptor(Location.prototype, 'href');
                if (_locHrefDesc && _locHrefDesc.set) {{
                    Object.defineProperty(Location.prototype, 'href', {{
                        configurable: true,
                        get: _locHrefDesc.get,
                        set: function(v) {{
                            var rewritten = rewriteUrl(v);
                            if (rewritten !== v) {{
                                console.log('[ODOO SHIM] location.href rewrite: ' + v + ' -> ' + rewritten);
                            }}
                            _locHrefDesc.set.call(this, rewritten);
                        }}
                    }});
                }}
                var _locAssign = Location.prototype.assign;
                Location.prototype.assign = function(url) {{
                    var rewritten = rewriteUrl(url);
                    if (rewritten !== url) {{
                        console.log('[ODOO SHIM] location.assign rewrite: ' + url + ' -> ' + rewritten);
                    }}
                    return _locAssign.call(this, rewritten);
                }};
                var _locReplace = Location.prototype.replace;
                Location.prototype.replace = function(url) {{
                    var rewritten = rewriteUrl(url);
                    if (rewritten !== url) {{
                        console.log('[ODOO SHIM] location.replace rewrite: ' + url + ' -> ' + rewritten);
                    }}
                    return _locReplace.call(this, rewritten);
                }};
            }} catch (locErr) {{
                console.warn('[ODOO SHIM] location patch skipped:', locErr);
            }}

            console.log('[ODOO SHIM] Installed rewriter + form POST guard. Proxy prefix: ' + PROXY_PREFIX);
            {auto_login_js}
        }})();
        </script>
        """

    def get_upstream_cookies(self, request):
        """
        Server-side Odoo session for sidebar entry (SSO).
        Authenticates via JSON-RPC when the browser has no session_id yet.
        Client-side shim remains as fallback only.
        """
        import time

        path = (getattr(request, 'path_info', '') or '').lower()
        if '/web/session/authenticate' in path or (
            path.endswith('/web/login') and request.method == 'POST'
        ):
            return {}

        try:
            import requests as _req
            from django.conf import settings
            from dose.models import TenantApp
            from dose.tenant_app_lookup import tenant_schema_search_path

            tenant = self._resolve_tenant(request)
            if not tenant:
                print(f"[ODOO HANDLER] get_upstream_cookies: no tenant context")
                return {}

            with tenant_schema_search_path(tenant):
                ta = TenantApp.objects.filter(
                    app_name='odoo', status='active',
                ).first()
            if not ta:
                print(f"[ODOO HANDLER] get_upstream_cookies: no active Odoo TenantApp")
                return {}

            extra = ta.extra_config if isinstance(ta.extra_config, dict) else {}

            odoo_url = (
                extra.get('odoo_url')
                or ta.app_url
                or getattr(settings, 'ODOO_SHARED_URL', 'https://odoo.prod-polysaas.cloud')
            ).rstrip('/')
            scheme = self._polysaas_display_mode(request)

            session_id = extra.get('odoo_session_id')
            session_time = extra.get('odoo_session_time', 0)
            if session_id and (time.time() - float(session_time or 0) < 1800):
                uid = extra.get('odoo_uid') or self._resolve_odoo_uid_from_session(
                    odoo_url, session_id,
                )
                if uid:
                    print(f"[ODOO HANDLER] Using cached Odoo session for tenant={tenant.slug} uid={uid}")
                    if hasattr(request, 'session') and request.session.get(ODOO_THEME_SYNC_SESSION_KEY) != scheme:
                        self._sync_odoo_user_color_scheme(odoo_url, session_id, uid, scheme)
                        request.session[ODOO_THEME_SYNC_SESSION_KEY] = scheme
                        try:
                            request.session.modified = True
                        except Exception:
                            pass
                    return {'session_id': session_id, 'color_scheme': scheme}
                print(f"[ODOO HANDLER] Cached Odoo session invalid for tenant={tenant.slug} — re-authenticating")
                self._clear_odoo_session_cache(ta)
                extra = ta.extra_config if isinstance(ta.extra_config, dict) else {}

            login_id = extra.get('odoo_login')
            password = extra.get('odoo_password')
            if not login_id or not password:
                print(f"[ODOO HANDLER] get_upstream_cookies: missing odoo_login/password in extra_config")
                return {}

            db_name = (
                extra.get('odoo_db')
                or getattr(settings, 'ODOO_SHARED_DB', None)
                or 'polysaas_odoo'
            )

            print(
                f"[ODOO HANDLER] get_upstream_cookies: authenticating tenant={tenant.slug} "
                f"login={login_id} db={db_name}"
            )
            resp = _req.post(
                f'{odoo_url}/web/session/authenticate',
                json={
                    'jsonrpc': '2.0',
                    'method': 'call',
                    'id': 1,
                    'params': {
                        'db': db_name,
                        'login': login_id,
                        'password': password,
                    },
                },
                timeout=30,
            )
            if resp.status_code != 200:
                print(f"[ODOO HANDLER] authenticate HTTP {resp.status_code}")
                return {}

            body = resp.json()
            uid = (body.get('result') or {}).get('uid')
            sid = resp.cookies.get('session_id')
            if uid and sid:
                if not isinstance(ta.extra_config, dict):
                    ta.extra_config = {}
                ta.extra_config['odoo_session_id'] = sid
                ta.extra_config['odoo_session_time'] = time.time()
                ta.extra_config['odoo_uid'] = uid
                with tenant_schema_search_path(tenant):
                    ta.save(update_fields=['extra_config'])
                if hasattr(request, 'session'):
                    request.session[ODOO_THEME_SYNC_SESSION_KEY] = scheme
                    try:
                        request.session.modified = True
                    except Exception:
                        pass
                self._sync_odoo_user_color_scheme(odoo_url, sid, uid, scheme)
                print(f"[ODOO HANDLER] Server-side SSO ok uid={uid}")
                return {'session_id': sid, 'color_scheme': scheme}

            err = (body.get('error') or {}).get('message') or 'auth failed'
            print(f"[ODOO HANDLER] authenticate failed uid={uid} err={err}")
            self._clear_odoo_session_cache(ta)
        except Exception as exc:
            print(f"[ODOO HANDLER] get_upstream_cookies error: {exc}")
            logger.warning("[ODOO HANDLER] get_upstream_cookies failed: %s", exc)
        return {}

    @staticmethod
    def _inject_after_open_tag(html_str, tag_pattern, injection):
        """Insert text immediately after the first matching opening tag (no re.sub replacement)."""
        m = re.search(tag_pattern, html_str, re.IGNORECASE)
        if not m:
            return html_str
        idx = m.end()
        return html_str[:idx] + '\n' + injection + html_str[idx:]

    def _rewrite_form_actions_server_side(self, html_str, prefix):
        """Rewrite static form actions before Owl renders (login page HTML from upstream)."""
        html_str = re.sub(
            r'(<form[^>]*\saction=["\'])(/[^"\']*)',
            lambda m: f'{m.group(1)}{prefix}{m.group(2)}',
            html_str,
            flags=re.IGNORECASE,
        )
        return html_str

    def process_html_response(self, html_str, request, endpoint_url=None, **context):
        """Inject client-side shim and rewrite asset/form URLs through proxy prefix."""
        if not html_str or not self.endpoint:
            return html_str

        prefix = self.proxy_prefix.rstrip('/')
        print(f"[ODOO HANDLER] Rewriting HTML with prefix={prefix}")

        extra = self._get_tenantapp_extra_config(request) or {}
        odoo_login = extra.get('odoo_login')
        odoo_password = extra.get('odoo_password')
        odoo_db = extra.get('odoo_db')

        is_login_html = self._is_odoo_login_page(request, html_str)

        if is_login_html:
            path_lower = (getattr(request, 'path_info', '') or '').lower()
            if '/web/login' not in path_lower:
                try:
                    from dose.models import TenantApp
                    tenant = self._resolve_tenant(request)
                    if tenant:
                        ta = TenantApp.objects.filter(
                            tenant=tenant, app_name='odoo', status='active',
                        ).first()
                        if ta and (ta.extra_config or {}).get('odoo_session_id'):
                            print(
                                f"[ODOO HANDLER] Login HTML on {path_lower} — "
                                "invalidating cached session"
                            )
                            self._clear_odoo_session_cache(ta)
                except Exception as exc:
                    print(f"[ODOO HANDLER] login-page cache invalidate failed: {exc}")

        display_mode = self._polysaas_display_mode(request)
        self._ensure_odoo_theme_sync_for_request(request, display_mode)
        upstream = endpoint_url or getattr(self.endpoint, "endpoint_url", None) or ""
        try:
            from urllib.parse import urlparse
            _p = urlparse(upstream)
            odoo_origin = f"{_p.scheme}://{_p.netloc}" if _p.scheme and _p.netloc else ""
        except Exception:
            odoo_origin = ""
        shim_js = self.get_client_side_shim(
            prefix, odoo_login, odoo_password, odoo_db,
            display_mode=display_mode,
            enable_auto_login=is_login_html,
            odoo_origin=odoo_origin,
        )
        if is_login_html:
            print(f"[ODOO HANDLER] Login page detected — client auto-login fallback enabled")
        html_str = self._rewrite_asset_bundles_for_mode(html_str, display_mode)
        html_str = self._inject_after_open_tag(
            html_str,
            r'<head[^>]*>',
            f'<base href="{prefix}/">\n{shim_js}',
        )

        html_str = self._rewrite_form_actions_server_side(html_str, prefix)

        html_str = re.sub(
            r'(src|href|action)=(["\'])(/(web|odoo|apps|report|download|base|api|bus|mail|longpolling|websocket|jsonrpc|website|logo\.png|logo)[^"\']*)',
            lambda m: f'{m.group(1)}={m.group(2)}{prefix}{m.group(3)}{m.group(2)}',
            html_str,
            flags=re.IGNORECASE
        )
        html_str = re.sub(
            r'(src|href)=(["\'])(/([a-z][a-z0-9_]*)/static/[^"\']*)',
            lambda m: f'{m.group(1)}={m.group(2)}{prefix}{m.group(3)}{m.group(2)}',
            html_str,
            flags=re.IGNORECASE
        )

        if is_login_html:
            print(f"[ODOO HANDLER] Login page rewritten — form POSTs must target {prefix}/web/login")

        print(f"[ODOO HANDLER] Rewriting complete (shim injected, assets/forms rewritten)")
        return html_str

