        }}
        var proxied = toProxy(url);
        var _xhrFixed = _mmFixLeakedTeamSlugUrl(proxied);
        if (_xhrFixed === '') {{
            proxied = PROXY + '/api/v4/users/me/teams';
        }} else if (_xhrFixed) {{
            proxied = _xhrFixed;
        }}
        if (url !== proxied) console.log('[PolySaaS MM] XHR:', method, url, '->', proxied);
        var rest = Array.prototype.slice.call(arguments, 2);
        _xo.apply(this, [method, proxied].concat(rest));
        if (_mmIsExactUsersMeApi(proxied)) {{
            var _self = this;
            this.addEventListener('load', function() {{
                console.log('[PolySaaS MM] XHR users/me status:', _self.status);
                if (_self.status === 401) {{
                    console.log('[PolySaaS MM] XHR 401 on exact users/me — clearing and redirecting');
                    _mmClearToken();
                    _mmRedirectToLogin();
                }}
            }});
        }}
        if (MMAUTHTOKEN && (proxied.indexOf('/api/v4/') !== -1 || proxied.indexOf('/plugins/') !== -1)) {{
            try {{
                this.setRequestHeader('Authorization', 'Bearer ' + MMAUTHTOKEN);
                var _xhrMethod = (method || 'GET').toUpperCase();
                if (_xhrMethod !== 'GET' && _xhrMethod !== 'HEAD') {{
                    var _xhrCsrf = _mmGetCsrfFromCookie() || _serverCsrf;
                    if (_xhrCsrf) this.setRequestHeader('X-CSRF-Token', _xhrCsrf);
                    this.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
                }}
                if (_mmIsExactUsersMeApi(proxied))
                    console.log('[PolySaaS MM] XHR Auth injected for users/me, token starts:', MMAUTHTOKEN.slice(0, 8));
                if (proxied.indexOf('/plugins/') !== -1)
                    console.log('[PolySaaS MM] XHR Auth injected for plugin endpoint:', proxied);
            }} catch(e) {{}}
        }}
    }};
    XMLHttpRequest.prototype.send = function() {{
        if (this._blockedLogoutStub) {{
