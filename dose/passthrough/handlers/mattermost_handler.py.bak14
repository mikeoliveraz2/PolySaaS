            setTimeout(function() {{
                Object.defineProperty(_self, 'status', {{value: 200}});
                Object.defineProperty(_self, 'responseText', {{value: '{{"status":"OK"}}'}});
                _self.dispatchEvent(new Event('load'));
            }}, 0);
            return;
