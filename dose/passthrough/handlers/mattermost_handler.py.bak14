                        _cachedTeamName = teams[0].name;
                        return _f.call(window, PROXY + '/api/v4/teams/name/' + _cachedTeamName, init || {{}});
                    }}
                    return new Response('{{}}', {{status: 404, headers: {{'Content-Type': 'application/json'}}}});
                }});
            }});
        }}
        if (_fixedTeamUrl && _fixedTeamUrl !== reqUrl) {{
            reqUrl = _fixedTeamUrl;
            input = typeof input === 'string' ? _fixedTeamUrl : new Request(_fixedTeamUrl, input);
        }}

        // Mattermost SPA may POST logout on auth glitches — never forward; it kills the plugin session.
        if (reqUrl.indexOf('/api/v4/users/logout') !== -1) {{
            console.log('[PolySaaS MM] Blocked logout during passthrough SSO');
            return Promise.resolve(new Response('{{"status":"OK"}}', {{
                status: 200,
                headers: {{'Content-Type': 'application/json'}}
