# dose/passthrough/utils.py — FINAL
from urllib.parse import urlparse


def normalize_trigger_segment(raw: str) -> str:
    """
    Same rule as admin sidebar /pt/admin/<seg>/ links: last path segment, lowercased,
    hyphens → underscores (e.g. dose/gmail → gmail, MatterMost → mattermost).
    """
    return (raw or "").strip("/").lower().split("/")[-1].replace("-", "_")


def derive_endpoint_base(full_url: str) -> str:
    """User can paste ANYTHING — we always return correct base"""
    if not full_url.startswith(('http://', 'https://')):
        full_url = 'http://' + full_url.lstrip('/')
    parsed = urlparse(full_url)
    return f"{parsed.scheme}://{parsed.netloc}/"