logger = logging.getLogger(__name__)


def _load_instructions_for_direction(tenant, direction):
    """Load instructions in the tenant schema for this direction."""
    from dose.models import Instruction

    ensure_tenant_search_path(tenant, 'load_instructions')
    try:
        instructions = list(Instruction.objects.filter(direction=direction))
        orch_log(
            'instructions_loaded',
            schema=tenant.schema_name,
            direction=direction,
            count=len(instructions),
        )
        return instructions
    except (DataError, ProgrammingError) as exc:
        orch_log_exception('instructions_load_failed', exc, schema=tenant.schema_name)
        try:
            with connection.cursor() as cur:
                cur.execute('SET search_path TO public')
            public_only = list(Instruction.objects.filter(tenant=None, direction=direction))
            ensure_tenant_search_path(tenant, 'load_instructions_retry')
            return public_only
        except Exception as exc2:
            orch_log_exception('instructions_public_fallback_failed', exc2)
            return []


def _extract_odoo_ids(upstream_path):
    """Extract action_id and menu_id from an Odoo URL (path, query, or fragment)."""
    import re
    action_id = None
    menu_id = None
    combined = upstream_path
    m = re.search(r'(?:[?&#]|^)action=([^&# ]+)', combined)
    if m:
        action_id = m.group(1)
    m = re.search(r'(?:[?&#]|^)menu_id=(\d+)', combined)
    if m:
        menu_id = m.group(1)
    if not menu_id:
        m = re.search(r'/odoo/[^/?#]+/(\d+)(?:[/?#]|$)', combined)
        if m:
            menu_id = m.group(1)
    return action_id, menu_id


def _instruction_matches(instr, upstream_path, method):
    """Return True if the instruction matches this request."""
    import re
    mt = getattr(instr, 'match_type', 'path') or 'path'
    mv = (instr.requestpath or '').strip()
    if not mv:
        return False

    extra = getattr(instr, 'match_extra', {}) or {}

    if extra.get('method') and extra['method'].upper() != method.upper():
        return False

    if extra.get('menu_id'):
        _, menu_id = _extract_odoo_ids(upstream_path)
        if not (menu_id and str(extra['menu_id']) == menu_id):
            return False

    if extra.get('action_id'):
        action_id, _ = _extract_odoo_ids(upstream_path)
        if not (action_id and extra['action_id'].lower() in action_id.lower()):
            return False

    norm = upstream_path.lower()
    mv_l = mv.lower().rstrip('/')

    if mt in ('path', 'contains'):
        if mv_l in norm:
            return True
        # Odoo 18: rule /odoo/accounting/116 also matches navigation to /odoo/accounting
        m = re.match(r'^(.+)/(\d+)$', mv_l)
        if m:
            base = m.group(1)
            menu_from_rule = m.group(2)
            if base in norm or norm.startswith(base + '/'):
                _, menu_from_path = _extract_odoo_ids(upstream_path)
                if not menu_from_path or menu_from_path == menu_from_rule:
                    return True
        # Shorter incoming path matches longer rule prefix (e.g. rule has extra segment)
        if norm and (mv_l.startswith(norm + '/') or norm.startswith(mv_l + '/')):
            return True
        return False
    elif mt == 'action_id':
        action_id, _ = _extract_odoo_ids(upstream_path)
        return bool(action_id and mv.lower() in action_id.lower())
    elif mt == 'menu_id':
        _, menu_id = _extract_odoo_ids(upstream_path)
        return bool(menu_id and mv == menu_id)
    elif mt == 'regex':
        try:
            return bool(re.search(mv, upstream_path))
        except re.error:
            logger.warning("[ORCH] Invalid regex in instruction id=%s: %s", instr.id, mv)
            return False
    return False


def _instruction_belongs_to_tenant(instr, tenant):
    """Only match instructions owned by this tenant (or global tenant=None)."""
    if not tenant:
        return True
    tid = getattr(instr, 'tenant_id', None)
    if tid is None:
        return True
    tenant_key = getattr(tenant, 'pk', None) or getattr(tenant, 'slug', None)
    return str(tid) == str(tenant_key)


def find_matching_instructions(tenant, upstream_path, method='GET', direction='REQ'):
    """Return instructions that match upstream_path using the same rules as the orchestration bar."""
    if not tenant:
        return []
    instructions = _load_instructions_for_direction(tenant, direction)
    matched = []
    for instr in instructions:
        if not _instruction_belongs_to_tenant(instr, tenant):
            continue
        if not _instruction_passes_requestmethod(instr, method):
            continue
        if _instruction_matches(instr, upstream_path, method):
            matched.append(instr)
    return matched


def _instruction_passes_requestmethod(instr, method):
    req_method = getattr(instr, 'requestmethod', None) or 'GET'
    return req_method.upper() == method.upper()


def _collapse_overlapping_matches(matched):
    """
    When several Instructions match one passthrough request (e.g. /odoo/accounting/119
    and /odoo/accounting), keep the most specific rule per eventKey + HTTP method.
    """
    if len(matched) <= 1:
        return matched
    best = {}
    for instr in matched:
        event_key = (getattr(instr, 'eventKey', None) or f'id:{instr.pk}').strip()
        method = (getattr(instr, 'requestmethod', None) or 'GET').upper()
        bucket = f'{event_key}|{method}'
        path_len = len((instr.requestpath or '').strip())
        prev = best.get(bucket)
        if not prev or path_len > len((prev.requestpath or '').strip()):
            best[bucket] = instr
        elif path_len == len((prev.requestpath or '').strip()) and instr.pk < prev.pk:
            best[bucket] = instr
    return list(best.values())


def _normalize_upstream_path(path):
    return ((path or '').split('?')[0].split('#')[0].rstrip('/') or '').lower()


def _derive_action_path(upstream_path):
    """
    Coarse navigation bucket for orchestration dedupe.

    Odoo/React may issue many passthrough requests (nav, assets, RPC) for one screen.
    Those share one action_path until the user opens a different module/menu.
    """
    import re
    norm = _normalize_upstream_path(upstream_path)
    if not norm:
        return ''

    low = norm if norm.startswith('/') else f'/{norm}'

    if 'account.move' in low or 'account_move' in low:
        return 'odoo:accounting'
    if '/odoo/accounting' in low:
        # One bucket for /odoo/accounting and /odoo/accounting/{menu_id} — Odoo SPA
        # hits both during a single Invoicing navigation; menu_id suffix caused double CallBackData.
        return 'odoo:accounting'

    rpc = re.search(r'/web/dataset/call_kw/([^/]+)', low)
    if rpc and 'account' in rpc.group(1).replace('_', '.'):
        return 'odoo:accounting'

    odoo_nav = re.match(r'/?odoo/([^/]+)(?:/(\d+))?', norm)
    if odoo_nav:
        module, menu_id = odoo_nav.group(1), odoo_nav.group(2)
        return f'odoo:{module}:{menu_id}' if menu_id else f'odoo:{module}'

    return norm


_ORCH_ACTION_GATE_KEY = 'orch_action_gate'
_LEGACY_ORCH_GATE_KEY = 'orch_callback_gate'


def _get_action_gate(request):
    if not hasattr(request, 'session'):
        return {}
    gate = request.session.get(_ORCH_ACTION_GATE_KEY)
    if gate:
        return gate
    return request.session.get(_LEGACY_ORCH_GATE_KEY) or {}


def _set_action_gate(request, gate):
    if not hasattr(request, 'session'):
        return
    request.session[_ORCH_ACTION_GATE_KEY] = gate
    request.session.modified = True


def _tenant_gate_key(tenant):
    return (
        getattr(tenant, 'schema_name', None)
        or getattr(tenant, 'slug', None)
        or str(getattr(tenant, 'pk', '') or '')
    )


def _sync_orchestration_action_gate(request, tenant, upstream_path):
    """
    Reset per-instruction orchestration when the user reaches a new action path.

    While they stay on one screen, each Instruction runs its atomic service at most once
    (SPA re-renders and duplicate RPCs are suppressed).
    """
    if not hasattr(request, 'session'):
        return
    action_path = _derive_action_path(upstream_path)
    tenant_key = _tenant_gate_key(tenant)
    gate = _get_action_gate(request)
    if gate.get('tenant') != tenant_key or gate.get('action_path') != action_path:
        _set_action_gate(request, {
            'tenant': tenant_key,
            'action_path': action_path,
            'executed_instruction_ids': [],
            'executed_event_keys': [],
        })
        orch_log(
            'action_gate_reset',
            tenant=tenant_key,
            action_path=action_path,
            upstream=_normalize_upstream_path(upstream_path),
        )


def _instruction_executed_at_action(request, instruction_row):
    """True if this Instruction (or its eventKey) already ran at the current action path."""
    gate = _get_action_gate(request)
    event_key = (getattr(instruction_row, 'eventKey', None) or '').strip()
    if event_key:
        executed_keys = gate.get('executed_event_keys') or []
        if event_key in executed_keys:
            return True
    executed = gate.get('executed_instruction_ids') or []
    instr_id = instruction_row.id
    return instr_id in executed or str(instr_id) in [str(x) for x in executed]


def _mark_instruction_executed_at_action(request, instruction_row):
    if not hasattr(request, 'session'):
        return
    gate = dict(_get_action_gate(request))
    executed = list(gate.get('executed_instruction_ids') or [])
    instr_id = instruction_row.id
    if instr_id not in executed and str(instr_id) not in [str(x) for x in executed]:
        executed.append(instr_id)
    gate['executed_instruction_ids'] = executed
    event_key = (getattr(instruction_row, 'eventKey', None) or '').strip()
    if event_key:
        keys = list(gate.get('executed_event_keys') or [])
        if event_key not in keys:
            keys.append(event_key)
        gate['executed_event_keys'] = keys
    _set_action_gate(request, gate)


def _sync_callback_path_gate(request, tenant, upstream_path):
    """Backward-compatible alias — action gate supersedes raw-path callback gate."""
    _sync_orchestration_action_gate(request, tenant, upstream_path)


def _instruction_already_saved_at_current_path(request, instruction_row):
    """Alias: execution gate covers atomic service + CallBackData."""
    return _instruction_executed_at_action(request, instruction_row)


def _mark_instruction_saved_at_current_path(request, instruction_row):
    _mark_instruction_executed_at_action(request, instruction_row)


def check_orchestration_trigger(request, upstream_path, app_name, tenant,
                               direction='REQ', upstream_response=None):
    """Check if upstream_path matches any Instruction and fire orchestration."""
    if not tenant:
        orch_log('abort_no_tenant', path=upstream_path, direction=direction)
        return {'matched': 0, 'saved': 0}

    method = request.method.upper()
    _sync_orchestration_action_gate(request, tenant, upstream_path)
    log_request_trace(request, tenant, upstream_path, app_name, direction)

    instructions = _load_instructions_for_direction(tenant, direction)
    log_instruction_catalog(instructions, upstream_path, method, direction)

    matched = []
    for instr in instructions:
        if not _instruction_belongs_to_tenant(instr, tenant):
            orch_log(
                'skip_tenant',
                id=instr.id,
                instr_tenant=instr.tenant_id,
                tenant=getattr(tenant, 'pk', None),
            )
            continue
        if not _instruction_passes_requestmethod(instr, method):
            orch_log(
                'skip_requestmethod',
                id=instr.id,
                want=instr.requestmethod,
                got=method,
                path=instr.requestpath,
            )
            continue
        if _instruction_matches(instr, upstream_path, method):
            matched.append(instr)
        else:
            orch_log(
                'no_match',
                id=instr.id,
                path=instr.requestpath,
                reason=match_failure_reason(instr, upstream_path, method),
            )

    orch_log('match_result', direction=direction, matched=len(matched), path=upstream_path, method=method)

    matched = _collapse_overlapping_matches(matched)
    orch_log('match_collapsed', direction=direction, matched=len(matched), path=upstream_path, method=method)

    if not matched:
        write_request_log(
            request, tenant, upstream_path,
            f'no instruction match ({direction} {method})',
        )
        return {'matched': 0, 'saved': 0}

    from dose.services.atomic_services_registry import (
        get_atomic_service,
        init_atomic_services_registry,
        normalize_executescript_value,
    )
    init_atomic_services_registry()
    tenant_name = getattr(tenant, 'schema_name', None)
    saved_count = 0

    for instruction_row in matched:
        if _instruction_executed_at_action(request, instruction_row):
            gate = _get_action_gate(request)
            orch_log(
                'orch_skipped_repeat_at_action',
                instruction_id=instruction_row.id,
                action_path=gate.get('action_path'),
                upstream=_normalize_upstream_path(upstream_path),
                hint='Atomic service already ran for this instruction at current action path',
            )
            continue

        _mark_instruction_executed_at_action(request, instruction_row)

        executescript_name = normalize_executescript_value(
            getattr(instruction_row, 'executescript', None) or ''
        )
        atomic_result = {
            'status': 'success',
            'path': upstream_path,
            'method': method,
            'direction': direction,
            'instruction_id': instruction_row.id,
            'eventKey': getattr(instruction_row, 'eventKey', ''),
        }

        if executescript_name:
            cls = get_atomic_service(executescript_name, tenant_name=tenant_name)
            if not cls or not hasattr(cls, 'execute_and_save'):
                orch_log('service_not_found', name=executescript_name, instruction_id=instruction_row.id)
                atomic_result['status'] = 'skipped'
                atomic_result['error'] = f'Service {executescript_name!r} not in registry'
            else:
                orch_log('service_execute', name=executescript_name, instruction_id=instruction_row.id)
                if upstream_response is not None:
                    request._upstream_response = upstream_response
                try:
                    result = cls.execute_and_save(request, instruction_row)
                    if result is not None:
                        if isinstance(result, dict):
                            atomic_result.update(result)
                        else:
                            atomic_result['service_result'] = result
                except Exception as exc:
                    orch_log_exception('service_failed', exc, name=executescript_name)
                    atomic_result = {'status': 'error', 'error': str(exc), **atomic_result}
        else:
            orch_log('match_no_executescript', instruction_id=instruction_row.id)

        if _save_callback_data(request, instruction_row, atomic_result, tenant):
            saved_count += 1
        _create_dose_message(request, instruction_row, atomic_result, executescript_name or 'OrchestratedEvent')

    write_request_log(
        request, tenant, upstream_path,
        f'matched {len(matched)} instruction(s), saved {saved_count} CallBackData row(s)',
    )
    return {'matched': len(matched), 'saved': saved_count}


def _save_callback_data(request, instruction_row, atomic_result, tenant):
    """Persist orchestration result to CallBackData for audit trail."""
    save_flag = getattr(instruction_row, 'save_callbackdata', False)
    if not save_flag:
        orch_log(
            'callback_skipped_flag',
            instruction_id=instruction_row.id,
            save_callbackdata=False,
            hint='Enable save_callbackdata on the Instruction to persist CallBackData',
        )
        return False

    try:
        from dose.models import CallBackData

        if not ensure_tenant_search_path(tenant, 'callback_data'):
            return False

        description = getattr(instruction_row, 'description', '') or ''
        if not description or description.strip().lower() == 'description':
            description = f"{instruction_row.executescript or 'orchestration'} @ {atomic_result.get('path', '?')}"

        payload = atomic_result
        if isinstance(payload, str):
            try:
                payload = json.loads(payload)
            except json.JSONDecodeError:
                payload = {'result': payload}

        cb = CallBackData.objects.create(
            matchingEventKey=getattr(instruction_row, 'eventKey', None),
            description=description[:255],
            callbackdata=payload,
            parameters_json={
                'instruction_id': instruction_row.id,
                'executescript': instruction_row.executescript,
                'direction': atomic_result.get('direction'),
                'method': atomic_result.get('method'),
            },
            tenant=tenant,
        )
        orch_log(
            'callback_saved',
            id=cb.id,
            schema=tenant.schema_name,
            eventKey=instruction_row.eventKey,
            instruction_id=instruction_row.id,
        )
        return True
    except Exception as exc:
        orch_log_exception('callback_save_failed', exc, instruction_id=instruction_row.id)
        return False


def _create_dose_message(request, instruction_row, atomic_result, service_name):
    """Create a DoseMessage so the display shell toast poller picks it up."""
    try:
        from dose.models import DoseMessage

        tenant = getattr(request, 'tenant', None) or getattr(instruction_row, 'tenant', None)
        ensure_tenant_search_path(tenant, 'dose_message')

        user = getattr(request, 'user', None)
        if not user or not getattr(user, 'is_authenticated', False):
            user = None

        status = 'success'
        if isinstance(atomic_result, dict) and atomic_result.get('status') in ('error', 'failed'):
            status = 'error'

        event_key = getattr(instruction_row, 'eventKey', '') or ''
        msg_text = f"Orchestration: {service_name} executed ({event_key})" if event_key else f"Orchestration: {service_name} executed"
        if isinstance(atomic_result, dict):
            if atomic_result.get('invoice_ref'):
                msg_text = f"Invoice {atomic_result['invoice_ref']} detected — orchestration triggered"
            elif atomic_result.get('event') == 'navigation':
                ok = atomic_result.get('status') == 'sent'
                msg_text = f"Invoices page viewed — {'Mattermost notified ✓' if ok else 'Mattermost notify failed'}"

        DoseMessage.objects.create(user=user, message=msg_text, level=status)
        orch_log('dose_message_saved', message=msg_text[:120])
    except Exception as exc:
        orch_log_exception('dose_message_failed', exc)
