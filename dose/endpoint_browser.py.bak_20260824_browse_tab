from urllib.parse import urljoin, urlsplit, urlunsplit

from dose.passthrough.registry import resolve_handler_for_endpoint


def safe_browser_launch_url(endpoint, relative_path: str | None = None) -> str:
    """Return a top-level http(s) URL or an empty string for unsafe targets."""
    candidate = ""
    handler = resolve_handler_for_endpoint(endpoint)
    hook = getattr(handler, "endpoint_browser_launch_url", None)
    if callable(hook):
        try:
            candidate = hook(endpoint) or ""
        except Exception:
            candidate = ""
    if not candidate:
        candidate = getattr(endpoint, "endpoint_url", "") or ""

    parsed = urlsplit(candidate)
    if (
        parsed.scheme not in ("http", "https")
        or not parsed.hostname
        or parsed.username
        or parsed.password
    ):
        return ""

    base = urlunsplit((parsed.scheme, parsed.netloc, parsed.path or "/", parsed.query, ""))
    path = (relative_path or "").strip()
    if not path or path == "/":
        return base
    requested = urlsplit(path)
    if requested.scheme:
        if (
            requested.netloc.lower() != parsed.netloc.lower()
            or requested.username
            or requested.password
            or requested.scheme not in ("http", "https")
            or (requested.scheme == "http" and parsed.scheme != "http")
        ):
            return ""
        return urlunsplit(
            (
                requested.scheme,
                requested.netloc,
                requested.path or "/",
                requested.query,
                "",
            )
        )
    if not path.startswith("/") or path.startswith("//") or "\\" in path:
        return ""
    origin = urlunsplit((parsed.scheme, parsed.netloc, "/", "", ""))
    return urljoin(origin, path.lstrip("/"))


def _handler_prefers_top_level_browser(handler, endpoint) -> bool:
    if handler is None:
        return False
    hook = getattr(handler, "prefers_top_level_browser", None)
    if callable(hook):
        try:
            return bool(hook())
        except TypeError:
            try:
                return bool(hook(endpoint))
            except Exception:
                return False
        except Exception:
            return False
    wireframe = getattr(handler, "polysniffer_wireframe_context", None)
    if callable(wireframe):
        try:
            ctx = wireframe(endpoint) or {}
            return bool(ctx.get("enabled"))
        except Exception:
            return False
    return False


def endpoint_browse_target(endpoint) -> dict:
    """Resolve Browse [app] for endpoint home.

    - Passthrough-capable apps (Odoo, Mattermost, Nextcloud, …): same-window
      `/pt/admin/...` embedded execution.
    - Non-proxied SPAs (Slack, HubSpot, …): top-level “dumb browser”; messages
      and consumers stay on the endpoint home pane.
    """
    from dose.endpoint_actions import adapter_for_endpoint

    adapter = adapter_for_endpoint(endpoint)
    if adapter is not None:
        mode = (getattr(adapter, "browse_mode", "") or "").strip().lower()
        if mode == "external":
            url = safe_browser_launch_url(endpoint)
            return {"url": url, "external": True, "mode": "external"}
        if mode == "passthrough":
            passthrough = ""
            if hasattr(endpoint, "get_menu_url"):
                passthrough = endpoint.get_menu_url() or ""
            if not passthrough and hasattr(endpoint, "get_proxy_prefix"):
                passthrough = (endpoint.get_proxy_prefix() or "").rstrip("/") + "/"
            return {"url": passthrough, "external": False, "mode": "passthrough"}

    handler = resolve_handler_for_endpoint(endpoint)
    if _handler_prefers_top_level_browser(handler, endpoint):
        url = safe_browser_launch_url(endpoint)
        return {"url": url, "external": True, "mode": "external"}

    passthrough = ""
    if hasattr(endpoint, "get_menu_url"):
        passthrough = endpoint.get_menu_url() or ""
    if not passthrough and hasattr(endpoint, "get_proxy_prefix"):
        passthrough = (endpoint.get_proxy_prefix() or "").rstrip("/") + "/"
    if passthrough:
        return {"url": passthrough, "external": False, "mode": "passthrough"}

    url = safe_browser_launch_url(endpoint)
    return {"url": url, "external": bool(url), "mode": "external" if url else "none"}
