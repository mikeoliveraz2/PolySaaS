logger = logging.getLogger(__name__)

def get_service_content_from_atomic_service(request, service_name, service_class_name, service_module_path):
    """
    Generic helper to get content from atomic service
    Falls back gracefully if atomic service doesn't exist

    Args:
        request: Django request object
        service_name: Display name of the service (e.g., 'Gmail', 'OSTicket')
        service_class_name: Class name of the atomic service (e.g., 'GmailProxyService')
        service_module_path: Import path (e.g., 'dose.services.gmail_proxy_service')

    Returns:
        str: Service content or None if atomic service not available
    """
    try:
        # Dynamic import of the atomic service
        import importlib
        service_module = importlib.import_module(service_module_path)
        service_class = getattr(service_module, service_class_name)

        # Instantiate and execute the service
        service_instance = service_class()
        service_response = service_instance.execute_and_save(request, None)

        # Extract content
        if hasattr(service_response, 'content'):
            content = service_response.content.decode('utf-8') if isinstance(service_response.content, bytes) else str(service_response.content)
        else:
            content = str(service_response)

        logger.info(f"{service_name} atomic service provided custom content")
        return content

    except ImportError:
        logger.info(f"{service_name} atomic service not available, using fallback")
        return None
    except Exception as e:
        logger.warning(f"{service_name} atomic service error, using fallback: {e}")
        return None

def get_service_data_from_atomic_service(request, service_name, service_class_name, service_module_path):
    """
    Helper to get structured data from atomic service that stores data in instruction_row
    Returns both content and structured data for template rendering

    Args:
        request: Django request object
        service_name: Display name of the service (e.g., 'Gmail', 'OSTicket')
        service_class_name: Class name of the atomic service (e.g., 'GmailProxyService')
        service_module_path: Import path (e.g., 'dose.services.gmail_proxy_service')

    Returns:
        tuple: (content_string, structured_data_dict) or (None, None) if not available
    """
    try:
        from dose.models import AtomicServiceInstructionTracker

        # Dynamic import of the atomic service
        import importlib
        service_module = importlib.import_module(service_module_path)
        service_class = getattr(service_module, service_class_name)

        # Create an instruction tracker to store data
        instruction_row = AtomicServiceInstructionTracker.objects.create(
            user=request.user,
            service_name=service_name,
            instruction_text=f"{service_name} passthrough request",
            tenant=getattr(request, 'tenant', None)
        )

        # Instantiate and execute the service
        service_instance = service_class()
        service_response = service_instance.execute_and_save(request, instruction_row)

        # Get structured data from instruction_row if available
        structured_data = getattr(instruction_row, 'response_output', None)

        # Get content as string
        if hasattr(service_response, 'content'):
            content = service_response.content.decode('utf-8') if isinstance(service_response.content, bytes) else str(service_response.content)
        else:
            content = str(service_response)

        logger.info(f"{service_name} atomic service provided structured data and content")
        logger.debug(f"[DEBUG] Content: {content[:100] if content else 'None'}...")
        logger.debug(f"[DEBUG] Structured data: {structured_data}")
        return content, structured_data

    except ImportError:
        logger.info(f"{service_name} atomic service not available, using fallback")
        return None, None
    except Exception as e:
        logger.warning(f"{service_name} atomic service error, using fallback: {e}")
        return None, None

@login_required
def passthrough_service(request, service, page=None):
    """
    Main passthrough view for external services
    Routes to appropriate service handler based on service parameter
    URL pattern: /admin/passthrough/<service>/
    URL pattern: /admin/passthrough/<service>/<path:page>
    """
    logger.info(f"Passthrough request: service={service}, page={page}, user={request.user.username}")

    # Service routing
    service_handlers = {
        'gmail': handle_gmail_passthrough,
        'osticket': handle_osticket_passthrough,
        # Future services can be added here
    }

    handler = service_handlers.get(service.lower())
    if not handler:
        logger.warning(f"Unknown service requested: {service}")
        return HttpResponseNotFound(f"Service '{service}' not found")

    return handler(request)

