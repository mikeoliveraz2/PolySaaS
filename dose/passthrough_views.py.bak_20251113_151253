def generic_html_passthrough(request, real_endpoint, real_domain, real_path, proxy_path, service_name):
    """
    Generic HTML passthrough handler for any external service endpoint.
    Handles both GET and POST requests, forwarding to the real endpoint.
    Rewrites HTML URLs to proxy paths so all asset requests route through Django.

    Uses Django session to persist external service cookies across requests.

    Args:
        request: Django request (can be GET or POST)
        real_endpoint: Full URL to real service endpoint for initial GET (e.g., https://service.com/scp/dashboard.php)
        real_domain: Domain only (e.g., https://service.com)
        real_path: Path prefix to replace (e.g., /scp/)
        proxy_path: Local proxy path replacement (e.g., /admin/passthrough/service/)
        service_name: Display name for logging

    Returns:
        HttpResponse with rewritten HTML content or forwarded response
    """
    import requests
    from http.cookiejar import Cookie
    from django.http import HttpResponse
    from datetime import datetime, timedelta

    logger.info(f"Generic HTML passthrough: {service_name}, method={request.method}, path={request.path}")

    try:
        # Create a session object to persist cookies
        session = requests.Session()

        # Restore any previously saved cookies from Django session
        service_cookies_key = f"_passthrough_cookies_{service_name.lower()}"
        if service_cookies_key in request.session:
            logger.info(f"Restoring saved cookies for {service_name}")
            saved_cookies = request.session[service_cookies_key]
            for cookie_dict in saved_cookies:
                session.cookies.set(
                    name=cookie_dict['name'],
                    value=cookie_dict['value'],
                    domain=cookie_dict.get('domain', ''),
                    path=cookie_dict.get('path', '/'),
                )
                logger.info(f"  Restored cookie: {cookie_dict['name']}={cookie_dict['value'][:20]}...")

        # Extract the requested path relative to proxy_path
        # E.g., /admin/passthrough/osticket/css/login.css -> css/login.css
        request_path = request.path
        if request_path.startswith(proxy_path):
            relative_path = request_path[len(proxy_path):]  # Strip the proxy_path prefix
        else:
            relative_path = ""

        logger.info(f"Request path: {request_path}, relative_path: {relative_path}")

        # Build the real endpoint URL
        # If it's an asset request (has relative_path), use that; otherwise use the default endpoint
        if relative_path:
            # Asset request: /admin/passthrough/osticket/css/login.css
            real_url = real_domain + real_path + relative_path
            logger.info(f"Asset request: {real_url}")
        else:
            # Main page request
            real_url = real_endpoint
            logger.info(f"Main page request: {real_url}")

        # Make the request to the real server
        if request.method == 'POST':
            # Forward POST with form data, maintaining cookies
            logger.info(f"POST request to {real_url}")
            logger.info(f"POST data fields: {list(request.POST.keys())}")
            response = session.post(
                real_url,
                data=request.POST.dict(),
                headers={'User-Agent': request.META.get('HTTP_USER_AGENT', '')},
                verify=False,
                timeout=10,
                allow_redirects=False
            )
        else:
            # GET request to real server, maintaining cookies
            response = session.get(real_url, timeout=10, verify=False)

        # Save any new cookies back to Django session
        if len(session.cookies) > 0:
            logger.info(f"Saving {len(session.cookies)} cookies to Django session")
            cookies_to_save = []
            for cookie in session.cookies:
                cookies_to_save.append({
                    'name': cookie.name,
                    'value': cookie.value,
                    'domain': cookie.domain,
                    'path': cookie.path,
                })
                logger.info(f"  Saving cookie: {cookie.name}={cookie.value[:20]}...")
            request.session[service_cookies_key] = cookies_to_save
            request.session.modified = True

        # Handle redirects for POST requests (common after login)
        if request.method == 'POST' and response.status_code in [301, 302, 303, 307, 308]:
            redirect_url = response.headers.get('Location', '')
            logger.info(f"POST request resulted in redirect: {response.status_code} to {redirect_url}")

            if redirect_url:
                # Extract the path from the redirect URL
                from urllib.parse import urlparse
                parsed = urlparse(redirect_url)
                redirect_path = parsed.path

                # If it's redirecting to the same domain, rewrite to proxy path
                if parsed.netloc == urlparse(real_domain).netloc or not parsed.netloc:
                    logger.info(f"Redirect is to same domain, rewriting to proxy path")
                    # Build new path relative to real_path
                    if redirect_path.startswith(real_path):
                        relative_redirect = redirect_path[len(real_path):]
                    else:
                        relative_redirect = redirect_path.lstrip('/')

                    proxy_redirect = f"{proxy_path}{relative_redirect}"
                    logger.info(f"Rewritten redirect: {proxy_redirect}")

                    # Make a GET request to the redirect URL to get the dashboard or next page
                    redirect_response = session.get(
                        real_domain + redirect_path if redirect_path.startswith('/') else real_domain + '/' + redirect_path,
                        timeout=10,
                        verify=False
                    )
                    response = redirect_response
                    logger.info(f"Following redirect to get dashboard content")

        # Check if this is an HTML response or an asset
        content_type = response.headers.get('content-type', '').lower()
        is_html = 'text/html' in content_type
        is_json = 'application/json' in content_type

        logger.info(f"\n{'='*120}")
        logger.info(f"RESPONSE RECEIVED FROM {service_name.upper()}")
        logger.info(f"{'='*120}")
        logger.info(f"Request Method: {request.method}")
        logger.info(f"Request Path: {request.path}")
        logger.info(f"Real Endpoint Called: {real_url}")
        logger.info(f"Status Code: {response.status_code}")
        logger.info(f"Content-Type: {content_type}")
        logger.info(f"Is HTML: {is_html}")
        logger.info(f"Is JSON: {is_json}")
        logger.info(f"{'='*120}\n")

        # Handle JSON responses (like AJAX login forms)
        if is_json:
            logger.info(f"JSON response from {service_name}, parsing...")
            try:
                import json
                json_data = json.loads(response.text)
                logger.info(f"JSON response: {json_data}")

                # Check if login was successful (common patterns)
                is_success = (
                    json_data.get('success') or
                    json_data.get('status') == 'success' or
                    json_data.get('redirect') or
                    response.status_code == 200
                )

                if is_success and json_data.get('redirect'):
                    # Follow the redirect in the JSON response
                    redirect_path = json_data.get('redirect')
                    logger.info(f"JSON response contains redirect to: {redirect_path}")

                    redirect_response = session.get(
                        real_domain + redirect_path if redirect_path.startswith('/') else real_domain + '/' + redirect_path,
                        timeout=10,
                        verify=False
                    )
                    response = redirect_response
                    logger.info(f"Following JSON redirect to get dashboard content")

                    # Re-check content type after redirect
                    content_type = response.headers.get('content-type', '').lower()
                    is_html = 'text/html' in content_type
                    is_json = 'application/json' in content_type
                else:
                    # Return JSON as-is for AJAX responses
                    logger.info(f"Returning JSON response as-is")
                    return HttpResponse(response.content, content_type=content_type, status=response.status_code)
            except json.JSONDecodeError:
                logger.warning(f"Failed to parse JSON response from {service_name}")
                return HttpResponse(response.content, content_type=content_type, status=response.status_code)

        # If this is NOT HTML (CSS, JS, image, etc.), return it as-is without rewriting
        if not is_html:
            logger.info(f"Asset response (not HTML), returning as-is with content-type: {content_type}")
            return HttpResponse(response.content, content_type=content_type, status=response.status_code)

        # From here on, we only process HTML responses
        html_original = response.text
        html = html_original

        logger.info(f"Original HTML size: {len(html_original)} bytes")
        logger.info(f"\n--- ORIGINAL HTML (first 2000 chars) ---")
        logger.info(html_original[:2000])
        logger.info(f"\n{'='*120}\n")

        import re
        from bs4 import BeautifulSoup

        # Parse HTML with BeautifulSoup for reliable attribute replacement
        soup = BeautifulSoup(html_original, 'html.parser')

        logger.info(f"Parsed HTML with BeautifulSoup")
        logger.info(f"  Found {len(soup.find_all('form'))} forms")
        logger.info(f"  Found {len(soup.find_all('a'))} links")
        logger.info(f"  Found {len(soup.find_all('link'))} <link> tags")
        logger.info(f"  Found {len(soup.find_all('img'))} images")
        logger.info(f"  Found {len(soup.find_all('script', src=True))} scripts with src")

        # STRATEGY: Rewrite ALL URLs to proxy paths so everything routes through Django
        # This allows Django to manage sessions for asset requests
        # Pattern: /scp/css/login.css -> /admin/passthrough/osticket/css/login.css

        # 1. Rewrite all form actions to proxy paths (will be forwarded to real server)
        form_count = 0
        for form in soup.find_all('form'):
            action = form.get('action', '')
            if action and not action.startswith(('http', '#')):
                # Convert any path to proxy path
                if action.startswith('//'):
                    form['action'] = f"{proxy_path}{action.lstrip('/')}"
                elif action.startswith('/'):
                    # Root-relative: /login.php -> /admin/passthrough/osticket/login.php
                    form['action'] = f"{proxy_path}{action.lstrip('/')}"
                else:
                    # Relative: login.php or ../path/login.php
                    form['action'] = f"{proxy_path}{action.lstrip('./')}"
                logger.info(f"  Rewrote form action: {action} → {form['action']}")
                form_count += 1
        logger.info(f"Rewrote {form_count} form actions")

        # 2. Rewrite all link hrefs to proxy paths
        link_count = 0
        for link in soup.find_all('a'):
            href = link.get('href', '')
            if href and not href.startswith(('http', '#', 'mailto:', 'tel:', 'data:')):
                if href.startswith('//'):
                    link['href'] = f"{proxy_path}{href.lstrip('/')}"
                elif href.startswith('/'):
                    link['href'] = f"{proxy_path}{href.lstrip('/')}"
                else:
                    link['href'] = f"{proxy_path}{href.lstrip('./')}"
                link_count += 1
        logger.info(f"Rewrote {link_count} link hrefs")

        # 3. Rewrite all CSS link hrefs to proxy paths
        css_count = 0
        for link in soup.find_all('link', href=True):
            href = link.get('href', '')
            if href and not href.startswith(('http', '#', 'data:')):
                # Handle absolute paths (/path), relative paths (../path, path), and protocol-relative (//domain)
                if href.startswith('//'):
                    # Protocol-relative URL like //cdn.example.com/file.css
                    link['href'] = f"{proxy_path}{href.lstrip('/')}"
                elif href.startswith('/'):
                    # Absolute path /css/style.css
                    link['href'] = f"{proxy_path}{href.lstrip('/')}"
                else:
                    # Relative path css/style.css or ../css/style.css
                    # For simplicity, treat all relative paths as if they're relative to /scp/
                    link['href'] = f"{proxy_path}{href.lstrip('./')}"
                logger.info(f"  Rewrote CSS href: {href} → {link['href']}")
                css_count += 1
        logger.info(f"Rewrote {css_count} CSS hrefs")

        # 4. Rewrite all image sources to proxy paths
        img_count = 0
        for img in soup.find_all('img'):
            src = img.get('src', '')
            if src and not src.startswith(('http', '#', 'data:')):
                if src.startswith('//'):
                    img['src'] = f"{proxy_path}{src.lstrip('/')}"
                elif src.startswith('/'):
                    img['src'] = f"{proxy_path}{src.lstrip('/')}"
                else:
                    img['src'] = f"{proxy_path}{src.lstrip('./')}"
                logger.info(f"  Rewrote img src: {src} → {img['src']}")
                img_count += 1
        logger.info(f"Rewrote {img_count} image sources")

        # 5. Rewrite all script sources to proxy paths
        script_count = 0
        for script in soup.find_all('script', src=True):
            src = script.get('src', '')
            if src and not src.startswith(('http', '#', 'data:')):
                if src.startswith('//'):
                    script['src'] = f"{proxy_path}{src.lstrip('/')}"
                elif src.startswith('/'):
                    script['src'] = f"{proxy_path}{src.lstrip('/')}"
                else:
                    script['src'] = f"{proxy_path}{src.lstrip('./')}"
                logger.info(f"  Rewrote script src: {src} → {script['src']}")
                script_count += 1
        logger.info(f"Rewrote {script_count} script sources")

        # Convert back to HTML string
        html = str(soup)
        logger.info(f"BeautifulSoup replacement complete")
        logger.info(f"Checking: css/login.css in html? {'css/login.css' in html}")
        logger.info(f"Checking: https://oliverenterprises.app.saasify.cloud/scp/css/login.css in html? {'https://oliverenterprises.app.saasify.cloud/scp/css/login.css' in html}")

        logger.info(f"\n{'='*120}")
        logger.info(f"HTML REPLACEMENT COMPLETE")
        logger.info(f"{'='*120}")
        logger.info(f"Modified HTML size: {len(html)} bytes")
        logger.info(f"Size difference: {len(html) - len(html_original):+d} bytes")
        logger.info(f"\n--- MODIFIED HTML (checking CSS paths, first 3000 chars) ---")
        logger.info(html[:3000])
        logger.info(f"\n{'='*120}\n")

        logger.info(f"{service_name} HTML passthrough successful")

        # Inject CSRF token into all forms so POST requests work
        from django.middleware.csrf import get_token
        csrf_token = get_token(request)

        import re
        html = re.sub(
            r'(<form[^>]*>)',
            f'\\1\n<input type="hidden" name="csrfmiddlewaretoken" value="{csrf_token}">',
            html
        )

        logger.info(f"{service_name} HTML passthrough successful, injected CSRF token")

        # Return the processed HTML directly - 100% page replacement like Flask tester
        # No wrapping, no admin template, just the raw processed HTML
        logger.info(f"Returning {service_name} HTML directly to browser")
        return HttpResponse(html, content_type='text/html', status=response.status_code)

    except requests.exceptions.RequestException as e:
        logger.error(f"{service_name} passthrough error: {e}")
        error_html = f"<h1 style='color:red;'>{service_name} Connection Error</h1><p>Error: {str(e)}</p>"
        context = site.each_context(request)
        context.update({'service_name': service_name, 'service_content': error_html})
        return TemplateResponse(request, 'admin/passthrough.html', context, status=502)
    except Exception as e:
        logger.error(f"{service_name} passthrough error: {e}")
        import traceback
        logger.error(traceback.format_exc())
        error_html = f"<h1 style='color:red;'>{service_name} Error</h1><p>Error: {str(e)}</p>"
        context = site.each_context(request)
        context.update({'service_name': service_name, 'service_content': error_html})
        return TemplateResponse(request, 'admin/passthrough.html', context, status=502)
