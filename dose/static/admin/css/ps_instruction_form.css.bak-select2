/**
 * Instruction add/change — readable selects in dark mode (admin + orchestration embed).
 */
#instruction_form select.ps-instruction-select,
.model-instruction.change-form select.ps-instruction-select {
    width: 100%;
    max-width: 520px;
}

/* Closed select + native dropdown list (Windows / Chromium) */
html[data-ps-theme="darkly"] #instruction_form select,
html[data-ps-theme="cyborg"] #instruction_form select,
html[data-ps-theme="slate"] #instruction_form select,
html[data-ps-theme="solar"] #instruction_form select,
html[data-ps-theme="superhero"] #instruction_form select,
html[data-bs-theme="dark"] #instruction_form select,
body.ps-orch-embed-dark #instruction_form select {
    color-scheme: dark;
    background-color: #0f172a !important;
    color: #f1f5f9 !important;
    border-color: #475569 !important;
}

html[data-ps-theme="darkly"] #instruction_form select option,
html[data-ps-theme="cyborg"] #instruction_form select option,
html[data-ps-theme="slate"] #instruction_form select option,
html[data-ps-theme="solar"] #instruction_form select option,
html[data-ps-theme="superhero"] #instruction_form select option,
html[data-bs-theme="dark"] #instruction_form select option,
body.ps-orch-embed-dark #instruction_form select option,
html[data-ps-theme="darkly"] #instruction_form select optgroup,
html[data-ps-theme="cyborg"] #instruction_form select optgroup,
html[data-ps-theme="slate"] #instruction_form select optgroup,
html[data-ps-theme="solar"] #instruction_form select optgroup,
html[data-ps-theme="superhero"] #instruction_form select optgroup,
html[data-bs-theme="dark"] #instruction_form select optgroup,
body.ps-orch-embed-dark #instruction_form select optgroup {
    background-color: #1e293b !important;
    color: #f8fafc !important;
}

html[data-ps-theme="darkly"] #instruction_form select option:checked,
html[data-ps-theme="cyborg"] #instruction_form select option:checked,
html[data-ps-theme="slate"] #instruction_form select option:checked,
html[data-ps-theme="solar"] #instruction_form select option:checked,
html[data-ps-theme="superhero"] #instruction_form select option:checked,
html[data-bs-theme="dark"] #instruction_form select option:checked,
body.ps-orch-embed-dark #instruction_form select option:checked {
    background-color: #2563eb !important;
    color: #ffffff !important;
}
