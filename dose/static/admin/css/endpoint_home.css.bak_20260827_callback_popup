/* BINGO: Slack producer/consumer home — 2026-08-24 */
.polysaas-endpoint-home {
    display: grid;
    gap: 16px;
    padding: 16px;
}
.polysaas-endpoint-home__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
}
.polysaas-endpoint-home__title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
}
.polysaas-endpoint-home__logo {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    object-fit: cover;
    background: #000;
    box-shadow: 0 0 0 1px rgba(148, 163, 184, 0.35);
}
.polysaas-endpoint-home__title-text {
    min-width: 0;
}
.polysaas-endpoint-home__header h1,
.polysaas-endpoint-home__title {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
    color: #111827 !important;
}
.polysaas-endpoint-home__lede {
    margin-top: 2px;
    font-size: 14px;
    line-height: 1.35;
    color: #4b5563 !important;
}
.polysaas-endpoint-home__launch {
    padding: 9px 14px;
    border-radius: 6px;
    background: #2563eb;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
}
.polysaas-endpoint-bookmark--browse {
    background: #2563eb !important;
    border-color: #2563eb !important;
    color: #fff !important;
    font-weight: 700;
}
.polysaas-endpoint-home__bookmarks {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding: 12px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    background: rgba(255, 255, 255, .06);
}
.polysaas-endpoint-bookmark {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 8px 12px;
    border: 1px solid #9ca3af;
    border-radius: 6px;
    background: #fff;
    color: #111827 !important;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
}
.polysaas-endpoint-home__create {
    background: #f8fafc;
}
.polysaas-endpoint-bookmark--create {
    background: #fff;
}
.polysaas-endpoint-bookmark:hover {
    border-color: #2563eb;
}
.polysaas-endpoint-bookmark[disabled] {
    opacity: .5;
    cursor: not-allowed;
}
.polysaas-endpoint-home__surface {
    display: grid;
    gap: 16px;
    min-height: 0;
    overflow: hidden;
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 16px;
    background: #111827;
}
.polysaas-endpoint-home__panel {
    display: grid;
    gap: 12px;
    color: #e5e7eb;
}
.polysaas-endpoint-home__placeholder {
    display: grid;
    place-items: center;
    min-height: 160px;
    padding: 24px;
    text-align: center;
    background: #1a1d21;
    color: #e5e7eb;
    border-radius: 8px;
}
.polysaas-endpoint-home__empty-note {
    padding: 12px 14px;
    border: 1px dashed #374151;
    border-radius: 8px;
    color: #9ca3af;
    font-size: 13px;
}
.polysaas-endpoint-home__consumers {
    display: grid;
    gap: 12px;
    padding: 16px;
    background: #111827;
    color: #e5e7eb;
    min-height: 280px;
}
.polysaas-endpoint-home__consumers-head h2 {
    margin: 0 0 4px;
    font-size: 18px;
    color: #fff;
}
.polysaas-endpoint-home__consumers-head p {
    margin: 0;
    color: #9ca3af;
    font-size: 13px;
}
.polysaas-consumer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
}
.polysaas-consumer-list__item {
    display: flex;
    align-items: stretch;
    gap: 8px;
    border: 1px solid #374151;
    border-radius: 8px;
    background: #1a1d21;
    overflow: hidden;
}
.polysaas-consumer-list__link {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 4px;
    padding: 12px 14px;
    color: inherit;
    text-decoration: none;
}
.polysaas-consumer-list__link:hover {
    background: #222529;
}
.polysaas-consumer-list__title {
    font-weight: 700;
    color: #fff;
}
.polysaas-consumer-list__meta {
    font: 12px Consolas, monospace;
    color: #86efac;
}
.polysaas-consumer-list__meta code {
    color: #93c5fd;
}
.polysaas-consumer-list__event {
    font-size: 12px;
    color: #9ca3af;
}
.polysaas-consumer-list__fed {
    font-size: 12px;
    color: #fbbf24;
}
.polysaas-producer-state {
    display: inline-block;
    margin-top: 2px;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    width: fit-content;
}
.polysaas-producer-state--paired {
    background: #14532d;
    color: #86efac;
}
.polysaas-producer-state--unpaired {
    background: #3f3f46;
    color: #d4d4d8;
}
.polysaas-consumer-list__run {
    flex: 0 0 auto;
    margin: 8px;
    padding: 8px 14px;
    border: 0;
    border-radius: 6px;
    background: #007a5a;
    color: #fff;
    font-weight: 700;
    cursor: pointer;
}
.polysaas-consumer-list__run:hover {
    background: #148567;
}
.polysaas-producer-pair {
    background: #2563eb;
}
.polysaas-producer-pair:hover {
    background: #1d4ed8;
}
.polysaas-pair-dialog {
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 0;
    background: #111827;
    color: #e5e7eb;
    max-width: 420px;
    width: calc(100% - 32px);
}
.polysaas-pair-dialog::backdrop {
    background: rgba(0, 0, 0, 0.55);
}
.polysaas-pair-dialog__form {
    display: grid;
    gap: 12px;
    padding: 16px;
}
.polysaas-pair-dialog__form h3 {
    margin: 0;
    color: #fff;
}
.polysaas-pair-dialog__hint {
    margin: 0;
    font-size: 13px;
    color: #9ca3af;
}
.polysaas-pair-dialog__list {
    display: grid;
    gap: 8px;
    max-height: 240px;
    overflow: auto;
}
.polysaas-pair-dialog__list label {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    padding: 8px;
    border: 1px solid #374151;
    border-radius: 6px;
    background: #1a1d21;
    font-size: 13px;
}
.polysaas-pair-dialog__actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}
.polysaas-pair-dialog__cancel,
.polysaas-pair-dialog__save {
    padding: 8px 12px;
    border-radius: 6px;
    border: 0;
    font-weight: 700;
    cursor: pointer;
}
.polysaas-pair-dialog__cancel {
    background: #374151;
    color: #e5e7eb;
}
.polysaas-pair-dialog__save {
    background: #2563eb;
    color: #fff;
}
/* Keep popup forms available without showing the full mock surface. */
.polysaas-endpoint-home__form-host {
    position: fixed;
    inset: 0;
    z-index: 4000;
    pointer-events: none;
}
.polysaas-endpoint-home__form-host .ps-slack-mock {
    position: absolute;
    inset: 0;
    min-height: 0;
    display: block;
    background: transparent;
    pointer-events: none;
}
.polysaas-endpoint-home__form-host .ps-slack-mock > :not(.ps-slack-mock__modal):not(style):not(script) {
    display: none !important;
}
.polysaas-endpoint-home__form-host .ps-slack-mock__modal {
    pointer-events: auto;
}
.polysaas-transaction-bar,
#polysaas-orchestration-bar.polysaas-transaction-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 8px 15px;
    border-bottom: 3px solid #0f0;
    background: #1a1a1a;
    color: #0f0;
    font: 14px Consolas, monospace;
}
.polysaas-transaction-bar__meta {
    color: #86efac;
    font-size: 13px;
}
.polysaas-transaction-bar code,
#polysaas-orchestration-bar #pss-action-path {
    background: rgba(255, 255, 255, 0.15);
    color: #86efac;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 12px;
}
.polysaas-transaction-bar__event {
    display: none;
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 3px;
    background: #166534;
    color: #86efac;
    font-size: 12px;
}
#polysaas-orchestration-bar #pss-orch-status {
    color: #93c5fd;
}
