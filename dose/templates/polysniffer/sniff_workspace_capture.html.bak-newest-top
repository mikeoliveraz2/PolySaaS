<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>PolySniffer Live Capture</title>
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; height: 100%; overflow: hidden; background: #1a1a1a; color: #f0f0f0; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        .header {
            background: #2a2a2a;
            padding: 10px 14px;
            border-bottom: 2px solid #0f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }
        .header h1 { margin: 0; font-size: 16px; color: #0f0; }
        .header p { margin: 2px 0 0; color: #ccc; font-size: 12px; }
        .status { padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; background: #1b5e20; color: #4caf50; }
        .stats {
            background: #2a2a2a;
            padding: 8px 14px;
            border-bottom: 1px solid #444;
            font-size: 12px;
            color: #aaa;
        }
        .stats span { color: #0f0; font-weight: bold; }
        .captures { padding: 8px 12px; overflow-y: auto; height: calc(100vh - 96px); }
        .capture-item {
            background: #2a2a2a;
            border: 1px solid #444;
            border-radius: 6px;
            padding: 10px 12px;
            margin-bottom: 8px;
            cursor: pointer;
        }
        .capture-item:hover { border-color: #0f0; }
        .capture-item.new { animation: flash 0.5s; }
        @keyframes flash { 0% { background: #1b3a1b; } 100% { background: #2a2a2a; } }
        .capture-row { display: flex; align-items: center; gap: 8px; font-size: 13px; }
        .capture-method { font-weight: bold; padding: 2px 8px; border-radius: 3px; font-size: 11px; background: #1565c0; color: #bbdefb; }
        .capture-path { flex: 1; color: #ccc; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .capture-status { font-size: 12px; font-weight: bold; }
        .capture-status.s2xx { color: #4caf50; }
        .capture-status.s3xx { color: #ff9800; }
        .capture-status.s4xx { color: #f44336; }
        .capture-status.s5xx { color: #e91e63; }
        .capture-time { color: #666; font-size: 11px; }
        .capture-detail { display: none; margin-top: 8px; padding-top: 8px; border-top: 1px solid #444; }
        .capture-item.open .capture-detail { display: block; }
        .capture-detail pre { background: #1a1a1a; padding: 8px; border-radius: 4px; font-size: 11px; overflow-x: auto; margin: 0; white-space: pre-wrap; word-break: break-all; }
        .empty { text-align: center; color: #666; padding: 48px 16px; font-size: 14px; line-height: 1.6; }
    </style>
</head>
<body>
<div class="header">
    <div>
        <h1>PolySniffer Live Capture</h1>
        <p>{{ endpoint_label }} · {{ mode|title }} mode</p>
    </div>
    <span class="status" id="status">POLLING</span>
</div>
<div class="stats">
    Captured: <span id="count">0</span> &nbsp;|&nbsp;
    Last update: <span id="last-update">-</span> &nbsp;|&nbsp;
    Session: <span id="session-name">{% if active_session %}{{ active_session.capture_name }}{% else %}none{% endif %}</span>
</div>
{% if mode == 'native' %}
<div class="stats" style="border-bottom:none;color:#888;font-size:11px;">
    {% if browse_external %}
    Native + separate browse tab: page loads through sniff proxy; HubSpot API calls are logged via client ingest.
    {% else %}
    Native: static loads direct from upstream; API traffic is logged through the sniff proxy.
    {% endif %}
</div>
{% elif mode == 'passthrough' %}
<div class="stats" style="border-bottom:none;color:#888;font-size:11px;">
    Passthrough: server-proxied pages plus client-side fetch/XHR from the iframe (direct upstream API).
</div>
{% endif %}
<div class="captures" id="captures">
    <div class="empty">{% if browse_external %}Use the sniff tab (opens when you start capture).{% else %}Browse in the left pane.{% endif %}<br>Captured requests appear here in real time.</div>
</div>
<script>
(function() {
    const pollUrl = '{{ poll_url }}';
    const mode = '{{ mode|escapejs }}';
    let lastId = 0, count = 0;
    const capturesEl = document.getElementById('captures');
    const countEl = document.getElementById('count');
    const updateEl = document.getElementById('last-update');
    const sessionEl = document.getElementById('session-name');

    function sc(code) {
        if (!code) return 's0';
        if (code < 300) return 's2xx';
        if (code < 400) return 's3xx';
        if (code < 500) return 's4xx';
        return 's5xx';
    }

    function add(c) {
        if (capturesEl.querySelector('.empty')) capturesEl.innerHTML = '';
        const div = document.createElement('div');
        div.className = 'capture-item new';
        div.innerHTML =
            '<div class="capture-row">' +
            '<span class="capture-method">' + (c.method || 'GET') + '</span>' +
            '<span class="capture-path" title="' + (c.url || '') + '">' + (c.path || c.client_path || '-') + '</span>' +
            '<span class="capture-status ' + sc(c.status_code) + '">' + (c.status_code || '-') + '</span>' +
            '<span class="capture-time">' + (c.captured_at || '') + '</span>' +
            '</div><div class="capture-detail"><pre>' + (c.url || '') + '</pre></div>';
        div.onclick = function() { div.classList.toggle('open'); };
        capturesEl.prepend(div);
        count += 1;
        countEl.textContent = String(count);
    }

    function poll() {
        fetch(pollUrl + '?mode=' + encodeURIComponent(mode) + '&since_id=' + lastId, { credentials: 'same-origin' })
            .then(function(r) {
                if (!r.ok) throw new Error('poll HTTP ' + r.status);
                return r.json();
            })
            .then(function(data) {
                updateEl.textContent = new Date().toLocaleTimeString();
                if (!data.success) {
                    sessionEl.textContent = data.error || 'poll failed';
                    return;
                }
                if (data.session_name) sessionEl.textContent = data.session_name;
                if (data.warning) console.warn('PolySniffer poll:', data.warning);
                (data.captures || []).forEach(function(c) {
                    if (c.id > lastId) lastId = c.id;
                    add(c);
                });
            })
            .catch(function(e) {
                console.error('PolySniffer poll error:', e);
                updateEl.textContent = 'error';
            });
    }
    setInterval(poll, 1500);
    poll();
})();
</script>
</body>
</html>
