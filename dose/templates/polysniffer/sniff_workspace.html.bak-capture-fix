<!-- BINGO: PolySniffer 2.0 Native Login Workspace — 2026-06-24 -->
<!-- BINGO: PolySniffer 2.0 Passthrough Workspace Iframe — 2026-06-24 -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>PolySniffer 2.0 — {% firstof endpoint_label "Workspace" %}</title>
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; height: 100%; overflow: hidden; background: #111827; color: #e5e7eb; font-family: system-ui, sans-serif; }
        .topbar {
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 14px;
            background: #1f2937;
            border-bottom: 1px solid #374151;
            flex-shrink: 0;
        }
        .topbar h1 { margin: 0; font-size: 0.95rem; color: #34d399; }
        .topbar .meta { font-size: 0.8rem; color: #9ca3af; }
        .live { color: #6ee7b7; font-size: 0.78rem; }
        .split { display: grid; grid-template-columns: 1fr 420px; height: calc(100vh - 44px); }
        .left-col { display: flex; flex-direction: column; min-width: 0; border-right: 1px solid #374151; }
        .mode-picker {
            padding: 10px 12px;
            background: #0b1220;
            border-bottom: 1px solid #1f2937;
            flex-shrink: 0;
        }
        .mode-picker h2 { margin: 0 0 6px; font-size: 0.8rem; color: #9ca3af; font-weight: 600; }
        .mode-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px; }
        .mode-card {
            border: 1px solid #374151;
            border-radius: 8px;
            padding: 10px 12px;
            background: #1f2937;
        }
        .mode-card.selected { border-color: #34d399; box-shadow: 0 0 0 1px #34d399; }
        .mode-card.pt.selected { border-color: #60a5fa; box-shadow: 0 0 0 1px #60a5fa; }
        .mode-card h3 { margin: 0 0 4px; font-size: 0.85rem; }
        .mode-card p { margin: 0 0 8px; font-size: 0.72rem; color: #9ca3af; line-height: 1.4; }
        .btn {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 6px;
            border: none;
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            color: #fff;
        }
        .btn-native { background: #059669; }
        .btn-native:hover { background: #047857; }
        .btn-pt { background: #2563eb; }
        .btn-pt:hover { background: #1d4ed8; }
        .btn-secondary { background: #374151; color: #f3f4f6; }
        .btn-secondary:hover { background: #4b5563; }
        .toolbar { display: flex; gap: 6px; flex-wrap: wrap; }
        .proxy-wrap { flex: 1; display: flex; flex-direction: column; min-height: 0; }
        .proxy-wrap header { padding: 5px 10px; font-size: 0.72rem; color: #6b7280; background: #111827; border-bottom: 1px solid #1f2937; }
        #proxy-frame { flex: 1; width: 100%; border: 0; background: #fff; }
        .proxy-placeholder {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #1f2937;
            color: #6b7280;
            font-size: 0.9rem;
            text-align: center;
            padding: 24px;
            line-height: 1.6;
        }
        .browse-launcher {
            flex: 1;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 14px;
            padding: 28px 24px;
            background: #1f2937;
            text-align: center;
        }
        .browse-launcher.visible { display: flex; }
        .browse-launcher h3 { margin: 0; font-size: 1rem; color: #e5e7eb; }
        .browse-launcher p { margin: 0; max-width: 420px; font-size: 0.82rem; color: #9ca3af; line-height: 1.55; }
        .browse-launcher code {
            display: block;
            margin-top: 6px;
            padding: 8px 10px;
            background: #111827;
            border: 1px solid #374151;
            border-radius: 6px;
            font-size: 0.72rem;
            color: #93c5fd;
            word-break: break-all;
        }
        .browse-launcher .btn-lg { padding: 10px 18px; font-size: 0.85rem; }
        .right-col { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
        .right-col header { padding: 6px 10px; font-size: 0.75rem; color: #4caf50; background: #1a1a1a; border-bottom: 2px solid #0f0; }
        #capture-frame { flex: 1; width: 100%; border: 0; background: #1a1a1a; }
        .error-box { margin: 40px auto; max-width: 520px; padding: 24px; background: #1f2937; border: 1px solid #7f1d1d; border-radius: 10px; color: #fecaca; }
        a { color: #93c5fd; }
    </style>
</head>
<body>
{% if error %}
<div class="error-box">
    <h2>PolySniffer unavailable</h2>
    <p>{{ error }}</p>
    <p><a href="/admin/dose/passthroughendpoint/">Back to endpoints</a></p>
</div>
{% else %}
<div class="topbar">
    <div>
        <h1>PolySniffer 2.0</h1>
        <span class="meta">{{ endpoint_label }}</span>
    </div>
    <div class="live" id="session-status">
        {% if active_session %}Recording · {{ active_session.capture_name }}{% else %}Pick a mode and start capture{% endif %}
    </div>
</div>

<div class="split">
    <section class="left-col">
        <div class="mode-picker">
            <h2>Mode picker — {% if browse_external %}last resort: new tab for browse{% else %}twin panels — browse left, capture right{% endif %}</h2>
            <div class="mode-cards">
                <div class="mode-card{% if mode == 'native' %} selected{% endif %}" id="card-native">
                    <h3>Native</h3>
                    <p>Minimal sniff proxy — static loads direct from host; no SSO handlers.</p>
                    <button type="button" class="btn btn-native" onclick="startSession('native')">Start native</button>
                </div>
                <div class="mode-card pt{% if mode == 'passthrough' %} selected{% endif %}" id="card-passthrough">
                    <h3>Passthrough</h3>
                    <p>Production chain — handlers, shim, orchestration.</p>
                    <button type="button" class="btn btn-pt" onclick="startSession('passthrough')">Start passthrough</button>
                </div>
            </div>
            <div class="toolbar">
                <button type="button" class="btn btn-secondary" onclick="stopSession()">Stop capture</button>
                <a class="btn btn-secondary" href="{{ diff_url }}">Diff</a>
                <a class="btn btn-secondary" href="{{ export_url }}">Export HAR</a>
                <a class="btn btn-secondary" href="/admin/dose/passthroughendpoint/">Endpoints</a>
            </div>
        </div>
        <div class="proxy-wrap">
            <header id="proxy-label">{% if mode == 'native' %}Browse — native proxy{% else %}{% if mode %}Browse — {{ mode|title }} proxy{% else %}Select a mode above{% endif %}{% endif %}</header>
            {% if browse_external %}
            <div class="browse-launcher{% if active_session and mode %} visible{% endif %}" id="browse-external-launcher">
                <h3>Last resort — browse in a separate tab</h3>
                <p>
                    PolySniffer normally uses <strong>twin panels</strong> (browse iframe left, capture right) so you can watch traffic without switching tabs.
                    {{ endpoint_label }} cannot run in the browse iframe (SSO and session cookies need a top-level window), so we open the sniff URL in a new tab instead.
                    Proxied traffic still appears in the capture panel on the right.
                </p>
                <button type="button" class="btn btn-native btn-lg" id="browse-external-open" onclick="reopenBrowseTab()">Reopen browse tab</button>
                <code id="browse-external-url">{% if native_proxy_url %}{{ native_proxy_url }}{% else %}Pick a mode and start capture{% endif %}</code>
                {% if upstream_browse_url %}
                <p style="font-size:0.75rem;margin-top:4px;">
                    Baseline (direct, no sniff): <a href="{{ upstream_browse_url }}" target="_blank" rel="noopener">upstream{{ native_browse_subpath }}</a>
                </p>
                {% endif %}
            </div>
            <iframe id="proxy-frame" title="PolySniffer browse" style="display:none"></iframe>
            {% else %}
            <iframe id="proxy-frame" title="PolySniffer browse"{% if native_proxy_url %} src="{{ native_proxy_url }}"{% elif proxy_url and active_session and mode == 'passthrough' %} src="{{ proxy_url }}"{% endif %}></iframe>
            {% endif %}
            <div class="proxy-placeholder" id="proxy-placeholder"{% if active_session or browse_external %} style="display:none"{% endif %}>
                Click <strong>Start native</strong> or <strong>Start passthrough</strong> above.<br>
                Native uses a minimal sniff proxy; passthrough uses the full production chain.
            </div>
            {% if not browse_external %}
            <div class="proxy-direct-link" id="proxy-direct-link" style="padding:6px 10px;font-size:0.72rem;background:#111827;border-top:1px solid #1f2937;">
                Browse iframe blank or SSO stuck?
                <a id="native-sniff-new-tab" href="{% if native_proxy_url %}{{ native_proxy_url }}{% else %}#{% endif %}" target="_blank" rel="noopener">Open sniff in new tab</a> (last resort)
                {% if upstream_browse_url %}
                &nbsp;|&nbsp;
                Baseline: <a href="{{ upstream_browse_url }}" target="_blank" rel="noopener">direct upstream{{ native_browse_subpath }}</a>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </section>

    <section class="right-col">
        <header>Live capture — green screen</header>
        <iframe id="capture-frame" src="{{ capture_frame_url }}" title="PolySniffer live capture"></iframe>
    </section>
</div>

<script>
(function() {
    const csrf = '{{ csrf_token }}';
    const epId = {{ endpoint_id }};
    let currentMode = '{{ mode|escapejs }}';
    const nativeBrowseSubpath = '{{ native_browse_subpath|escapejs }}';
    const upstreamBrowseUrl = '{{ upstream_browse_url|escapejs }}';
    const browseExternal = {{ browse_external|yesno:"true,false" }};
    let lastBrowseUrl = '';

    function browseUrl(mode) {
        if (mode === 'native') {
            return '/dose/sniff/' + epId + '/native' + nativeBrowseSubpath;
        }
        if (mode === 'passthrough') {
            return '/pt/polysniff/' + epId + '/';
        }
        return '/dose/sniff/' + epId + '/' + mode + '/';
    }

    function browseLabel(mode) {
        if (mode === 'native') return 'Browse — native proxy' + nativeBrowseSubpath;
        return 'Browse — ' + mode.charAt(0).toUpperCase() + mode.slice(1) + ' proxy';
    }

    function setModeUI(mode, options) {
        options = options || {};
        const autoOpenTab = !!options.autoOpenTab;
        currentMode = mode;
        document.getElementById('card-native').classList.toggle('selected', mode === 'native');
        document.getElementById('card-passthrough').classList.toggle('selected', mode === 'passthrough');
        document.getElementById('proxy-label').textContent = browseLabel(mode);

        const placeholder = document.getElementById('proxy-placeholder');
        const url = browseUrl(mode);
        lastBrowseUrl = url;

        if (browseExternal) {
            const launcher = document.getElementById('browse-external-launcher');
            const urlEl = document.getElementById('browse-external-url');
            const frame = document.getElementById('proxy-frame');
            if (placeholder) placeholder.style.display = 'none';
            if (launcher) launcher.classList.add('visible');
            if (urlEl) urlEl.textContent = url;
            if (frame) frame.style.display = 'none';
            if (autoOpenTab) window.open(url, '_blank', 'noopener');
        } else {
            let frame = document.getElementById('proxy-frame');
            if (placeholder) placeholder.style.display = 'none';
            if (!frame) {
                const wrap = document.querySelector('.proxy-wrap');
                frame = document.createElement('iframe');
                frame.id = 'proxy-frame';
                frame.title = 'PolySniffer browse';
                wrap.appendChild(frame);
            }
            frame.style.display = '';
            frame.src = url;
            const newTab = document.getElementById('native-sniff-new-tab');
            if (newTab) newTab.href = url;
        }

        const cap = document.getElementById('capture-frame');
        cap.src = '{{ capture_frame_url }}?mode=' + encodeURIComponent(mode) + '&_=' + Date.now();
    }

    window.reopenBrowseTab = function() {
        if (!lastBrowseUrl) {
            alert('Start a capture session first.');
            return;
        }
        window.open(lastBrowseUrl, '_blank', 'noopener');
    };

    window.startSession = async function(mode) {
        const fd = new FormData();
        fd.append('mode', mode);
        const r = await fetch('/dose/sniff/' + epId + '/session/start/', {
            method: 'POST', body: fd, headers: {'X-CSRFToken': csrf}
        });
        const j = await r.json();
        if (!j.ok) {
            alert(j.error || 'Failed to start capture');
            return;
        }
        document.getElementById('session-status').textContent = 'Recording · ' + j.capture_name;
        setModeUI(mode, { autoOpenTab: browseExternal });
    };

    window.stopSession = async function() {
        const r = await fetch('/dose/sniff/' + epId + '/session/stop/', {
            method: 'POST', headers: {'X-CSRFToken': csrf}
        });
        const j = await r.json();
        if (!j.ok) {
            alert(j.error || 'Failed to stop');
            return;
        }
        document.getElementById('session-status').textContent = 'Capture stopped — pick a mode';
        lastBrowseUrl = '';
        const launcher = document.getElementById('browse-external-launcher');
        if (launcher) launcher.classList.remove('visible');
        const frame = document.getElementById('proxy-frame');
        if (frame) {
            frame.removeAttribute('src');
            if (!browseExternal) frame.style.display = '';
        }
        const placeholder = document.getElementById('proxy-placeholder');
        if (placeholder) placeholder.style.display = '';
    };

    document.addEventListener('DOMContentLoaded', function() {
        if (!currentMode) return;
        const statusEl = document.getElementById('session-status');
        const isRecording = statusEl && statusEl.textContent.indexOf('Recording') >= 0;
        if (isRecording) {
            setModeUI(currentMode, { autoOpenTab: false });
            if (browseExternal && currentMode) {
                lastBrowseUrl = browseUrl(currentMode);
            }
            return;
        }
        startSession(currentMode);
    });
})();
</script>
{% endif %}
</body>
</html>
