<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>PolySniffer 2.0 — {{ endpoint_label }}</title>
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; height: 100%; overflow: hidden; background: #0f172a; color: #e2e8f0; font-family: system-ui, sans-serif; }
        .topbar {
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 14px;
            background: #1e293b;
            border-bottom: 1px solid #334155;
        }
        .topbar h1 { margin: 0; font-size: 0.95rem; color: #34d399; }
        .topbar .meta { font-size: 0.8rem; color: #94a3b8; }
        .live { color: #6ee7b7; font-size: 0.78rem; }
        .split { display: grid; grid-template-columns: 1fr 1fr; height: calc(100vh - 44px); }
        .pane { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
        .pane + .pane { border-left: 1px solid #334155; }
        .pane header { padding: 6px 10px; font-size: 0.75rem; color: #94a3b8; background: #111827; border-bottom: 1px solid #1f2937; }
        .pane iframe { flex: 1; width: 100%; border: 0; background: #fff; }
        .error-box { margin: 40px auto; max-width: 520px; padding: 24px; background: #1f2937; border: 1px solid #7f1d1d; border-radius: 10px; color: #fecaca; }
        a { color: #93c5fd; }
    </style>
</head>
<body>
{% if error %}
<div class="error-box">
    <h2>Workspace unavailable</h2>
    <p>{{ error }}</p>
    <p><a href="/admin/dose/passthroughendpoint/">Back to endpoints</a></p>
</div>
{% else %}
<div class="topbar">
    <div>
        <h1>PolySniffer 2.0</h1>
        <span class="meta">{{ endpoint_label }}</span>
    </div>
    <div class="live">{% if active_session %}Recording · {{ active_session.capture_name }}{% else %}Starting capture…{% endif %}</div>
</div>
<div class="split">
    <section class="pane">
        <header>Native + passthrough browse</header>
        <iframe src="{{ browse_frame_url }}" title="PolySniffer browse"></iframe>
    </section>
    <section class="pane">
        <header>Live capture</header>
        <iframe src="{{ capture_frame_url }}" title="PolySniffer capture"></iframe>
    </section>
</div>
{% endif %}
</body>
</html>
