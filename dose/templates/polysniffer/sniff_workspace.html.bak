<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PolySniffer - {% firstof endpoint_label "Workspace" %}</title>
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; background: #111827; color: #e5e7eb; font-family: Georgia, "Times New Roman", serif; }
        body { min-height: 100vh; display: flex; flex-direction: column; }
        .topbar { min-height: 52px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 8px 16px; background: #1f2937; border-bottom: 1px solid #374151; }
        .topbar h1 { margin: 0; font-size: 1rem; color: #34d399; display: inline; }
        .meta, .live { font: 0.78rem Consolas, monospace; color: #9ca3af; }
        .topbar .meta { margin-left: 0.5rem; }
        .live { color: #6ee7b7; text-align: right; }
        .split { flex: 1; display: grid; grid-template-columns: 1fr 30%; min-height: 0; }
        .left-col { display: flex; flex-direction: column; padding: 14px; border-right: 1px solid #374151; background: #0b1220; }
        .right-col { min-width: 0; display: flex; flex-direction: column; background: #171717; }
        h2 { margin: 0 0 10px; font-size: 0.9rem; color: #d1d5db; }
        .mode-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .mode-card { border: 1px solid #374151; border-radius: 6px; padding: 12px; background: #1f2937; display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: start; }
        .mode-card.selected { border-color: #34d399; }
        .mode-card.pt.selected { border-color: #60a5fa; }
        .mode-card p { margin: 0; }
        .mode-card p, .launch-panel p { margin: 0 0 8px; font: 0.72rem/1.4 Consolas, monospace; color: #9ca3af; overflow-wrap: anywhere; }
        .mode-card p { margin: 0; }
        .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 32px; padding: 6px 12px; border: 0; border-radius: 5px; color: #fff; font: 600 0.78rem Georgia, serif; cursor: pointer; text-decoration: none; }
        .btn-native { background: #047857; }
        .btn-pt { background: #1d4ed8; }
        .btn-secondary { background: #374151; }
        .toolbar { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 12px; margin-bottom: 12px; }
        .launch-panel { flex: 1; min-height: 0; border: 1px solid #374151; border-radius: 6px; background: #111827; padding: 16px; }
        .right-col header { padding: 12px 14px; border-bottom: 2px solid #16a34a; }
        .right-col header h2 { margin: 0; color: #4ade80; }
        .stats { padding: 8px 14px; border-bottom: 1px solid #404040; font: 0.75rem Consolas, monospace; color: #a3a3a3; }
        .stats span { color: #4ade80; }
        .captures { flex: 1; min-height: 120px; padding: 10px 12px; overflow-y: auto; }
        .capture-item { margin-bottom: 8px; padding: 10px; border: 1px solid #404040; border-radius: 5px; background: #262626; cursor: pointer; }
        .capture-row { display: flex; align-items: center; gap: 8px; font: 0.75rem Consolas, monospace; }
        .capture-method { padding: 2px 6px; background: #1d4ed8; color: #dbeafe; }
        .capture-path { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .capture-status { color: #4ade80; }
        .capture-detail { display: none; margin-top: 8px; overflow-wrap: anywhere; color: #a3a3a3; }
        .capture-item.open .capture-detail { display: block; }
        .empty { padding: 24px 12px; text-align: center; color: #737373; }
        .error-box { margin: 40px auto; max-width: 560px; padding: 24px; border: 1px solid #991b1b; background: #1f2937; color: #fecaca; }
        a { color: #93c5fd; }
        @media (max-width: 860px) { .split { grid-template-columns: 1fr; } .left-col { border-right: 0; border-bottom: 1px solid #374151; } }
    </style>
</head>
<body>
{% if error %}
<div class="error-box"><h2>PolySniffer unavailable</h2><p>{{ error }}</p><p><a href="/admin/dose/passthroughendpoint/">Back to endpoints</a></p></div>
{% else %}
<div class="topbar">
    <div><h1>PolySniffer</h1><span class="meta">{{ endpoint_label }} - {{ endpoint_host }}</span></div>
    <div class="live" id="session-status">{% if active_session %}Recording #{{ active_session.id }} - {{ active_session.capture_name }}{% else %}No active capture{% endif %}</div>
</div>
<div class="split">
    <section class="left-col">
        <div class="mode-cards">
            <div class="mode-card{% if mode == 'native' %} selected{% endif %}" data-mode="native">
                <button type="button" class="btn btn-native" onclick="startSession('native')">Start Native</button>
                <p>Direct top-level browser navigation to {{ upstream_browse_url }}.</p>
            </div>
            <div class="mode-card pt{% if mode == 'passthrough' %} selected{% endif %}" data-mode="passthrough">
                <button type="button" class="btn btn-pt" onclick="startSession('passthrough')">Start Passthrough</button>
                <p>Top-level browser navigation through /pt/admin/{{ endpoint_host }}{{ browse_subpath }}.</p>
            </div>
        </div>
        <div class="toolbar">
            <button type="button" class="btn btn-secondary" onclick="stopSession()">Stop capture</button>
            <a class="btn btn-secondary" href="{{ diff_url }}">Diff</a>
            <a class="btn btn-secondary" href="{{ export_url }}">Export HAR</a>
            <a class="btn btn-secondary" href="/admin/dose/passthroughendpoint/">Endpoints</a>
        </div>
        <div class="launch-panel">
            {% if app_launch_url %}
            <p>{{ app_launch_url }}</p>
            <a class="btn {% if mode == 'passthrough' %}btn-pt{% else %}btn-native{% endif %}" href="{{ app_launch_url }}" target="_blank" rel="noopener">Open {{ mode|title }} App</a>
            <p>App opens in a new top-level window. Passthrough is HTML-injected in the Jazzmin shell — no iframe.</p>
            {% else %}
            <p>Click Native or Passthrough to start capturing. The app opens top-level (no iframe, no object embed).</p>
            {% endif %}
        </div>
    </section>
    <section class="right-col">
        <header><h2>Live capture</h2></header>
        <div class="stats">Captured: <span id="count">0</span> | Last update: <span id="last-update">-</span> | Session: <span id="session-name">{% if active_session %}{{ active_session.capture_name }}{% else %}none{% endif %}</span></div>
        <div class="captures" id="captures"><div class="empty">No captured requests.</div></div>
    </section>
</div>
<script>
(function() {
    const csrf = '{{ csrf_token }}';
    const endpointHost = '{{ endpoint_host|escapejs }}';
    const pollUrl = '{{ poll_url|escapejs }}';
    const nativeLaunchUrl = '{{ upstream_browse_url|escapejs }}';
    const passthroughLaunchUrl = '/pt/admin/' + endpointHost + '{{ browse_subpath|escapejs }}';
    let currentMode = '{{ mode|escapejs }}';
    let lastId = 0;
    let count = 0;
    const seen = new Set();

    const workspaceUrl = '/admin/polysniffer/sniff/' + endpointHost;
    function modeUrl(mode) { return workspaceUrl + '/workspace/' + mode + '/'; }

    window.startSession = async function(mode) {
        const appWindow = window.open('about:blank', '_blank');
        if (!appWindow) {
            alert('Allow pop-ups for this site to open the isolated app window.');
            return;
        }
        appWindow.opener = null;
        try {
            const form = new FormData();
            form.append('mode', mode);
            const response = await fetch(workspaceUrl + '/session/start/', {method: 'POST', body: form, credentials: 'same-origin', headers: {'X-CSRFToken': csrf}});
            const data = await response.json();
            if (!data.ok) throw new Error(data.error || 'Failed to start capture');
            await storeMmToken();
            appWindow.location.replace(mode === 'passthrough' ? passthroughLaunchUrl : nativeLaunchUrl);
            window.location.replace(modeUrl(mode));
        } catch (error) {
            appWindow.close();
            alert(error.message);
        }
    };

    window.stopSession = async function() {
        try {
            const response = await fetch(workspaceUrl + '/session/stop/', {method: 'POST', credentials: 'same-origin', headers: {'X-CSRFToken': csrf}});
            const data = await response.json();
            if (!data.ok) throw new Error(data.error || 'Failed to stop capture');
            window.location.replace(workspaceUrl + '/');
        } catch (error) { alert(error.message); }
    };

    async function storeMmToken() {
        const match = document.cookie.match(/(?:^|; )MMAUTHTOKEN=([^;]+)/);
        if (!match) return;
        const token = decodeURIComponent(match[1]);
        const form = new URLSearchParams();
        form.append('token', token);
        try {
            const r = await fetch(workspaceUrl + '/store-mm-token/', {method: 'POST', body: form, credentials: 'same-origin', headers: {'X-CSRFToken': csrf}});
            const d = await r.json();
            console.log('[PolySniffer] store-mm-token:', d.ok);
        } catch (e) { console.log('[PolySniffer] store-mm-token failed:', e); }
    }

    function addCapture(capture) {
        if (!capture || !capture.id || seen.has(capture.id)) return;
        seen.add(capture.id);
        lastId = Math.max(lastId, capture.id);
        const empty = document.querySelector('#captures .empty');
        if (empty) empty.remove();
        const item = document.createElement('div');
        item.className = 'capture-item';
        const row = document.createElement('div');
        row.className = 'capture-row';
        const method = document.createElement('span');
        method.className = 'capture-method';
        method.textContent = capture.method || 'GET';
        const path = document.createElement('span');
        path.className = 'capture-path';
        path.textContent = capture.path || capture.client_path || '-';
        const status = document.createElement('span');
        status.className = 'capture-status';
        status.textContent = capture.status_code || '-';
        const detail = document.createElement('div');
        detail.className = 'capture-detail';
        detail.textContent = capture.url || '';
        row.append(method, path, status);
        item.append(row, detail);
        item.onclick = function() { item.classList.toggle('open'); };
        document.getElementById('captures').prepend(item);
        document.getElementById('count').textContent = String(++count);
    }

    async function poll() {
        try {
            const query = '?mode=' + encodeURIComponent(currentMode || 'native') + '&since_id=' + lastId;
            const response = await fetch(pollUrl + query, {credentials: 'same-origin', cache: 'no-store', headers: {'Accept': 'application/json'}});
            const data = await response.json();
            if (!data.success) throw new Error(data.error || 'Poll failed');
            (data.captures || []).sort(function(a, b) { return a.id - b.id; }).forEach(addCapture);
            document.getElementById('last-update').textContent = new Date().toLocaleTimeString();
            if (data.session_name) document.getElementById('session-name').textContent = data.session_name;
        } catch (error) { document.getElementById('last-update').textContent = 'error'; }
    }

    storeMmToken();
    poll();
    window.setInterval(poll, 1500);
})();
</script>
{% endif %}
</body>
</html>
