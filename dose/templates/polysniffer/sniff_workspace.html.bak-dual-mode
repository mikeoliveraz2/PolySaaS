<!-- BINGO: PolySniffer 2.0 Passthrough Workspace Iframe — 2026-06-24 -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>PolySniffer 2.0 — {% firstof endpoint_label "Workspace" %}</title>
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; height: 100%; overflow: hidden; background: #111827; color: #e5e7eb; font-family: system-ui, sans-serif; }
        .topbar {
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 14px;
            background: #1f2937;
            border-bottom: 1px solid #374151;
            flex-shrink: 0;
        }
        .topbar h1 { margin: 0; font-size: 0.95rem; color: #34d399; }
        .topbar .meta { font-size: 0.8rem; color: #9ca3af; }
        .live { color: #6ee7b7; font-size: 0.78rem; }
        .split { display: grid; grid-template-columns: 1fr 420px; height: calc(100vh - 44px); }
        .left-col { display: flex; flex-direction: column; min-width: 0; border-right: 1px solid #374151; }
        .controls {
            padding: 10px 12px;
            background: #0b1220;
            border-bottom: 1px solid #1f2937;
            flex-shrink: 0;
        }
        .controls h2 { margin: 0 0 8px; font-size: 0.8rem; color: #9ca3af; font-weight: 600; }
        .controls p { margin: 0 0 8px; font-size: 0.72rem; color: #6b7280; line-height: 1.45; }
        .btn {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 6px;
            border: none;
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            color: #fff;
        }
        .btn-start { background: #059669; }
        .btn-start:hover { background: #047857; }
        .btn-secondary { background: #374151; color: #f3f4f6; }
        .btn-secondary:hover { background: #4b5563; }
        .toolbar { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
        .proxy-wrap { flex: 1; display: flex; flex-direction: column; min-height: 0; }
        .proxy-wrap header { padding: 5px 10px; font-size: 0.72rem; color: #6b7280; background: #111827; border-bottom: 1px solid #1f2937; }
        #browse-frame { flex: 1; width: 100%; border: 0; background: #fff; }
        .proxy-placeholder {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #1f2937;
            color: #6b7280;
            font-size: 0.9rem;
            text-align: center;
            padding: 24px;
            line-height: 1.6;
        }
        .right-col { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
        .right-col header { padding: 6px 10px; font-size: 0.75rem; color: #4caf50; background: #1a1a1a; border-bottom: 2px solid #0f0; }
        #capture-frame { flex: 1; width: 100%; border: 0; background: #1a1a1a; }
        .error-box { margin: 40px auto; max-width: 520px; padding: 24px; background: #1f2937; border: 1px solid #7f1d1d; border-radius: 10px; color: #fecaca; }
        a { color: #93c5fd; }
    </style>
</head>
<body>
{% if error %}
<div class="error-box">
    <h2>PolySniffer unavailable</h2>
    <p>{{ error }}</p>
    <p><a href="/admin/dose/passthroughendpoint/">Back to endpoints</a></p>
</div>
{% else %}
<div class="topbar">
    <div>
        <h1>PolySniffer 2.0</h1>
        <span class="meta">{{ endpoint_label }}</span>
    </div>
    <div class="live" id="session-status">
        {% if active_session %}Recording · {{ active_session.capture_name }}{% else %}Click Start capture{% endif %}
    </div>
</div>

<div class="split">
    <section class="left-col">
        <div class="controls">
            <h2>Browse left · live capture right</h2>
            <p>Lightweight sniff embed — upstream content only, no orchestration bar. Works for all endpoints.</p>
            <div class="toolbar">
                <button type="button" class="btn btn-start" onclick="startSession()">Start capture</button>
                <button type="button" class="btn btn-secondary" onclick="stopSession()">Stop capture</button>
                <a class="btn btn-secondary" href="{{ export_url }}">Export HAR</a>
                <a class="btn btn-secondary" href="/admin/dose/passthroughendpoint/">Endpoints</a>
            </div>
        </div>
        <div class="proxy-wrap">
            <header id="browse-label">Browse — sniff embed{{ browse_subpath }}</header>
            <iframe id="browse-frame" title="PolySniffer browse"{% if browse_url %} src="{{ browse_url }}"{% endif %}></iframe>
            <div class="proxy-placeholder" id="browse-placeholder"{% if active_session %} style="display:none"{% endif %}>
                Click <strong>Start capture</strong> above to load the sniff embed and begin recording.
            </div>
            {% if upstream_browse_url %}
            <div style="padding:6px 10px;font-size:0.72rem;background:#111827;border-top:1px solid #1f2937;">
                Embed blank or SSO stuck?
                <a id="browse-new-tab" href="{% if browse_url %}{{ browse_url }}{% else %}#{% endif %}" target="_blank" rel="noopener">Open sniff in new tab</a>
                &nbsp;|&nbsp;
                Baseline: <a href="{{ upstream_browse_url }}" target="_blank" rel="noopener">direct upstream{{ browse_subpath }}</a>
            </div>
            {% endif %}
        </div>
    </section>

    <section class="right-col">
        <header>Live capture</header>
        <iframe id="capture-frame" src="{{ capture_frame_url }}" title="PolySniffer live capture"></iframe>
    </section>
</div>

<script>
(function() {
    const csrf = '{{ csrf_token }}';
    const epId = {{ endpoint_id }};
    const browseSubpath = '{{ browse_subpath|escapejs }}';
    const captureFrameUrl = '{{ capture_frame_url }}';

    function browseUrl() {
        return '/dose/sniff/' + epId + '/workspace/browse' + browseSubpath;
    }

    function setBrowseUI(options) {
        options = options || {};
        const url = browseUrl();
        const placeholder = document.getElementById('browse-placeholder');
        const frame = document.getElementById('browse-frame');
        if (placeholder) placeholder.style.display = 'none';
        if (frame) frame.src = url;
        const newTab = document.getElementById('browse-new-tab');
        if (newTab) newTab.href = url;

        const cap = document.getElementById('capture-frame');
        if (options.forceCaptureReload || cap.getAttribute('data-ps-active') !== '1') {
            cap.setAttribute('data-ps-active', '1');
            cap.src = captureFrameUrl + '?_=' + Date.now();
        }
    }

    window.startSession = async function() {
        const fd = new FormData();
        fd.append('mode', 'native');
        const r = await fetch('/dose/sniff/' + epId + '/session/start/', {
            method: 'POST', body: fd, headers: {'X-CSRFToken': csrf}
        });
        const j = await r.json();
        if (!j.ok) {
            alert(j.error || 'Failed to start capture');
            return;
        }
        document.getElementById('session-status').textContent = 'Recording · ' + j.capture_name;
        setBrowseUI({ forceCaptureReload: true });
    };

    window.stopSession = async function() {
        const r = await fetch('/dose/sniff/' + epId + '/session/stop/', {
            method: 'POST', headers: {'X-CSRFToken': csrf}
        });
        const j = await r.json();
        if (!j.ok) {
            alert(j.error || 'Failed to stop');
            return;
        }
        document.getElementById('session-status').textContent = 'Capture stopped';
        const frame = document.getElementById('browse-frame');
        if (frame) frame.removeAttribute('src');
        const cap = document.getElementById('capture-frame');
        cap.removeAttribute('data-ps-active');
        const placeholder = document.getElementById('browse-placeholder');
        if (placeholder) placeholder.style.display = '';
    };

    document.addEventListener('DOMContentLoaded', function() {
        const statusEl = document.getElementById('session-status');
        const isRecording = statusEl && statusEl.textContent.indexOf('Recording') >= 0;
        if (isRecording) {
            setBrowseUI({ forceCaptureReload: false });
        }
    });
})();
</script>
{% endif %}
</body>
</html>
