<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PolySniffer - {% firstof endpoint_label "Workspace" %}</title>
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; background: #111827; color: #e5e7eb; font-family: Georgia, "Times New Roman", serif; }
        body { min-height: 100vh; display: flex; flex-direction: column; }
        .topbar { min-height: 52px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 8px 16px; background: #1f2937; border-bottom: 1px solid #374151; }
        .topbar h1 { margin: 0; font-size: 1rem; color: #34d399; display: inline; }
        .meta, .live { font: 0.78rem Consolas, monospace; color: #9ca3af; }
        .topbar .meta { margin-left: 0.5rem; }
        .live { color: #6ee7b7; text-align: right; }
        .split { flex: 1; display: grid; grid-template-columns: 1fr 30%; min-height: 0; }
        .left-col { display: flex; flex-direction: column; padding: 14px; border-right: 1px solid #374151; background: #0b1220; }
        .right-col { min-width: 0; display: flex; flex-direction: column; background: #171717; }
        h2 { margin: 0 0 10px; font-size: 0.9rem; color: #d1d5db; }
        .mode-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .mode-card { border: 1px solid #374151; border-radius: 6px; padding: 12px; background: #1f2937; display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: start; }
        .mode-card.selected { border-color: #34d399; }
        .mode-card.pt.selected { border-color: #60a5fa; }
        .mode-card p { margin: 0; }
        .mode-card p, .browser-placeholder p { margin: 0 0 8px; font: 0.72rem/1.4 Consolas, monospace; color: #9ca3af; overflow-wrap: anywhere; }
        .mode-card p { margin: 0; }
        .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 32px; padding: 6px 12px; border: 0; border-radius: 5px; color: #fff; font: 600 0.78rem Georgia, serif; cursor: pointer; text-decoration: none; }
        .btn-native { background: #047857; }
        .btn-pt { background: #1d4ed8; }
        .btn-secondary { background: #374151; }
        .toolbar { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 12px; margin-bottom: 12px; }
        .browser-pane { flex: 1; min-height: 0; border: 1px solid #374151; border-radius: 6px; background: #fff; overflow: hidden; }
        .browser-pane object { width: 100%; height: 100%; border: 0; background: #fff; }
        .browser-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; color: #6b7280; font: 0.8rem Consolas, monospace; background: #111827; }
        .right-col header { padding: 12px 14px; border-bottom: 2px solid #16a34a; }
        .right-col header h2 { margin: 0; color: #4ade80; }
        .stats { padding: 8px 14px; border-bottom: 1px solid #404040; font: 0.75rem Consolas, monospace; color: #a3a3a3; }
        .stats span { color: #4ade80; }
        .captures { flex: 1; min-height: 120px; padding: 10px 12px; overflow-y: auto; }
        .capture-item { margin-bottom: 8px; padding: 10px; border: 1px solid #404040; border-radius: 5px; background: #262626; cursor: pointer; }
        .capture-row { display: flex; align-items: center; gap: 8px; font: 0.75rem Consolas, monospace; }
        .capture-method { padding: 2px 6px; background: #1d4ed8; color: #dbeafe; }
        .capture-path { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .capture-status { color: #4ade80; }
        .capture-detail { display: none; margin-top: 8px; overflow-wrap: anywhere; color: #a3a3a3; }
        .capture-item.open .capture-detail { display: block; }
        .empty { padding: 24px 12px; text-align: center; color: #737373; }
        .error-box { margin: 40px auto; max-width: 560px; padding: 24px; border: 1px solid #991b1b; background: #1f2937; color: #fecaca; }
        a { color: #93c5fd; }
        @media (max-width: 860px) { .split { grid-template-columns: 1fr; } .left-col { border-right: 0; border-bottom: 1px solid #374151; } }
    </style>
</head>
<body>
{% if error %}
<div class="error-box"><h2>PolySniffer unavailable</h2><p>{{ error }}</p><p><a href="/admin/dose/passthroughendpoint/">Back to endpoints</a></p></div>
{% else %}
<div class="topbar">
    <div><h1>PolySniffer</h1><span class="meta">{{ endpoint_label }} - {{ endpoint_host }}</span></div>
    <div class="live" id="session-status">{% if active_session %}Recording #{{ active_session.id }} - {{ active_session.capture_name }}{% else %}No active capture{% endif %}</div>
</div>
<div class="split">
    <section class="left-col">
        <div class="mode-cards">
            <div class="mode-card{% if mode == 'native' %} selected{% endif %}" data-mode="native">
                <button type="button" class="btn btn-native" onclick="startSession('native')">Start Native</button>
                <p>Direct top-level browser navigation to {{ upstream_browse_url }}.</p>
            </div>
            <div class="mode-card pt{% if mode == 'passthrough' %} selected{% endif %}" data-mode="passthrough">
                <button type="button" class="btn btn-pt" onclick="startSession('passthrough')">Start Passthrough</button>
                <p>Top-level browser navigation through /pt/admin/{{ endpoint_host }}{{ browse_subpath }}.</p>
            </div>
        </div>
        <div class="toolbar">
            <button type="button" class="btn btn-secondary" onclick="stopSession()">Stop capture</button>
            <a class="btn btn-secondary" href="{{ diff_url }}">Diff</a>
            <a class="btn btn-secondary" href="{{ export_url }}">Export HAR</a>
            <a class="btn btn-secondary" href="/admin/dose/passthroughendpoint/">Endpoints</a>
        </div>
        <div class="browser-pane" id="browser-pane">
            <div class="browser-placeholder">Click Native or Passthrough to start capturing.</div>
        </div>
    </section>
    <section class="right-col">
        <header><h2>Live capture</h2></header>
        <div class="stats">Captured: <span id="count">0</span> | Last update: <span id="last-update">-</span> | Session: <span id="session-name">{% if active_session %}{{ active_session.capture_name }}{% else %}none{% endif %}</span></div>
        <div class="captures" id="captures"><div class="empty">No captured requests.</div></div>
    </section>
</div>
<script>
(function() {
    const csrf = '{{ csrf_token }}';
    const endpointHost = '{{ endpoint_host|escapejs }}';
    const schemaParam = '{{ schema|escapejs }}';
    /* FIX 2026-08-20 / 2026-08-21: launch URL carries tenant as _ps_tenant= (not
       schema= — Slack consumes that name). Prefix is host-keyed
       /pt/polysniff/<host>/ — same identity as /pt/admin/<host>/; no row id.
       BINGO: PolySniffer Host-Keyed Polysniff URLs — 2026-08-21 */
    const schemaQuery = schemaParam ? ('?_ps_tenant=' + encodeURIComponent(schemaParam)) : '';
    const pollUrl = '{{ poll_url|escapejs }}';
    const nativeLaunchUrl = '/pt/polysniff/' + endpointHost + '{{ browse_subpath|escapejs }}' + schemaQuery;
    const passthroughLaunchUrl = '/pt/polysniff/' + endpointHost + '{{ browse_subpath|escapejs }}' + schemaQuery;
    /* FIX 2026-08-21 (owner-approved, frozen-file exception): some apps send
       Content-Security-Policy: frame-ancestors 'self' on their own pages (confirmed
       live for Slack) and refuse to render inside this workspace's <object> embed no
       matter what origin the request comes from -- a hard browser-enforced wall, not
       a routing bug. Native mode only (Passthrough keeps identical <object> embed
       behavior for every app -- same look and feel everywhere) falls back to opening
       a real top-level tab for these apps, driven by the generic per-handler hook
       requires_top_level_native() so no app name is hardcoded here.
       BINGO: PolySniffer Native Top-Level Fallback — 2026-08-21 */
    const nativeTopLevel = {{ native_top_level|yesno:"true,false" }};
    const upstreamBrowseUrl = '{{ upstream_browse_url|escapejs }}';
    let currentMode = '{{ mode|escapejs }}';
    let lastId = 0;
    let count = 0;
    const seen = new Set();

    const workspaceUrl = '/admin/polysniffer/sniff/' + endpointHost;
    const browserPane = document.getElementById('browser-pane');

    function setBrowserUrl(url, mode) {
        browserPane.innerHTML = '<object type="text/html" data="' + url + '" title="PolySniffer browse" style="width:100%;height:100%;border:0;background:#fff;"></object>';
        currentMode = mode;
        document.querySelectorAll('.mode-card').forEach(function(card) {
            card.classList.remove('selected');
            if (card.dataset.mode === mode) card.classList.add('selected');
        });
    }

    /* Same panel, same placeholder styling as clearBrowser()/the initial state --
       only the message differs, so the workspace still looks identical to every
       other app's Native pane even though this one opened a separate tab. */
    function setTopLevelPlaceholder(mode) {
        browserPane.innerHTML = '<div class="browser-placeholder">Opened in a new browser tab (this app cannot be embedded). Capture continues on the right.</div>';
        currentMode = mode;
        document.querySelectorAll('.mode-card').forEach(function(card) {
            card.classList.remove('selected');
            if (card.dataset.mode === mode) card.classList.add('selected');
        });
    }

    /* Native renders the captured browser itself into this pane: frames arrive as
       a multipart image stream and gestures go back as small posts. Applications
       that refuse to be framed, or that only run against a session they created
       themselves, still appear here. Driven by the session/start response, so no
       app name appears in this template. */
    const MOD_ALT = 1, MOD_CTRL = 2, MOD_META = 4, MOD_SHIFT = 8;
    const NATIVE_KEYS = ['Enter', 'Tab', 'Backspace', 'Delete', 'Escape', 'ArrowLeft',
        'ArrowUp', 'ArrowRight', 'ArrowDown', 'Home', 'End', 'PageUp', 'PageDown'];
    let lastMoveSent = 0;

    function modifiersOf(ev) {
        return (ev.altKey ? MOD_ALT : 0) | (ev.ctrlKey ? MOD_CTRL : 0)
            | (ev.metaKey ? MOD_META : 0) | (ev.shiftKey ? MOD_SHIFT : 0);
    }

    function sendNativeInput(event) {
        fetch(workspaceUrl + '/native/input/', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-CSRFToken': csrf},
            body: JSON.stringify(event)
        }).catch(function() {});
    }

    /* The frame keeps its aspect ratio inside the pane, so pane coordinates are
       mapped back through the letterboxing to browser coordinates. */
    function frameCoords(view, ev) {
        const rect = view.getBoundingClientRect();
        if (!view.naturalWidth || !view.naturalHeight || !rect.width || !rect.height) {
            return null;
        }
        const natural = view.naturalWidth / view.naturalHeight;
        const box = rect.width / rect.height;
        const shownWidth = natural > box ? rect.width : rect.height * natural;
        const shownHeight = natural > box ? rect.width / natural : rect.height;
        const left = rect.left + (rect.width - shownWidth) / 2;
        const top = rect.top + (rect.height - shownHeight) / 2;
        return {
            x: (ev.clientX - left) * (view.naturalWidth / shownWidth),
            y: (ev.clientY - top) * (view.naturalHeight / shownHeight)
        };
    }

    function attachNativeInput(view) {
        view.addEventListener('mousemove', function(ev) {
            const now = Date.now();
            if (now - lastMoveSent < 60) return;
            lastMoveSent = now;
            const at = frameCoords(view, ev);
            if (at) sendNativeInput({kind: 'mouse', action: 'move', x: at.x, y: at.y,
                buttons: ev.buttons, modifiers: modifiersOf(ev)});
        });
        view.addEventListener('mousedown', function(ev) {
            ev.preventDefault();
            view.focus();
            const at = frameCoords(view, ev);
            if (at) sendNativeInput({kind: 'mouse', action: 'down', x: at.x, y: at.y,
                button: ev.button, buttons: ev.buttons, click_count: ev.detail || 1,
                modifiers: modifiersOf(ev)});
        });
        view.addEventListener('mouseup', function(ev) {
            ev.preventDefault();
            const at = frameCoords(view, ev);
            if (at) sendNativeInput({kind: 'mouse', action: 'up', x: at.x, y: at.y,
                button: ev.button, buttons: ev.buttons, click_count: ev.detail || 1,
                modifiers: modifiersOf(ev)});
        });
        view.addEventListener('contextmenu', function(ev) { ev.preventDefault(); });
        view.addEventListener('wheel', function(ev) {
            ev.preventDefault();
            const at = frameCoords(view, ev);
            if (at) sendNativeInput({kind: 'wheel', x: at.x, y: at.y,
                delta_x: ev.deltaX, delta_y: ev.deltaY, modifiers: modifiersOf(ev)});
        }, {passive: false});
        view.addEventListener('keydown', function(ev) {
            if (NATIVE_KEYS.indexOf(ev.key) !== -1) {
                ev.preventDefault();
                sendNativeInput({kind: 'key', key: ev.key, code: ev.code,
                    modifiers: modifiersOf(ev)});
            } else if (ev.key.length === 1 && !ev.ctrlKey && !ev.metaKey) {
                ev.preventDefault();
                sendNativeInput({kind: 'text', text: ev.key});
            }
        });
    }

    function setRealBrowserPane(mode) {
        browserPane.innerHTML = '<img id="native-view" tabindex="0" alt="Captured browser"'
            + ' src="' + workspaceUrl + '/native/stream/?t=' + Date.now() + '"'
            + ' style="width:100%;height:100%;object-fit:contain;background:#0b1220;outline:0;cursor:default;">';
        const view = document.getElementById('native-view');
        attachNativeInput(view);
        view.focus();
        currentMode = mode;
        document.querySelectorAll('.mode-card').forEach(function(card) {
            card.classList.remove('selected');
            if (card.dataset.mode === mode) card.classList.add('selected');
        });
    }

    function clearBrowser() {
        browserPane.innerHTML = '<div class="browser-placeholder">Click Native or Passthrough to start capturing.</div>';
        currentMode = '';
        document.querySelectorAll('.mode-card').forEach(function(card) { card.classList.remove('selected'); });
    }

    window.startSession = async function(mode) {
        try {
            const form = new FormData();
            form.append('mode', mode);
            const response = await fetch(workspaceUrl + '/session/start/', {method: 'POST', body: form, credentials: 'same-origin', headers: {'X-CSRFToken': csrf}});
            const data = await response.json();
            if (!data.ok) throw new Error(data.error || 'Failed to start capture');
            await storeMmToken();
            if (mode === 'native' && data.browser && data.browser.started) {
                setRealBrowserPane(mode);
            } else if (mode === 'native' && nativeTopLevel) {
                window.open(upstreamBrowseUrl, '_blank', 'noopener');
                setTopLevelPlaceholder(mode);
            } else {
                setBrowserUrl(mode === 'passthrough' ? passthroughLaunchUrl : nativeLaunchUrl, mode);
            }
        } catch (error) { alert(error.message); }
    };

    window.stopSession = async function() {
        try {
            const response = await fetch(workspaceUrl + '/session/stop/', {method: 'POST', credentials: 'same-origin', headers: {'X-CSRFToken': csrf}});
            const data = await response.json();
            if (!data.ok) throw new Error(data.error || 'Failed to stop capture');
            clearBrowser();
            lastId = 0;
            count = 0;
            seen.clear();
            document.getElementById('captures').innerHTML = '<div class="empty">No captured requests.</div>';
            document.getElementById('count').textContent = '0';
        } catch (error) { alert(error.message); }
    };

    async function storeMmToken() {
        const match = document.cookie.match(/(?:^|; )MMAUTHTOKEN=([^;]+)/);
        if (!match) return;
        const token = decodeURIComponent(match[1]);
        const form = new URLSearchParams();
        form.append('token', token);
        try {
            const r = await fetch(workspaceUrl + '/store-mm-token/', {method: 'POST', body: form, credentials: 'same-origin', headers: {'X-CSRFToken': csrf}});
            const d = await r.json();
            console.log('[PolySniffer] store-mm-token:', d.ok);
        } catch (e) { console.log('[PolySniffer] store-mm-token failed:', e); }
    }

    function addCapture(capture) {
        if (!capture || !capture.id || seen.has(capture.id)) return;
        seen.add(capture.id);
        lastId = Math.max(lastId, capture.id);
        const empty = document.querySelector('#captures .empty');
        if (empty) empty.remove();
        const item = document.createElement('div');
        item.className = 'capture-item';
        const row = document.createElement('div');
        row.className = 'capture-row';
        const method = document.createElement('span');
        method.className = 'capture-method';
        method.textContent = capture.method || 'GET';
        const path = document.createElement('span');
        path.className = 'capture-path';
        path.textContent = capture.path || capture.client_path || '-';
        const status = document.createElement('span');
        status.className = 'capture-status';
        status.textContent = capture.status_code || '-';
        const detail = document.createElement('div');
        detail.className = 'capture-detail';
        detail.textContent = capture.url || '';
        row.append(method, path, status);
        item.append(row, detail);
        item.onclick = function() { item.classList.toggle('open'); };
        document.getElementById('captures').prepend(item);
        document.getElementById('count').textContent = String(++count);
    }

    async function poll() {
        try {
            const query = '?mode=' + encodeURIComponent(currentMode || 'native') + '&since_id=' + lastId;
            const response = await fetch(pollUrl + query, {credentials: 'same-origin', cache: 'no-store', headers: {'Accept': 'application/json'}});
            const data = await response.json();
            if (!data.success) throw new Error(data.error || 'Poll failed');
            (data.captures || []).sort(function(a, b) { return a.id - b.id; }).forEach(addCapture);
            document.getElementById('last-update').textContent = new Date().toLocaleTimeString();
            if (data.session_name) document.getElementById('session-name').textContent = data.session_name;
        } catch (error) { document.getElementById('last-update').textContent = 'error'; }
    }

    storeMmToken();
    poll();
    window.setInterval(poll, 1500);
})();
</script>
{% endif %}
</body>
</html>