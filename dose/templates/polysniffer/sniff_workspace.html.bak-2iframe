<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>PolySniffer 2.0 Workspace — {{ endpoint_label }}</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #111827;
            color: #e5e7eb;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 16px;
            background: #1f2937;
            border-bottom: 1px solid #374151;
            flex-shrink: 0;
        }
        .topbar h1 { margin: 0; font-size: 1rem; font-weight: 700; color: #34d399; }
        .topbar .meta { font-size: 0.85rem; color: #9ca3af; }
        .topbar .actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .btn {
            display: inline-block;
            padding: 7px 12px;
            border-radius: 6px;
            border: none;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            background: #374151;
            color: #f9fafb;
        }
        .btn:hover { background: #4b5563; }
        .btn.active { background: #059669; }
        .btn.pt.active { background: #2563eb; }
        .status-pill {
            font-size: 0.8rem;
            padding: 4px 10px;
            border-radius: 999px;
            background: #374151;
            color: #d1d5db;
        }
        .status-pill.live { background: #064e3b; color: #6ee7b7; }
        .split {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 420px;
            min-height: 0;
        }
        .nav-panel {
            border-right: 1px solid #374151;
            display: flex;
            flex-direction: column;
            min-width: 0;
            background: #0b1220;
        }
        .nav-panel header {
            padding: 8px 12px;
            font-size: 0.8rem;
            color: #9ca3af;
            border-bottom: 1px solid #1f2937;
            background: #111827;
        }
        .nav-panel iframe {
            flex: 1;
            width: 100%;
            border: 0;
            background: #fff;
        }
        .capture-panel {
            display: flex;
            flex-direction: column;
            min-width: 0;
            background: #111827;
        }
        .capture-panel header {
            padding: 8px 12px;
            border-bottom: 1px solid #374151;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }
        .capture-panel header strong { color: #60a5fa; font-size: 0.9rem; }
        .capture-stats { font-size: 0.75rem; color: #9ca3af; }
        .captures {
            flex: 1;
            overflow-y: auto;
            padding: 10px 12px;
        }
        .capture-item {
            background: #1f2937;
            border: 1px solid #374151;
            border-radius: 8px;
            padding: 10px 12px;
            margin-bottom: 8px;
            cursor: pointer;
        }
        .capture-item:hover { border-color: #34d399; }
        .capture-item.new { animation: flash 0.45s ease; }
        @keyframes flash {
            from { background: #064e3b; }
            to { background: #1f2937; }
        }
        .capture-row {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.82rem;
        }
        .method {
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.72rem;
            background: #1e3a8a;
            color: #bfdbfe;
        }
        .path {
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: #d1d5db;
        }
        .code { font-weight: 700; }
        .code.s2xx { color: #34d399; }
        .code.s3xx { color: #fbbf24; }
        .code.s4xx { color: #f87171; }
        .code.s5xx { color: #fb7185; }
        .time { color: #6b7280; font-size: 0.72rem; }
        .capture-detail {
            display: none;
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px solid #374151;
        }
        .capture-item.open .capture-detail { display: block; }
        .capture-detail pre {
            margin: 4px 0 0;
            padding: 8px;
            background: #0b1220;
            border-radius: 4px;
            font-size: 0.72rem;
            overflow-x: auto;
            white-space: pre-wrap;
            word-break: break-all;
        }
        .empty {
            text-align: center;
            color: #6b7280;
            padding: 40px 16px;
            font-size: 0.9rem;
            line-height: 1.5;
        }
        .error-box {
            margin: 40px auto;
            max-width: 520px;
            padding: 24px;
            background: #1f2937;
            border: 1px solid #7f1d1d;
            border-radius: 10px;
            color: #fecaca;
        }
    </style>
</head>
<body>
{% if error %}
<div class="error-box">
    <h2>Workspace unavailable</h2>
    <p>{{ error }}</p>
    <p><a class="btn" href="/admin/dose/passthroughendpoint/">Back to endpoints</a></p>
</div>
{% else %}
<div class="topbar">
    <div>
        <h1>PolySniffer 2.0 Workspace</h1>
        <div class="meta">{{ endpoint_label }} · {{ mode|title }} mode</div>
    </div>
    <div class="actions">
        <span id="session-pill" class="status-pill{% if active_session %} live{% endif %}">
            {% if active_session %}Recording: {{ active_session.capture_name }}{% else %}No active session{% endif %}
        </span>
        <a class="btn{% if mode == 'native' %} active{% endif %}" href="/dose/sniff/{{ endpoint_id }}/workspace/native/">Native</a>
        <a class="btn pt{% if mode == 'passthrough' %} active{% endif %}" href="/dose/sniff/{{ endpoint_id }}/workspace/passthrough/">Passthrough</a>
        <a class="btn" href="{{ picker_url }}">Mode picker</a>
    </div>
</div>

<div class="split">
    <section class="nav-panel">
        <header>Navigate here — {{ mode|title }} proxy (left)</header>
        <iframe id="sniff-proxy" src="{{ proxy_url }}" title="PolySniffer {{ mode }} proxy"></iframe>
    </section>
    <section class="capture-panel">
        <header>
            <strong>Live capture (right)</strong>
            <span class="capture-stats">
                <span id="count">0</span> rows · <span id="last-update">waiting</span>
            </span>
        </header>
        <div id="captures" class="captures">
            <div class="empty">
                Browse the app on the left.<br>
                Requests appear here as they are logged server-side.
            </div>
        </div>
    </section>
</div>

<script>
(function() {
    const endpointId = {{ endpoint_id }};
    const mode = '{{ mode }}';
    const pollUrl = '{{ poll_url }}?mode=' + encodeURIComponent(mode);
    let lastId = 0;
    let captureCount = 0;
    let polling = true;

    const capturesEl = document.getElementById('captures');
    const countEl = document.getElementById('count');
    const updateEl = document.getElementById('last-update');

    function statusClass(code) {
        if (!code) return 's0';
        if (code < 300) return 's2xx';
        if (code < 400) return 's3xx';
        if (code < 500) return 's4xx';
        return 's5xx';
    }

    function addCapture(c) {
        if (capturesEl.querySelector('.empty')) {
            capturesEl.innerHTML = '';
        }
        const div = document.createElement('div');
        div.className = 'capture-item new';
        div.innerHTML =
            '<div class="capture-row">' +
            '<span class="method">' + (c.method || 'GET') + '</span>' +
            '<span class="path" title="' + (c.url || '') + '">' + (c.path || c.client_path || c.url || '-') + '</span>' +
            '<span class="code ' + statusClass(c.status_code) + '">' + (c.status_code || '-') + '</span>' +
            '<span class="time">' + (c.captured_at || '') + '</span>' +
            '</div>' +
            '<div class="capture-detail">' +
            '<pre>' + (c.url || '') + '\n' + (c.duration_ms != null ? ('duration: ' + c.duration_ms + 'ms') : '') + '</pre>' +
            '</div>';
        div.addEventListener('click', function() { div.classList.toggle('open'); });
        capturesEl.prepend(div);
        captureCount += 1;
        countEl.textContent = String(captureCount);
    }

    function poll() {
        if (!polling) return;
        fetch(pollUrl + '&since_id=' + lastId, { credentials: 'same-origin' })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.success) return;
                updateEl.textContent = new Date().toLocaleTimeString();
                (data.captures || []).forEach(function(c) {
                    if (c.id > lastId) lastId = c.id;
                    addCapture(c);
                });
            })
            .catch(function(err) {
                console.error('workspace poll failed', err);
            });
    }

    setInterval(poll, 1500);
    poll();
})();
</script>
{% endif %}
</body>
</html>
