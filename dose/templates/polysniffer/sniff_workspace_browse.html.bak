<!-- BINGO: PolySniffer 2.0 Native Login Workspace — 2026-06-24 -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Browse — {{ endpoint_label }}</title>
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; height: 100%; overflow: hidden; background: #0b1220; }
        .stack { display: grid; grid-template-rows: 1fr 1fr; height: 100vh; }
        .half { display: flex; flex-direction: column; min-height: 0; }
        .half + .half { border-top: 2px solid #334155; }
        .label { padding: 4px 8px; font: 600 11px system-ui, sans-serif; color: #cbd5e1; background: #1e293b; }
        .label.native { color: #6ee7b7; }
        .label.pt { color: #93c5fd; }
        iframe { flex: 1; width: 100%; border: 0; background: #fff; }
        .error { padding: 16px; color: #fca5a5; font-family: system-ui, sans-serif; }
    </style>
</head>
<body>
{% if error %}
<p class="error">{{ error }}</p>
{% else %}
<div class="stack">
    <div class="half">
        <div class="label native">Native</div>
        <iframe src="{{ native_url }}" title="Native proxy"></iframe>
    </div>
    <div class="half">
        <div class="label pt">Passthrough</div>
        <iframe src="{{ passthrough_url }}" title="Passthrough proxy"></iframe>
    </div>
</div>
{% endif %}
</body>
</html>
