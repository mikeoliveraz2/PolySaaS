<!DOCTYPE html>
<html>
<head>
  <title>Dose SaaS</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body { font-family: Arial, sans-serif; margin: 0; }
    header { background: #222; color: #fff; padding: 1em; }
    nav { background: #eee; padding: 0.5em; }
    nav a { margin-right: 1em; color: #222; text-decoration: none; }
    main { padding: 2em; }
  </style>
</head>
<body>
  <header>
    <h1>Dose SaaS Header</h1>
  </header>
  <nav>
    <a href="/">Home</a>
    <a href="/dose/passthrough-iframe/?url=https://msn.com">Iframe Test</a>
    <a href="/dose/passthrough-html/?url=https://msn.com">HTML Test</a>
  </nav>
  <main>
    {% block content %}{% endblock %}
  </main>
</body>
</html>
