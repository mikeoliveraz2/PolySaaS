<!-- THIS CODE IS FROZEN — NO CHANGES TO THIS CODE ARE ALLOWED WITHOUT THE OWNER'S PERMISSION -->
<!-- BINGO: Slack producer/consumer home — 2026-08-24 -->
<!-- BINGO: Slack → Odoo + HubSpot dual-feed — 2026-08-28 -->
{% extends "admin/base_site.html" %}
{% load static %}

{% block title %}{{ title }} · PolySaaS{% endblock %}

{% block extrahead %}
{{ block.super }}
<link rel="stylesheet" href="{% static 'admin/css/endpoint_home.css' %}?v=20260830-6">
{% endblock %}

{% block content %}
<main
    class="polysaas-endpoint-home"
    data-endpoint-home
    data-status-url="{{ endpoint_status_url }}"
    data-pair-url="{{ producer_pair_url }}"
>
    <header class="polysaas-endpoint-home__header polysaas-endpoint-home__pane">
        <div class="polysaas-endpoint-home__title-row">
            {% if app_logo_static %}
            <img
                class="polysaas-endpoint-home__logo"
                src="{% static app_logo_static %}"
                alt="{{ title }}"
                width="48"
                height="48"
            >
            {% endif %}
            <div class="polysaas-endpoint-home__title-text">
                <h1 class="polysaas-endpoint-home__title">{{ title }}</h1>
                <div class="polysaas-endpoint-home__lede">{{ endpoint.description|default:"Producers, consumers, and selected actions" }}</div>
            </div>
        </div>
        {% if browser_launch_url %}
        <a
            class="polysaas-endpoint-home__launch"
            href="{{ browser_launch_url }}"
            target="_blank"
            rel="noopener"
            title="{{ browse_button_label }} in a new tab"
        >{{ browse_button_label }}</a>
        {% endif %}
    </header>

    <nav class="polysaas-endpoint-home__bookmarks polysaas-endpoint-home__create polysaas-endpoint-home__pane" aria-label="Create orchestration">
        {% with app_key=endpoint.slug|default:title|lower %}
        <a
            class="polysaas-endpoint-bookmark polysaas-endpoint-bookmark--create"
            href="{% url 'admin:dose_instruction_add' %}?app={{ app_key }}&amp;role=producer"
            title="Declare a new producer event for this home"
        >New producer</a>
        <a
            class="polysaas-endpoint-bookmark polysaas-endpoint-bookmark--create"
            href="{% url 'admin:dose_instruction_add' %}?app={{ app_key }}&amp;role=consumer"
            title="Add a consumer Instruction for this home"
        >New consumer</a>
        <a
            class="polysaas-endpoint-bookmark polysaas-endpoint-bookmark--create"
            href="{% url 'admin:dose_instruction_add' %}?app={{ app_key }}&amp;custom_endpoint=1"
            title="Bind a Custom Endpoint URL / API as the service"
        >Dynamic service based on API</a>
        <a
            class="polysaas-endpoint-bookmark polysaas-endpoint-bookmark--create"
            href="{% url 'admin:dose_atomicservice_add' %}"
            title="Upload or register a Dynamic / Atomic Service"
        >Dynamic service</a>
        {% endwith %}
    </nav>

    {% if bookmarks %}
    <nav class="polysaas-endpoint-home__bookmarks polysaas-endpoint-home__pane" aria-label="{{ title }} bookmarks">
        {% for bookmark in bookmarks %}
            {% if bookmark.destination_type == "external_path" or bookmark.destination_type == "passthrough_path" %}
                {% if bookmark.url %}
                <a
                    class="polysaas-endpoint-bookmark"
                    href="{{ bookmark.url }}"
                    {% if bookmark.destination_type == "external_path" %}target="_blank" rel="noopener"{% endif %}
                    title="{{ bookmark.description }}"
                ><span>{{ bookmark.icon }}</span>{{ bookmark.title }}</a>
                {% else %}
                <button class="polysaas-endpoint-bookmark" type="button" disabled>{{ bookmark.icon }} {{ bookmark.title }}</button>
                {% endif %}
            {% else %}
            <button
                class="polysaas-endpoint-bookmark"
                type="button"
                data-bookmark-type="{{ bookmark.destination_type }}"
                data-bookmark-target="{{ bookmark.target }}"
                data-action-url="{{ bookmark.url }}"
                {% if bookmark.disabled %}disabled{% endif %}
                title="{{ bookmark.description }}"
            ><span>{{ bookmark.icon }}</span>{{ bookmark.title }}</button>
            {% endif %}
        {% endfor %}
    </nav>
    {% endif %}

    {% if surface_template %}
    <section class="polysaas-endpoint-home__form-host polysaas-endpoint-home__pane" aria-label="{{ title }} workspace">
        {% include surface_template %}
    </section>
    {% endif %}

    {% include "dose/includes/orchestration_bar.html" %}

    <section
        class="polysaas-callback-panel"
        data-callback-dialog
        hidden
        aria-live="polite"
        aria-label="CallBackData record"
    >
        <div class="polysaas-callback-dialog__panel">
            <header class="polysaas-callback-dialog__head">
                <div>
                    <h3 data-callback-title>CallBackData</h3>
                    <p class="polysaas-callback-dialog__sub" data-callback-sub></p>
                </div>
                <button type="button" class="polysaas-callback-dialog__close" data-callback-close aria-label="Close">&times;</button>
            </header>
            <div class="polysaas-callback-dialog__meta" data-callback-meta></div>
            <div class="polysaas-callback-dialog__body" data-callback-body></div>
            <div class="polysaas-callback-dialog__actions">
                <button type="button" class="polysaas-callback-dialog__close-btn" data-callback-close>Close</button>
            </div>
        </div>
    </section>

    <section class="polysaas-endpoint-home__surface" aria-label="Producers and consumers">
        {% if producers %}
        <div class="polysaas-endpoint-home__panel polysaas-endpoint-home__pane">
            <div class="polysaas-endpoint-home__consumers-head">
                <h2>Producers</h2>
                <p>Events this {{ title }} home receives — live bindings only.</p>
            </div>
            <ul class="polysaas-consumer-list" data-producer-list>
                {% for producer in producers %}
                <li class="polysaas-consumer-list__item">
                    <div class="polysaas-consumer-list__link">
                        <span class="polysaas-consumer-list__title">{{ producer.display_name }}</span>
                        <span class="polysaas-consumer-list__meta">
                            <code>{{ producer.event_key }}</code>
                            {% if producer.action_path %} · <code>{{ producer.action_path }}</code>{% endif %}
                            · {{ producer.paired_count }} consumer{{ producer.paired_count|pluralize }}
                        </span>
                        <span class="polysaas-producer-state polysaas-producer-state--{{ producer.state|lower }}">{{ producer.state }}</span>
                    </div>
                    {% if producer.pairable %}
                    <button
                        type="button"
                        class="polysaas-consumer-list__run polysaas-producer-pair"
                        data-pair-producer
                        data-event-key="{{ producer.event_key }}"
                        data-paired-ids="{% for cid in producer.paired_consumer_ids %}{{ cid }}{% if not forloop.last %},{% endif %}{% endfor %}"
                    >Pair…</button>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}

        {% if consumers %}
        <div class="polysaas-endpoint-home__panel polysaas-endpoint-home__pane">
            <div class="polysaas-endpoint-home__consumers-head">
                <h2>Consumers</h2>
                <p>Instructions bound for {{ title }} — click to open, or run a linked form when available.</p>
            </div>
            <ul class="polysaas-consumer-list" data-consumer-list>
                {% for consumer in consumers %}
                <li class="polysaas-consumer-list__item" data-consumer-id="{{ consumer.id }}">
                    <a class="polysaas-consumer-list__link" href="{{ consumer.admin_url }}">
                        <span class="polysaas-consumer-list__title">{{ consumer.title }}</span>
                        <span class="polysaas-consumer-list__meta">
                            <code>{{ consumer.method }} {{ consumer.request_path }}</code>
                            → <strong>{{ consumer.executescript }}</strong>
                        </span>
                        {% if consumer.event_key %}
                        <span class="polysaas-consumer-list__event">{{ consumer.event_key }}</span>
                        {% endif %}
                        {% if consumer.fed_by %}
                        <span class="polysaas-consumer-list__fed">fed by: {{ consumer.fed_by|join:", " }}</span>
                        {% endif %}
                    </a>
                    {% if consumer.form_key %}
                    <button
                        type="button"
                        class="polysaas-consumer-list__run"
                        data-form="{{ consumer.form_key }}"
                    >Run</button>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
    </section>

    <dialog class="polysaas-pair-dialog" data-pair-dialog>
        <form method="dialog" class="polysaas-pair-dialog__form">
            <h3 data-pair-title>Pair producer</h3>
            <p class="polysaas-pair-dialog__hint">Select consumers on this home. Pairing sets event key + action path so orch can match; uncheck and save to unpair.</p>
            <div class="polysaas-pair-dialog__list" data-pair-choices></div>
            <div class="polysaas-pair-dialog__actions">
                <button type="submit" value="cancel" class="polysaas-pair-dialog__cancel">Cancel</button>
                <button type="button" class="polysaas-pair-dialog__save" data-pair-save>Save</button>
            </div>
        </form>
    </dialog>

</main>
{% endblock %}

{% block extrajs %}
{{ block.super }}
<script src="{% static 'admin/js/orchestration_bar.js' %}?v=20260824-1"></script>
<script src="{% static 'admin/js/endpoint_home.js' %}?v=20260828-1"></script>
{% endblock %}
