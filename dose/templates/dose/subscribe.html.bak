<!-- THIS CODE IS FROZEN — NO CHANGES TO THIS CODE ARE ALLOWED WITHOUT THE OWNER'S PERMISSION -->
<!-- BINGO: Subscribe Behavior Enhanced — commit c9339777 -->
<!-- BINGO: Production Preview demo — provisioning failure feedback — 2026-06-15 -->
{% extends "dose/dosebase.html" %}
{% load static %}
{% block title %}PolySaaS Online{% endblock %}
{% block header_title %}PolySaaS Online{% endblock %}
{% block content %}

<style>
    .subscription-form {
        max-width: 440px;
        margin: 2em auto;
        padding: 2em;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .form-group { margin-bottom: 1.5em; }
    .form-label { display: block; margin-bottom: 0.5em; font-weight: 500; color: #333; }
    .form-input {
        width: 100%;
        padding: 0.75em;
        border: 2px solid #1976d2;
        border-radius: 4px;
        font-size: 1em;
        outline: none;
        transition: border-color 0.2s;
        background: #f9f9f9;
    }
    .form-input:focus { border-color: #1565c0; background: #fff; }
    #card-element {
        border: 2px solid #1976d2;
        border-radius: 4px;
        padding: 0.75em;
        background: #f9f9f9;
        margin-bottom: 1em;
    }
    .subscription-btn {
        width: 100%;
        padding: 0.75em;
        background: #1976d2;
        color: #fff;
        border: none;
        border-radius: 4px;
        font-size: 1em;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }
    .subscription-btn:hover { background: #1565c0; }
    .subscription-btn:disabled { opacity: 0.65; cursor: not-allowed; background: #90a4ae; }
    #subscribe-hint { color: #d32f2f; font-size: 0.95em; margin-top: 0.75em; text-align: center; min-height: 1.25em; }
    #card-errors { color: #d32f2f; margin-top: 1em; font-size: 0.95em; }

    /* ── Plan cards ── */
    .plan-cards { display: flex; justify-content: center; gap: 1.25em; flex-wrap: wrap; margin: 0.75em 0 0.5em; }
    .plan-card {
        background: #fff; border: 2px solid #e0e0e0; border-radius: 10px;
        padding: 1.25em; width: 200px; text-align: center; cursor: pointer;
        transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s; position: relative;
    }
    .plan-card:hover { border-color: #90caf9; box-shadow: 0 4px 16px rgba(25,118,210,0.12); transform: translateY(-2px); }
    .plan-card.selected { border-color: #1976d2; box-shadow: 0 4px 20px rgba(25,118,210,0.2); }
    .plan-card.recommended { border-color: #43a047; box-shadow: 0 4px 16px rgba(67,160,71,0.18); }
    .plan-card.selected.recommended { border-color: #1976d2; }
    .plan-badge {
        position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
        background: #43a047; color: #fff; font-size: 0.72em; font-weight: 600;
        padding: 0.2em 0.65em; border-radius: 12px; white-space: nowrap;
    }
    .plan-card h3 { margin: 0.4em 0 0.2em; color: #333; font-size: 1.1em; }
    .plan-price { font-size: 1.6em; font-weight: 700; color: #1976d2; margin: 0.2em 0 0.4em; }
    .plan-price span { font-size: 0.45em; font-weight: 400; color: #888; }
    .plan-features { list-style: none; padding: 0; margin: 0 0 0.75em; font-size: 0.85em; color: #555; }
    .plan-features li { padding: 0.25em 0; border-bottom: 1px solid #f0f0f0; }
    .plan-features li:last-child { border-bottom: none; }
    .plan-select-btn {
        width: 100%; padding: 0.45em; border: 2px solid #1976d2; border-radius: 4px;
        background: transparent; color: #1976d2; font-weight: 600; cursor: pointer;
        transition: background 0.2s, color 0.2s;
    }
    .plan-card.selected .plan-select-btn { background: #1976d2; color: #fff; }
    .plan-select-btn:hover { background: #e3f2fd; }
    .plan-card.selected .plan-select-btn:hover { background: #1565c0; }

    /* ── App checkbox rows ── */
    .app-checkbox-row {
        display: flex;
        align-items: center;
        margin-bottom: 0.5em;
        gap: 0.5em;
    }
    .app-checkbox-row input[type="checkbox"] {
        margin: 0;
        flex-shrink: 0;
        width: 18px;
        height: 18px;
        cursor: pointer;
    }
    .app-checkbox-row label {
        font-weight: normal;
        color: #555;
        margin: 0;
        cursor: pointer;
        line-height: 1.4;
    }
    .app-slot-label {
        color: #1976d2;
        font-size: 0.85em;
    }
    .app-checkbox-row.app-unavailable {
        opacity: 0.7;
    }
    .app-checkbox-row.app-unavailable input[type="checkbox"] {
        cursor: not-allowed;
    }
    .app-checkbox-row.app-unavailable label {
        cursor: not-allowed;
        color: #888;
    }
    .app-coming-soon {
        font-size: 0.82em;
        color: #999;
        font-style: italic;
    }

    /* ── Slot advisory messages ── */
    #slot-advisory {
        margin: 0.5em 0; padding: 0.75em 1em; border-radius: 6px;
        font-size: 0.92em; line-height: 1.45; display: none;
    }
    #slot-advisory.info { background: #e3f2fd; border: 1px solid #90caf9; color: #1565c0; }
    #slot-advisory.warn { background: #fff3e0; border: 1px solid #ffb74d; color: #e65100; }

    /* Provisioning wait modal */
    #subscribe-provisioning-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 2147483646;
        background: rgba(15, 23, 42, 0.55);
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
    }
    #subscribe-provisioning-modal.is-visible {
        display: flex;
    }
    #subscribe-provisioning-modal .spm-dialog {
        max-width: 420px;
        width: 100%;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        padding: 1.75rem 1.5rem 1.5rem;
        text-align: center;
    }
    #subscribe-provisioning-modal .spm-spinner {
        width: 44px;
        height: 44px;
        margin: 0 auto 1rem;
        border: 4px solid #e3f2fd;
        border-top-color: #1976d2;
        border-radius: 50%;
        animation: spm-spin 0.85s linear infinite;
    }
    @keyframes spm-spin {
        to { transform: rotate(360deg); }
    }
    #subscribe-provisioning-modal .spm-title {
        margin: 0 0 0.65rem;
        font-size: 1.15em;
        font-weight: 700;
        color: #1565c0;
    }
    #subscribe-provisioning-modal .spm-body {
        margin: 0;
        font-size: 0.98em;
        line-height: 1.5;
        color: #455a64;
    }
</style>

<h2 style="text-align:center; margin-bottom:0.25em;">Subscribe to PolySaaS</h2>
<p style="text-align:center; font-size:1.05em; margin-bottom:1.5em; color:#555;">
    All plans include a <strong>14-day free trial</strong>. Upgrade anytime.
</p>

<form id="subscription-form" class="subscription-form" method="post" action="" novalidate>
    <div id="stripe-load-error" style="display:none;color:#d32f2f;margin-bottom:1em;font-size:1em;text-align:center;">Unable to load secure card fields. Please check your internet connection or contact support.</div>
    {% csrf_token %}
    <input type="hidden" id="plan-tier" name="plan_tier" value="">

    <!-- ═══ Section 1: Tenant & Account ═══ -->
    <div class="form-group">
        <label for="tenant-name" class="form-label">Tenant Name</label>
        <input type="text" id="tenant-name" name="tenant_name" class="form-input" required placeholder="Your organization or tenant name" value="">
        <div class="field-error" id="tenant-name-error" style="color:#d32f2f;font-size:0.95em;"></div>
    </div>
    <div class="form-group">
        <label for="tenant-shortname" class="form-label">Tenant Short Name (slug)</label>
        <input type="text" id="tenant-shortname" name="tenant_shortname" class="form-input" required minlength="3" maxlength="32" placeholder="Short name, e.g. olient" title="Lowercase letters, numbers, hyphens only. No spaces." value="">
        <small style="color:#666;">Lowercase letters, numbers, hyphens only. No spaces.</small>
        <div class="field-error" id="tenant-shortname-error" style="color:#d32f2f;font-size:0.95em;"></div>
    </div>
    <div class="form-group">
        <label for="username" class="form-label">Username</label>
        <input type="text" id="username" name="username" class="form-input" required placeholder="Choose a username" value="" autocomplete="new-username">
        <div class="field-error" id="username-error" style="color:#d32f2f;font-size:0.95em;"></div>
    </div>
    <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <div style="position:relative;display:flex;align-items:center;">
            <input type="password" id="password" name="password" class="form-input" required placeholder="Choose a password" minlength="9" title="Password must be at least 9 characters, cannot start with a number, and must include at least one special character." value="" autocomplete="new-password" style="padding-right:2.6em;flex:1;">
            <button type="button" id="toggle-password" tabindex="-1" onclick="(function(){var f=document.getElementById('password'),b=document.getElementById('toggle-password');if(f.type==='password'){f.type='text';b.textContent='🙈';}else{f.type='password';b.textContent='👁';}})()" aria-label="Show/hide password" style="position:absolute;right:8px;background:none;border:none;cursor:pointer;font-size:1.1em;padding:0;line-height:1;color:#666;">👁</button>
        </div>
        <small style="color:#666;">At least 9 characters, cannot start with a number, must include a special character.</small>
        <div class="field-error" id="password-error" style="color:#d32f2f;font-size:0.95em;"></div>
    </div>
    <div class="form-group">
        <label for="email" class="form-label">Email</label>
        <input type="email" id="email" name="email" class="form-input" required placeholder="Your email address" value="">
        <div class="field-error" id="email-error" style="color:#d32f2f;font-size:0.95em;"></div>
    </div>

    <!-- ═══ Section 2: Applications (pick first, plan follows) ═══ -->
    <div class="form-group" style="border: 1px solid #e0e0e0; padding: 1em; border-radius: 4px; background: #f8f9fa;">
        <h4 style="margin-top: 0; color: #333; font-size: 1.1em;">
            Select Your Applications
            <span id="slot-count-label" style="font-size:0.82em; color:#888; margin-left:0.5em;"></span>
        </h4>
        <small style="display: block; color: #666; margin-bottom: 0.75em;">
            Pick the applications you need. Odoo, WordPress and PolySysMon each count as <strong>2 slots</strong>; all others count as 1.
            A plan that fits will be recommended below.
            Bundled apps are queued after subscribe; you will get email when each is ready.
        </small>
        <div class="app-checkbox-row">
            <input type="checkbox" id="enable-odoo" name="enable_odoo" class="app-checkbox" data-app-slots="2">
            <label for="enable-odoo">Odoo ERP <span class="app-slot-label">(2 slots)</span></label>
        </div>
        <div class="app-checkbox-row">
            <input type="checkbox" id="enable-nextcloud" name="enable_nextcloud" class="app-checkbox">
            <label for="enable-nextcloud">Nextcloud File Storage <span class="app-slot-label">(1 slot)</span></label>
        </div>
        <div class="app-checkbox-row">
            <input type="checkbox" id="enable-dolibarr" name="enable_dolibarr" class="app-checkbox">
            <label for="enable-dolibarr">Dolibarr ERP/CRM <span class="app-slot-label">(1 slot)</span></label>
        </div>
        <div class="app-checkbox-row">
            <input type="checkbox" id="enable-mattermost" name="enable_mattermost" class="app-checkbox">
            <label for="enable-mattermost">Mattermost Team Chat <span class="app-slot-label">(1 slot)</span></label>
        </div>
        <div class="app-checkbox-row app-unavailable">
            <input type="checkbox" id="enable-wordpress" name="enable_wordpress" class="app-checkbox" data-app-slots="2" disabled aria-disabled="true">
            <label for="enable-wordpress">WordPress CMS <span class="app-slot-label">(2 slots)</span> <span class="app-coming-soon">— coming soon</span></label>
        </div>
        <div class="app-checkbox-row app-unavailable">
            <input type="checkbox" id="enable-liferay" name="enable_liferay" class="app-checkbox" disabled aria-disabled="true">
            <label for="enable-liferay">Liferay <span class="app-slot-label">(1 slot)</span> <span class="app-coming-soon">— coming soon</span></label>
        </div>
        <div class="app-checkbox-row app-unavailable">
            <input type="checkbox" id="enable-monitor-logger" name="enable_monitor_logger" class="app-checkbox" disabled aria-disabled="true">
            <label for="enable-monitor-logger">Monitor Logger <span class="app-slot-label">(1 slot)</span> <span class="app-coming-soon">— coming soon</span></label>
        </div>
        <div class="app-checkbox-row app-unavailable">
            <input type="checkbox" id="enable-polysysmon" name="enable_polysysmon" class="app-checkbox" data-app-slots="2" disabled aria-disabled="true">
            <label for="enable-polysysmon">PolySysMon <span class="app-slot-label">(2 slots)</span> <span class="app-coming-soon">— coming soon</span></label>
        </div>
        <div id="slot-advisory"></div>
    </div>

    <!-- ═══ Section 3: Plan Selection (driven by app choices) ═══ -->
    <div class="form-group">
        <h4 style="margin: 0 0 0.25em; color: #333; font-size: 1.1em;">Choose Your Plan</h4>
        <p id="plan-suggestion" style="font-size:0.92em; color:#555; margin: 0 0 0.75em;"></p>
        <div class="plan-cards">
            <div class="plan-card" data-tier="polysaas-1" data-price="{{ PRICE_1 }}">
                <h3>PolySaaS-1</h3>
                <div class="plan-price">${{ PRICE_1 }}<span>/user/mo</span></div>
                <ul class="plan-features">
                    <li>1 application slot</li>
                    <li>All integrations</li>
                    <li>14-day free trial</li>
                </ul>
                <button type="button" class="plan-select-btn" onclick="selectPlan('polysaas-1')">Select</button>
            </div>
            <div class="plan-card" data-tier="polysaas-3" data-price="{{ PRICE_3 }}">
                <h3>PolySaaS-3</h3>
                <div class="plan-price">${{ PRICE_3 }}<span>/user/mo</span></div>
                <ul class="plan-features">
                    <li>Up to 3 application slots</li>
                    <li>All integrations</li>
                    <li>14-day free trial</li>
                </ul>
                <button type="button" class="plan-select-btn" onclick="selectPlan('polysaas-3')">Select</button>
            </div>
            <div class="plan-card" data-tier="polysaas-unlimited" data-price="{{ PRICE_UNLIMITED }}">
                <h3>PolySaaS-Unlimited</h3>
                <div class="plan-price">${{ PRICE_UNLIMITED }}<span>/user/mo</span></div>
                <ul class="plan-features">
                    <li>Unlimited applications</li>
                    <li>All integrations</li>
                    <li>14-day free trial</li>
                    <li>Priority support</li>
                </ul>
                <button type="button" class="plan-select-btn" onclick="selectPlan('polysaas-unlimited')">Select</button>
            </div>
        </div>
    </div>

    <!-- Storage Add-on -->
    <div class="form-group" style="border: 1px solid #e0e0e0; padding: 1em; border-radius: 4px; background: #f8f9fa;">
        <h4 style="margin-top: 0; color: #333; font-size: 1.1em;">File Storage <span style="font-size:0.85em; color:#888;">(usage-based)</span></h4>
        <small style="display: block; color: #666; margin-bottom: 0.5em;">Storage for Nextcloud and WordPress files is billed at <strong>$0.12/GB per month</strong> based on actual usage. No charge if you don't use file storage.</small>
    </div>

    <!-- ═══ Section 4: Payment ═══ -->
    <div class="form-group">
        <label for="zip" class="form-label">ZIP Code</label>
        <input type="text" id="zip" name="zip" class="form-input" required pattern="\d{4,5}" maxlength="5" placeholder="ZIP code (4 or 5 digits)" value="">
        <small style="color:#666;">Philippines: 4 digits, US: 5 digits</small>
        <div class="field-error" id="zip-error" style="color:#d32f2f;font-size:0.95em;"></div>
    </div>
    <div class="form-group">
        <label for="amount" class="form-label">Amount (USD)</label>
        <input type="number" id="amount" name="amount" class="form-input" min="1" step="0.01" value="" required readonly style="background:#eee;cursor:not-allowed;">
        <div class="field-error" id="amount-error" style="color:#d32f2f;font-size:0.95em;"></div>
    </div>
    <div class="form-group">
        <label for="card-name" class="form-label">Name on Card</label>
        <input type="text" id="card-name" name="card_name" class="form-input" required placeholder="Name as it appears on card" value="">
        <div class="field-error" id="card-name-error" style="color:#d32f2f;font-size:0.95em;"></div>
    </div>
    <div class="form-group">
        <label for="card-element" class="form-label">Credit/Debit Card</label>
        <div id="card-element"></div>
    </div>

    <div id="subscribe-submit-status" role="alert" aria-live="assertive" style="min-height:1.25em;margin:0.75em 0 0.5em;font-size:0.98em;line-height:1.4;"></div>
    <div id="card-errors" role="alert" style="margin-bottom:0.5em;font-size:0.95em;"></div>
    <button type="submit" id="subscribe-btn" class="subscription-btn" disabled>Subscribe &amp; Pay</button>
    <div id="subscribe-hint" aria-live="polite"></div>
</form>

<div id="subscribe-provisioning-modal" role="dialog" aria-modal="true" aria-labelledby="subscribe-provisioning-title" aria-describedby="subscribe-provisioning-body" aria-hidden="true">
    <div class="spm-dialog">
        <div class="spm-spinner" aria-hidden="true"></div>
        <h3 id="subscribe-provisioning-title" class="spm-title">Setting up your account</h3>
        <p id="subscribe-provisioning-body" class="spm-body">
            We are provisioning your accounts and bundled applications.
            Please be patient — just a few moments longer.
        </p>
    </div>
</div>

{{ plan_max_apps|json_script:"ps-plan-max-apps" }}
{{ plan_prices|json_script:"ps-plan-prices" }}
<script src="https://js.stripe.com/v3/"></script>
<script>
/* ================================================================
   Subscribe page logic — apps-first flow
   ================================================================ */
var APP_LIMITS, PLAN_PRICES;
(function () {
    function readJsonScript(id, fallback) {
        var el = document.getElementById(id);
        if (!el || !el.textContent) return fallback;
        try { return JSON.parse(el.textContent); }
        catch (e) { return fallback; }
    }
    APP_LIMITS = readJsonScript('ps-plan-max-apps', {
        'polysaas-1': 1, 'polysaas-3': 3, 'polysaas-unlimited': null
    });
    PLAN_PRICES = readJsonScript('ps-plan-prices', {
        'polysaas-1': 26, 'polysaas-3': 49, 'polysaas-unlimited': 99
    });
})();

/* ── Slot arithmetic ──────────────────────────────────────────── */

function appCheckboxSlots(cb) {
    var s = cb.getAttribute('data-app-slots');
    return s ? parseInt(s, 10) : 1;
}
function totalSelectedSlots() {
    var t = 0;
    document.querySelectorAll('.app-checkbox:checked').forEach(function(cb) {
        t += appCheckboxSlots(cb);
    });
    return t;
}

/* ── Plan suggestion based on slot count ─────────────────────── */

var PLAN_TIERS_ASC = ['polysaas-1', 'polysaas-3', 'polysaas-unlimited'];

function cheapestPlanForSlots(slots) {
    if (slots <= 0) return 'polysaas-1';
    for (var i = 0; i < PLAN_TIERS_ASC.length; i++) {
        var lim = APP_LIMITS[PLAN_TIERS_ASC[i]];
        if (lim === null || slots <= lim) return PLAN_TIERS_ASC[i];
    }
    return 'polysaas-unlimited';
}

function updateSlotAdvisory() {
    var slots = totalSelectedSlots();
    var adv = document.getElementById('slot-advisory');
    var label = document.getElementById('slot-count-label');
    label.textContent = slots > 0 ? '(' + slots + ' slot' + (slots === 1 ? '' : 's') + ' selected)' : '';

    if (slots === 0) {
        adv.style.display = 'none';
        adv.className = '';
        return;
    }
    if (slots > 3) {
        adv.style.display = '';
        adv.className = 'warn';
        adv.innerHTML = '<strong>You have selected more than 3 application slots.</strong> ' +
            'This requires the <strong>PolySaaS-Unlimited</strong> plan ($' + PLAN_PRICES['polysaas-unlimited'] + '/user/mo). ' +
            'Select fewer apps to qualify for a less expensive plan.';
    } else if (slots > 1) {
        adv.style.display = '';
        adv.className = 'info';
        adv.textContent = 'Your selections need the PolySaaS-3 plan or higher.';
    } else {
        adv.style.display = '';
        adv.className = 'info';
        adv.textContent = 'Fits the PolySaaS-1 plan.';
    }
}

function suggestAndSelectPlan() {
    var slots = totalSelectedSlots();
    var recommended = cheapestPlanForSlots(slots);
    var suggestion = document.getElementById('plan-suggestion');

    if (slots === 0) {
        suggestion.textContent = 'Select applications above, then pick a plan here.';
    } else {
        var price = PLAN_PRICES[recommended] || '—';
        var label = recommended.replace('polysaas-', 'PolySaaS-').replace('unlimited', 'Unlimited');
        suggestion.innerHTML = 'Based on your selections (<strong>' + slots + ' slot' +
            (slots === 1 ? '' : 's') + '</strong>), we recommend <strong>' + label +
            '</strong> ($' + price + '/user/mo).';
    }

    document.querySelectorAll('.plan-card').forEach(function(card) {
        var badge = card.querySelector('.plan-badge');
        if (badge) badge.remove();
        card.classList.remove('recommended');
    });

    var recCard = document.querySelector('.plan-card[data-tier="' + recommended + '"]');
    if (recCard && slots > 0) {
        recCard.classList.add('recommended');
        var badge = document.createElement('div');
        badge.className = 'plan-badge';
        badge.textContent = 'Recommended';
        recCard.appendChild(badge);
    }

    var wp = document.getElementById('enable-wordpress');
    var ps = document.getElementById('enable-polysysmon');
    document.querySelectorAll('.plan-card').forEach(function(card) {
        var tier = card.getAttribute('data-tier');
        var lim = APP_LIMITS[tier];
        var tooSmall = (lim !== null && slots > lim);
        var wpPsConflict = (tier === 'polysaas-3' && wp.checked && ps.checked);
        var btn = card.querySelector('.plan-select-btn');
        if (tooSmall || wpPsConflict) {
            card.style.opacity = '0.5';
            card.style.pointerEvents = 'none';
            btn.disabled = true;
        } else {
            card.style.opacity = '';
            card.style.pointerEvents = '';
            btn.disabled = false;
        }
    });

    var currentTier = document.getElementById('plan-tier').value;
    var currentLimit = APP_LIMITS[currentTier];
    if (!currentTier || (currentLimit !== null && slots > currentLimit)) {
        selectPlan(recommended);
    }
}

/* ── Plan selection ───────────────────────────────────────────── */

function selectPlan(tier) {
    var card = document.querySelector('.plan-card[data-tier="' + tier + '"]');
    if (!card || card.style.pointerEvents === 'none') return;
    var price = card.getAttribute('data-price');

    document.getElementById('plan-tier').value = tier;
    document.getElementById('amount').value = price;

    document.querySelectorAll('.plan-card').forEach(function(c) {
        c.classList.remove('selected');
        c.querySelector('.plan-select-btn').textContent = 'Select';
    });
    card.classList.add('selected');
    card.querySelector('.plan-select-btn').textContent = 'Selected';

    checkFormFields();
}

/* ── App checkbox change handler ─────────────────────────────── */

document.querySelectorAll('.app-checkbox').forEach(function(cb) {
    cb.addEventListener('change', function() {
        updateSlotAdvisory();
        suggestAndSelectPlan();
        checkFormFields();
    });
});

/* ── Plan card click handler ─────────────────────────────────── */

document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.plan-card').forEach(function(card) {
        card.addEventListener('click', function() {
            var tier = card.getAttribute('data-tier');
            selectPlan(tier);
        });
    });
    updateSlotAdvisory();
    suggestAndSelectPlan();
    checkFormFields();
});

function showProvisioningModal() {
    var modal = document.getElementById('subscribe-provisioning-modal');
    if (!modal) return;
    modal.classList.add('is-visible');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
}

function hideProvisioningModal() {
    var modal = document.getElementById('subscribe-provisioning-modal');
    if (!modal) return;
    modal.classList.remove('is-visible');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
}

function showSubscribeFeedback(message, options) {
    options = options || {};
    var isError = options.isError !== false;
    var statusEl = document.getElementById('subscribe-submit-status');
    var cardErr = document.getElementById('card-errors');
    var c = isError ? '#c62828' : '#2e7d32';
    var shown = false;
    var useHtml = options.html || false;
    if (statusEl) {
        if (useHtml) { statusEl.innerHTML = message || ''; } else { statusEl.textContent = message || ''; }
        statusEl.style.color = message ? c : '';
        statusEl.style.fontWeight = message ? '600' : '';
        if (message) shown = true;
    }
    if (cardErr) {
        if (isError) {
            if (useHtml) { cardErr.innerHTML = message || ''; } else { cardErr.textContent = message || ''; }
            cardErr.style.color = message ? c : '';
        } else {
            cardErr.innerHTML = '';
            cardErr.textContent = '';
        }
    }
    if (message && !shown) {
        var toast = document.getElementById('subscribe-fallback-toast');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'subscribe-fallback-toast';
            toast.setAttribute('role', 'alert');
            toast.style.cssText = 'position:fixed;bottom:12px;left:12px;right:12px;max-height:40vh;overflow:auto;padding:14px 16px;border-radius:8px;z-index:2147483647;font-size:15px;line-height:1.4;box-shadow:0 6px 24px rgba(0,0,0,0.25);border:2px solid;';
            document.body.appendChild(toast);
        }
        toast.textContent = message;
        toast.style.display = 'block';
        if (isError) { toast.style.background = '#ffebee'; toast.style.color = '#b71c1c'; toast.style.borderColor = '#c62828'; }
        else { toast.style.background = '#e8f5e9'; toast.style.color = '#1b5e20'; toast.style.borderColor = '#2e7d32'; }
    } else {
        var t2 = document.getElementById('subscribe-fallback-toast');
        if (t2 && !message) t2.style.display = 'none';
    }
    if (message && options.scroll !== false && statusEl) {
        try { statusEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch (e) {}
    }
}

function payloadErrorMessage(data) {
    if (!data || typeof data !== 'object' || Array.isArray(data)) return null;
    if (typeof data.error === 'string' && data.error) return data.error;
    if (typeof data.detail === 'string' && data.detail) return data.detail;
    if (Array.isArray(data.detail) && data.detail.length) {
        return data.detail.map(function (x) { return typeof x === 'string' ? x : JSON.stringify(x); }).join(' ');
    }
    if (data.non_field_errors && data.non_field_errors.length) return [].concat(data.non_field_errors).join(' ');
    var parts = [];
    Object.keys(data).forEach(function (k) {
        var v = data[k];
        if (v == null) return;
        if (Array.isArray(v) && v.length && typeof v[0] === 'string') parts.push(k + ': ' + v.join(' '));
    });
    return parts.length ? parts.join(' | ') : null;
}

/* ── Field validation ─────────────────────────────────────────── */

function subscribeHintForFailure(failedField) {
    var map = {
        'tenant-name': 'Enter your organization / tenant name.',
        'tenant-shortname': 'Enter a valid short name (lowercase letters, numbers, hyphens; 3\u201332 characters).',
        'tenant-shortname (slug validation)': 'Short name must use only lowercase letters, numbers, and hyphens (3\u201332 characters).',
        'username': 'Choose a username.',
        'password': 'Enter a password (at least 9 characters).',
        'password (validation)': 'Password: at least 9 characters, cannot start with a number, and must include a special character.',
        'email': 'Enter a valid email address.',
        'zip': 'Enter a ZIP or postal code (4 or 5 digits).',
        'amount': 'Select a plan first.',
        'card-name': 'Enter the name as it appears on the card.',
        'plan-tier': 'Select a plan.',
    };
    return map[failedField] || 'Please complete all required fields above.';
}

function checkFormFields() {
    var requiredFields = [
        'tenant-name', 'tenant-shortname', 'username', 'password', 'email', 'zip', 'card-name'
    ];
    var allFilled = true;
    var failedField = null;
    for (var i = 0; i < requiredFields.length; i++) {
        var el = document.getElementById(requiredFields[i]);
        if (!el || !el.value || (el.type === 'password' && el.value.length < 9)) {
            allFilled = false;
            failedField = requiredFields[i];
            break;
        }
    }
    if (allFilled) {
        var pw = document.getElementById('password').value;
        var specialCharRegex = /[!@#$%^&*()_+=\-\[\]{};':",.<>/?`~]/;
        if (pw.length < 9 || /^[0-9]/.test(pw) || !specialCharRegex.test(pw)) {
            allFilled = false;
            failedField = 'password (validation)';
        }
    }
    if (allFilled) {
        var sn = document.getElementById('tenant-shortname').value;
        if (!/^[a-z0-9-]+$/.test(sn) || sn.length < 3 || sn.length > 32) {
            allFilled = false;
            failedField = 'tenant-shortname (slug validation)';
        }
    }
    if (allFilled) {
        var tier = document.getElementById('plan-tier').value;
        if (!tier) { allFilled = false; failedField = 'plan-tier'; }
    }
    if (allFilled) {
        var amt = document.getElementById('amount').value;
        if (!amt || isNaN(amt) || Number(amt) < 1) { allFilled = false; failedField = 'amount'; }
    }
    var btn = document.getElementById('subscribe-btn');
    var hint = document.getElementById('subscribe-hint');
    if (btn) { btn.disabled = !allFilled; }
    if (hint) { hint.textContent = allFilled ? '' : subscribeHintForFailure(failedField); }
}

function validateField(id) {
    var error = '';
    var el = document.getElementById(id);
    var val = el ? el.value : '';
    if (!el) return;
    switch (id) {
        case 'tenant-name': if (!val.trim()) error = 'Tenant name is required.'; break;
        case 'tenant-shortname':
            if (!val.trim()) error = 'Short name is required.';
            else if (!/^[a-z0-9-]+$/.test(val)) error = 'Only lowercase letters, numbers, hyphens.';
            else if (val.length < 3 || val.length > 32) error = 'Must be 3-32 characters.';
            break;
        case 'username': if (!val.trim()) error = 'Username is required.'; break;
        case 'password':
            var specialCharRegex = /[!@#$%^&*()_+=\-\[\]{};':",.<>/?`~]/;
            if (!val) error = 'Password is required.';
            else if (val.length < 9) error = 'At least 9 characters.';
            else if (/^[0-9]/.test(val)) error = 'Cannot start with a number.';
            else if (!specialCharRegex.test(val)) error = 'Must include a special character.';
            break;
        case 'email':
            if (!val.trim()) error = 'Email is required.';
            else if (!/^\S+@\S+\.\S+$/.test(val)) error = 'Invalid email address.';
            break;
        case 'zip':
            if (!val.trim()) error = 'ZIP code is required.';
            else if (!/^\d{4,5}$/.test(val)) error = 'ZIP must be 4 or 5 digits.';
            break;
        case 'card-name': if (!val.trim()) error = 'Name on card is required.'; break;
    }
    var errorDiv = document.getElementById(id + '-error');
    if (errorDiv) errorDiv.textContent = error;
    return !error;
}

var fieldIds = ['tenant-name', 'tenant-shortname', 'username', 'password', 'email', 'zip', 'card-name'];
fieldIds.forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('blur', function() { validateField(id); });
});
document.addEventListener('input', function(e) {
    if (fieldIds.indexOf(e.target.id) !== -1) validateField(e.target.id);
    checkFormFields();
});
document.addEventListener('DOMContentLoaded', function() {
    checkFormFields();
});

/* ── Stripe ───────────────────────────────────────────────────── */

var stripeLoaded = false;
var stripe, elements, card;
var _spk = '{{ STRIPE_PUBLISHABLE_KEY }}';
if (_spk && _spk.indexOf('pk_') === 0) {
    try {
        stripe = Stripe(_spk);
        elements = stripe.elements();
        stripeLoaded = true;
        card = elements.create('card', { hidePostalCode: true });
        card.mount('#card-element');
        card.on('change', function(event) {
            document.getElementById('card-errors').textContent = event.error ? event.error.message : '';
        });
    } catch (e) {
        console.error('Stripe init error:', e);
        document.getElementById('stripe-load-error').style.display = 'block';
    }
} else {
    document.getElementById('stripe-load-error').textContent = 'Stripe is not configured. Card payment is unavailable (STRIPE_PUBLISHABLE_KEY missing).';
    document.getElementById('stripe-load-error').style.display = 'block';
}

/* ── Submit handler ───────────────────────────────────────────── */

var subscribeSubmitInFlight = false;
function resetSubscribeButton() {
    subscribeSubmitInFlight = false;
    hideProvisioningModal();
    var b = document.getElementById('subscribe-btn');
    if (b) {
        b.disabled = false;
        b.textContent = 'Subscribe & Pay';
    }
}

document.getElementById('subscription-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    var btn = document.getElementById('subscribe-btn');
    if (subscribeSubmitInFlight) return;

    checkFormFields();
    var requiredFields = ['tenant-name', 'tenant-shortname', 'username', 'password', 'email', 'zip', 'card-name'];
    var fail = null;
    for (var i = 0; i < requiredFields.length; i++) {
        var el = document.getElementById(requiredFields[i]);
        if (!el || !String(el.value || '').trim()) { fail = requiredFields[i]; break; }
    }
    var password = document.getElementById('password').value;
    var specialCharRegex = /[!@#$%^&*()_+=\-\[\]{};':",.<>/?`~]/;
    if (!fail && (password.length < 9 || /^[0-9]/.test(password) || !specialCharRegex.test(password))) fail = 'password (validation)';
    var shortname = document.getElementById('tenant-shortname').value;
    if (!fail && (!/^[a-z0-9-]+$/.test(shortname) || shortname.length < 3 || shortname.length > 32)) fail = 'tenant-shortname (slug validation)';
    var zipVal = document.getElementById('zip').value;
    if (!fail && !/^\d{4,5}$/.test(zipVal)) fail = 'zip';
    var planTier = document.getElementById('plan-tier').value;
    if (!fail && !planTier) fail = 'plan-tier';
    var amt = document.getElementById('amount').value;
    if (!fail && (!amt || isNaN(amt) || Number(amt) < 1)) fail = 'amount';

    if (fail) {
        showSubscribeFeedback(subscribeHintForFailure(fail), { isError: true });
        return;
    }

    if (typeof stripe === 'undefined' || !card) {
        showSubscribeFeedback('Payment form did not load. Check your connection, disable blockers, refresh the page, or verify the Stripe publishable key.', { isError: true });
        return;
    }

    showSubscribeFeedback('', {});
    subscribeSubmitInFlight = true;
    if (btn) {
        btn.disabled = true;
        btn.textContent = 'Processing…';
    }
    showProvisioningModal();

    var cardholderName = document.getElementById('card-name').value;
    var tenantName = document.getElementById('tenant-name').value;
    var email = document.getElementById('email').value;
    var zip = document.getElementById('zip').value;
    var amount = document.getElementById('amount').value;
    var username = document.getElementById('username').value;
    var tenantShortname = document.getElementById('tenant-shortname').value;

    var tokenResult;
    try {
        tokenResult = await stripe.createToken(card, { name: cardholderName });
    } catch (err) {
        showSubscribeFeedback('Stripe could not read the card. If you used Link or a saved card, try entering test card 4242 4242 4242 4242 manually, or refresh the page.', { isError: true });
        resetSubscribeButton();
        if (card) card.clear();
        return;
    }
    if (tokenResult.error) {
        showSubscribeFeedback(tokenResult.error.message || 'Card was declined or invalid.', { isError: true });
        resetSubscribeButton();
        if (card) card.clear();
        return;
    }

    var payload = {
        stripe_token: tokenResult.token.id,
        tenant_name: tenantName,
        tenant_shortname: tenantShortname,
        card_name: cardholderName,
        amount: amount,
        email: email,
        zip: zip,
        username: username,
        password: password,
        plan_tier: planTier,
        enable_odoo: !!document.getElementById('enable-odoo').checked,
        enable_nextcloud: !!document.getElementById('enable-nextcloud').checked,
        enable_dolibarr: !!document.getElementById('enable-dolibarr').checked,
        enable_mattermost: !!document.getElementById('enable-mattermost').checked,
        enable_wordpress: !!document.getElementById('enable-wordpress').checked,
        enable_liferay: !!document.getElementById('enable-liferay').checked,
        enable_monitor_logger: !!document.getElementById('enable-monitor-logger').checked,
        enable_polysysmon: !!document.getElementById('enable-polysysmon').checked,
    };

    try {
        console.log('[subscribe] POST /dose/api/subscriptions/ payload:', payload);
    } catch (e) {}

    var csrfInput = document.querySelector('[name=csrfmiddlewaretoken]');
    if (!csrfInput || !csrfInput.value) {
        showSubscribeFeedback('Security token missing \u2014 refresh the page and try again.', { isError: true });
        resetSubscribeButton();
        return;
    }

    fetch('/dose/api/subscriptions/', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrfInput.value },
        body: JSON.stringify(payload)
    }).then(async function(response) {
        var rawText = '';
        try { rawText = await response.text(); } catch (readErr) {
            showSubscribeFeedback('Could not read server response.', { isError: true });
            resetSubscribeButton(); if (card) card.clear(); return;
        }
        var data = null;
        if (rawText) {
            try {
                data = JSON.parse(rawText);
            } catch (e) {
                try {
                    console.warn('[subscribe] Non-JSON response (likely HTML error). status=' + response.status);
                    console.warn(rawText.slice(0, 800));
                } catch (e2) {}
            }
        }

        if (!response.ok) {
            var errMsg = data ? payloadErrorMessage(data) : null;
            if (!errMsg && rawText) errMsg = rawText.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 700);
            if (!errMsg) errMsg = 'Request failed (HTTP ' + response.status + ').';
            if (data && data.login_url) {
                errMsg += ' <a href="' + data.login_url + '" style="color:#1976d2;font-weight:600;text-decoration:underline;">Sign in here</a>';
            }
            showSubscribeFeedback(errMsg, { isError: true, html: !!(data && data.login_url) });
            resetSubscribeButton(); if (card) card.clear(); return;
        }
        // 2xx response — only bail on explicit error/detail fields, not on any array field
        var looksOk = response.ok && data && typeof data === 'object' && !data.error && !data.detail;
        if (data.trial_welcome || data.provisioning_notice) {
            try {
                sessionStorage.setItem('polysaas_subscribe_notice', JSON.stringify({
                    trial_welcome: data.trial_welcome || '',
                    provisioning_notice: data.provisioning_notice || ''
                }));
            } catch (e) {}
        }
        // Store new credentials so the login page can pre-fill them
        var newUsername = document.getElementById('username') ? document.getElementById('username').value : '';
        var newPassword = document.getElementById('password') ? document.getElementById('password').value : '';
        try {
            sessionStorage.setItem('polysaas_new_user_creds', JSON.stringify({ u: newUsername, p: newPassword }));
            // Store Mattermost credentials to restore after login (without team name)
            if (data.mm_username && data.mm_password) {
                sessionStorage.setItem('polysaas_mm_creds', JSON.stringify({
                    username: data.mm_username,
                    password: data.mm_password,
                    email: data.mm_email || newUsername,
                    mattermost_token: data.mm_token || ''
                }));
            }
        } catch(e) {}
        var loginUrl = '/dose/login/?next=/admin/';
        hideProvisioningModal();
        var feedbackParts = ['Subscription saved!'];
        if (data.trial_welcome) {
            feedbackParts.push(data.trial_welcome);
        }
        if (data.provisioning_notice) {
            feedbackParts.push(data.provisioning_notice);
        }
        var hasProvFailure = false;
        if (data.provisioning_results && typeof data.provisioning_results === 'object') {
            Object.keys(data.provisioning_results).forEach(function(k) {
                var row = data.provisioning_results[k];
                if (row && row.success === false) {
                    hasProvFailure = true;
                }
            });
        }
        if (data.mm_provisioning_failed) {
            hasProvFailure = true;
        }
        feedbackParts.push(
            '<a href="' + loginUrl + '" style="color:#1565c0;font-weight:700;text-decoration:underline;">Click here to log in</a> \u2014 redirecting in 6 seconds\u2026'
        );
        showSubscribeFeedback(
            feedbackParts.join(' '),
            { isError: hasProvFailure, html: true }
        );
        setTimeout(function() { window.location.assign(loginUrl); }, 6000);
    }).catch(function(err) {
        showSubscribeFeedback('Network error: ' + (err && err.message ? err.message : String(err)), { isError: true });
        resetSubscribeButton(); if (card) card.clear();
    });
});
</script>
{% endblock %}
