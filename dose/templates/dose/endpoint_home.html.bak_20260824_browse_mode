{% extends "admin/base_site.html" %}
{% load static %}

{% block title %}{{ title }} · PolySaaS{% endblock %}

{% block extrahead %}
{{ block.super }}
<link rel="stylesheet" href="{% static 'admin/css/endpoint_home.css' %}?v=20260824-2">
{% endblock %}

{% block content %}
<main
    class="polysaas-endpoint-home"
    data-endpoint-home
    data-status-url="{{ endpoint_status_url }}"
>
    <header class="polysaas-endpoint-home__header">
        <div>
            <h1>{{ title }}</h1>
            <div>{{ endpoint.description|default:"Configured consumers and selected actions" }}</div>
        </div>
        {% if browser_launch_url %}
        <a
            class="polysaas-endpoint-home__launch"
            href="{{ browser_launch_url }}"
            target="_blank"
            rel="noopener"
        >Browse {{ app_label }} ↗</a>
        {% endif %}
    </header>

    <nav class="polysaas-endpoint-home__bookmarks" aria-label="{{ title }} bookmarks">
        {% for bookmark in bookmarks %}
            {% if bookmark.destination_type == "external_path" or bookmark.destination_type == "passthrough_path" %}
                {% if bookmark.url %}
                <a
                    class="polysaas-endpoint-bookmark"
                    href="{{ bookmark.url }}"
                    {% if bookmark.destination_type == "external_path" %}target="_blank" rel="noopener"{% endif %}
                    title="{{ bookmark.description }}"
                ><span>{{ bookmark.icon }}</span>{{ bookmark.title }}</a>
                {% else %}
                <button class="polysaas-endpoint-bookmark" type="button" disabled>{{ bookmark.icon }} {{ bookmark.title }}</button>
                {% endif %}
            {% else %}
            <button
                class="polysaas-endpoint-bookmark"
                type="button"
                data-bookmark-type="{{ bookmark.destination_type }}"
                data-bookmark-target="{{ bookmark.target }}"
                data-action-url="{{ bookmark.url }}"
                {% if bookmark.disabled %}disabled{% endif %}
                title="{{ bookmark.description }}"
            ><span>{{ bookmark.icon }}</span>{{ bookmark.title }}</button>
            {% endif %}
        {% empty %}
            <span>No bookmarks published yet.</span>
        {% endfor %}
    </nav>

    {% include "dose/includes/orchestration_bar.html" %}

    <section class="polysaas-endpoint-home__surface" aria-label="Configured consumers">
        <div class="polysaas-endpoint-home__consumers">
            <div class="polysaas-endpoint-home__consumers-head">
                <h2>Configured consumers</h2>
                <p>Instructions bound for this app — click to open, or run a linked form when available.</p>
            </div>
            {% if consumers %}
            <ul class="polysaas-consumer-list">
                {% for consumer in consumers %}
                <li class="polysaas-consumer-list__item">
                    <a class="polysaas-consumer-list__link" href="{{ consumer.admin_url }}">
                        <span class="polysaas-consumer-list__title">{{ consumer.title }}</span>
                        <span class="polysaas-consumer-list__meta">
                            <code>{{ consumer.method }} {{ consumer.request_path }}</code>
                            → <strong>{{ consumer.executescript }}</strong>
                        </span>
                        {% if consumer.event_key %}
                        <span class="polysaas-consumer-list__event">{{ consumer.event_key }}</span>
                        {% endif %}
                    </a>
                    {% if consumer.form_key %}
                    <button
                        type="button"
                        class="polysaas-consumer-list__run"
                        data-form="{{ consumer.form_key }}"
                    >Run</button>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <div class="polysaas-endpoint-home__placeholder">
                <div>
                    <h2>No consumers configured</h2>
                    <p>Bind an Instruction for this endpoint to see it listed here.</p>
                </div>
            </div>
            {% endif %}
        </div>
    </section>

    {% if surface_template %}
    <div class="polysaas-endpoint-home__form-host" aria-hidden="true">
        {% include surface_template %}
    </div>
    {% endif %}
</main>
{% endblock %}

{% block extrajs %}
{{ block.super }}
<script src="{% static 'admin/js/orchestration_bar.js' %}?v=20260824-1"></script>
<script src="{% static 'admin/js/endpoint_home.js' %}?v=20260824-2"></script>
{% endblock %}
