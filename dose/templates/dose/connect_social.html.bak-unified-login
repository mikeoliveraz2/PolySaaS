{% extends "dose/dosebase.html" %}
{% block content %}
<h2>Connect Your Social Account</h2>
<p style="text-align:center; font-size:1.1em; margin-bottom:1.5em; color:#1976d2;">
    For enhanced security and single sign-on, connect your Google account to your Dose account.<br>
    You can skip this step and connect later from your profile.
</p>
<div style="text-align:center; margin-bottom:2em;">
    <a href="/accounts/google/login/?process=connect&prompt=select_account" class="btn btn-google" style="display:inline-block;padding:0.75em 1.5em;background:#fff;color:#444;border:1px solid #4285f4;border-radius:4px;font-weight:600;font-size:1em;text-decoration:none;box-shadow:0 2px 4px rgba(66,133,244,0.08);margin-bottom:1em;">
        <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google logo" style="height:20px;vertical-align:middle;margin-right:8px;">Connect with Google
    </a>
</div>
<div style="text-align:center;">
    <a href="/dose/login/?next=/admin/" style="color:#1976d2;">Skip for now and go to login</a>
</div>
{% endblock %}
