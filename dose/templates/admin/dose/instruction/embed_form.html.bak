<!-- THIS CODE IS FROZEN — NO CHANGES TO THIS CODE ARE ALLOWED WITHOUT THE OWNER'S PERMISSION
BINGO: Orchestration Bar + Instruction Embed — commit PENDING -->
{% extends "admin/base.html" %}
{% load i18n admin_urls static admin_modify jazzmin %}
{% get_jazzmin_settings request as jazzmin_settings %}
{% firstof orch_active_theme request.GET.orch_theme jazzmin_theme "flatly" as active_theme %}
{% firstof orch_display_mode request.GET.orch_mode "light" as active_mode %}

{% block extrastyle %}
    {{ block.super }}
    <link rel="stylesheet" href="{% static 'vendor/select2/css/select2.min.css' %}">
    <link rel="stylesheet" href="{% static 'admin/css/ps_instruction_form.css' %}?v=20260611-select2">
    <style>
        body.popup .app-main { margin-left: 0 !important; padding-top: 0 !important; }
        body.popup .app-content { padding: 0 !important; }
        body.popup .container-fluid { padding: 12px 16px !important; }
        #ps-orch-embed-title { font-size: 1.05rem; font-weight: 600; margin: 0 0 12px; }
        body.ps-orch-embed-dark,
        html[data-ps-theme="darkly"] body.popup,
        html[data-ps-theme="cyborg"] body.popup,
        html[data-ps-theme="slate"] body.popup,
        html[data-ps-theme="solar"] body.popup,
        html[data-ps-theme="superhero"] body.popup {
            background: #1f2937 !important;
            color: #e2e8f0;
        }
        body.ps-orch-embed-dark .card,
        html[data-ps-theme="darkly"] body.popup .card,
        html[data-ps-theme="cyborg"] body.popup .card,
        html[data-ps-theme="slate"] body.popup .card,
        html[data-ps-theme="solar"] body.popup .card,
        html[data-ps-theme="superhero"] body.popup .card {
            background: #111827 !important;
            border-color: #374151 !important;
            color: #e2e8f0;
        }
        body.ps-orch-embed-dark .form-control,
        body.ps-orch-embed-dark .form-select,
        body.ps-orch-embed-dark .ps-instruction-select,
        body.ps-orch-embed-dark select,
        body.ps-orch-embed-dark input,
        body.ps-orch-embed-dark textarea,
        html[data-ps-theme="darkly"] body.popup .form-control,
        html[data-ps-theme="darkly"] body.popup .form-select,
        html[data-ps-theme="darkly"] body.popup .ps-instruction-select,
        html[data-ps-theme="darkly"] body.popup select,
        html[data-ps-theme="darkly"] body.popup input,
        html[data-ps-theme="darkly"] body.popup textarea {
            background-color: #0f172a !important;
            color: #e2e8f0 !important;
            border-color: #475569 !important;
        }
        body.ps-orch-embed-dark label,
        body.ps-orch-embed-dark .help,
        body.ps-orch-embed-dark .helptext,
        body.ps-orch-embed-dark p,
        body.ps-orch-embed-dark .text-muted,
        html[data-ps-theme="darkly"] body.popup label,
        html[data-ps-theme="darkly"] body.popup .help,
        html[data-ps-theme="darkly"] body.popup .helptext,
        html[data-ps-theme="darkly"] body.popup p {
            color: #cbd5e1 !important;
        }
        body.ps-orch-embed-dark .nav-tabs .nav-link,
        html[data-ps-theme="darkly"] body.popup .nav-tabs .nav-link {
            color: #cbd5e1;
        }
        body.ps-orch-embed-dark .nav-tabs .nav-link.active,
        html[data-ps-theme="darkly"] body.popup .nav-tabs .nav-link.active {
            background: #111827;
            color: #f8fafc;
            border-color: #475569;
        }
        body.ps-orch-embed-dark .tab-content,
        html[data-ps-theme="darkly"] body.popup .tab-content {
            background: transparent;
        }
    </style>
{% endblock %}

{% block extrahead %}
    {{ block.super }}
    <script type="text/javascript" src="{% url 'admin:jsi18n' %}"></script>
    {{ media }}
    {% include "admin/dose/instruction/param_samples_script.html" %}
{% endblock %}

{% block coltype %}colM{% endblock %}

{% block bodyclass %}{{ block.super }} app-{{ opts.app_label }} model-{{ opts.model_name }} change-form popup{% if orch_is_dark or active_mode == "dark" %} ps-orch-embed-dark{% endif %}{% endblock %}

{% block content_title %}{% endblock %}

{% block content %}
    <p id="ps-orch-embed-title">
        {% if add %}
            {% blocktrans with name=opts.verbose_name %}Add {{ name }}{% endblocktrans %}
        {% else %}
            {% blocktrans with name=opts.verbose_name %}Change {{ name }}{% endblocktrans %}
        {% endif %}
    </p>

    <div id="content-main" class="col-12">
        <form {% if has_file_field %}enctype="multipart/form-data" {% endif %}action="{{ form_url }}" method="post" id="{{ opts.model_name }}_form" novalidate>
            {% csrf_token %}
            {% block form_top %}{% endblock %}

            {% if errors %}
                <div class="alert alert-danger">
                    {% if errors|length == 1 %}
                        {% trans "Please correct the error below." %}
                    {% else %}
                        {% trans "Please correct the errors below." %}
                    {% endif %}
                </div>
                {% for error in adminform.form.non_field_errors %}
                    <div class="alert alert-danger alert-dismissible">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        <i class="icon fa fa-ban"></i>{{ error|capfirst }}
                    </div>
                {% endfor %}
            {% endif %}

            <div class="row">
                <input type="hidden" name="{{ is_popup_var }}" value="1">
                <input type="hidden" name="_orch_theme" value="{{ active_theme }}">
                <input type="hidden" name="_orch_mode" value="{{ active_mode }}">

                {% block field_sets %}
                    <div class="col-12 col-lg-9">
                        <div class="card">
                            <div class="card-body">
                                {% get_changeform_template adminform as changeform_template %}
                                {% include changeform_template %}
                            </div>
                        </div>
                    </div>
                {% endblock %}

                {% block after_field_sets %}{% endblock %}
                {% block inline_field_sets %}{% endblock %}
                {% block after_related_objects %}{% endblock %}

                <div class="col-12 col-lg-3">
                    <div id="jazzy-actions" class="{{ jazzmin_ui.actions_classes }}">
                        {% block submit_buttons_bottom %}
                            {% submit_row %}
                        {% endblock %}
                    </div>
                </div>

                {% block admin_change_form_document_ready %}
                    <script type="text/javascript" id="django-admin-form-add-constants" src="{% static 'admin/js/change_form.js' %}" {% if adminform and add %}data-model-name="{{ opts.model_name }}"{% endif %}></script>
                {% endblock %}

                {% prepopulated_fields_js %}
            </div>
        </form>
    </div>
{% endblock %}

{% block extrajs %}
    {{ block.super }}
    <script type="text/javascript" src="{% static 'vendor/select2/js/select2.min.js' %}"></script>
    <script type="text/javascript" src="{% static 'jazzmin/js/change_form.js' %}"></script>
    <script type="text/javascript" src="{% static 'admin/js/instruction_atomic_service.js' %}"></script>
    {% if active_theme and active_theme != 'default' %}
    <script>
    (function () {
        var BOOTSWATCH = {
            'cerulean':  '{% static "vendor/bootswatch/cerulean/bootstrap.min.css" %}',
            'cosmo':     '{% static "vendor/bootswatch/cosmo/bootstrap.min.css" %}',
            'cyborg':    '{% static "vendor/bootswatch/cyborg/bootstrap.min.css" %}',
            'darkly':    '{% static "vendor/bootswatch/darkly/bootstrap.min.css" %}',
            'flatly':    '{% static "vendor/bootswatch/flatly/bootstrap.min.css" %}',
            'journal':   '{% static "vendor/bootswatch/journal/bootstrap.min.css" %}',
            'litera':    '{% static "vendor/bootswatch/litera/bootstrap.min.css" %}',
            'lumen':     '{% static "vendor/bootswatch/lumen/bootstrap.min.css" %}',
            'lux':       '{% static "vendor/bootswatch/lux/bootstrap.min.css" %}',
            'materia':   '{% static "vendor/bootswatch/materia/bootstrap.min.css" %}',
            'minty':     '{% static "vendor/bootswatch/minty/bootstrap.min.css" %}',
            'pulse':     '{% static "vendor/bootswatch/pulse/bootstrap.min.css" %}',
            'sandstone': '{% static "vendor/bootswatch/sandstone/bootstrap.min.css" %}',
            'simplex':   '{% static "vendor/bootswatch/simplex/bootstrap.min.css" %}',
            'sketchy':   '{% static "vendor/bootswatch/sketchy/bootstrap.min.css" %}',
            'slate':     '{% static "vendor/bootswatch/slate/bootstrap.min.css" %}',
            'solar':     '{% static "vendor/bootswatch/solar/bootstrap.min.css" %}',
            'spacelab':  '{% static "vendor/bootswatch/spacelab/bootstrap.min.css" %}',
            'superhero': '{% static "vendor/bootswatch/superhero/bootstrap.min.css" %}',
            'united':    '{% static "vendor/bootswatch/united/bootstrap.min.css" %}',
            'yeti':      '{% static "vendor/bootswatch/yeti/bootstrap.min.css" %}'
        };
        var DARK_THEMES = ['darkly', 'cyborg', 'slate', 'solar', 'superhero'];
        var want = '{{ active_theme|escapejs }}';
        var mode = '{{ active_mode|escapejs }}';
        var src = BOOTSWATCH[want];
        if (src) {
            var el = document.getElementById('jazzmin-theme');
            if (el) {
                el.href = src;
            } else {
                var l = document.createElement('link');
                l.rel = 'stylesheet';
                l.id = 'jazzmin-theme';
                l.href = src;
                document.head.appendChild(l);
            }
        }
        var isDark = mode === 'dark' || DARK_THEMES.indexOf(want) !== -1;
        if (isDark) {
            document.documentElement.setAttribute('data-bs-theme', 'dark');
            document.documentElement.setAttribute('data-ps-theme', want);
            document.body.classList.add('ps-orch-embed-dark');
        } else {
            document.documentElement.setAttribute('data-bs-theme', 'light');
        }
    })();
    </script>
    {% endif %}
    {% if request.GET.saved %}
    <script>
    (function () {
        try {
            window.parent.postMessage({
                type: 'ps-orch-instruction-saved',
                id: '{{ original.pk|default:"" }}'
            }, '*');
        } catch (e) {}
    })();
    </script>
    {% endif %}
{% endblock %}
