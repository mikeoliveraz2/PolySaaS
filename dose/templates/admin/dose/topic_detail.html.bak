{% extends "admin/base_site.html" %}
{% block content %}
<style>
  .ct-panel {
    max-width: 1100px;
    margin-top: 1rem;
    padding: 1rem 1.25rem 1.25rem;
    border-radius: 0.5rem;
    background: #fff;
    color: #212529;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
  html[data-bs-theme="dark"] .ct-panel,
  html[data-ps-theme="dark"] .ct-panel,
  body.dark-mode .ct-panel {
    background: var(--bs-body-bg, #2b3035);
    color: var(--bs-body-color, #f8f9fa);
    border-color: var(--bs-border-color, #495057);
  }
  .ct-panel h1, .ct-panel h2, .ct-panel a.ct-back { color: inherit; }
  .ct-panel .table { color: inherit; }
  .ct-panel code { color: inherit; }
  .ct-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.75rem 0 1rem; }
  .ct-actions .btn { min-width: 7.5rem; }
  .ct-row-actions { display: flex; gap: 0.4rem; flex-wrap: nowrap; justify-content: flex-end; }
  .ct-row-actions .btn { white-space: nowrap; }
  .ct-when { white-space: nowrap; font-variant-numeric: tabular-nums; }
</style>
<div class="container-fluid">
  <div class="ct-panel">
    <p class="mb-2"><a class="ct-back" href="{% url 'admin:dose_webhookmailbox_topics' %}">&larr; All topics</a></p>
    <h1>Browse Topic</h1>
    <p class="mb-1"><strong>{{ family_label }}</strong> · pending {{ pending_count }}</p>
    <p class="mb-3"><code>{{ topic }}</code></p>

    {% if messages %}
    <ul class="messagelist">{% for message in messages %}<li{% if message.tags %} class="{{ message.tags }}"{% endif %}>{{ message }}</li>{% endfor %}</ul>
    {% endif %}

    <div class="ct-actions">
      {% if consumable %}
      <form method="post" style="display:inline;">
        {% csrf_token %}
        <input type="hidden" name="topic" value="{{ topic }}">
        <input type="hidden" name="action" value="consume">
        <input type="hidden" name="limit" value="100">
        <button type="submit" class="btn btn-sm btn-primary">Consume all pending → history</button>
      </form>
      {% endif %}

      {% if can_requeue %}
      <form method="post" style="display:inline;">
        {% csrf_token %}
        <input type="hidden" name="topic" value="{{ topic }}">
        <input type="hidden" name="action" value="requeue">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Re-queue → pending</button>
      </form>
      {% endif %}

      {% if family != "unknown" %}
      <a class="btn btn-sm btn-outline-secondary"
         href="{% url 'admin:dose_webhookmailbox_topic_history' %}?topic={{ topic|urlencode }}">
        Topic History
      </a>
      {% endif %}
    </div>

    <h2>Envelopes</h2>
    <table class="table table-striped table-sm">
      <thead>
        <tr>
          <th>Status</th>
          <th>Records</th>
          <th>Event</th>
          <th>Date / time</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for e in envelopes %}
        <tr>
          <td>{{ e.status }}</td>
          <td>
            {% if e.record_count %}
            <a class="btn btn-sm btn-outline-primary"
               href="{% url 'admin:dose_webhookmailbox_change' e.id %}">
              Browse records ({{ e.record_count }})
            </a>
            {% else %}
            —
            {% endif %}
          </td>
          <td><code>{{ e.event_id|truncatechars:20 }}</code></td>
          <td class="ct-when">{{ e.created_at|date:"Y-m-d H:i:s" }}</td>
          <td>
            <div class="ct-row-actions">
              <a class="btn btn-sm btn-outline-secondary"
                 href="{% url 'admin:dose_webhookmailbox_change' e.id %}">
                Open
              </a>
              {% if family != "unknown" %}
              <form method="post" style="display:inline; margin:0;">
                {% csrf_token %}
                <input type="hidden" name="topic" value="{{ topic }}">
                <input type="hidden" name="action" value="consume_one">
                <input type="hidden" name="mailbox_id" value="{{ e.id }}">
                <button type="submit" class="btn btn-sm btn-primary">
                  Consume to History
                </button>
              </form>
              {% else %}
              <button type="button" class="btn btn-sm btn-primary disabled" disabled title="No history handler">
                Consume to History
              </button>
              {% endif %}
            </div>
          </td>
        </tr>
        {% empty %}
        <tr><td colspan="5">No envelopes on this topic.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
