{% extends "admin/change_form.html" %}

{% block extrastyle %}
{{ block.super }}
<style>
  /* Layout only — colors come from Jazzmin / Bootstrap theme classes */
  .mailbox-records-pre {
    margin: 0;
    max-height: 40rem;
    overflow: auto;
    white-space: pre;
    font-size: 0.85rem;
    line-height: 1.4;
  }
</style>
{% endblock %}

{% block field_sets %}
{% if mailbox_records_table %}
<div class="card card-outline card-primary mb-3">
  <div class="card-header">
    <h3 class="card-title mb-0">Published inventory records</h3>
  </div>
  <div class="card-body p-3">
    <pre class="mailbox-records-pre mb-0 text-body">{{ mailbox_records_table }}</pre>
  </div>
</div>
{% else %}
<div class="alert alert-secondary mb-3" role="status">
  No <code>records[]</code> on this mailbox row.
  Go back and click a row whose <strong>Payload</strong> column says
  <em>N record(s)</em> (for example <em>10 record(s) — Cable tie pack</em>),
  not the navigate <em>get_response</em> / action-384 row.
</div>
{% endif %}
{{ block.super }}
{% endblock %}
