{% extends "admin/change_form.html" %}

{% block extrastyle %}
{{ block.super }}
<style>
  /* Webhook mailbox change form — high-contrast readable fields */
  .mailbox-banner-ok {
    margin-bottom: 1rem;
    border: 1px solid #1f4b2e;
    border-radius: 8px;
    background: #0f1f14;
    color: #e8f5e9;
    overflow: hidden;
  }
  .mailbox-banner-ok .mailbox-banner-title {
    margin: 0;
    padding: 10px 14px;
    font-size: 1.05rem;
    font-weight: 600;
    background: #1b4332;
    color: #ffffff;
    border-bottom: 1px solid #2d6a4f;
  }
  .mailbox-banner-ok pre {
    margin: 0;
    max-height: 40rem;
    overflow: auto;
    white-space: pre;
    background: #0b1220;
    color: #f1f5f9;
    padding: 14px;
    font-size: 12px;
    line-height: 1.4;
  }

  .mailbox-banner-empty {
    margin-bottom: 1rem;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid #92400e;
    background: #fff7ed;
    color: #1c1917;
    font-size: 14px;
    line-height: 1.45;
  }
  .mailbox-banner-empty code,
  .mailbox-banner-empty strong,
  .mailbox-banner-empty em {
    color: #111827;
  }

  /* Jazzmin readonly / fieldset description on this page */
  .app-dose.model-webhookmailbox .card-body .form-group .readonly,
  .app-dose.model-webhookmailbox .card-body .form-group .form-control[readonly],
  .app-dose.model-webhookmailbox .card-body .form-group textarea,
  .app-dose.model-webhookmailbox .card-body .form-group .help,
  .app-dose.model-webhookmailbox .card-body .form-group .help-block,
  .app-dose.model-webhookmailbox .card-body .form-group label + div,
  .app-dose.model-webhookmailbox .card-body .form-row .readonly {
    color: #111827 !important;
    background: #f8fafc !important;
  }
  .app-dose.model-webhookmailbox .card-body .text-muted,
  .app-dose.model-webhookmailbox .card-body .form-text {
    color: #334155 !important;
  }
  .app-dose.model-webhookmailbox fieldset .description {
    color: #1e293b !important;
    background: #e2e8f0 !important;
    border: 1px solid #94a3b8 !important;
    padding: 8px 10px !important;
    border-radius: 6px !important;
  }
</style>
{% endblock %}

{% block field_sets %}
{% if mailbox_records_table %}
<div class="mailbox-banner-ok">
  <div class="mailbox-banner-title">Published inventory records</div>
  <pre>{{ mailbox_records_table }}</pre>
</div>
{% else %}
<div class="mailbox-banner-empty">
  No <code>records[]</code> on this mailbox row.
  Go back and click a row whose <strong>Payload</strong> column says
  <em>N record(s)</em> (for example <em>10 record(s) — Cable tie pack</em>),
  not the navigate <em>get_response</em> / action-384 row.
</div>
{% endif %}
{{ block.super }}
{% endblock %}
