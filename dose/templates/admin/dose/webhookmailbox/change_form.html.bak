{% extends "admin/change_form.html" %}

{% block extrastyle %}
{{ block.super }}
<style>
  /*
    Follow PolySaaS / Jazzmin theme tokens (same hooks as sidebar + instruction embed).
    Do not hardcode orange/white or force light-only field colors.
  */
  .mailbox-records-card {
    margin-bottom: 1rem;
  }
  .mailbox-records-pre {
    margin: 0;
    max-height: 40rem;
    overflow: auto;
    white-space: pre;
    font-size: 0.85rem;
    line-height: 1.4;
    padding: 0.75rem;
    border-radius: 0.25rem;
    color: var(--bs-body-color, #212529);
    background-color: var(--bs-body-bg, #fff);
    border: 1px solid var(--bs-border-color, #dee2e6);
  }

  html[data-bs-theme="dark"] .mailbox-records-pre,
  html[data-ps-theme="darkly"] .mailbox-records-pre,
  html[data-ps-theme="cyborg"] .mailbox-records-pre,
  html[data-ps-theme="slate"] .mailbox-records-pre,
  html[data-ps-theme="solar"] .mailbox-records-pre,
  html[data-ps-theme="superhero"] .mailbox-records-pre,
  body.dark-mode .mailbox-records-pre {
    color: var(--bs-body-color, #f8f9fa);
    background-color: var(--bs-body-bg, #212529);
    border-color: var(--bs-border-color, #495057);
  }

  /* If Jazzmin still renders a readonly box on this page, inherit theme too */
  .app-dose.model-webhookmailbox .form-group .readonly,
  .app-dose.model-webhookmailbox .form-control[readonly],
  .app-dose.model-webhookmailbox fieldset .description {
    color: var(--bs-body-color, inherit) !important;
    background-color: var(--bs-tertiary-bg, var(--bs-body-bg, transparent)) !important;
    border-color: var(--bs-border-color, transparent) !important;
  }

  html[data-bs-theme="dark"] .app-dose.model-webhookmailbox .form-group .readonly,
  html[data-ps-theme="darkly"] .app-dose.model-webhookmailbox .form-group .readonly,
  html[data-ps-theme="cyborg"] .app-dose.model-webhookmailbox .form-group .readonly,
  html[data-ps-theme="slate"] .app-dose.model-webhookmailbox .form-group .readonly,
  html[data-ps-theme="solar"] .app-dose.model-webhookmailbox .form-group .readonly,
  html[data-ps-theme="superhero"] .app-dose.model-webhookmailbox .form-group .readonly,
  body.dark-mode .app-dose.model-webhookmailbox .form-group .readonly {
    color: var(--bs-body-color, #f8f9fa) !important;
    background-color: var(--bs-body-bg, #2b3035) !important;
  }
</style>
{% endblock %}

{% block field_sets %}
{% if mailbox_records_table %}
<div class="card card-outline card-primary mailbox-records-card">
  <div class="card-header">
    <h3 class="card-title mb-0">Published inventory records</h3>
  </div>
  <div class="card-body p-3">
    <pre class="mailbox-records-pre">{{ mailbox_records_table }}</pre>
  </div>
</div>
{% else %}
<div class="alert alert-secondary mb-3" role="status">
  No <code>records[]</code> on this mailbox row.
  Go back and click a row whose <strong>Payload</strong> column says
  <em>N record(s)</em> (for example <em>10 record(s) — Cable tie pack</em>),
  not the navigate <em>get_response</em> / action-384 row.
</div>
{% endif %}
{{ block.super }}
{% endblock %}
