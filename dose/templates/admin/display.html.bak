{% extends "admin/base_site.html" %}

{% block title %}PolySaaS Display{% endblock %}

{% block extrastyle %}
<style>
    #polysaas-orchestration-bar {
        background-color: #1a1a1a;
        color: #0f0;
        padding: 10px 15px;
        border-bottom: 3px solid #0f0;
        font-family: monospace;
        font-size: 15px;
        margin: 0 -15px 20px -15px;
    }

    #polysaas-display-body-bucket {
        position: relative;
        border: 2px dashed #555;
        padding: 20px;
        min-height: 500px;
        background-color: #fafafa;
        max-width: 100%;
        width: 100%;
        box-sizing: border-box;
        overflow-x: auto;
        /* no contain: layout — breaks Odoo/Owl sub-views (e.g. Discuss) after in-app nav */
    }

    /* Keep Odoo root nodes inside the column (they often use 100% / fixed layouts). */
    #polysaas-display-body-bucket #wrapwrap,
    #polysaas-display-body-bucket .o_web_client {
        max-width: 100% !important;
        width: 100% !important;
        box-sizing: border-box !important;
    }

    /* Force the placeholder h3 to be visible regardless of font-controls JS overrides.
       CSS !important beats JS el.style.fontSize = '14px' (inline style without !important). */
    #polysaas-body-placeholder {
        display: block !important;
        visibility: visible !important;
        color: #c0392b !important;
        background-color: #fff3cd !important;
        font-size: 20px !important;
        font-weight: 700 !important;
        padding: 12px 16px !important;
        margin: 0 0 12px 0 !important;
        border-left: 5px solid #c0392b !important;
        border-radius: 3px !important;
        opacity: 1 !important;
    }

    /* Head fragment must stay in the content column (not global extrahead) so Jazzmin is not torn down. Hidden, not a visible “bucket”. */
    #polysaas-display-head-inject {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
</style>
{% endblock %}

{% block content %}
    <div id="polysaas-orchestration-bar">
        ● POLYSAAS ORCHESTRATION ACTIVE — DISPLAY SHELL (PHASE 1)<br>
        <span style="color:#86efac;font-size:13px;">Phase 1 Shell — Use browser refresh (F5) to reload. Do not use the in-app Reload button yet.</span><br>
        <span style="color:#86efac;font-size:13px;">Note: In-app Reload currently takes you out of Phase 1 shell. Use browser refresh (F5) to return.</span>
    </div>

    <div id="polysaas-display-body-bucket">
        <h3 id="polysaas-body-placeholder">✅ CONTENT AREA WORKING — upstream response body will be injected here</h3>
    </div>

    <small style="color:#666;">{{ display_shell_footer|default:"Passthrough display shell — trigger is shown when the handler sets display_shell_footer." }}</small>
{% endblock %}

{% block extrajs %}
{{ block.super }}
    {# Odoo mounts late; root may be #wrapwrap or .o_web_client (not always body direct). #}
    <script>
    (function () {
        var bucket = document.getElementById('polysaas-display-body-bucket');
        if (!bucket) return;

        function canMove(el) {
            return el && el !== document.body && el !== document.documentElement;
        }

        function firstOutsideBucket(selector) {
            var list = document.querySelectorAll(selector);
            var i;
            var el;
            for (i = 0; i < list.length; i++) {
                el = list[i];
                if (canMove(el) && !bucket.contains(el)) {
                    return el;
                }
            }
            return null;
        }

        function tuckFromBodyChildren() {
            var ch = document.body ? document.body.children : [];
            var i;
            var n;
            for (i = 0; i < ch.length; i++) {
                n = ch[i];
                if (n.contains && n.contains(bucket)) {
                    continue;
                }
                if (n === bucket) {
                    continue;
                }
                if (n.tagName === 'SCRIPT' || n.tagName === 'STYLE' || n.tagName === 'LINK') {
                    continue;
                }
                if (n.id === 'wrapwrap' && canMove(n)) {
                    bucket.appendChild(n);
                    return true;
                }
                if (canMove(n) && n.classList && (n.classList.contains('o_web_client') || n.classList.contains('o_home_menu_background'))) {
                    bucket.appendChild(n);
                    return true;
                }
            }
            return false;
        }

        function tuck() {
            var el;
            var list;
            var i;
            if (tuckFromBodyChildren()) {
                return;
            }
            el = firstOutsideBucket('#wrapwrap');
            if (el) {
                bucket.appendChild(el);
                return;
            }
            el = firstOutsideBucket('.o_web_client');
            if (el) {
                bucket.appendChild(el);
                return;
            }
            list = document.querySelectorAll('.o_action_manager');
            for (i = 0; i < list.length; i++) {
                el = list[i];
                if (canMove(el) && !bucket.contains(el)) {
                    bucket.appendChild(el);
                    return;
                }
            }
        }

        function start() {
            tuck();
            [400, 800, 1500, 3000, 6000, 10000].forEach(function (ms) {
                setTimeout(tuck, ms);
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', start);
        } else {
            start();
        }

        // Diagnostic: confirm placeholder h3 is in the DOM and visible
        (function checkPlaceholder() {
            var ph = document.getElementById('polysaas-body-placeholder');
            if (ph) {
                console.log('[PolySaaS Display] ✅ placeholder h3 found in DOM. offsetHeight=' + ph.offsetHeight + ' computedColor=' + (window.getComputedStyle ? window.getComputedStyle(ph).color : 'n/a'));
            } else {
                console.warn('[PolySaaS Display] ❌ placeholder h3 NOT found in DOM — check template rendering');
            }
        })();

        if (document.body && typeof MutationObserver !== 'undefined') {
            var tuckTimer = null;
            function debouncedTuck() {
                if (tuckTimer) {
                    clearTimeout(tuckTimer);
                }
                tuckTimer = setTimeout(function () {
                    tuckTimer = null;
                    tuck();
                }, 250);
            }
            var mo = new MutationObserver(debouncedTuck);
            mo.observe(document.body, { childList: true, subtree: true });
            /* Do not disconnect: Odoo SPA adds new roots to body after Apps → Discuss, etc. */
            window.addEventListener('hashchange', debouncedTuck);
            window.addEventListener('popstate', debouncedTuck);
        }
    })();
    </script>
    {# Odoo passthrough: must run at end of body (after Jazzmin extrajs) so XHR/fetch are patched before deferred Odoo modules execute. Head-inject div scripts are unreliable here. #}
    {% if display_odoo_pt_prefix %}
    <script>
    (function () {
        console.log('[PolySaaS Odoo] Shim loaded - forcing action = null for clean start');
        if (window.odoo && window.odoo.__session_info__) {
            window.odoo.__session_info__.action = null;
            console.log('[PolySaaS Odoo] Action forced to null');
        }
        var P = '{{ display_odoo_pt_prefix|escapejs }}';
        console.log('[PolySaaS Odoo DEBUG] Shim started - P =', P);
        console.log('[PolySaaS Odoo DEBUG] Initial fetch path being used:', 'check network for first /pt/admin/odoo/ request');
        function fix(u) {
            console.log('[PolySaaS Odoo DEBUG] fix() called with url:', u);
            if (typeof u !== 'string' || !u) return u;
            if (/^https?:\/\//i.test(u)) {
                try {
                    var o = window.location.origin;
                    if (u.indexOf(o) === 0) u = u.slice(o.length);
                    else return u;
                } catch (e) {
                    return u;
                }
            }
            /* Collapse /mail/<P>/… and /bus/<P>/… (bad relative joins → double prefix in workers/RPC). */
            var mailPad = '/mail/' + P, busPad = '/bus/' + P;
            if (u === mailPad || u.indexOf(mailPad + '/') === 0) u = '/mail' + u.slice(mailPad.length);
            if (u === busPad || u.indexOf(busPad + '/') === 0) u = '/bus' + u.slice(busPad.length);
            var pb = P + '/bus/' + P, pm = P + '/mail/' + P;
            while (u.indexOf(pb) !== -1) u = u.split(pb).join(P + '/bus');
            while (u.indexOf(pm) !== -1) u = u.split(pm).join(P + '/mail');
            /* Already under this passthrough prefix — do not prefix again (avoids double /pt/admin/odoo/...). */
            if (u === P || u.startsWith(P + '/')) return u;
            if (u === '/mail' || u.startsWith('/mail/')) return P + u;
            /* Bus, worker bundles, and loose *worker* paths (not /web/… assets). Strip leading /odoo/ once to avoid P+/odoo/odoo/… */
            if (u === '/bus' || u.startsWith('/bus/') || u.indexOf('websocket_worker_bundle') !== -1 || (u.indexOf('worker') !== -1 && u.indexOf('/web/') !== 0)) {
                return P + u.replace(/^\/odoo\//, '/');
            }
            if (u === '/discuss' || u.startsWith('/discuss/') || u === '/odoo/discuss' || u.startsWith('/odoo/discuss/')) {
                return P + u.replace(/^\/odoo\//, '/');
            }
            /* Odoo bus — same-origin WS to /websocket (query allowed). */
            if (u === '/websocket' || /^\/websocket(\/|\?|$)/.test(u)) return P + u;
            if (u.startsWith('/web/dataset/') || u.startsWith('/web/action/') || u.startsWith('/jsonrpc')) return P + u;
            /* Website / translations / frontend lazy assets (else GET /website/... 404s on PolySaaS host). */
            if (u === '/website' || u.startsWith('/website/')) return P + u;
            if (u.charAt(0) !== '/') {
                if (u.indexOf('web/') === 0 || u.indexOf('website/') === 0 || u.indexOf('odoo/') === 0 || u.indexOf('mail/') === 0 || u.indexOf('bus/') === 0) {
                    return P + '/' + u;
                }
                return u;
            }
            if (u.indexOf('/web/') === 0 || u.indexOf('/website/') === 0 || u === '/odoo' || u.indexOf('/odoo/') === 0) {
                return P + u;
            }
            if (u.indexOf('/json/') === 0 || u.indexOf('/longpolling/') === 0) return P + u;
            return u;
        }
        setTimeout(() => {
            try {
                localStorage.removeItem('odoo_last_action');
                localStorage.removeItem('discuss_last_channel');
                if (window.odoo && window.odoo.__session_info__) {
                    window.odoo.__session_info__.action = null;
                    console.log('[PolySaaS Odoo] Action forced to null + localStorage cleared');
                }
            } catch (e) {}
        }, 3500);
        /* Odoo calls .addEventListener on registration.active (etc.); null caused TypeError. */
        if (navigator.serviceWorker) {
            navigator.serviceWorker.register = function () {
                function fakeWorker() {
                    return {
                        state: 'activated',
                        scriptURL: '',
                        postMessage: function () {},
                        addEventListener: function () {},
                        removeEventListener: function () {},
                        dispatchEvent: function () { return true; }
                    };
                }
                var reg = {
                    scope: (typeof location !== 'undefined' ? location.origin : '') + P + '/web/',
                    active: fakeWorker(),
                    installing: null,
                    waiting: null,
                    navigationPreload: {
                        enable: function () { return Promise.resolve(); },
                        disable: function () { return Promise.resolve(); },
                        setHeaderValue: function () { return Promise.resolve(); },
                        getState: function () { return 'disabled'; }
                    },
                    update: function () { return Promise.resolve(reg); },
                    unregister: function () { return Promise.resolve(true); },
                    addEventListener: function () {},
                    removeEventListener: function () {},
                    dispatchEvent: function () { return true; }
                };
                reg.ready = Promise.resolve(reg);
                return Promise.resolve(reg);
            };
        }
        var _Worker = window.Worker;
        if (_Worker) {
            window.Worker = function (scriptURL, options) {
                if (typeof scriptURL === 'string') scriptURL = fix(scriptURL);
                return new _Worker(scriptURL, options);
            };
        }
        var _SharedWorker = window.SharedWorker;
        if (typeof _SharedWorker === 'function') {
            window.SharedWorker = function (scriptURL, options) {
                if (typeof scriptURL === 'string') scriptURL = fix(scriptURL);
                return new _SharedWorker(scriptURL, options);
            };
        }
        var ox = XMLHttpRequest.prototype.open;
        XMLHttpRequest.prototype.open = function () {
            var a = [].slice.call(arguments);
            a[1] = fix(a[1]);
            return ox.apply(this, a);
        };
        var _WS = window.WebSocket;
        window.WebSocket = function (url, protocols) {
            var u = url;
            if (typeof u === 'string') {
                if (/^wss?:\/\//i.test(u)) {
                    try {
                        var wu = new URL(u);
                        if (wu.origin === location.origin) {
                            var wp = wu.pathname + (wu.search || '') + (wu.hash || '');
                            wp = fix(wp);
                            u = wu.protocol + '//' + wu.host + wp;
                        }
                    } catch (e) {}
                } else {
                    u = fix(u);
                    if (u.charAt(0) === '/') {
                        u = (location.protocol === 'https:' ? 'wss:' : 'ws:') + '//' + location.host + u;
                    }
                }
            }
            if (protocols !== undefined) return new _WS(u, protocols);
            return new _WS(u);
        };
        if (_WS.CONNECTING !== undefined) window.WebSocket.CONNECTING = _WS.CONNECTING;
        if (_WS.OPEN !== undefined) window.WebSocket.OPEN = _WS.OPEN;
        if (_WS.CLOSING !== undefined) window.WebSocket.CLOSING = _WS.CLOSING;
        if (_WS.CLOSED !== undefined) window.WebSocket.CLOSED = _WS.CLOSED;
        /* WSGI passthrough cannot upgrade WS; force HTTP longpolling bus like full Odoo shim. */
        function forceOdooLongPolling() {
            try {
                if (window.odoo && window.odoo.info) window.odoo.info.websocket = false;
            } catch (e) {}
        }
        [0, 100, 500, 1000, 2000, 4000].forEach(function (ms) { setTimeout(forceOdooLongPolling, ms); });
        var ofn = window.fetch;
        window.fetch = function (input, init) {
            if (typeof input === 'string') {
                input = fix(input);
            } else if (input && typeof Request !== 'undefined' && input instanceof Request) {
                var n = fix(input.url);
                if (n !== input.url) input = new Request(n, input);
            } else if (input && typeof URL !== 'undefined' && input instanceof URL) {
                var pu = input.pathname + (input.search || '') + (input.hash || '');
                var nf = fix(pu);
                if (nf !== pu) input = new URL(nf, location.origin);
            }
            return ofn.call(this, input, init);
        };
        if (typeof Response !== 'undefined' && Response.prototype.json) {
            var _rj = Response.prototype.json;
            Response.prototype.json = function () {
                var self = this;
                var ct = (self.headers && self.headers.get) ? (self.headers.get('content-type') || '') : '';
                var ctl = ct.toLowerCase();
                if (ctl.indexOf('text/html') !== -1 || ctl.indexOf('application/xhtml') !== -1) {
                    return Promise.resolve(null);
                }
                return _rj.call(self).catch(function () { return null; });
            };
        }
    })();
    </script>
    {% endif %}
{% endblock %}
