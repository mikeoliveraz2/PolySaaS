{% extends "admin/base_site.html" %}
{% load static %}

{% block title %}Passthrough Display - {{ trigger|default:"External Service" }}{% endblock %}

{% block extrastyle %}
<style>
    .passthrough-shell {
        width: 100%;
        height: calc(100vh - 120px);
        border: 1px solid #dee2e6;
        border-radius: 4px;
        overflow: hidden;
    }
    .passthrough-shell iframe {
        width: 100%;
        height: 100%;
        border: none;
    }
    .passthrough-info {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 4px;
        margin-bottom: 15px;
    }
    .passthrough-info h3 {
        margin-top: 0;
        color: #495057;
    }
    .passthrough-info p {
        margin-bottom: 5px;
        color: #6c757d;
    }
    .loading-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 200px;
        color: #6c757d;
    }
</style>
{% endblock %}

{% block page_content %}
<div class="container-fluid">
    <div class="passthrough-info">
        <h3>Passthrough Display Shell</h3>
        {% if trigger %}
            <p><strong>Service:</strong> {{ trigger }}</p>
            {% if handler_name %}
                <p><strong>Handler:</strong> {{ handler_name }}</p>
            {% endif %}
            {% if endpoint_id %}
                <p><strong>Endpoint ID:</strong> {{ endpoint_id }}</p>
            {% endif %}
        {% else %}
            <p>No service specified. Use ?trigger=<service> to load a passthrough.</p>
        {% endif %}
    </div>

    {% if trigger %}
    <div class="passthrough-shell">
        <iframe 
            src="/pt/admin/{{ trigger }}/" 
            title="Passthrough content for {{ trigger }}"
            loading="lazy"
        ></iframe>
    </div>
    {% else %}
    <div class="loading-indicator">
        <p>Specify a trigger parameter to load passthrough content.</p>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block extrajs %}
<script>
    // Handle any passthrough-specific logic here
    document.addEventListener('DOMContentLoaded', function() {
        console.log('[Passthrough Display Shell] Loaded');
    });
</script>
{% endblock %}