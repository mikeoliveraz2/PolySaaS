{% extends "admin/base.html" %}

{% block title %}{{ title }} - PolySaaS{% endblock %}

{% block content %}
<div style="padding: 30px; max-width: 1000px; margin: 0 auto;">

    <h3 class="mb-4">{{ service_name }}</h3>

    <!-- Login Step -->
    <div id="login-step">
        <div class="card shadow">
            <div class="card-body p-5">
                <h5 class="mb-4">Sign in to {{ service_name }}</h5>
                
                <form onsubmit="handleLogin(event)">
                    <div class="mb-3">
                        <input type="text" id="username" class="form-control form-control-lg" 
                               placeholder="Username or Email" value="admin">
                    </div>
                    <div class="mb-4">
                        <input type="password" id="password" class="form-control form-control-lg" 
                               placeholder="Password" value="admin">
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        Login & Load Service
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Iframe Step -->
    <div id="iframe-step" style="display: none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5>✅ Connected to {{ service_name }}</h5>
            <a href="{{ external_url }}" target="_blank" class="btn btn-outline-primary">
                Open Full Screen →
            </a>
        </div>
        
        <iframe id="service-iframe" 
                style="width: 100%; height: calc(100vh - 170px); border: 1px solid #dee2e6; border-radius: 8px; background: white;"
                allowfullscreen>
        </iframe>
    </div>

</div>

<script>
function handleLogin(e) {
    e.preventDefault();                    // ← This prevents direct submit
    document.getElementById('login-step').style.display = 'none';
    document.getElementById('iframe-step').style.display = 'block';
    
    const iframe = document.getElementById('service-iframe');
    iframe.src = "{{ external_url }}";
}
</script>
{% endblock %}