{% extends "admin/base_site.html" %}
{% load i18n static %}

{% comment %}
Passthrough: full upstream document rendered inside the content column only.
ALL upstream HTML (head styles + body) goes in the scope div — nothing in extrahead.
This prevents Mattermost's global CSS from blowing out the sidebar and header.
{% endcomment %}

{% block bodyclass %}polysaas-passthrough-embed-page{% endblock %}

{% block extrahead %}
{{ block.super }}
<style id="polysaas-passthrough-embed-shield">
/* Drop the right-sidebar column — content takes the full available width */
body.polysaas-passthrough-embed-page .admin-content-grid {
    grid-template-columns: 280px 1fr !important;
}
body.polysaas-passthrough-embed-page .admin-content-grid.sidebar-collapse,
body.polysaas-passthrough-embed-page.polysaas-collapsed .admin-content-grid {
    grid-template-columns: 60px 1fr !important;
}
body.polysaas-passthrough-embed-page #recent-actions-sidebar {
    display: none !important;
}
/* Zero out padding/margin on Jazzmin content wrappers so the app uses the full column */
body.polysaas-passthrough-embed-page .content .container-fluid {
    padding-left: 0 !important;
    padding-right: 0 !important;
    max-width: none !important;
}
body.polysaas-passthrough-embed-page .content .row {
    margin-left: 0 !important;
    margin-right: 0 !important;
}
body.polysaas-passthrough-embed-page .polysaas-passthrough-embed-col {
    padding: 0 !important;
}
/* The scope div fills the available viewport height */
.polysaas-passthrough-scope {
    position: relative;
    width: 100%;
    height: calc(100vh - var(--pss-header-h, 40px) - 90px);
    overflow: auto;
    box-sizing: border-box;
}
/* PolySaaS sidebar — always on top, never overridden */
.admin-content-grid > .collapsible-nav {
    z-index: 1040 !important;
    position: sticky !important;
}
/* Jazzmin top navbar */
#jazzy-navbar,
.app-header {
    z-index: 1050 !important;
}
</style>
{% endblock %}

{% block title %}{{ embed_title }} — {{ site_title|default:_('Django site admin') }}{% endblock %}

{% block breadcrumbs %}
<div class="breadcrumbs">
    <a href="{% url 'admin:index' %}">{% trans 'Home' %}</a>
    &rsaquo; {{ embed_title }}
</div>
{% endblock %}

{% block content %}
<div class="col-12 polysaas-passthrough-embed-col polysaas-passthrough-embed-wrap">
    {% if embed_body %}
    {{ embed_body }}
    {% endif %}
</div>
<p class="text-muted" style="margin-top:10px;font-size:12px;">
    {% trans "Open in full window" %}:
    <a href="{{ embed_src }}" target="_blank" rel="noopener">{{ embed_src }}</a>
</p>
{% endblock %}

{% block extrajs %}
{{ block.super }}
{% endblock %}
