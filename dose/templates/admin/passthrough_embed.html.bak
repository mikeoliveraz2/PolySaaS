{% extends "admin/base_site.html" %}
{% load i18n static %}

{% comment %}
Passthrough: full upstream document in extrahead + content column (no iframe).
Upstream CSS is global; shield styles protect PolySaaS chrome where possible.
{% endcomment %}

{% block bodyclass %}polysaas-passthrough-embed-page{% endblock %}

{% block extrahead %}
{{ block.super }}
{{ embed_head }}
<style id="polysaas-passthrough-embed-shield">
/*
 * Global <link> stylesheets from the bundled app cannot be subtree-scoped without
 * shadow DOM or server-side prefixing. These rules re-stabilize our grid sidebar and
 * top bar after upstream Bootstrap/app CSS loads.
 */
/* Jazzmin wraps the main content template block in .row > .col-*; use full width. */
body.polysaas-passthrough-embed-page .content .container-fluid {
    padding-left: 0 !important;
    padding-right: 0 !important;
    max-width: none !important;
}
body.polysaas-passthrough-embed-page .content .row {
    margin-left: 0 !important;
    margin-right: 0 !important;
}
/* Flex column so % / min-height:0 heights resolve inside the grid cell (not viewport). */
body.polysaas-passthrough-embed-page .admin-content-grid > .dose-content-col {
    min-height: calc(100vh - var(--pss-header-h, 40px) - 48px);
}
body.polysaas-passthrough-embed-page .polysaas-passthrough-embed-col {
    padding-left: 0;
    padding-right: 0;
    flex: 1 1 auto;
    min-width: 0;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    min-height: 0;
    align-self: stretch;
}
/*
 * Clip + transform: containing block for Mattermost position:fixed / 100vh loading UI.
 * Without min-height:0 on flex children, inner height:100% never resolves.
 */
body.polysaas-passthrough-embed-page .polysaas-passthrough-embed-wrap {
    flex: 1 1 auto;
    min-height: 0;
    position: relative;
    transform: translateZ(0);
    clip-path: inset(0);
    -webkit-clip-path: inset(0);
    max-height: calc(100vh - var(--pss-header-h, 40px) - 120px);
    overflow: hidden;
}
.polysaas-passthrough-scope {
    isolation: isolate;
    transform: translateZ(0);
    position: relative;
    height: 100%;
    max-height: 100%;
    min-height: 0;
    overflow: auto;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
}
/* Override Mattermost 100vh on #root — use column height only */
body.polysaas-passthrough-embed-page .polysaas-passthrough-scope #root,
body.polysaas-passthrough-embed-page .polysaas-passthrough-scope [id='root'],
body.polysaas-passthrough-embed-page .polysaas-passthrough-scope #app,
body.polysaas-passthrough-embed-page .polysaas-passthrough-scope [id='app'] {
    height: 100% !important;
    min-height: 0 !important;
    max-height: 100% !important;
    width: 100% !important;
}
/* Initial loading screen (BEM + legacy class names) — pin to scope, not viewport */
body.polysaas-passthrough-embed-page .polysaas-passthrough-scope .LoadingScreen,
body.polysaas-passthrough-embed-page .polysaas-passthrough-scope [class*="LoadingScreen"],
body.polysaas-passthrough-embed-page .polysaas-passthrough-scope [class*="loading-screen"],
body.polysaas-passthrough-embed-page .polysaas-passthrough-scope [class*="InitialLoading"] {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-height: 100% !important;
    min-height: 0 !important;
}
/* PolySaaS left nav (grid column 1) — match custom_sidebar.html */
.admin-content-grid > .collapsible-nav {
    background-color: #1e293b !important;
    box-shadow: 2px 0 12px rgba(15, 23, 42, 0.12) !important;
}
.admin-content-grid > .collapsible-nav .nav-header {
    background-color: #34495e !important;
    color: #fff !important;
    border-bottom-color: #2c3e50 !important;
}
.admin-content-grid > .collapsible-nav a,
.admin-content-grid > .collapsible-nav .nav-link {
    color: #c0c0c0 !important;
}
.admin-content-grid > .collapsible-nav a:hover,
.admin-content-grid > .collapsible-nav .nav-link:hover {
    background-color: rgba(255, 255, 255, 0.15) !important;
    color: #ffffff !important;
}
/* Jazzmin / AdminLTE top navbar */
#jazzy-navbar {
    position: relative !important;
    z-index: 1030 !important;
}
</style>
{% endblock %}

{% block title %}{{ embed_title }} — {{ site_title|default:_('Django site admin') }}{% endblock %}

{% block breadcrumbs %}
<div class="breadcrumbs">
    <a href="{% url 'admin:index' %}">{% trans 'Home' %}</a>
    &rsaquo; {{ embed_title }}
</div>
{% endblock %}

{% block content %}
<div class="col-12 polysaas-passthrough-embed-col polysaas-passthrough-embed-wrap">
    {% if embed_body %}
    {{ embed_body }}
    {% endif %}
</div>
<p class="text-muted" style="margin-top:10px;font-size:12px;">
    {% trans "Open in full window" %}:
    <a href="{{ embed_src }}" target="_blank" rel="noopener">{{ embed_src }}</a>
</p>
{% endblock %}

{% block extrajs %}
{{ block.super }}
{% endblock %}
