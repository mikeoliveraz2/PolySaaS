{% extends "admin/base_site.html" %}
{% load i18n static %}

{# Full browser navigation: Jazzmin shell; upstream header/styles injected; iframe loads full /pt/... app. #}

{% block extrahead %}
{{ block.super }}
{{ embed_head }}
{% endblock %}

{% block title %}{{ embed_title }} — {{ site_title|default:_('Django site admin') }}{% endblock %}

{% block breadcrumbs %}
<div class="breadcrumbs">
    <a href="{% url 'admin:index' %}">{% trans 'Home' %}</a>
    &rsaquo; {{ embed_title }}
</div>
{% endblock %}

{% block content %}
<div class="polysaas-passthrough-embed-wrap" style="display:flex;flex-direction:column;width:100%;height:calc(100vh - 220px);min-height:480px;gap:0;">
    {% if embed_body %}
    <div class="polysaas-passthrough-chrome dose-content-passthrough-chrome" style="flex:0 0 auto;width:100%;">
        {{ embed_body }}
    </div>
    {% endif %}
    <iframe
        title="{{ embed_title }}"
        src="{{ embed_src }}"
        style="flex:1 1 auto;width:100%;min-height:320px;border:0;border-radius:8px;background:#fff;"
        referrerpolicy="same-origin"
    ></iframe>
</div>
<p class="text-muted" style="margin-top:10px;font-size:12px;">
    {% trans "Open in full window" %}:
    <a href="{{ embed_src }}" target="_blank" rel="noopener">{{ embed_src }}</a>
</p>
{% endblock %}
