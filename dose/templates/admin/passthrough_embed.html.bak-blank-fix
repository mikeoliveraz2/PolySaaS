{# Odoo: set color_scheme before upstream head scripts load (must match PolySaaS display_mode). #}
<script>
(function () {
    var want = '{{ embed_polysaas_display_mode|escapejs }}';
    if (want !== 'dark') want = 'light';
    document.cookie = 'color_scheme=' + want + '; path=/; max-age=' + (365 * 24 * 60 * 60) + '; SameSite=Lax';
    console.log('[PolySaaS Odoo] color_scheme cookie set to', want);
})();
</script>
{% endif %}
