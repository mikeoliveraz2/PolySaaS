<script>PolySaaSOrchBar.initEmbed();</script>
    {% if embed_enable_odoo_body_scope %}
    <script>
    (function () {
        'use strict';
        var SCOPE_SEL = '.polysaas-passthrough-scope';

        function getScope() {
            return document.querySelector(SCOPE_SEL);
        }

        var _jazzmin = new Set();
        function _snapshotJazzmin() {
            var _ch = document.body ? Array.prototype.slice.call(document.body.childNodes) : [];
            for (var _i = 0; _i < _ch.length; _i++) { _jazzmin.add(_ch[_i]); }
        }
        _snapshotJazzmin();

        function _isJazzmin(node) {
            if (_jazzmin.has(node)) return true;
            if (!node || !node.classList) return false;
            var c = node.classList;
            if (c.contains('wrapper') || c.contains('app-wrapper') ||
                c.contains('app-footer') || c.contains('main-footer') ||
                c.contains('modal') || c.contains('modal-backdrop') ||
                c.contains('toast') || c.contains('tooltip') ||
                c.contains('popover') || c.contains('dropdown-menu')) return true;
            return false;
        }

        function _isOdooMount(node) {
            if (!node || node.nodeType !== 1) return false;
            var scope = getScope();
            if (scope && (node === scope || scope.contains(node))) return false;
            if (_isJazzmin(node)) return false;
            if (node.classList && (
                node.classList.contains('o_web_client') ||
                node.classList.contains('o_main_navbar') ||
                node.classList.contains('o_home_menu') ||
                node.classList.contains('o_action_manager') ||
                node.classList.contains('o_apps') ||
                node.id === 'wrapwrap'
            )) return true;
            if (node.tagName === 'MAIN' || node.tagName === 'NAV' || node.tagName === 'HEADER') return true;
            return false;
        }

        var _ODOO_BODY_STRIP_CLASSES = ['o_no_scroll'];
        var _ODOO_SCOPE_CLASSES = ['o_web_client', 'o_dark', 'o_light', 'o_rtl', 'o_touch'];

        function _odooShellCandidate(ch) {
            if (!ch || ch.nodeType !== 1) return false;
            if (ch.classList && ch.classList.contains('o_web_client')) return false;
            if (ch.classList && (
                ch.classList.contains('o_main_navbar') ||
                ch.classList.contains('o_action_manager') ||
                ch.classList.contains('o_home_menu') ||
                ch.id === 'wrapwrap'
            )) return true;
            return ch.tagName === 'HEADER' || ch.tagName === 'MAIN' || ch.tagName === 'NAV';
        }

        function _ensureWebClientShell(scope) {
            if (!scope) return;
            scope.classList.add('o_web_client');
            var candidates = [];
            Array.prototype.slice.call(scope.children).forEach(function (ch) {
                if (_odooShellCandidate(ch)) candidates.push(ch);
            });
            var shell = scope.querySelector(':scope > .o_web_client[data-polysaas-odoo-shell]');
            if (!shell && candidates.length) {
                shell = document.createElement('div');
                shell.className = 'o_web_client';
                shell.setAttribute('data-polysaas-odoo-shell', '1');
                scope.appendChild(shell);
                console.log('[PolySaaS Embed] Created .o_web_client shell');
            }
            if (shell && candidates.length) {
                candidates.forEach(function (n) { shell.appendChild(n); });
            }
            _pinNavbar(scope);
        }

        function _mirrorOdooBodyClasses() {
            var scope = getScope();
            if (!scope) return;
            var psMode = (scope.getAttribute('data-polysaas-display-mode') || '').toLowerCase();
            if (psMode === 'dark') {
                scope.classList.add('o_dark');
                scope.classList.remove('o_light');
            } else if (psMode === 'light') {
                scope.classList.add('o_light');
                scope.classList.remove('o_dark');
            }
            _ODOO_SCOPE_CLASSES.forEach(function (cls) {
                if (document.body.classList.contains(cls)) {
                    scope.classList.add(cls);
                }
            });
            _ODOO_BODY_STRIP_CLASSES.forEach(function (cls) {
                if (document.body.classList.contains(cls)) {
                    document.body.classList.remove(cls);
                }
            });
        }

        function _pinNavbar(scope) {
            if (!scope) return;
            var shell = scope.querySelector(':scope > .o_web_client[data-polysaas-odoo-shell]') || scope;
            var nav = shell.querySelector(':scope > .o_main_navbar, :scope > header.o_main_navbar');
            if (!nav) nav = scope.querySelector(':scope > .o_main_navbar, :scope > header.o_main_navbar');
            if (!nav) nav = document.querySelector('header.o_main_navbar, .o_main_navbar');
            if (!nav) return;
            var parent = shell || scope;
            if (!parent.contains(nav)) {
                parent.insertBefore(nav, parent.firstChild);
            } else if (parent.firstElementChild !== nav) {
                parent.insertBefore(nav, parent.firstChild);
            }
            nav.style.setProperty('position', 'relative', 'important');
            nav.style.setProperty('top', 'auto', 'important');
            nav.style.setProperty('display', 'flex', 'important');
            nav.style.setProperty('visibility', 'visible', 'important');
            nav.style.setProperty('opacity', '1', 'important');
        }

        function _claim(node) {
            var scope = getScope();
            if (!scope || !node || node.nodeType !== 1) return;
            if (node === scope || scope.contains(node)) return;
            if (_isJazzmin(node)) return;
            if (!_isOdooMount(node)) return;
            console.log('[PolySaaS Embed] Moving Odoo node to scope:', node.tagName, node.className || node.id || '');
            scope.appendChild(node);
            _ensureWebClientShell(scope);
            _mirrorOdooBodyClasses();
        }

        function _redirectToScope(parent, node, insertFn) {
            if (parent !== document.body || !node || !_isOdooMount(node) || _isJazzmin(node)) {
                return false;
            }
            var scope = getScope();
            if (!scope) return false;
            console.log('[PolySaaS Embed] Redirect mount to scope:', node.tagName, node.className || node.id || '');
            insertFn(scope, node);
            _ensureWebClientShell(scope);
            _mirrorOdooBodyClasses();
            return true;
        }

        var _origAppend = Element.prototype.appendChild;
        Element.prototype.appendChild = function (child) {
            if (_redirectToScope(this, child, function (scope, node) { _origAppend.call(scope, node); })) {
                return child;
            }
            return _origAppend.call(this, child);
        };

        var _origInsertBefore = Element.prototype.insertBefore;
        Element.prototype.insertBefore = function (newNode, ref) {
            if (_redirectToScope(this, newNode, function (scope, node) {
                _origInsertBefore.call(scope, node, scope.firstChild);
            })) {
                return newNode;
            }
            return _origInsertBefore.call(this, newNode, ref);
        };

        if (Element.prototype.prepend) {
            var _origPrepend = Element.prototype.prepend;
            Element.prototype.prepend = function () {
                var nodes = Array.prototype.slice.call(arguments);
                if (this === document.body && nodes.length) {
                    var scope = getScope();
                    if (scope) {
                        console.log('[PolySaaS Embed] Redirect body.prepend to scope');
                        _origPrepend.apply(scope, nodes);
                        _ensureWebClientShell(scope);
                        _mirrorOdooBodyClasses();
                        return;
                    }
                }
                return _origPrepend.apply(this, nodes);
            };
        }

        if (typeof MutationObserver !== 'undefined') {
            var _mo = new MutationObserver(function (mutations) {
                mutations.forEach(function (m) {
                    m.addedNodes.forEach(function (node) {
                        if (node.parentNode === document.body) { _claim(node); }
                    });
                });
            });
            if (document.body) _mo.observe(document.body, { childList: true });
        }

        function _claimLoose(node) {
            var scope = getScope();
            if (!scope || !node || node.nodeType !== 1) return;
            if (node === scope || scope.contains(node)) return;
            if (_isJazzmin(node)) return;
            console.log('[PolySaaS Embed] Harvest to scope:', node.tagName, node.className || node.id || '');
            scope.appendChild(node);
            _ensureWebClientShell(scope);
            _mirrorOdooBodyClasses();
        }

        function _harvestBodyChildren() {
            var scope = getScope();
            if (!scope) return;
            Array.prototype.slice.call(document.body.children).forEach(function (node) {
                if (node === scope || scope.contains(node)) return;
                if (_isJazzmin(node)) return;
                if (node.parentElement === document.body) { _claimLoose(node); }
            });
            _ensureWebClientShell(scope);
            _mirrorOdooBodyClasses();
        }

        function _boot() {
            _snapshotJazzmin();
            _harvestBodyChildren();
            if (typeof MutationObserver !== 'undefined') {
                var _bodyMo = new MutationObserver(function () {
                    _mirrorOdooBodyClasses();
                    _ensureWebClientShell(getScope());
                });
                _bodyMo.observe(document.body, { attributes: true, attributeFilter: ['class'] });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', _boot);
        } else {
            _boot();
        }
        [200, 500, 1000, 2000, 4000, 8000, 12000].forEach(function (ms) {
            setTimeout(_harvestBodyChildren, ms);
        });
    })();
    </script>
