    // ═══════════════════════════════════════════════════════════════════════
    // BELL NOTIFICATION SYSTEM - Enhanced with individual message handling
    // ═══════════════════════════════════════════════════════════════════════
    const sidebarBellBtn = document.getElementById('sidebarBellBtn');
    const sidebarUnreadDropdown = document.getElementById('sidebar-unread-dropdown');
    const markAllReadBtn = document.getElementById('mark-all-read-btn');

    if (sidebarBellBtn && sidebarUnreadDropdown) {
        // Helper to safely parse JSON responses
        function unreadJsonOrNull(response) {
            if (!response.ok) return Promise.resolve(null);
            var ct = response.headers.get('content-type') || '';
            if (ct.indexOf('application/json') === -1) return Promise.resolve(null);
            return response.json().catch(function () { return null; });
        }

        // Get CSRF token
        function getCSRFToken() {
            const cookie = document.cookie.split(';').find(c => c.trim().startsWith('csrftoken='));
            return cookie ? cookie.split('=')[1] : '';
        }

        // Format relative time
        function formatRelativeTime(dateStr) {
            const date = new Date(dateStr);
            const now = new Date();
            const diffMs = now - date;
            const diffMins = Math.floor(diffMs / 60000);
            const diffHours = Math.floor(diffMs / 3600000);
            const diffDays = Math.floor(diffMs / 86400000);

            if (diffMins < 1) return 'Just now';
            if (diffMins < 60) return `${diffMins}m ago`;
            if (diffHours < 24) return `${diffHours}h ago`;
            if (diffDays < 7) return `${diffDays}d ago`;
            return date.toLocaleDateString();
        }

        // Get level color
        function getLevelColor(level) {
            const colors = {
                'success': '#22c55e',
                'info': '#3b82f6',
                'warning': '#f59e0b',
                'error': '#ef4444',
                'debug': '#6b7280'
            };
            return colors[level] || '#6b7280';
        }

        // Get level icon
        function getLevelIcon(level) {
            const icons = {
                'success': '✓',
                'info': 'ℹ',
                'warning': '⚠',
                'error': '✕',
                'debug': '🔧'
            };
            return icons[level] || '📝';
        }

        // Update unread count and populate dropdown
        function updateSidebarUnreadCount() {
            fetch('/dose/api/unread-dosemessages/')
                .then(unreadJsonOrNull)
                .then(data => {
                    if (!data) return;
                    
                    const count = data.count || 0;
                    const countSpan = document.getElementById('sidebar-unread-count');
                    if (countSpan) {
                        countSpan.textContent = count > 99 ? '99+' : count;
                        countSpan.style.display = count > 0 ? 'inline-block' : 'none';
                        countSpan.style.background = count > 0 ? '#ef4444' : '#9ca3af';
                    }

                    const messagesList = document.getElementById('sidebar-unread-messages-list');
                    if (messagesList) {
                        messagesList.innerHTML = '';
                        
                        if (data.messages && data.messages.length > 0) {
                            // Show most recent 20 messages
                            const recentMessages = data.messages.slice(0, 20);
                            
                            recentMessages.forEach(function(msg) {
                                const item = document.createElement('div');
                                item.style.cssText = 'padding: 10px 12px; border-bottom: 1px solid #f1f5f9; cursor: pointer; transition: background 0.15s; position: relative;';
                                item.setAttribute('data-message-id', msg.id);
                                
                                item.innerHTML = `
                                    <div style="display: flex; align-items: flex-start; gap: 8px;">
                                        <span style="flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%; background: ${getLevelColor(msg.level)}; color: white; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold;">${getLevelIcon(msg.level)}</span>
                                        <div style="flex: 1; min-width: 0;">
                                            <div style="font-size: 11px; font-weight: 600; color: ${getLevelColor(msg.level)}; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">${msg.level}</div>
                                            <div style="font-size: 12px; color: #334155; line-height: 1.4; word-wrap: break-word;">${msg.message}</div>
                                            <div style="font-size: 10px; color: #94a3b8; margin-top: 4px;">${formatRelativeTime(msg.created_at)}</div>
                                        </div>
                                    </div>
                                `;
                                
                                // Hover effect
                                item.addEventListener('mouseenter', function() {
                                    this.style.background = '#f8fafc';
                                });
                                item.addEventListener('mouseleave', function() {
                                    this.style.background = '';
                                });
                                
                                // Click to view and mark as read
                                item.addEventListener('click', function() {
                                    const messageId = this.getAttribute('data-message-id');
                                    markMessageAsRead(messageId, this);
                                });
                                
                                messagesList.appendChild(item);
                            });
                            
                            if (data.messages.length > 20) {
                                const moreItem = document.createElement('div');
                                moreItem.style.cssText = 'padding: 10px; text-align: center; color: #64748b; font-size: 12px; border-top: 1px solid #e2e8f0;';
                                moreItem.textContent = `+ ${data.messages.length - 20} more messages`;
                                messagesList.appendChild(moreItem);
                            }
                        } else {
                            messagesList.innerHTML = `
                                <div style="padding: 30px 15px; text-align: center;">
                                    <div style="font-size: 32px; margin-bottom: 8px;">🎉</div>
                                    <div style="color: #64748b; font-size: 13px;">All caught up!</div>
                                    <div style="color: #94a3b8; font-size: 11px; margin-top: 4px;">No unread messages</div>
                                </div>
                            `;
                        }
                    }
                })
                .catch(function(err) {
                    console.log('[Bell Notifications] Error fetching messages:', err);
                });
        }

        // Mark a single message as read
        function markMessageAsRead(messageId, element) {
            if (!messageId) return;
            
            fetch('/dose/api/unread-dosemessages/', {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': getCSRFToken()
                },
                body: JSON.stringify({ message_id: messageId })
            })
            .then(unreadJsonOrNull)
            .then(data => {
                if (data && data.success) {
                    // Animate the item being removed
                    if (element) {
                        element.style.opacity = '0';
                        element.style.transform = 'translateX(20px)';
                        element.style.transition = 'all 0.3s ease';
                        
                        setTimeout(() => {
                            element.remove();
                            // Update count
                            updateCountOnly();
                        }, 300);
                    } else {
                        updateCountOnly();
                    }
                }
            })
            .catch(function(err) {
                console.log('[Bell Notifications] Error marking message as read:', err);
            });
        }

        // Mark all messages as read
        function markAllAsRead() {
            fetch('/dose/api/unread-dosemessages/', {
                method: 'POST',
                headers: {
                    'X-CSRFToken': getCSRFToken()
                }
            })
            .then(unreadJsonOrNull)
            .then(() => {
                // Clear the list and update count
                const messagesList = document.getElementById('sidebar-unread-messages-list');
                if (messagesList) {
                    messagesList.innerHTML = `
                        <div style="padding: 30px 15px; text-align: center;">
                            <div style="font-size: 32px; margin-bottom: 8px;">🎉</div>
                            <div style="color: #64748b; font-size: 13px;">All caught up!</div>
                            <div style="color: #94a3b8; font-size: 11px; margin-top: 4px;">No unread messages</div>
                        </div>
                    `;
                }
                updateCountOnly();
            })
            .catch(function(err) {
                console.log('[Bell Notifications] Error marking all as read:', err);
            });
        }

        // Update only the count
        function updateCountOnly() {
            fetch('/dose/api/unread-dosemessages/')
                .then(unreadJsonOrNull)
                .then(data => {
                    if (!data) return;
                    const count = data.count || 0;
                    const countSpan = document.getElementById('sidebar-unread-count');
                    if (countSpan) {
                        countSpan.textContent = count > 99 ? '99+' : count;
                        countSpan.style.display = count > 0 ? 'inline-block' : 'none';
                        countSpan.style.background = count > 0 ? '#ef4444' : '#9ca3af';
                    }
                })
                .catch(function () {});
        }

        // Initial load
        updateSidebarUnreadCount();
        
        // Refresh every 30 seconds
        setInterval(updateSidebarUnreadCount, 30000);

        // Bell click toggles dropdown
        sidebarBellBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            const isVisible = sidebarUnreadDropdown.style.display === 'block';
            
            if (!isVisible) {
                sidebarUnreadDropdown.style.display = 'block';
                // Refresh the list when opening
                updateSidebarUnreadCount();
            } else {
                sidebarUnreadDropdown.style.display = 'none';
            }
        });

        // Mark all read button
        if (markAllReadBtn) {
            markAllReadBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                markAllAsRead();
            });
            
            markAllReadBtn.addEventListener('mouseenter', function() {
                this.style.background = '#dbeafe';
            });
            markAllReadBtn.addEventListener('mouseleave', function() {
                this.style.background = '';
            });
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!sidebarBellBtn.contains(e.target) && !sidebarUnreadDropdown.contains(e.target)) {
                sidebarUnreadDropdown.style.display = 'none';
            }
        });

        // Close on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && sidebarUnreadDropdown.style.display === 'block') {
                sidebarUnreadDropdown.style.display = 'none';
            }
        });
    }
});

// Passthrough sidebar links use normal full navigation (same as CRUD changelist links) so Django
// admin base_site, messages, and session all refresh in one request — do not intercept with fetch.

function toggleDoseSidebar() {
    const navContainer = document.getElementById('dose-custom-sidebar');
    const navToggle = document.getElementById('dose-nav-toggle');
    const grid = document.querySelector('.admin-content-grid');

    navContainer.classList.toggle('collapsed');
    if (grid) {
        grid.classList.toggle('sidebar-collapse');
    }

    const isCollapsed = navContainer.classList.contains('collapsed');
    document.body.classList.toggle('polysaas-collapsed', isCollapsed);
    localStorage.setItem('pss_sidebar_collapsed', isCollapsed ? '1' : '0');

    // Drive blue header background + tooltip via JS (overrides any CSS conflicts)
    const header = document.getElementById('dose-nav-header');
    if (header) {
        header.title = isCollapsed ? 'Expand sidebar' : 'Collapse sidebar';
        header.style.background = isCollapsed ? '#2563eb' : '';
        header.style.borderBottom = isCollapsed ? '2px solid #1d4ed8' : '';
        header.style.justifyContent = isCollapsed ? 'center' : '';
    }
    // No rotation — fa-bars rotated 90° looks like ||| not ☰
    navToggle.style.transform = '';
    // Make icon clearly visible in both states
    navToggle.style.display = 'inline-flex';
    navToggle.style.alignItems = 'center';
    navToggle.style.justifyContent = 'center';
    navToggle.style.fontSize = '1.3rem';
    navToggle.style.color = '#fff';
    if (isCollapsed) {
        navToggle.style.width = '40px';
        navToggle.style.height = '40px';
        navToggle.style.background = 'rgba(255,255,255,0.2)';
        navToggle.style.borderRadius = '8px';
    } else {
        navToggle.style.width = '';
        navToggle.style.height = '';
        navToggle.style.background = '';
        navToggle.style.borderRadius = '';
    }
}
</script>
