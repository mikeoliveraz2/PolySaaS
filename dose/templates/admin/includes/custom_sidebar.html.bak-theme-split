{# AUTHORITATIVE ADMIN SIDEBAR — dose/templates/admin/includes/custom_sidebar.html — DO NOT MODIFY WITHOUT APPROVAL #}
{% load i18n static custom_menu_tags %}
<!-- Custom PolySaaS Sidebar - Below Menu Bar with Grid Layout -->
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<style>
    /* Header height — tuned to the live Jazzmin navbar so the grid clears the fixed header. */
    :root {
        --pss-header-h: 64px;
        --pss-sidebar-shell-bg: #1e293b;
        --pss-sidebar-shell-shadow: 2px 0 12px rgba(15, 23, 42, 0.12);
        --pss-sidebar-header-bg: #34495e;
        --pss-sidebar-header-hover-bg: #1e293b;
        --pss-sidebar-header-text: #ffffff;
        --pss-sidebar-header-border: #2c3e50;
        --pss-sidebar-surface: #f8fafc;
        --pss-sidebar-scroll-track: #f1f1f1;
        --pss-sidebar-scroll-thumb: #888;
        --pss-sidebar-scroll-thumb-hover: #555;
        --pss-sidebar-item-text: #334155;
        --pss-sidebar-item-hover-bg: rgba(37, 99, 235, 0.08);
        --pss-sidebar-item-active-bg: rgba(37, 99, 235, 0.18);
        --pss-sidebar-item-active-text: #1e3a8a;
        --pss-sidebar-item-active-shadow: inset 3px 0 0 #2563eb;
        --pss-sidebar-icon: #64748b;
        --pss-sidebar-icon-hover: #2563eb;
        --pss-sidebar-icon-active: #2563eb;
        --pss-sidebar-panel-bg: #f1f5f9;
        --pss-sidebar-panel-text: #64748b;
        --pss-sidebar-panel-border: #e2e8f0;
        --pss-sidebar-passthrough-bg: #eff6ff;
        --pss-sidebar-passthrough-text: #1e40af;
        --pss-sidebar-passthrough-border: #3b82f6;
    }

    html[data-ps-theme="darkly"],
    html[data-ps-theme="cyborg"],
    html[data-ps-theme="slate"],
    html[data-ps-theme="solar"],
    html[data-ps-theme="superhero"] {
        --pss-sidebar-shell-bg: #20252b;
        --pss-sidebar-shell-shadow: 2px 0 16px rgba(0, 0, 0, 0.3);
        --pss-sidebar-header-bg: #2f353c;
        --pss-sidebar-header-hover-bg: #252a31;
        --pss-sidebar-header-text: #f5f7fa;
        --pss-sidebar-header-border: #454d55;
        --pss-sidebar-surface: #2b2b2b;
        --pss-sidebar-scroll-track: #252525;
        --pss-sidebar-scroll-thumb: #626b75;
        --pss-sidebar-scroll-thumb-hover: #7a848f;
        --pss-sidebar-item-text: #d9e2ec;
        --pss-sidebar-item-hover-bg: rgba(41, 128, 185, 0.2);
        --pss-sidebar-item-active-bg: rgba(77, 182, 255, 0.22);
        --pss-sidebar-item-active-text: #f5fbff;
        --pss-sidebar-item-active-shadow: inset 3px 0 0 #4db6ff;
        --pss-sidebar-icon: #a7b3c2;
        --pss-sidebar-icon-hover: #4db6ff;
        --pss-sidebar-icon-active: #8ecbff;
        --pss-sidebar-panel-bg: #3a3a3a;
        --pss-sidebar-panel-text: #d0d7de;
        --pss-sidebar-panel-border: #4b525a;
        --pss-sidebar-passthrough-bg: #16324f;
        --pss-sidebar-passthrough-text: #8ecbff;
        --pss-sidebar-passthrough-border: #2196f3;
    }

    /* Main content grid - sidebar + main content + right sidebar (Recent Actions) */
    .admin-content-grid {
        display: grid;
        grid-template-columns: 280px 1fr 320px;
        gap: 0;
        margin-top: var(--pss-header-h);
        transition: grid-template-columns 0.3s ease;
    }

    .admin-content-grid.sidebar-collapse {
        grid-template-columns: 60px 1fr 320px;
    }

    /* Use only our own class — do not rely on AdminLTE body classes */
    body.polysaas-collapsed .admin-content-grid {
        grid-template-columns: 60px 1fr 320px;
    }

    /* Content column must allow shrinking for 1fr to respond */
    .admin-content-grid > .dose-content-col,
    .admin-content-grid > div:nth-child(2) {
        min-width: 0;
        /* Do not clip vertically — overflow:hidden hid Jazzmin index cards on some viewports */
        overflow-x: hidden;
        overflow-y: visible;
    }

    /* Jazzmin 3 / BS5 often use col-md-* / row — do not force col-lg-* to 100% (breaks index layout) */

    /* Make container-fluid truly full width */
    .dose-content-col .container-fluid {
        max-width: 100% !important;
        padding-left: 8px !important;
        padding-right: 8px !important;
    }

    .dose-content-col .row {
        margin: 0 !important;
    }

    /* col-md-6 is Jazzmin's two-column card split — let Bootstrap handle it at >=900px.
       At <900px we override it back to full width (see @media block below). */

    /* Sidebar Container - positioned in grid, not fixed */
    .collapsible-nav {
        background: var(--pss-sidebar-shell-bg);
        border-radius: 0;
        overflow: hidden;
        box-shadow: var(--pss-sidebar-shell-shadow);
        height: calc(100vh - var(--pss-header-h));
        position: sticky;
        top: var(--pss-header-h); /* stick just below the fixed header */
        transition: width 0.3s ease;
        display: flex;
        flex-direction: column;
        width: 280px;
    }

    .collapsible-nav.collapsed {
        width: 60px;
    }

    .nav-header {
        background: var(--pss-sidebar-header-bg);
        color: var(--pss-sidebar-header-text);
        padding: 12px 15px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        border-bottom: 1px solid var(--pss-sidebar-header-border);
        white-space: nowrap;
        overflow: hidden;
    }

    .collapsible-nav.collapsed .nav-header {
        justify-content: center;
        padding: 8px 5px;
        background: #2563eb !important;   /* bright blue — unmistakably a button */
        border-bottom: 2px solid #1d4ed8;
        min-height: 48px;
    }

    .collapsible-nav.collapsed .nav-header > span:first-child {
        display: none;
    }

    /* Make the fa-bars icon look like a proper restore button when collapsed */
    .collapsible-nav.collapsed .nav-toggle {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: rgba(255,255,255,0.2);
        border-radius: 8px;
        font-size: 1.3rem !important;
        transition: background 0.2s ease;
        cursor: pointer;
    }

    .collapsible-nav.collapsed .nav-toggle i {
        font-size: 1.2rem;
        color: #fff;
    }

    .collapsible-nav.collapsed .nav-header:hover .nav-toggle {
        background: rgba(255,255,255,0.35);
    }

    .nav-header:hover {
        background: var(--pss-sidebar-header-hover-bg);
    }

    .nav-toggle {
        font-size: 1.3rem;
        transition: all 0.3s ease;
        font-weight: normal;
    }

    /* applyFont() in base_site.html sets el.style.fontFamily on every element,
       overriding FA's glyph font and making icons vanish.
       These !important rules beat the JS inline-style (no !important) and restore rendering. */
    .nav-toggle i,
    .nav-toggle i.fas,
    .nav-toggle i.far,
    .nav-toggle i.fab {
        font-family: "Font Awesome 5 Free" !important;
        font-weight: 900 !important;
        font-size: inherit !important;
        display: inline-block !important;
        color: #fff !important;
    }

    .nav-items {
        max-height: 85vh;
        overflow-y: auto;
        overflow-x: hidden;
        background: var(--pss-sidebar-surface);
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        min-height: 0;
        transition: max-height 0.3s ease, flex-grow 0.3s ease;
    }

    .collapsible-nav.collapsed .nav-items {
        max-height: none;
        overflow: visible;
        flex-grow: 0;
        height: auto;
        align-items: center;
    }

    /* Custom scrollbar for navigation */
    .nav-items::-webkit-scrollbar {
        width: 6px;
    }

    .nav-items::-webkit-scrollbar-track {
        background: var(--pss-sidebar-scroll-track);
    }

    .nav-items::-webkit-scrollbar-thumb {
        background: var(--pss-sidebar-scroll-thumb);
        border-radius: 3px;
    }

    .nav-items::-webkit-scrollbar-thumb:hover {
        background: var(--pss-sidebar-scroll-thumb-hover);
    }

    /* Admin-style compact nav items */
    .nav-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 15px;
        margin: 2px 8px;
        color: var(--pss-sidebar-item-text);
        text-decoration: none;
        border: none;
        border-radius: 6px;
        background: transparent;
        transition: background 0.15s ease, padding-left 0.15s ease;
        font-size: 0.9rem;
        white-space: nowrap;
    }

    /* Collapsed mode - show only icons centered */
    .collapsible-nav.collapsed .nav-item,
    #dose-custom-sidebar.collapsed .nav-item {
        justify-content: center;
        padding: 10px;
        gap: 0;
        min-height: 40px;
        border: none;
        width: auto;
    }

    .collapsible-nav.collapsed .nav-panel,
    #dose-custom-sidebar.collapsed .nav-panel {
        border: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .collapsible-nav.collapsed .nav-panel-items,
    #dose-custom-sidebar.collapsed .nav-panel-items {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    .collapsible-nav.collapsed .nav-text,
    #dose-custom-sidebar.collapsed .nav-text {
        display: none !important;
        visibility: hidden !important;
        width: 0 !important;
        height: 0 !important;
        overflow: hidden !important;
        font-size: 0 !important;
    }

    .collapsible-nav.collapsed .nav-panel-title,
    #dose-custom-sidebar.collapsed .nav-panel-title,
    #dose-custom-sidebar.collapsed h4.nav-panel-title {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        font-size: 0 !important;
    }

    .collapsible-nav.collapsed .nav-icon,
    #dose-custom-sidebar.collapsed .nav-icon {
        font-size: 1.3rem;
        min-width: auto;
        margin: 0;
        display: inline-flex !important;
        flex-shrink: 0;
    }

    .collapsible-nav.collapsed .custom-icon,
    #dose-custom-sidebar.collapsed .custom-icon {
        width: 24px;
        height: 24px;
    }

    /* Force hide all text content in collapsed sidebar */
    #dose-custom-sidebar.collapsed .nav-item * {
        font-size: inherit;
    }

    #dose-custom-sidebar.collapsed .nav-text,
    #dose-custom-sidebar.collapsed .nav-text * {
        font-size: 0 !important;
        line-height: 0 !important;
        opacity: 0 !important;
    }

    .nav-item:hover {
        background: var(--pss-sidebar-item-hover-bg) !important;
        padding-left: 15px;
    }

    #dose-custom-sidebar .nav-item.is-active,
    #dose-custom-sidebar .nav-item[aria-current="page"] {
        background: var(--pss-sidebar-item-active-bg) !important;
        color: var(--pss-sidebar-item-active-text) !important;
        box-shadow: var(--pss-sidebar-item-active-shadow) !important;
        border-left: 3px solid var(--pss-sidebar-icon-active);
        font-weight: 600 !important;
        padding-left: 12px;
    }

    #dose-custom-sidebar .nav-item.is-active:hover,
    #dose-custom-sidebar .nav-item[aria-current="page"]:hover {
        background: var(--pss-sidebar-item-active-bg) !important;
        color: var(--pss-sidebar-item-active-text) !important;
        padding-left: 12px;
    }

    #dose-custom-sidebar .nav-item.is-active .nav-icon,
    #dose-custom-sidebar .nav-item[aria-current="page"] .nav-icon {
        color: var(--pss-sidebar-icon-active) !important;
    }

    #dose-custom-sidebar .nav-item.is-active .nav-text,
    #dose-custom-sidebar .nav-item[aria-current="page"] .nav-text {
        color: inherit;
    }

    .collapsible-nav.collapsed .nav-item:hover {
        padding-left: 10px;
    }

    .collapsible-nav.collapsed .nav-item.is-active,
    #dose-custom-sidebar.collapsed .nav-item.is-active,
    .collapsible-nav.collapsed .nav-item[aria-current="page"],
    #dose-custom-sidebar.collapsed .nav-item[aria-current="page"] {
        box-shadow: inset 0 0 0 2px var(--pss-sidebar-passthrough-border);
        border-left: none;
        padding-left: 10px;
    }

    .nav-icon {
        width: 1.75rem;
        height: 1.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        color: var(--pss-sidebar-icon);
        border-radius: 6px;
        font-size: 0.85rem;
        flex-shrink: 0;
        overflow: hidden;
    }

    /* Material Icons ligature support */
    .nav-icon.material-icon {
        font-family: 'Material Icons';
        font-size: 1.2rem;
        font-style: normal;
        line-height: 1;
        overflow: visible;
    }

    .nav-item:hover .nav-icon {
        color: var(--pss-sidebar-icon-hover);
    }

    /* Ensure icons from FontAwesome/Bootstrap work */
    .nav-icon i {
        font-size: inherit;
    }

    /* Custom image icons */
    .custom-icon {
        width: 20px;
        height: 20px;
        object-fit: contain;
    }

    .nav-text {
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .nav-panel-title {
        background: var(--pss-sidebar-panel-bg);
        padding: 8px 15px;
        margin: 0;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--pss-sidebar-panel-text);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-top: 1px solid var(--pss-sidebar-panel-border);
        white-space: nowrap;
        overflow: hidden;
    }

    /* Passthrough panel — subtle accent, not loud green */
    .nav-panel[data-panel-type="passthrough_services"] .nav-panel-title {
        background: var(--pss-sidebar-passthrough-bg);
        color: var(--pss-sidebar-passthrough-text);
        border-left: 3px solid var(--pss-sidebar-passthrough-border);
        padding-left: 12px;
    }

    /* ── Passthrough logo card grid ── */
    .pss-pt-cards {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        padding: 10px 8px 12px;
    }
    .pss-pt-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 10px 6px 8px;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        transition: background 0.2s, transform 0.2s;
    }
    .pss-pt-card:hover {
        background: rgba(255,255,255,0.12);
        transform: translateY(-2px);
        text-decoration: none;
        color: inherit;
    }
    .pss-pt-card.is-active {
        background: rgba(77,182,255,0.15);
        border-color: rgba(77,182,255,0.35);
    }
    .pss-pt-logo {
        width: 75px;
        height: 75px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 7px;
        overflow: hidden;
        box-shadow: 0 3px 8px rgba(0,0,0,0.2);
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
    }
    .pss-pt-logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
        padding: 6px;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
    }
    .pss-pt-logo--odoo { background: linear-gradient(135deg, #9c5acc 0%, #714b67 100%); }
    .pss-pt-logo--mattermost { background: linear-gradient(135deg, #1668ca 0%, #0058cc 100%); }
    .pss-pt-logo--nextcloud { background: linear-gradient(135deg, #0082c9 0%, #006aa8 100%); }
    .pss-pt-logo--dolibarr { background: linear-gradient(135deg, #f47b20 0%, #d66a18 100%); }
    .pss-pt-logo--wordpress { background: linear-gradient(135deg, #21759b 0%, #1a5c7a 100%); }
    .pss-pt-label {
        font-size: 12px;
        font-weight: 600;
        text-align: center;
        line-height: 1.3;
        color: var(--pss-sidebar-item-text);
    }

    .collapsible-nav.collapsed .nav-panel-title {
        font-size: 0;
        padding: 4px 0;
        min-height: 2px;
    }

    .nav-panel-items {
        /* No padding - items handle their own spacing */
    }

    .nav-panel:first-child .nav-panel-title {
        border-top: none;
    }

    .nav-panel-description {
        display: none;
    }

    .collapsible-nav.collapsed .nav-panel-description {
        display: none;
    }

    /* Content wrapper - no left margin, handled by grid */
    .content-wrapper,
    .main-footer,
    .app-footer {
        margin-left: 0 !important;
        transition: none;
    }

    /* Menu bar spans full width above grid */
    .main-header,
    .app-header {
        margin-left: 0 !important;
        width: 100% !important;
    }

    /* Legacy AdminLTE2 sidebar (unused under Jazzmin 3) */
    .main-sidebar {
        display: none !important;
    }

    /* Wrapper for grid container */
    .admin-main-wrapper {
        min-height: calc(100vh - var(--pss-header-h));
    }

    /* Ensure grid and sidebar are visible */
    .admin-content-grid {
        display: grid !important;
        visibility: visible !important;
    }

    #dose-custom-sidebar {
        display: flex !important;
        visibility: visible !important;
    }

    /* Right activity sidebar */
    #recent-actions-sidebar {
        background: var(--bs-body-bg, #fff);
        border-left: 1px solid rgba(0,0,0,.08);
        padding: 16px 14px;
        height: calc(100vh - var(--pss-header-h));
        position: sticky;
        top: var(--pss-header-h);
        overflow-y: auto;
        font-size: .85rem;
    }

    #recent-actions-sidebar h2,
    #recent-actions-sidebar .module h2 {
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        font-weight: 700;
        padding: 0 0 8px;
        margin-bottom: 10px;
        border-bottom: 1px solid rgba(0,0,0,.1);
    }

    /* Responsive: single column on narrow screens */
    @media (max-width: 899px) {
        .admin-content-grid {
            grid-template-columns: 1fr !important;
        }
        .admin-content-grid.sidebar-collapse {
            grid-template-columns: 1fr !important;
        }
        .collapsible-nav {
            display: none !important;
        }
        #recent-actions-sidebar {
            display: none !important;
        }
        /* At narrow widths collapse Jazzmin's 2-col cards to single column */
        .dose-content-col .col-md-6 {
            width: 100% !important;
            max-width: 100% !important;
            flex: 0 0 100% !important;
        }
    }
</style>

<!-- Grid Container Wrapper -->
<div class="admin-content-grid">
    <!-- Sidebar Column -->
    <div class="collapsible-nav" id="dose-custom-sidebar" style="">
    <div class="nav-header" onclick="toggleDoseSidebar()" id="dose-nav-header" title="Collapse sidebar">
        <span>Navigation Bar</span>
        <span class="nav-toggle" id="dose-nav-toggle"><i class="fas fa-bars"></i></span>
    </div>
    <div class="nav-items" id="dose-nav-items">
        <!-- DEBUG: Log context data for admin sidebar -->
        <script>
        console.log('=== ADMIN SIDEBAR CONTEXT DATA ===');
        console.log('passthrough_services count:', {{ passthrough_services|length }});
        console.log('external_services count:', {{ external_services|length }});
        {% if external_services %}
        console.log('external_services EXISTS - rendering panel');
        {% for service in external_services %}
        console.log('  - {{ service.title|escapejs }} ({{ service.url|escapejs }})');
        {% endfor %}
        {% else %}
        console.log('external_services is EMPTY or FALSE');
        {% endif %}
        console.log('navigation_panels count:', {{ navigation_panels|length }});
        {% for panel in navigation_panels %}
            console.log('  Panel "{{ panel.title|escapejs }}": {{ panel.filtered_items|length }} items');
        {% endfor %}
        console.log('top_navigation_items count:', {{ top_navigation_items|length }});
        console.log('===============================');
        </script>

        {# HOME — Dashboard + PolySaaS AI, always shown, no conditions. #}
        <div class="nav-panel" data-panel-type="admin_home">
            <h4 class="nav-panel-title">HOME</h4>
            <div class="nav-panel-items">
                <a href="/admin/" class="nav-item" title="Jazzmin model dashboard">
                    <span class="nav-icon"><i class="fas fa-tachometer-alt" aria-hidden="true"></i></span>
                    <span class="nav-text">Dashboard</span>
                </a>
                <a href="/admin/polysaas-ai/" class="nav-item" title="PolySaaS AI chat (full page)">
                    <span class="nav-icon"><i class="fas fa-comments" aria-hidden="true"></i></span>
                    <span class="nav-text">PolySaaS AI</span>
                </a>
            </div>
        </div>

        <!-- Passthrough Services — logo card grid -->
        {% if passthrough_services %}
            <div class="nav-panel" data-panel-type="passthrough_services">
                <h4 class="nav-panel-title">PASSTHROUGH SERVICES</h4>
                <div class="pss-pt-cards">
                    {% for service in passthrough_services %}
                        {% with slug=service.title|lower %}
                        <a href="{{ service.url }}"
                           class="pss-pt-card{% if request.path_info|path_starts_with:service.url %} is-active{% endif %}"
                           {% if request.path_info|path_starts_with:service.url %}aria-current="page"{% endif %}
                           title="{{ service.description|default:service.title }}">
                            <div class="pss-pt-logo pss-pt-logo--{{ slug }}">
                                {% if 'odoo' in slug %}
                                    <img src="{% static 'img/apps/odoo-logo.svg' %}" alt="Odoo">
                                {% elif 'mattermost' in slug %}
                                    <img src="{% static 'img/apps/mattermost-logo.svg' %}" alt="Mattermost">
                                {% elif 'nextcloud' in slug %}
                                    <img src="{% static 'img/apps/nextcloud-logo.svg' %}" alt="Nextcloud">
                                {% elif 'dolibarr' in slug %}
                                    <img src="{% static 'img/apps/dolibarr-logo.svg' %}" alt="Dolibarr">
                                {% elif 'wordpress' in slug %}
                                    <img src="{% static 'img/apps/wordpress-logo.svg' %}" alt="WordPress">
                                {% else %}
                                    {{ service.title|first|upper }}
                                {% endif %}
                            </div>
                            <span class="pss-pt-label">{{ service.title }}</span>
                        </a>
                        {% endwith %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <!-- External Services (Other integrations) -->
        {% if external_services %}
            <div class="nav-panel" data-panel-type="external_services">
                <h4 class="nav-panel-title">EXTERNAL SERVICES</h4>
                <div class="nav-panel-items">
                    {% for service in external_services %}
                        <a href="{{ service.url }}"
