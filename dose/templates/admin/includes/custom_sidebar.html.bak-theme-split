<script>
function normalizeSidebarPath(value) {
    if (!value) {
        return '';
    }

    try {
        const parsedUrl = new URL(value, window.location.origin);
        let normalizedPath = parsedUrl.pathname || '';
        normalizedPath = normalizedPath.replace(/\/+$/, '');
        return normalizedPath || '/';
    } catch (error) {
        return '';
    }
}

function applyActiveSidebarLink() {
    const currentPath = normalizeSidebarPath(window.location.pathname);
    const sidebarLinks = Array.from(document.querySelectorAll('#dose-custom-sidebar a.nav-item[href]'));
    let bestMatch = null;
    let bestScore = -1;

    sidebarLinks.forEach(function(link) {
        const href = link.getAttribute('href');
        if (!href || href.startsWith('#')) {
            return;
        }

        const targetUrl = new URL(href, window.location.origin);
        if (targetUrl.origin !== window.location.origin) {
            return;
        }

        const linkPath = normalizeSidebarPath(targetUrl.pathname);
        if (!linkPath) {
            return;
        }

        const exactOnly = link.getAttribute('data-sidebar-exact') === '1';
        const isExactMatch = currentPath === linkPath;
        const isSubpathMatch =
            !exactOnly && linkPath !== '/' && currentPath.startsWith(linkPath + '/');

        if (exactOnly) {
            if (!isExactMatch) {
                return;
            }
        } else if (!isExactMatch && !isSubpathMatch) {
            return;
        }

        const matchScore = linkPath.length;
        if (matchScore > bestScore) {
            bestMatch = link;
            bestScore = matchScore;
        }
    });

    if (bestMatch) {
        sidebarLinks.forEach(function(link) {
            link.classList.remove('is-active');
            link.removeAttribute('aria-current');
        });
        bestMatch.classList.add('is-active');
        bestMatch.setAttribute('aria-current', 'page');
    }
}

window.addEventListener('pageshow', function() {
    applyActiveSidebarLink();
});

// Move content-wrapper into grid on page load
document.addEventListener('DOMContentLoaded', function() {
    console.log('[ADMIN SIDEBAR] DOMContentLoaded - setting up grid');
    const grid = document.querySelector('.admin-content-grid');
    const contentWrapper = document.querySelector('.dose-content-col');
    const mainFooter = document.querySelector('.app-footer, .main-footer');

    console.log('[ADMIN SIDEBAR] Grid found:', !!grid);
    console.log('[ADMIN SIDEBAR] Content wrapper found:', !!contentWrapper);
    console.log('[ADMIN SIDEBAR] Footer found:', !!mainFooter);

    if (!grid) {
        console.error('[ADMIN SIDEBAR] ERROR: admin-content-grid not found!');
        return;
    }

    if (!contentWrapper) {
        console.error('[ADMIN SIDEBAR] ERROR: content-wrapper not found!');
        // Try to find it with a delay (in case it's created later)
        setTimeout(function() {
            const delayedWrapper = document.querySelector('.dose-content-col');
            if (delayedWrapper && grid) {
                console.log('[ADMIN SIDEBAR] Found content-wrapper on retry, moving into grid');
                grid.appendChild(delayedWrapper);
            } else {
                console.error('[ADMIN SIDEBAR] Content-wrapper still not found after retry');
            }
        }, 100);
        return;
    }

    applyActiveSidebarLink();
    window.setTimeout(applyActiveSidebarLink, 150);

    // Ensure grid is visible
    if (grid) {
        grid.style.display = 'grid';
        grid.style.visibility = 'visible';
        console.log('[ADMIN SIDEBAR] Grid display set to grid, visibility set to visible');
    }

    // Move content-wrapper into grid as second column
    if (grid && contentWrapper) {
        // Check if already in grid
        if (contentWrapper.parentNode === grid) {
            console.log('[ADMIN SIDEBAR] Content-wrapper already in grid');
        } else {
            console.log('[ADMIN SIDEBAR] Moving content-wrapper into grid');
            grid.appendChild(contentWrapper);
        }
    }

    // Create right sidebar column for Recent Actions
    let rightSidebar = document.getElementById('recent-actions-sidebar');
    if (!rightSidebar) {
        rightSidebar = document.createElement('div');
        rightSidebar.id = 'recent-actions-sidebar';
        rightSidebar.style.position = 'sticky';
        rightSidebar.style.top = 'var(--pss-header-h, 57px)';
        rightSidebar.style.height = 'fit-content';
        rightSidebar.style.padding = '0 15px';
        
        // Jazzmin index does NOT emit #recent-actions-module (Django classic only). Heuristic moves
        // (.module / .card) matched wrong nodes on Render and emptied the center column — only
        // reparent when the stock admin id exists.
        const recentActions = document.querySelector('#recent-actions-module');
        if (recentActions) {
            console.log('[ADMIN SIDEBAR] Found #recent-actions-module, moving to right sidebar');
            rightSidebar.appendChild(recentActions);
        } else {
            console.log('[ADMIN SIDEBAR] No #recent-actions-module (Jazzmin index); skip Recent Actions reparent');
        }
        
        // Add to grid as third column
        if (grid) {
            grid.appendChild(rightSidebar);
            console.log('[ADMIN SIDEBAR] Right sidebar added to grid');
        }
    }

    // Move footer after grid if it exists
    if (mainFooter && grid && grid.parentNode) {
        // Only move if not already after grid
        if (mainFooter.previousSibling !== grid && mainFooter.parentNode !== grid.parentNode) {
            console.log('[ADMIN SIDEBAR] Moving footer after grid');
            grid.parentNode.insertBefore(mainFooter, grid.nextSibling);
        }
    }

    // Ensure sidebar is visible
    const sidebar = document.getElementById('dose-custom-sidebar');
    if (sidebar) {
        sidebar.style.display = 'flex';
        sidebar.style.visibility = 'visible';
        console.log('[ADMIN SIDEBAR] Sidebar display set to flex, visibility set to visible');

        // Restore collapsed state from localStorage
        if (localStorage.getItem('pss_sidebar_collapsed') === '1') {
            sidebar.classList.add('collapsed');
            document.body.classList.add('polysaas-collapsed');
            if (grid) grid.classList.add('sidebar-collapse');
            // Apply blue + icon styles inline (same as toggleDoseSidebar collapsed path)
            const header = document.getElementById('dose-nav-header');
            if (header) {
                header.title = 'Expand sidebar';
                header.style.background = '#2563eb';
                header.style.borderBottom = '2px solid #1d4ed8';
                header.style.justifyContent = 'center';
            }
            const toggle = document.getElementById('dose-nav-toggle');
            if (toggle) {
                toggle.style.transform = '';
                toggle.style.display = 'inline-flex';
                toggle.style.alignItems = 'center';
                toggle.style.justifyContent = 'center';
                toggle.style.width = '40px';
                toggle.style.height = '40px';
                toggle.style.fontSize = '1.3rem';
                toggle.style.color = '#fff';
                toggle.style.background = 'rgba(255,255,255,0.2)';
                toggle.style.borderRadius = '8px';
            }
        }
    } else {
        console.error('[ADMIN SIDEBAR] ERROR: dose-custom-sidebar not found!');
    }

    // ═══════════════════════════════════════════════════════════════════════
    // DISPLAY SETTINGS POPOVER - Comprehensive accessibility controls
    // ═══════════════════════════════════════════════════════════════════════

    const displaySettingsBtn = document.getElementById('sidebarDisplaySettingsBtn');
    const displaySettingsPopover = document.getElementById('sidebar-display-settings-popover');
    const displaySettingsClose = document.getElementById('display-settings-close');
    const displaySettingsResetBtn = document.getElementById('display-settings-reset-btn');

    // Font size to pixel mapping
    const FONT_SIZE_MAP = {
        'small': '12px',
        'medium': '14px',
        'large': '16px'
    };

    // Get CSRF token helper
    function getCSRFToken() {
        const cookie = document.cookie.split(';').find(c => c.trim().startsWith('csrftoken='));
        return cookie ? cookie.split('=')[1] : '';
    }

    var PS_LIGHT_THEME_OPTIONS = [
        {v: 'sandstone', l: 'Sandstone — warm, easy on the eyes'},
        {v: 'journal', l: 'Journal — classic editorial'},
        {v: 'united', l: 'United — bold orange accent'},
        {v: 'cerulean', l: 'Cerulean — calm sky blue'},
        {v: 'cosmo', l: 'Cosmo — modern metro'},
        {v: 'flatly', l: 'Flatly — minimal flat (bright)'},
        {v: 'litera', l: 'Litera — book-readable'},
        {v: 'lumen', l: 'Lumen — sharp light'},
        {v: 'lux', l: 'Lux — elegant light'},
        {v: 'materia', l: 'Materia — material design'},
        {v: 'minty', l: 'Minty — fresh green'},
        {v: 'pulse', l: 'Pulse — vivid magenta'},
        {v: 'simplex', l: 'Simplex — clean red accent'},
        {v: 'sketchy', l: 'Sketchy — hand-drawn'},
        {v: 'spacelab', l: 'Spacelab — retro NASA'},
        {v: 'yeti', l: 'Yeti — cool gray'}
    ];
    var PS_DARK_THEME_OPTIONS = [
        {v: 'darkly', l: 'Darkly — classic navy dark'},
