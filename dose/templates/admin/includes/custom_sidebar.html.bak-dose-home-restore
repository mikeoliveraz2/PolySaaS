    function buildBootswatchSelect(el, options, current) {
        if (!el) return;
        el.innerHTML = '';
        options.forEach(function(opt) {
            var o = document.createElement('option');
            o.value = opt.v;
            o.textContent = opt.l;
            if (opt.v === current) o.selected = true;
            el.appendChild(o);
        });
    }

    function loadBootswatchThemeSelects() {
        var lightEl = document.getElementById('ps-sidebar-light-theme');
        var darkEl = document.getElementById('ps-sidebar-dark-theme');
        if (!lightEl || !darkEl) return;
        fetch('/admin/select-theme/api/', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                buildBootswatchSelect(lightEl, PS_LIGHT_THEME_OPTIONS, d.light_theme || 'sandstone');
                buildBootswatchSelect(darkEl, PS_DARK_THEME_OPTIONS, d.dark_theme || 'darkly');
                localStorage.setItem('ps_light_theme', d.light_theme || 'sandstone');
                localStorage.setItem('ps_dark_theme', d.dark_theme || 'darkly');
            })
            .catch(function() {
                buildBootswatchSelect(lightEl, PS_LIGHT_THEME_OPTIONS, localStorage.getItem('ps_light_theme') || 'sandstone');
                buildBootswatchSelect(darkEl, PS_DARK_THEME_OPTIONS, localStorage.getItem('ps_dark_theme') || 'darkly');
            });
    }

    function saveBootswatchThemePicks(reloadAfter) {
        var light = (document.getElementById('ps-sidebar-light-theme') || {}).value;
        var dark = (document.getElementById('ps-sidebar-dark-theme') || {}).value;
        if (!light || !dark) return;
        localStorage.setItem('ps_light_theme', light);
        localStorage.setItem('ps_dark_theme', dark);
        fetch('/admin/select-theme/', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-CSRFToken': getCSRFToken(),
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: 'light_theme=' + encodeURIComponent(light) + '&dark_theme=' + encodeURIComponent(dark)
        })
        .then(function() {
            if (reloadAfter) window.location.reload();
        })
        .catch(function() {
            if (reloadAfter) window.location.reload();
        });
    }

    function positionDisplaySettingsPopover() {
        if (!displaySettingsBtn || !displaySettingsPopover) return;
        var rect = displaySettingsBtn.getBoundingClientRect();
        var popW = 310;
        var gap = 10;
        var left = rect.right + gap;
        var top = rect.top;
        if (left + popW > window.innerWidth - 12) {
            left = Math.max(12, rect.left - popW - gap);
        }
        if (left < 12) {
            left = 12;
        }
        displaySettingsPopover.style.left = left + 'px';
        displaySettingsPopover.style.top = top + 'px';
        var popH = displaySettingsPopover.offsetHeight;
        if (top + popH > window.innerHeight - 12) {
            top = Math.max(12, window.innerHeight - popH - 12);
            displaySettingsPopover.style.top = top + 'px';
        }
    }

    // Open display settings popover (portal to body — escapes sidebar overflow:hidden)
    function openDisplaySettings() {
        if (displaySettingsPopover) {
            if (displaySettingsPopover.parentNode !== document.body) {
                document.body.appendChild(displaySettingsPopover);
            }
            loadDisplaySettings();
            loadBootswatchThemeSelects();
            displaySettingsPopover.style.display = 'block';
            positionDisplaySettingsPopover();
            requestAnimationFrame(positionDisplaySettingsPopover);
        }
    }

    // Close display settings popover
    function closeDisplaySettings() {
        if (displaySettingsPopover) {
            displaySettingsPopover.style.display = 'none';
        }
    }

    // Toggle popover
    function toggleDisplaySettings() {
        if (displaySettingsPopover && displaySettingsPopover.style.display === 'block') {
            closeDisplaySettings();
        } else {
            openDisplaySettings();
        }
    }

    // Load display settings from API
    function loadDisplaySettings() {
        fetch('/dose/api/display-settings/', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(response => {
            if (!response.ok) throw new Error('Failed to load settings');
            return response.json();
        })
        .then(settings => {
            applyDisplaySettingsToUI(settings);
            applyDisplaySettingsToPage(settings);
        })
        .catch(err => {
            console.log('[Display Settings] Using localStorage fallback:', err.message);
            loadDisplaySettingsFromLocalStorage();
        });
    }

    // Load from localStorage as fallback
    function loadDisplaySettingsFromLocalStorage() {
        const settings = {
            theme_mode: localStorage.getItem('ps_theme_mode') || 'light',
            font_size: localStorage.getItem('ps_font_size') || 'medium',
            bold_text: localStorage.getItem('ps_bold_text') === 'true',
            high_contrast: localStorage.getItem('ps_high_contrast') === 'true',
            reduce_motion: localStorage.getItem('ps_reduce_motion') === 'true',
            light_theme: localStorage.getItem('ps_light_theme') || 'flatly',
            dark_theme: localStorage.getItem('ps_dark_theme') || 'darkly'
        };
        applyDisplaySettingsToUI(settings);
        applyDisplaySettingsToPage(settings);
    }

    // Apply settings to UI controls
    function applyDisplaySettingsToUI(settings) {
        // Theme mode buttons
        document.querySelectorAll('.theme-mode-btn').forEach(btn => {
            const isActive = btn.dataset.mode === settings.theme_mode;
            btn.style.borderColor = isActive ? '#2563eb' : '#cbd5e1';
            btn.style.background = isActive ? '#dbeafe' : '#f1f5f9';
            btn.style.color = isActive ? '#1e40af' : '#475569';
        });

        // Font size buttons
        document.querySelectorAll('.font-size-btn').forEach(btn => {
            const isActive = btn.dataset.size === settings.font_size;
            btn.style.borderColor = isActive ? '#2563eb' : '#cbd5e1';
            btn.style.background = isActive ? '#dbeafe' : '#f1f5f9';
            btn.style.color = isActive ? '#1e40af' : '#475569';
        });

        // Toggle switches
        const boldToggle = document.getElementById('bold-text-toggle');
        const highContrastToggle = document.getElementById('high-contrast-toggle');
        const reduceMotionToggle = document.getElementById('reduce-motion-toggle');

        if (boldToggle) setToggleState(boldToggle, settings.bold_text);
        if (highContrastToggle) setToggleState(highContrastToggle, settings.high_contrast);
        if (reduceMotionToggle) setToggleState(reduceMotionToggle, settings.reduce_motion);
    }

    // Set toggle switch visual state
    function setToggleState(checkbox, checked) {
        checkbox.checked = checked;
        const track = checkbox.nextElementSibling;
        const thumb = track.nextElementSibling;
        if (track && thumb) {
            track.style.backgroundColor = checked ? '#2563eb' : '#cbd5e1';
            thumb.style.transform = checked ? 'translateX(18px)' : 'translateX(0)';
        }
    }

    // Apply settings to page
    function applyDisplaySettingsToPage(settings) {
        // Font size
        const fontSize = FONT_SIZE_MAP[settings.font_size] || '14px';
        document.documentElement.style.fontSize = fontSize;
        document.body.style.fontSize = fontSize;

        // Bold text
        if (settings.bold_text) {
            document.documentElement.style.fontWeight = '600';
            document.body.style.fontWeight = '600';
        } else {
            document.documentElement.style.fontWeight = '';
            document.body.style.fontWeight = '';
        }

        // High contrast
        if (settings.high_contrast) {
            document.documentElement.setAttribute('data-high-contrast', 'true');
            document.body.setAttribute('data-high-contrast', 'true');
        } else {
            document.documentElement.removeAttribute('data-high-contrast');
            document.body.removeAttribute('data-high-contrast');
        }

        // Reduce motion
        if (settings.reduce_motion) {
            document.documentElement.setAttribute('data-reduce-motion', 'true');
            document.body.setAttribute('data-reduce-motion', 'true');
        } else {
            document.documentElement.removeAttribute('data-reduce-motion');
            document.body.removeAttribute('data-reduce-motion');
        }

        // Theme mode - store for reference
        localStorage.setItem('ps_theme_mode', settings.theme_mode || 'light');
    }

    // Save display settings to API
    function saveDisplaySettings(settings) {
        fetch('/dose/api/save-display-settings/', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCSRFToken(),
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(settings)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                console.log('[Display Settings] Saved to server');
            }
        })
        .catch(err => {
            console.log('[Display Settings] Save failed, using localStorage:', err.message);
        });

        // Always save to localStorage as well for instant persistence
        if (settings.font_size !== undefined) localStorage.setItem('ps_font_size', settings.font_size);
        if (settings.bold_text !== undefined) localStorage.setItem('ps_bold_text', settings.bold_text);
        if (settings.high_contrast !== undefined) localStorage.setItem('ps_high_contrast', settings.high_contrast);
        if (settings.reduce_motion !== undefined) localStorage.setItem('ps_reduce_motion', settings.reduce_motion);
        if (settings.light_theme !== undefined) localStorage.setItem('ps_light_theme', settings.light_theme);
        if (settings.dark_theme !== undefined) localStorage.setItem('ps_dark_theme', settings.dark_theme);
    }

    var saveThemesBtn = document.getElementById('ps-sidebar-save-themes');
    if (saveThemesBtn) {
        saveThemesBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            saveBootswatchThemePicks(true);
        });
    }
    function applyThemeMode(mode) {
        var url = '/dose/set-display-mode/?mode=' + encodeURIComponent(mode);
        if (mode === 'system') {
            var effective = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark' : 'light';
            url += '&effective=' + effective;
        }
        return fetch(url, {
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'X-CSRFToken': getCSRFToken() }
        });
    }

    // Reset to defaults
    function resetDisplaySettings() {
        const defaults = {
            font_size: 'medium',
            bold_text: false,
            high_contrast: false,
            reduce_motion: false
        };

        // Clear localStorage
        localStorage.removeItem('ps_font_size');
        localStorage.removeItem('ps_bold_text');
        localStorage.removeItem('ps_high_contrast');
        localStorage.removeItem('ps_reduce_motion');

        applyDisplaySettingsToUI(defaults);
        applyDisplaySettingsToPage(defaults);
        saveDisplaySettings(defaults);
    }

    // Event listeners for display settings
    if (displaySettingsBtn && displaySettingsPopover) {
        displaySettingsBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            toggleDisplaySettings();
        });

