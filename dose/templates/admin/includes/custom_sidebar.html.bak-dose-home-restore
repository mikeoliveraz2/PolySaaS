    // Toggle switches
    const boldToggle = document.getElementById('bold-text-toggle');
    const highContrastToggle = document.getElementById('high-contrast-toggle');
    const reduceMotionToggle = document.getElementById('reduce-motion-toggle');

    if (boldToggle) {
        boldToggle.addEventListener('change', function() {
            const checked = this.checked;
            setToggleState(this, checked);
            document.documentElement.style.fontWeight = checked ? '600' : '';
            document.body.style.fontWeight = checked ? '600' : '';
            saveDisplaySettings({ bold_text: checked });
        });
    }

    if (highContrastToggle) {
        highContrastToggle.addEventListener('change', function() {
            const checked = this.checked;
            setToggleState(this, checked);
            if (checked) {
                document.documentElement.setAttribute('data-high-contrast', 'true');
                document.body.setAttribute('data-high-contrast', 'true');
            } else {
                document.documentElement.removeAttribute('data-high-contrast');
                document.body.removeAttribute('data-high-contrast');
            }
            saveDisplaySettings({ high_contrast: checked });
        });
    }

    if (reduceMotionToggle) {
        reduceMotionToggle.addEventListener('change', function() {
            const checked = this.checked;
            setToggleState(this, checked);
            if (checked) {
                document.documentElement.setAttribute('data-reduce-motion', 'true');
                document.body.setAttribute('data-reduce-motion', 'true');
            } else {
                document.documentElement.removeAttribute('data-reduce-motion');
                document.body.removeAttribute('data-reduce-motion');
            }
            saveDisplaySettings({ reduce_motion: checked });
        });
