## runwt.ps1 - Main Cursor workspace launcher

Write-Host "Starting PolySaaS from Cursor Workspace..." -ForegroundColor Green

# Get the root directory (where this script is)
$ROOT = Split-Path -Parent $MyInvocation.MyCommand.Path

Write-Host "Root: $ROOT" -ForegroundColor Cyan

# Change to root if not already there
Push-Location $ROOT
Write-Host "Working directory: $ROOT" -ForegroundColor Green

# Activate venv
$VENV_PATH = Join-Path $ROOT "venv\Scripts\Activate.ps1"
if (Test-Path $VENV_PATH) {
    & $VENV_PATH
    Write-Host "Virtual environment activated" -ForegroundColor Green
} else {
    Write-Host "Warning: Virtual environment not found at $VENV_PATH" -ForegroundColor Yellow
}

# Force PYTHONPATH to use ONLY the main workspace (not grok worktree)
$env:PYTHONPATH = $ROOT

# Fallback secret key
if (-not $env:DJANGO_SECRET_KEY) {
    $env:DJANGO_SECRET_KEY = "django-insecure-cursor-$(Get-Random -Maximum 999999999)"
}

Clear-Host
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "PolySaaS - Cursor Workspace" -ForegroundColor Green
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Root: $ROOT" -ForegroundColor Gray
Write-Host "Python: $(python --version)" -ForegroundColor Gray
Write-Host "PYTHONPATH: $env:PYTHONPATH" -ForegroundColor Gray
Write-Host "========================================" -ForegroundColor Cyan

# Run Django dev server
python manage.py runserver 0.0.0.0:8000
