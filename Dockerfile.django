# PolySaaS Django (DOSE) — container deploy
# Build: docker build -f Dockerfile.django -t polysaas-django .
# Run:   docker run -e DJANGO_SECRET_KEY=... -e DATABASE_URL=... -p 8000:8000 polysaas-django

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DJANGO_SETTINGS_MODULE=mysite.settings_hosted

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY manage.py test_decompression_view.py ./
COPY mysite ./mysite
COPY dose ./dose
COPY captured_topics ./captured_topics
COPY llm_router ./llm_router
COPY parameters ./parameters
COPY alerts ./alerts
COPY ml_studio ./ml_studio
COPY active_urls ./active_urls
COPY middleware ./middleware
COPY static ./static
COPY templates ./templates
COPY deploy/hostinger/entrypoint-django.sh /entrypoint-django.sh

RUN mkdir -p /app/var/static_root /app/var/media_root \
    && chmod +x /entrypoint-django.sh \
    && adduser --disabled-password --gecos '' --uid 1000 django \
    && chown -R django:django /app /entrypoint-django.sh

# Collect static at build (Whitenoise); secrets not required for collectstatic with hosted settings if DEBUG path allowed
USER django
RUN DJANGO_SECRET_KEY=build-only-not-for-runtime \
    ALLOWED_HOSTS=localhost \
    DATABASE_URL=sqlite:///tmp/build.db \
    python manage.py collectstatic --noinput || true

EXPOSE 8000

ENTRYPOINT ["/entrypoint-django.sh"]
CMD ["web"]

