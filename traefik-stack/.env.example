# =============================================================================
# Traefik v3 Path-Based Routing Stack - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values

# =============================================================================
# Domain Configuration
# =============================================================================
DOMAIN=production.polysaas.online
TRAEFIK_DOMAIN=traefik.production.polysaas.online

# =============================================================================
# Traefik Configuration
# =============================================================================
# Email for Let's Encrypt certificate notifications
ACME_EMAIL=admin@polysaas.online

# Basic auth for Traefik dashboard (generate with: htpasswd -nb user pass)
TRAEFIK_BASIC_AUTH=user:$apr1$hash...

# =============================================================================
# PolySaaS Django Core
# =============================================================================
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
ALLOWED_HOSTS=production.polysaas.online,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://production.polysaas.online,http://production.polysaas.online

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_USER=polysaas
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD
POSTGRES_DB=polysaas

# =============================================================================
# Redis
# =============================================================================
REDIS_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# =============================================================================
# Mattermost
# =============================================================================
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SQLSETTINGS_DATASOURCE=postgres://polysaas:CHANGE_THIS_TO_A_SECURE_PASSWORD@postgres:5432/mattermost?sslmode=disable
MM_SERVICESETTINGS_SITEURL=https://production.polysaas.online/mattermost

# =============================================================================
# Odoo
# =============================================================================
ODOO_ADMIN_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD
ODOO_DB_HOST=postgres
ODOO_DB_USER=polysaas
ODOO_DB_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD
ODOO_DB_NAME=odoo

# =============================================================================
# Nextcloud
# =============================================================================
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD
NEXTCLOUD_TRUSTED_DOMAINS=production.polysaas.online
NEXTCLOUD_DB_HOST=postgres
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=polysaas
NEXTCLOUD_DB_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# =============================================================================
# Additional Services (placeholders)
# =============================================================================
# Dolibarr
DOLIBARR_DB_HOST=postgres
DOLIBARR_DB_NAME=dolibarr
DOLIBARR_DB_USER=polysaas
DOLIBARR_DB_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# Liferay
LIFERAY_DB_HOST=postgres
LIFERAY_DB_NAME=liferay
LIFERAY_DB_USER=polysaas
LIFERAY_DB_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# WordPress
WORDPRESS_DB_HOST=postgres
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=polysaas
WORDPRESS_DB_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD
