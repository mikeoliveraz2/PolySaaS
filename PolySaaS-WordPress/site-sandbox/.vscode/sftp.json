{
  "name": "SANITIZED - SFTP (placeholders)",
  "host": "<SFTP_HOST>",
  "protocol": "sftp",
  "port": 22,
  "username": "<USERNAME>",
  "password": "<REDACTED>",
  "remotePath": "<REMOTE_PATH>",
  "uploadOnSave": false,
  "syncMode": "update",
  "interactiveAuth": true,
  "ignore": [
    ".vscode/**",
    ".git/**",
    ".DS_Store",
    "wp-config.php",
    ".env",
    "/wp-content/uploads/**",
    "/wp-content/cache/**",
    "/wp-content/upgrade/**"
  ],
  "watcher": {
    "files": "**/*.{php,css,js,html,svg,json,txt}",
    "autoUpload": false,
    "autoDelete": false
  },
  "downloadOnOpen": false,
  "note": "Sanitized in repo — replace placeholders locally before use"
}