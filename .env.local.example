# PolySaaS laptop standalone environment.
# Copy these values into `.env` when you want Django to use the local Docker stack.

DJANGO_SETTINGS_MODULE=mysite.settings
DJANGO_SECRET_KEY=change-me-local-only
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Core Django database, exposed by docker-compose.local.yml on localhost:15433.
DB_NAME=dosedbsaas
DB_USER=dosedbadmin
DOSE_DB_PASSWORD=PolySaaS2026!
DB_HOST=localhost
DB_PORT=15433
DATABASE_URL=postgresql://dosedbadmin:PolySaaS2026!@localhost:15433/dosedbsaas

# Celery broker used by current settings.py.
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Shared local app origins.
MATTERMOST_URL=http://localhost:8065
NEXTCLOUD_SHARED_URL=http://localhost:8888
NEXTCLOUD_SHARED_ADMIN_LOGIN=ncadmin
ODOO_SHARED_URL=http://localhost:8086
ODOO_SHARED_DB=polysaas_odoo
ODOO_XMLRPC_ADMIN_LOGIN=admin
DOLIBARR_SHARED_URL=http://localhost:8083

# Shared bootstrap password for local app admins. Replace for real deployments.
POLYSAAS_APP_ADMIN_PASSWORD=PolySaaS2026!

# App database defaults used by docker-compose.local.yml.
MATTERMOST_DB_NAME=mattermost
MATTERMOST_DB_USER=mattermost
MATTERMOST_DB_PASSWORD=mattermost_pw
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=nextcloud_pw
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo_pw
DOLIBARR_DB_NAME=dolibarr
DOLIBARR_DB_USER=dolibarr
DOLIBARR_DB_PASSWORD=dolibarr_pw
DOLIBARR_DB_ROOT_PASSWORD=dolibarr_root_pw

# LLM Router — configure API keys for Claude (Anthropic), Gemini (Google), or xAI (Grok).
# Geronimo defaults to Claude for endpoint homes and admin chat.
# Visit https://console.anthropic.com/account/keys to get ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: override default LLM providers (standard, lite, heavy, admin_chat)
# LLM_ROUTER_STANDARD_PROVIDER=anthropic
# LLM_ROUTER_STANDARD_MODEL=claude-sonnet-4-20250514
# LLM_ROUTER_ADMIN_CHAT_PROVIDER=anthropic
# LLM_ROUTER_ADMIN_CHAT_MODEL=claude-sonnet-4-20250514

# Keep live payment/OAuth credentials out of local stack until explicitly needed.
STRIPE_LIVE_MODE=false